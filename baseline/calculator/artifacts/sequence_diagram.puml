@startuml sequence_diagram

skinparam sequenceArrowThickness 2
skinparam sequenceParticipantBorderColor #555555

actor       User
participant "CalculatorCLI"     as CLI
participant "CalculatorService" as Service
participant "Calculator"        as Calc
participant "JsonStorage"       as Storage
database    "calculations.json" as DB

== Interactive Mode ==

User  -> CLI : run_interactive()

loop until exit chosen
    CLI  --> User : display menu
    User  -> CLI  : choice

    alt valid operation chosen (1–4)
        CLI  --> User    : prompt first number
        User  -> CLI     : a
        CLI  --> User    : prompt second number
        User  -> CLI     : b

        CLI   -> Service : perform(op, a, b)
        activate Service

        Service -> Calc  : calculate(op, a, b)
        activate Calc

        alt calculation succeeds
            Calc --> Service : result : float
            deactivate Calc

            Service -> Service : new CalculationResult(op, a, b, result)

            Service -> Storage : save(result)
            activate Storage
            Storage -> DB      : read records
            DB     --> Storage : records : list
            Storage -> DB      : write updated records
            DB     --> Storage : ok
            Storage --> Service : None
            deactivate Storage

            Service --> CLI : result : CalculationResult
            deactivate Service
            CLI --> User    : "a op b = result"

        else ValueError (e.g. division by zero)
            Calc --> Service : raises ValueError
            deactivate Calc
            deactivate Service
            CLI --> User : "Error: <message>"
        end

    else history chosen (5)
        CLI   -> Service : get_history()
        activate Service
        Service -> Storage : load_all()
        activate Storage
        Storage -> DB      : read records
        DB     --> Storage : raw records : list
        Storage --> Service : records : list[CalculationResult]
        deactivate Storage
        Service --> CLI    : history : list[CalculationResult]
        deactivate Service
        CLI --> User : print each entry with timestamp

    else exit chosen (6)
        CLI --> User : "Goodbye!"
    end
end

== Command Mode ==

User -> CLI : run_command(op_str, a, b)
activate CLI

CLI -> CLI : Operation.from_string(op_str)

alt valid operation
    CLI   -> Service : perform(op, a, b)
    activate Service

    Service -> Calc  : calculate(op, a, b)
    activate Calc

    alt calculation succeeds
        Calc    --> Service : result : float
        deactivate Calc
        Service -> Storage  : save(result)
        activate Storage
        Storage -> DB       : read records
        DB      --> Storage : records : list
        Storage -> DB       : write updated records
        DB      --> Storage : ok
        Storage --> Service : None
        deactivate Storage
        Service --> CLI     : result : CalculationResult
        deactivate Service
        CLI     --> User    : "a op b = result"

    else ValueError
        Calc    --> Service : raises ValueError
        deactivate Calc
        deactivate Service
        CLI     --> User    : "Error: <message>" (stderr, exit 1)
    end

else invalid operation string
    CLI --> User : "Error: Unknown operation" (stderr, exit 1)
end

deactivate CLI

@enduml
