@startuml use_case_diagram

<style>
usecaseDiagram {
  FontSize 13
  ActorFontSize 14
}
</style>

left to right direction

actor User

rectangle "Calculator Application" {
    usecase "Calculate a result"          as UC_Calc
    usecase "Review calculation history"  as UC_History
    usecase "Validate inputs"             as UC_Validate
    usecase "Record result"               as UC_Record
}

User --> UC_Calc
User --> UC_History

' <<include>>: Validate inputs is mandatory — always executed
UC_Calc ..> UC_Validate : <<include>>

' <<extend>>: Record result is conditional — only when calculation succeeds
UC_Record ..> UC_Calc : <<extend>>
note on link : [calculation succeeded]

@enduml
