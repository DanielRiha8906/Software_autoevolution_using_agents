@startuml activity_diagram

skinparam activityBackgroundColor #DDEEFF
skinparam activityBorderColor     #3366AA
skinparam activityDiamondBackgroundColor #FFF3CC

start

:Load WorkflowJsonStorage\n& WorkflowRunService;

if (CLI arguments provided?) then (yes)
  :Parse args with argparse;
  switch (subcommand)

    case (add)
      :Read name, branch, status\nconclusion, run-number, commit-sha;
      :WorkflowRunTracker.track();
      :Print "Added run <id>";

    case (list)
      :WorkflowRunService.list_runs();
      if (--branch?) then (yes)
        :filter_by_branch();
      elseif (--status?) then (yes)
        :filter_by_status();
      elseif (--conclusion?) then (yes)
        :filter_by_conclusion();
      endif
      if (no runs?) then (yes)
        :Print "No runs found.";
      else (no)
        :Print formatted run list;
      endif

    case (detail)
      :WorkflowRunService.get_run_detail(run_id);
      if (run found?) then (yes)
        :Print run details;
      else (no)
        :Print error to stderr;
        :Exit code 1;
      endif

  endswitch
  stop

else (no)
  :Display interactive menu;
endif

repeat

  :Wait for user selection;

  switch (choice)

    case (1 — Add workflow run)
      :Prompt workflow name;
      :Prompt branch;
      :Choose status from list;
      :Choose conclusion (optional, 0 to skip);
      :Prompt run number (optional);
      :Prompt commit SHA (optional);
      :WorkflowRunTracker.track();
      :Print "Added run <id>";

    case (2 — List all runs)
      :WorkflowRunService.list_runs();
      if (no runs?) then (yes)
        :Print "No runs recorded.";
      else (no)
        :Print all runs;
      endif

    case (3 — Get run detail)
      :Prompt run ID;
      :WorkflowRunService.get_run_detail(run_id);
      if (found?) then (yes)
        :Print run details;
      else (no)
        :Print "No run found with id '<id>'";
      endif

    case (4 — Filter runs)
      :Choose filter type\n(branch / status / conclusion);
      if (branch?) then (yes)
        :Prompt branch name;
        :filter_by_branch();
      elseif (status?) then (yes)
        :Choose status from list;
        :filter_by_status();
      else (conclusion)
        :Choose conclusion from list;
        :filter_by_conclusion();
      endif
      if (no matches?) then (yes)
        :Print "No matching runs.";
      else (no)
        :Print matching runs;
      endif

    case (5 — Exit)
      :Print "Goodbye.";
      stop

  endswitch

repeat while (user continues)

@enduml
