@startuml sequence_diagram

skinparam sequenceArrowThickness 2
skinparam sequenceParticipantBorderColor #555555

actor       User
participant "InteractiveMenu\n/ workflow_cli" as UI
participant "WorkflowRunTracker"  as TRACKER
participant "WorkflowRunService"  as SVC
participant "WorkflowJsonStorage" as STOR
database    "workflow_runs.json"  as DB

== Add a workflow run ==

User    -> UI      : choice "1" (Add workflow run)
UI     --> User    : prompt name, branch, status,\nconclusion, run_number, commit_sha
User    -> UI      : provides values

UI      -> TRACKER : track(name, branch, status, ...)
activate TRACKER
TRACKER -> TRACKER : WorkflowRun(id=uuid4(),\ncreated_at=now(), ...)
TRACKER -> SVC     : add_workflow_run(run)
activate SVC
note right of SVC  : raises ValueError if id already exists
SVC     -> STOR    : save(runs)
activate STOR
STOR    -> DB      : write JSON
DB     --> STOR    : ok
deactivate STOR
SVC    --> TRACKER : run : WorkflowRun
deactivate SVC
TRACKER --> UI     : run : WorkflowRun
deactivate TRACKER
UI     --> User    : "Added run <id>"

== List all runs ==

User    -> UI  : choice "2" (List all runs)
UI      -> SVC : list_runs()
activate SVC
SVC    --> UI  : runs : List[WorkflowRun]
deactivate SVC
UI     --> User : formatted run list

== Filter runs by status ==

User    -> UI  : choice "4" (Filter) → "status"
UI     --> User : prompt status choice
User    -> UI  : status value
UI      -> SVC : filter_by_status(WorkflowStatus)
activate SVC
SVC    --> UI  : matching_runs : List[WorkflowRun]
deactivate SVC
alt runs found
    UI --> User : formatted matching runs
else no matches
    UI --> User : "No matching runs."
end

== Get run detail ==

User    -> UI  : choice "3" (Get run detail)
UI     --> User : prompt run ID
User    -> UI  : run_id
UI      -> SVC : get_run_detail(run_id)
activate SVC
SVC    --> UI  : run : Optional[WorkflowRun]
deactivate SVC
alt run found
    UI --> User : formatted run details
else not found
    UI --> User : "No run found with id '<id>'"
end

@enduml
