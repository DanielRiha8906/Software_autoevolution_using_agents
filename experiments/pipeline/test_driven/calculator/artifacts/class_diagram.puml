@startuml class_diagram

skinparam classAttributeIconSize 0
skinparam classFontStyle bold

package "core" #DDFFD4 {
    interface "<<protocol>>\nCalculationEngine" as CalcProto {
        +calculate(operation: Operation, a: float, b: float) : float
    }

    class Calculator {
        +add(a: float, b: float) : float
        +subtract(a: float, b: float) : float
        +multiply(a: float, b: float) : float
        +divide(a: float, b: float) : float
        +square(a: float, b: float = 0) : float
        +sqrt(a: float, b: float = 0) : float
        +power(a: float, b: float) : float
        +modulo(a: float, b: float) : float
        +calculate(op: Operation, a: float, b: float) : float
    }

    class ScientificCalculator {
        +sin(a: float, b: float = 0) : float
        +cos(a: float, b: float = 0) : float
        +tan(a: float, b: float = 0) : float
        +log(a: float, b: float = 0) : float
        +ln(a: float, b: float = 0) : float
        +exp(a: float, b: float = 0) : float
        +calculate(op: Operation, a: float, b: float) : float
    }

    ScientificCalculator --|> Calculator
    Calculator ..|> CalcProto : implements
    ScientificCalculator ..|> CalcProto : implements
}

package "storage" #FFF3CC {
    interface "<<protocol>>\nStorageBackend" as StorProto {
        +save(result: CalculationResult) : void
        +load_all() : list[CalculationResult]
    }

    class JsonStorage {
        -filepath : Path
        --
        +JsonStorage(filepath: Path | str)
        +save(result: CalculationResult) : void
        +load_all() : list[CalculationResult]
        -_read_raw() : list
        -_write_raw(records: list) : void
    }

    JsonStorage ..|> StorProto : implements
}

package "history" #FFF8CC {
    interface "<<protocol>>\nMemoryBackend" as MemProto {
        +store(entry: MemoryEntry) : void
        +retrieve() : list[MemoryEntry]
    }

    class MemoryService {
        -_entries : list[MemoryEntry]
        --
        +MemoryService()
        +store(entry: MemoryEntry) : void
        +retrieve() : list[MemoryEntry]
        +query(operation: Optional[str], success: Optional[bool]) : list[MemoryEntry]
    }

    class StatisticsService {
        -_memory_service : MemoryBackend
        --
        +StatisticsService(memory_service: MemoryBackend)
        +compute() : StatisticsResult
    }

    class ImportExportService {
        --
        +export(memory_service: MemoryBackend, filepath: Path | str) : void
        +import_from(memory_service: MemoryBackend, filepath: Path | str) : void
    }

    MemoryService ..|> MemProto : implements
    StatisticsService --> MemProto : depends on
    ImportExportService --> MemProto : depends on
}

package "services" #E5F3FF {
    class CalculatorService {
        -calculator : CalculationEngine
        -storage : StorageBackend
        --
        +CalculatorService(calculator: CalculationEngine, storage: StorageBackend)
        +perform(operation: Operation, a: float, b: float) : CalculationResult
        +get_history() : list[CalculationResult]
    }

    CalculatorService --> CalcProto : depends on
    CalculatorService --> StorProto : depends on
}

package "cli" #FFE5E5 {
    class CalculatorCLI {
        -service : CalculatorService
        -memory_service : MemoryService [0..1]
        -import_export_service : ImportExportService [0..1]
        --
        +CalculatorCLI(service, memory_service [0..1], import_export_service [0..1])
        +run_interactive() : void
        +run_command(operation_str: str, a: float, b: float) : void
        -_build_menu() : list[tuple]
        -_print_menu() : void
    }

    CalculatorCLI --> CalculatorService : service
    CalculatorCLI --> MemoryService : memory_service
    CalculatorCLI --> ImportExportService : import_export_service
}

package "models" #DDEEFF {
    enum Operation {
        ADD, SUBTRACT, MULTIPLY, DIVIDE
        SQUARE, SQRT, POWER, MODULO
        SIN, COS, TAN
        LOG, LN, EXP
        --
        +from_string(value: str) : Operation
        +display_name() : str
    }

    class CalculationResult {
        +operation : str
        +operand_a : float
        +operand_b : float
        +result : float
        +timestamp : str
        +execution_time_ms : float
        --
        +to_dict() : dict
        +from_dict(data: dict) : CalculationResult
    }

    class MemoryEntry {
        +operation : str
        +operands : list
        +result : Optional[float]
        +success : bool
        +execution_time_ms : float
        +id : str
        +timestamp : str
        --
        +to_dict() : dict
        +from_dict(data: dict) : MemoryEntry
    }

    class StatisticsResult {
        +count_per_operation : dict[str, int]
        +total_errors : int
        +error_rate : float
        +avg_execution_time_ms : float
    }
}

CalculatorService ..> CalculationResult : creates
CalculatorService ..> Operation
CalculatorCLI ..> Operation
Calculator ..> Operation
JsonStorage ..> CalculationResult : stores
MemoryService ..> MemoryEntry : manages
ImportExportService ..> MemoryEntry : serializes
StatisticsService ..> StatisticsResult : creates

@enduml