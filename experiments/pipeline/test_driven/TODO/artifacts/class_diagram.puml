@startuml class_diagram

skinparam classAttributeIconSize 0
skinparam classFontStyle bold

package "models" #DDEEFF {
    enum TaskStatus {
        PENDING
        IN_PROGRESS
        DONE
    }

    class Project {
        +id : String
        +name : String
        +description : String [0..1]
        +created_at : DateTime
        --
        +__post_init__() : void
        +to_dict() : Dictionary
        +from_dict(data: Dictionary) : Project
    }

    class Task {
        +id : String
        +title : String
        +description : String [0..1]
        +status : TaskStatus
        +created_at : DateTime
        +updated_at : DateTime
        +due_date : DateTime [0..1]
        +project_id : String [0..1]
        --
        +__post_init__() : void
        +to_dict() : Dictionary
        +from_dict(data: Dictionary) : Task
        +mark_in_progress() : void
        +mark_done() : void
        +reopen() : void
        +is_completed() : bool
        +is_pending() : bool
        +is_in_progress() : bool
        +is_overdue() : bool
    }

    class TaskComment {
        +id : String
        +task_id : String
        +content : String
        +created_at : DateTime
        +author : String [0..1]
        +updated_at : DateTime [0..1]
        --
        +__post_init__() : void
        +to_dict() : Dictionary
        +from_dict(data: Dictionary) : TaskComment
    }
}

package "storage" #FFF3CC {
    class JsonStorage {
        -path : String
        --
        +JsonStorage(path: String [0..1])
        +load() : List<Dictionary>
        +save(tasks: List<Dictionary>) : void
        +load_comments() : List<Dictionary>
        +save_comments(comments: List<Dictionary>) : void
        +load_projects() : List<Dictionary>
        +save_projects(projects: List<Dictionary>) : void
    }
}

package "services" #DDFFD4 {
    exception TaskNotFoundError
    exception ProjectNotFoundError

    class TaskManager {
        -storage : JsonStorage
        -tasks : Dictionary<String, Task>
        --
        +TaskManager(storage: JsonStorage [0..1])
        +add(title: String, description: String [0..1], project_id: String [0..1]) : Task
        +get(taskId: String) : Task
        +listAll() : List<Task>
        +listByStatus(status: TaskStatus) : List<Task>
        +listByProject(project_id: String) : List<Task>
        +update(taskId: String, title: String [0..1], description: String [0..1], project_id: String [0..1]) : Task
        +setStatus(taskId: String, status: TaskStatus) : Task
        +delete(taskId: String) : void
        -load() : void
        -persist() : void
    }

    class ProjectService {
        -_storage : JsonStorage
        -_projects : Dictionary<String, Project>
        --
        +ProjectService(storage: JsonStorage [0..1])
        +create(name: String, description: String [0..1]) : Project
        +get(project_id: String) : Project
        +list_all() : List<Project>
        +update(project_id: String, name: String [0..1], description: String [0..1]) : Project
        +delete(project_id: String) : void
        -_load() : void
        -_persist() : void
    }

    class TodoService {
        -_manager : TaskManager
        --
        +TodoService(storage: JsonStorage [0..1])
        +add_task(title: String, description: String [0..1], due_date: DateTime [0..1], project_id: String [0..1]) : Task
        +get_task(taskId: String) : Task
        +list_tasks(status: TaskStatus [0..1], due_before: DateTime [0..1], due_after: DateTime [0..1], overdue: bool, project_id: String [0..1]) : List<Task>
        +start_task(taskId: String) : Task
        +complete_task(taskId: String) : Task
        +reopen_task(taskId: String) : Task
        +update_task(taskId: String, title: String [0..1], description: String [0..1], project_id: String [0..1]) : Task
        +delete_task(taskId: String) : void
    }

    class CommentsService {
        -todo_service : TodoService
        -storage : JsonStorage
        -comments : Dictionary<String, TaskComment>
        --
        +CommentsService(todo_service: TodoService, storage: JsonStorage [0..1])
        +add_comment(task_id: String, content: String) : TaskComment
        +list_comments(task_id: String) : List<TaskComment>
        +delete_comment(comment_id: String) : void
        +delete_comments_for_task(task_id: String) : void
    }

    class TaskStatistics {
        +total : int
        +count_per_status : dict
        +overdue_count : int
        +with_due_date_count : int
        +completion_rate : float
    }

    class TaskStatisticsService {
        -_service : TodoService
        --
        +TaskStatisticsService(todo_service: TodoService)
        +compute() : TaskStatistics
    }

    class TaskImportExportService {
        -_todo_service : TodoService
        -_comments_service : CommentsService
        --
        +TaskImportExportService(todo_service: TodoService, comments_service: CommentsService)
        +export(filepath: String) : void
        +import_from(filepath: String) : Tuple<List<Task>, List<TaskComment>>
    }
}

package "cli" #FFE5E5 {
    class TodoCLI {
        -service : TodoService
        -comments_service : CommentsService
        -import_export_service : TaskImportExportService
        --
        +TodoCLI(storagePath: String [0..1])
        +run(argv: List<String> [0..1]) : Integer
    }

    class InteractiveMenu {
        -service : TodoService
        -comments_service : CommentsService
        -import_export_service : TaskImportExportService
        --
        +InteractiveMenu(storagePath: String [0..1])
        +run() : void
    }
}

Task --> TaskStatus : status
Task --> Project : references [0..1]
TaskComment --> Task : task_id
TaskManager --> JsonStorage : storage
TaskManager ..> TaskNotFoundError : raises
ProjectService --> JsonStorage : storage
ProjectService --> Project : manages
ProjectService ..> ProjectNotFoundError : raises
TodoService --> TaskManager : _manager
CommentsService --> TodoService : todo_service
CommentsService --> JsonStorage : storage
CommentsService --> TaskComment : contains
TaskStatisticsService --> TodoService : uses
TaskStatisticsService --> TaskStatistics : returns
TaskImportExportService --> TodoService : uses
TaskImportExportService --> CommentsService : uses
TaskImportExportService --> Task : works with
TaskImportExportService --> TaskComment : works with
TodoCLI --> TodoService : service
TodoCLI --> CommentsService : comments_service
TodoCLI --> TaskImportExportService : import_export_service
InteractiveMenu --> TodoService : service
InteractiveMenu --> CommentsService : comments_service
InteractiveMenu --> TaskImportExportService : import_export_service

@enduml