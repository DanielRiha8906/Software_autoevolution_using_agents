@startuml class_diagram

skinparam classAttributeIconSize 0
skinparam classFontStyle bold

package "models" #DDEEFF {
    enum TaskStatus {
        PENDING
        IN_PROGRESS
        DONE
    }

    class Project {
        +id : String
        +name : String
        +description : String [0..1]
        +created_at : DateTime
        --
        +__post_init__() : void
        +to_dict() : Dictionary
        +from_dict(data: Dictionary) : Project
    }

    class Task {
        +id : String
        +title : String
        +description : String [0..1]
        +status : TaskStatus
        +created_at : DateTime
        +updated_at : DateTime
        +due_date : DateTime [0..1]
        +project_id : String [0..1]
        --
        +__post_init__() : void
        +to_dict() : Dictionary
        +from_dict(data: Dictionary) : Task
        +mark_in_progress() : void
        +mark_done() : void
        +reopen() : void
        +is_completed() : bool
        +is_pending() : bool
        +is_in_progress() : bool
        +is_overdue() : bool
    }

    class TaskComment {
        +id : String
        +task_id : String
        +content : String
        +created_at : DateTime
        +author : String [0..1]
        +updated_at : DateTime [0..1]
        --
        +__post_init__() : void
        +to_dict() : Dictionary
        +from_dict(data: Dictionary) : TaskComment
    }
}

package "serialization" #FFF8DC {
    class TaskSerializer {
        --
        +{static}to_dict(task: Task) : Dictionary
        +{static}from_dict(data: Dictionary) : Task
    }
}

package "storage" #FFF3CC {
    interface StoragePort <<protocol>> {
        +load() : List<Dictionary>
        +save(tasks: List<Dictionary>) : void
    }

    class JsonStorage {
        -path : Path
        --
        +JsonStorage(path: String [0..1])
        +load() : List<Dictionary>
        +save(tasks: List<Dictionary>) : void
        +load_comments() : List<Dictionary>
        +save_comments(comments: List<Dictionary>) : void
        +load_projects() : List<Dictionary>
        +save_projects(projects: List<Dictionary>) : void
    }
}

package "repositories" #FFE4E1 {
    class TaskRepository {
        -_storage : StoragePort
        -_serializer : TaskSerializer
        --
        +TaskRepository(storage: StoragePort)
        +load_all() : List<Task>
        +save_all(tasks: List<Task>) : void
    }
}

package "services" #DDFFD4 {
    exception TaskNotFoundError
    exception ProjectNotFoundError

    class TaskManager {
        -_repository : TaskRepository
        -_tasks : Dictionary<String, Task>
        --
        +TaskManager(storage_or_repo: Union[JsonStorage, TaskRepository] [0..1])
        +add(title: String, description: String [0..1], project_id: String [0..1]) : Task
        +get(task_id: String) : Task
        +list_all() : List<Task>
        +list_by_status(status: TaskStatus) : List<Task>
        +list_by_project(project_id: String) : List<Task>
        +update(task_id: String, title: String [0..1], description: String [0..1], project_id: String [0..1]) : Task
        +set_status(task_id: String, status: TaskStatus) : Task
        +delete(task_id: String) : void
        -_load() : void
        -_persist() : void
    }

    class ProjectService {
        -_storage : JsonStorage
        -_projects : Dictionary<String, Project>
        --
        +ProjectService(storage: JsonStorage [0..1])
        +create(name: String, description: String [0..1]) : Project
        +get(project_id: String) : Project
        +list_all() : List<Project>
        +update(project_id: String, name: String [0..1], description: String [0..1]) : Project
        +delete(project_id: String) : void
        -_load() : void
        -_persist() : void
    }

    class TodoService {
        -_manager : TaskManager
        --
        +TodoService(storage: JsonStorage [0..1])
        +add_task(title: String, description: String [0..1], due_date: DateTime [0..1], project_id: String [0..1]) : Task
        +get_task(task_id: String) : Task
        +list_tasks(status: TaskStatus [0..1], due_before: DateTime [0..1], due_after: DateTime [0..1], overdue: bool, project_id: String [0..1]) : List<Task>
        +start_task(task_id: String) : Task
        +complete_task(task_id: String) : Task
        +reopen_task(task_id: String) : Task
        +update_task(task_id: String, title: String [0..1], description: String [0..1], project_id: String [0..1]) : Task
        +delete_task(task_id: String) : void
    }

    class CommentsService {
        -_todo_service : TodoService
        -_storage : JsonStorage
        -_comments : Dictionary<String, TaskComment>
        --
        +CommentsService(todo_service: TodoService, storage: JsonStorage [0..1])
        +add_comment(task_id: String, content: String) : TaskComment
        +list_comments(task_id: String) : List<TaskComment>
        +delete_comment(comment_id: String) : void
        +delete_comments_for_task(task_id: String) : void
    }

    class TaskStatistics {
        +total : int
        +count_per_status : dict
        +overdue_count : int
        +with_due_date_count : int
        +completion_rate : float
    }

    class TaskStatisticsService {
        -_service : TodoService
        --
        +TaskStatisticsService(todo_service: TodoService)
        +compute() : TaskStatistics
    }

    class TaskImportExportService {
        -_todo_service : TodoService
        -_comments_service : CommentsService
        --
        +TaskImportExportService(todo_service: TodoService, comments_service: CommentsService)
        +export(filepath: String) : void
        +import_from(filepath: String) : Tuple<List<Task>, List<TaskComment>>
    }

    class DatetimeService {
        --
        +{static}utc_now() : DateTime
    }
}

package "formatters" #FFEBCD {
    class TaskFormatter {
        --
        +{static}get_status_symbol(status: TaskStatus) : String
        +{static}get_status_name(status: TaskStatus) : String
        +{static}format_task_line(task: Task, show_project: bool) : String
    }
}

package "cli" #FFE5E5 {
    class TodoCLI {
        -_service : TodoService
        -_project_service : ProjectService
        -_comments_service : CommentsService
        -_import_export_service : TaskImportExportService
        --
        +TodoCLI(storage_path: String [0..1])
        +run(argv: List<String> [0..1]) : Integer
    }

    class InteractiveMenu {
        -service : TodoService
        -comments_service : CommentsService
        -import_export_service : TaskImportExportService
        --
        +InteractiveMenu(storagePath: String [0..1])
        +run() : void
    }
}

