@startuml component_diagram

skinparam componentStyle uml2
skinparam defaultFontSize 12

top to bottom direction

package "TODO Application" {

    component "Entry Point\n(__main__)" as Main

    package "GUI Layer" #FFD9B3 {
        component "Tkinter GUI\n(TodoGUI)" as GUI
    }

    package "CLI Layer" #FFE5E5 {
        component "Interactive Menu\n(InteractiveMenu)" as IM
        component "Command-line Interface\n(TodoCLI)" as CLI
    }

    package "Formatter Layer" #FFEBCD {
        component "Task Formatter\n(TaskFormatter)" as TF
    }

    package "Service Layer" #DDFFD4 {
        component "Todo Service\n(TodoService)" as SVC
        component "Task Manager\n(TaskManager)" as MGR
        component "Project Service\n(ProjectService)" as PSVC
        component "Comments Service\n(CommentsService)" as CSVC
        component "Statistics Service\n(TaskStatisticsService)" as STATS
        component "Import/Export Service\n(TaskImportExportService)" as IESVC
        component "Datetime Service\n(DatetimeService)" as DTS
    }

    package "Repository Layer" #FFE4E1 {
        component "Task Repository\n(TaskRepository)" as REPO
    }

    package "Serialization Layer" #FFF8DC {
        component "Task Serializer\n(TaskSerializer)" as SER
    }

    package "Storage Layer" #FFF3CC {
        component "Storage Protocol\n(StoragePort)" as SP
        component "JSON Storage\n(JsonStorage)" as Storage
    }

    package "Models Layer" #DDEEFF {
        component "Task, TaskStatus\n(models)" as Model
        component "Project\n(models)" as PModel
        component "TaskComment\n(models)" as CModel
    }
}

database "todo_data.json" as DB

Main --> GUI : gui
Main --> IM : interactive
Main --> CLI : command-line

GUI --> SVC
GUI --> TF
IM --> SVC
IM --> PSVC
IM --> IESVC
IM --> TF
CLI --> SVC
CLI --> PSVC
CLI --> IESVC
CLI --> TF

TF ..> Model : depends
TF ..> CModel : depends

SVC --> MGR : delegates
SVC --> DTS : uses
PSVC --> Storage : uses
CSVC --> SVC : validates
CSVC --> Storage : persists
STATS --> SVC : analyzes

IESVC --> SVC : exports
IESVC --> CSVC : exports

MGR --> REPO : delegates
REPO --> SER : uses
REPO --> SP : depends

SER ..> Model : serializes
SER ..> CModel : serializes

SP <|.. Storage : implements
Storage --> DB : read/write

Storage ..> Model : loads/saves
Storage ..> PModel : loads/saves
Storage ..> CModel : loads/saves

@enduml