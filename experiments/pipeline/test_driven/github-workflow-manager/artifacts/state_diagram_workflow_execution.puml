@startuml state_diagram_workflow_execution

title WorkflowRun execution lifecycle

skinparam state {
  BackgroundColor #DDEEFF
  BorderColor #3366AA
  FontStyle bold
}

[*] --> REQUESTED : workflow triggered

REQUESTED --> QUEUED   : accepted
REQUESTED --> PENDING  : awaiting approval

PENDING   --> QUEUED   : approved

QUEUED    --> WAITING    : concurrency group\nor deployment gate
QUEUED    --> IN_PROGRESS : runner acquired

WAITING   --> IN_PROGRESS : gate resolved

state COMPLETED {
  [*] --> SUCCESS
  [*] --> FAILURE
  [*] --> CANCELLED
  [*] --> SKIPPED
  [*] --> TIMED_OUT
  [*] --> ACTION_REQUIRED
  [*] --> NEUTRAL
  [*] --> STALE
}

IN_PROGRESS --> COMPLETED : execution finished

COMPLETED --> [*]

@enduml
