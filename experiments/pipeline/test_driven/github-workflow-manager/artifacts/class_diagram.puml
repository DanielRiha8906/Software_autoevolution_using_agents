@startuml class_diagram

skinparam classAttributeIconSize 0
skinparam classFontStyle bold

package "models" #DDEEFF {
    enum WorkflowStatus {
        QUEUED = "queued"
        IN_PROGRESS = "in_progress"
        COMPLETED = "completed"
        WAITING = "waiting"
        REQUESTED = "requested"
        PENDING = "pending"
    }

    enum WorkflowConclusion {
        SUCCESS = "success"
        FAILURE = "failure"
        CANCELLED = "cancelled"
        SKIPPED = "skipped"
        TIMED_OUT = "timed_out"
        ACTION_REQUIRED = "action_required"
        NEUTRAL = "neutral"
        STALE = "stale"
    }

    class WorkflowRun {
        +id                : str
        +workflow_name     : str
        +branch            : str
        +status            : WorkflowStatus
        +conclusion        : Optional[WorkflowConclusion]
        +created_at        : datetime
        +updated_at        : Optional[datetime]
        +run_number        : Optional[int]
        +commit_sha        : Optional[str]
        +duration_seconds  : float
        --
        +__post_init() : None
        +to_dict() : dict
        +{static} from_dict(data: dict) : WorkflowRun
        +is_running() : bool
        +is_terminal() : bool
        +is_successful() : bool
        +is_failed() : bool
        +is_cancelled() : bool
    }

    class WorkflowRunAttempt {
        +id                : int
        +run_id            : int
        +attempt_number    : int
        +status            : str
        +conclusion        : str
        +created_at        : datetime
        +duration_seconds  : Optional[float]
        --
        +__post_init() : None
        +to_dict() : dict
        +{static} from_dict(data: dict) : WorkflowRunAttempt
    }

    class WorkflowStatisticsReport {
        +count_by_conclusion     : Dict[str, int]
        +avg_duration_seconds    : float
        +min_duration_seconds    : float
        +max_duration_seconds    : float
        +avg_attempts_per_run    : float
    }
}

package "storage" #FFF3CC {
    class WorkflowJsonStorage {
        +filepath : str
        --
        +__init__(filepath: str)
        +save(runs: List[WorkflowRun]) : None
        +load() : List[WorkflowRun]
    }
}

package "services" #DDFFD4 {
    class SchemaValidationError extends Exception {
        Error raised when import data fails validation against schema.
    }

    class GitHubFetchService {
        -_secrets_path : Optional[str]
        -_token : Optional[str]
        --
        +__init__(secrets_path: Optional[str] = None) : None
        +resolve_token() : str
        +fetch(owner: str, repo: str) : List[WorkflowRun]
        -_parse_env_file(path: str) : Optional[str]
        -_convert_to_workflow_run(gh_data: dict) : WorkflowRun
    }

    class WorkflowRunService {
        -_storage : WorkflowJsonStorage
        -_runs    : List[WorkflowRun]
        --
        +__init__(storage: WorkflowJsonStorage)
        +add_workflow_run(run: WorkflowRun) : WorkflowRun
        +list_runs() : List[WorkflowRun]
        +get_run_detail(run_id: str) : Optional[WorkflowRun]
        +filter_by_branch(branch: str) : List[WorkflowRun]
        +filter_by_status(status: WorkflowStatus) : List[WorkflowRun]
        +filter_by_conclusion(conclusion: WorkflowConclusion) : List[WorkflowRun]
        +query(min_duration: Optional[float],\n  max_duration: Optional[float],\n  created_after: Optional[datetime],\n  created_before: Optional[datetime],\n  has_attempts: Optional[bool],\n  attempt_service: Optional[AttemptService]) : List[WorkflowRun]
        -_persist() : None
    }

    class WorkflowRunTracker {
        -_service : WorkflowRunService
        --
        +__init__(service: WorkflowRunService)
        +track(workflow_name: str, branch: str,\n  status: WorkflowStatus,\n  conclusion: Optional[WorkflowConclusion],\n  run_number: Optional[int],\n  commit_sha: Optional[str],\n  run_id: Optional[str]) : WorkflowRun
    }

    class AttemptService {
        -_attempts : List[WorkflowRunAttempt]
        --
        +__init__() : None
        +create(attempt: WorkflowRunAttempt) : WorkflowRunAttempt
        +get_by_run_id(run_id: int) : List[WorkflowRunAttempt]
        +get_all_attempts() : List[WorkflowRunAttempt]
    }

    class WorkflowImportExportService {
        -_workflow_run_service : WorkflowRunService
        -_attempt_service : AttemptService
        --
        +__init__(workflow_run_service: WorkflowRunService,\n  attempt_service: AttemptService) : None
        +export() : str
        +import_from(filepath: str) : None
        -_validate_and_import_run(run_data: dict, existing_ids: set) : None
        -_validate_and_import_attempt(attempt_data: dict, existing_attempts: set) : None
    }

    class WorkflowStatisticsService {
        -_workflow_run_service : WorkflowRunService
        --
        +__init__(workflow_run_service: WorkflowRunService) : None
        +compute(attempt_service: Optional[AttemptService] = None) : WorkflowStatisticsReport
    }
}

package "cli" #FFE5E5 {
    class "workflow_cli" <<module>> {
        +build_parser() : ArgumentParser
        +run_cli(service: WorkflowRunService, args) : None
        -_fmt_run(run: WorkflowRun) : str
    }

    class "interactive_menu" <<module>> {
        +run_interactive(service: WorkflowRunService) : None
        -_add_run(service: WorkflowRunService) : None
        -_list_runs(service: WorkflowRunService) : None
        -_detail_run(service: WorkflowRunService) : None
        -_filter_menu(service: WorkflowRunService) : None
    }
}

package "gui" #FFE5CC {
    class WorkflowGUI {
        -service : WorkflowRunService
        -attempt_service : Optional[AttemptService]
        -root : Optional[Tk]
        -tree : Optional[Treeview]
        -branch_var : Optional[StringVar]
        -status_var : Optional[StringVar]
        -conclusion_var : Optional[StringVar]
        --
        +__init__(service: WorkflowRunService,\n  attempt_service: Optional[AttemptService]) : None
        +run() : None
        -_setup_widgets() : None
        -_load_runs() : List[WorkflowRun]
        -_refresh_tree() : None
        -_on_tree_select(event: tk.Event) : None
        -_update_filter_options(runs: List[WorkflowRun]) : None
    }
}

