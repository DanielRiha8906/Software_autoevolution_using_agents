@startuml activity_diagram

start
:Launch application;

repeat
  :Display task list + main menu;
  :Wait for user input;

  switch (choice)
    case (1 — List/filter)
      :Prompt user for status filter;
      :Prompt user for due date range (due_after, due_before);
      :Prompt user for overdue filter (all/overdue only/not-overdue only);
      :Call TodoService.list_tasks(status, due_after, due_before, overdue);
      partition "TaskManager.list_by_filter()" {
        :Filter by status (if provided);
        :Filter by due date range (if provided);
        :Filter by overdue status (if provided);
      }
      :Display filtered task list;
    case (2 — Add task)
      :Run add task flow;
    case (3 — Show details)
      :Run show details flow;
    case (4 — Change status)
      :Run change status flow;
    case (5 — Update task)
      :Run update task flow;
    case (6 — Delete task)
      :Cascade: delete comments then task;
    case (7 — Check if completed)
      :Run check completed flow;
    case (8 — Check if overdue)
      :Run check overdue flow;
    case (9 — Manage comments)
      :Select task;
      repeat
        :Display comment menu;
        switch (comment choice)
          case (1 — View comments)
            :Display all comments;
          case (2 — Add comment)
            :Prompt for comment content;
            :Create comment;
          case (3 — Delete comment)
            :Select comment;
            :Delete comment;
          case (0 — Back)
            stop
        endswitch
      repeat while (manage comments)
    case (10 — View statistics)
      :Call TodoService.get_statistics();
      partition "Statistics Computation" {
        :Count total tasks;
        :Count by status (PENDING, IN_PROGRESS, DONE);
        :Count overdue tasks;
        :Count tasks with due date;
      }
      :Display task statistics;
    case (0/q — Quit)
      :Clear screen;
      stop
    case (other)
      :Show unknown option;
  endswitch

repeat while (user continues)

@enduml