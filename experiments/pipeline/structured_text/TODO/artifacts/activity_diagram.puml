@startuml activity_diagram

start
:Launch application;

repeat
  :Display task list + main menu;
  :Wait for user input;

  switch (choice)
    case (1 — List/filter)
      :Prompt user for status filter;
      :Prompt user for due date range (due_after, due_before);
      :Prompt user for overdue filter (all/overdue only/not-overdue only);
      :Call TodoService.list_tasks(status, due_after, due_before, overdue);
      partition "TaskManager.list_by_filter()" {
        :Filter by status (if provided);
        :Filter by due date range (if provided);
        :Filter by overdue status (if provided);
      }
      :Display filtered task list;
    case (2 — Add task)
      :Run add task flow;
    case (3 — Show details)
      :Run show details flow;
    case (4 — Change status)
      :Run change status flow;
    case (5 — Update task)
      :Run update task flow;
    case (6 — Delete task)
      :Cascade: delete comments then task;
    case (7 — Check if completed)
      :Run check completed flow;
    case (8 — Check if overdue)
      :Run check overdue flow;
    case (9 — Manage comments)
      :Select task;
      repeat
        :Display comment menu;
        switch (comment choice)
          case (1 — View comments)
            :Display all comments;
          case (2 — Add comment)
            :Prompt for comment content;
            :Create comment;
          case (3 — Delete comment)
            :Select comment;
            :Delete comment;
          case (0 — Back)
            stop
        endswitch
      repeat while (manage comments)
    case (10 — View statistics)
      :Call TodoService.get_statistics();
      partition "Statistics Computation" {
        :Count total tasks;
        :Count by status (PENDING, IN_PROGRESS, DONE);
        :Count overdue tasks;
        :Count tasks with due date;
      }
      :Display task statistics;
    case (11 — Import/Export)
      :Display import/export menu;
      switch (import/export choice)
        case (1 — Export)
          :Prompt for export file path;
          :Call TodoService.export_tasks_and_comments(filepath);
          partition "ExportService.export_to_file()" {
            :Gather all tasks from TaskManager;
            :Gather all comments from CommentManager;
            :Serialize to JSON structure;
            :Write JSON file to path;
          }
          :Display export summary (count of tasks and comments);
        case (2 — Import)
          :Prompt for import file path;
          :Prompt for conflict mode (fail/skip/replace);
          :Call TodoService.import_tasks_and_comments(filepath, mode);
          partition "ImportService.import_from_file()" {
            :Read and parse JSON file;
            :Validate JSON schema;
            :Parse Task objects;
            :Parse TaskComment objects;
            :Check for ID conflicts;
            switch (mode)
              case (fail)
                if (conflicts found?) then (yes)
                  :Raise ImportExportError;
                  stop
                else (no)
                  :Import all records;
                endif
              case (skip)
                :Import only non-conflicting records;
              case (replace)
                :Import all records, overwriting existing;
            endswitch
            :Persist changes to storage;
          }
          :Display import summary (counts and conflicts);
        case (0 — Back)
          stop
      endswitch
    case (0/q — Quit)
      :Clear screen;
      stop
    case (other)
      :Show unknown option;
  endswitch

repeat while (user continues)

@enduml