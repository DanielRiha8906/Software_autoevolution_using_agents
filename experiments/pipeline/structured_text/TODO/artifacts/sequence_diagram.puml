@startuml sequence_diagram

title Assign Task to Project (Repository Pattern)

actor User
participant Menu as InteractiveMenu
participant Container as Container
participant Service as TodoService
participant TaskRepo as TaskRepository
participant ProjRepo as ProjectRepository
database Storage as JsonStorage

User -> Menu: Select "Assign task to project"
activate Menu

Menu -> Container: get_todo_service()
activate Container
Container --> Menu: TodoService (with injected repositories)
deactivate Container

Menu -> Service: get_task(task_id prefix)
activate Service
Service -> TaskRepo: get(task_id)
activate TaskRepo
TaskRepo --> Service: Task
deactivate TaskRepo
Service --> Menu: Task
deactivate Service

Menu -> Service: get_project(project_id prefix)
activate Service
Service -> ProjRepo: get(project_id)
activate ProjRepo
ProjRepo --> Service: Project
deactivate ProjRepo
Service --> Menu: Project
deactivate Service

Menu -> Service: assign_task_to_project(task_id, project_id)
activate Service
Service -> TaskRepo: assign_to_project(task_id, project_id)
activate TaskRepo
TaskRepo -> TaskRepo: Get task and set project_id
TaskRepo -> Storage: save([task_dict, ...])
activate Storage
Storage --> TaskRepo: (success)
deactivate Storage
TaskRepo --> Service: Task (updated)
deactivate TaskRepo
Service --> Menu: Task (updated)
deactivate Service

Menu -> User: Display "Task assigned to project"
deactivate Menu

@enduml
