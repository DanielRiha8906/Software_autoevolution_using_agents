@startuml sequence_diagram

title Cascading Deletion: Delete Task with Comments

actor User
participant CLI as TodoCLI
participant Service as TodoService
participant TaskMgr as TaskManager
participant CommentMgr as CommentManager
database Storage as JsonStorage

User -> CLI: delete <task_id>
CLI -> Service: delete_task(task_id)

Service -> TaskMgr: get(task_id)
activate TaskMgr
TaskMgr -> Storage: load()
TaskMgr --> Service: Task object
deactivate TaskMgr

Service -> CommentMgr: delete_all_by_task(task.id)
activate CommentMgr
CommentMgr -> Storage: load()
CommentMgr -> Storage: save(filtered_comments)
deactivate CommentMgr

Service -> TaskMgr: delete(task.id)
activate TaskMgr
TaskMgr -> Storage: load()
TaskMgr -> Storage: save(filtered_tasks)
deactivate TaskMgr

Service --> CLI: void
CLI -> User: Confirmation message

@enduml
