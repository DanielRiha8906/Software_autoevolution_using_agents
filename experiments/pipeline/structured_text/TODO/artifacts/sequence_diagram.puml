@startuml sequence_diagram

title Assign Task to Project

actor User
participant Menu as InteractiveMenu
participant Service as TodoService
participant TaskMgr as TaskManager
participant ProjMgr as ProjectManager
database Storage as JsonStorage

User -> Menu: Select "Assign task to project"
activate Menu

Menu -> Service: get_task(task_id prefix)
activate Service
Service -> TaskMgr: get(task_id)
activate TaskMgr
TaskMgr -> Storage: load()
activate Storage
Storage --> TaskMgr: List<Task>
deactivate Storage
TaskMgr --> Service: Task
deactivate TaskMgr
Service --> Menu: Task
deactivate Service

Menu -> Service: get_project(project_id prefix)
activate Service
Service -> ProjMgr: get(project_id)
activate ProjMgr
ProjMgr -> Storage: load()
activate Storage
Storage --> ProjMgr: List<Project>
deactivate Storage
ProjMgr --> Service: Project
deactivate ProjMgr
Service --> Menu: Project
deactivate Service

Menu -> Service: assign_task_to_project(task_id, project_id)
activate Service
Service -> TaskMgr: assign_to_project(task_id, project_id)
activate TaskMgr
TaskMgr -> TaskMgr: Get task and set project_id
TaskMgr -> Storage: save([task_dict, ...])
activate Storage
Storage --> TaskMgr: (success)
deactivate Storage
TaskMgr --> Service: Task (updated)
deactivate TaskMgr
Service --> Menu: Task (updated)
deactivate Service

Menu -> User: Display "Task assigned to project"
deactivate Menu

@enduml
