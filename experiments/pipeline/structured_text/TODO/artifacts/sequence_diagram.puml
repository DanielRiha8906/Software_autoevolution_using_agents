@startuml sequence_diagram

title List Tasks with Filtering

actor User
participant CLI as TodoCLI
participant Service as TodoService
participant TaskMgr as TaskManager
participant TZ as TimezoneUtils
database Storage as JsonStorage

User -> CLI: list [--status=...] [--due-after=...] [--due-before=...] [--overdue]
activate CLI
CLI -> Service: list_tasks(status, due_after, due_before, overdue)
activate Service
Service -> TaskMgr: list_by_filter(status, due_after, due_before, overdue)
activate TaskMgr

TaskMgr -> Storage: load()
activate Storage
Storage --> TaskMgr: List<Task>
deactivate Storage

TaskMgr -> TaskMgr: filter_by_status(tasks, status)
TaskMgr -> TaskMgr: filter_by_due_date(tasks, due_after, due_before)

alt overdue filter is specified
  TaskMgr -> TaskMgr: filter_by_overdue(tasks, overdue)
  note over TaskMgr, TZ
    Task.is_overdue() compares current UTC time
    against task.due_date
  end note
end

TaskMgr --> Service: List<Task> (filtered)
deactivate TaskMgr

Service --> CLI: List<Task>
deactivate Service

CLI -> User: Display filtered task list
deactivate CLI

@enduml
