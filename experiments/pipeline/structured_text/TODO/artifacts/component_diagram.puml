@startuml component_diagram

skinparam componentStyle uml2
skinparam defaultFontSize 13

left to right direction

package "TODO Application" {

    component "Entry Point\n(main)" as Main

    package "CLI Layer" {
        component "Interactive Menu" as IM
        component "Command-line Interface\n(TodoCLI)" as CLI
    }

    package "Service Layer" {
        component "Todo Service" as SVC
        component "Task Manager" as MGR
        component "Comments Service" as CommentSVC
    }

    package "Domain Model" {
        component "Task Model\n(Task, TaskStatus, TaskComment)" as Model
    }

    package "Persistence Layer" {
        component "JSON Storage\n(Tasks)" as Storage
        component "JSON Storage\n(Comments)" as CommentsStorage
    }
}

database "todo_data.json" as DB
database "todo_comments.json" as CommentsDB

Main --> IM : interactive mode
Main --> CLI : command mode

IM --> SVC
CLI --> SVC

SVC --> MGR
SVC --> CommentSVC
MGR --> Storage
CommentSVC --> CommentsStorage
CommentSVC --> MGR : validates tasks
MGR ..> Model
CommentsStorage ..> Model
Storage ..> Model

Storage --> DB : read/write
CommentsStorage --> CommentsDB : read/write

@enduml