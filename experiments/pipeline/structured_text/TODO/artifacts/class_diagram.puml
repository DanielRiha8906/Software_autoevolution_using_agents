@startuml class_diagram

skinparam classAttributeIconSize 0
skinparam classFontStyle bold

package "models" #DDEEFF {
    enum TaskStatus {
        PENDING
        IN_PROGRESS
        DONE
    }

    class Task {
        +id : String
        +title : String
        +description : String [0..1]
        +status : TaskStatus
        +due_date : DateTime [0..1]
        +project_id : String [0..1]
        +created_at : DateTime
        +updated_at : DateTime
        --
        +to_dict() : Dictionary
        +from_dict(data: Dictionary) : Task
        +is_overdue() : Boolean
        +mark_in_progress() : Task
        +mark_done() : Task
        +reopen() : Task
        +is_completed() : Boolean
    }

    class Project {
        +id : String
        +name : String
        +created_at : DateTime
        --
        +to_dict() : Dictionary
        +from_dict(data: Dictionary) : Project
    }

    class TaskStatistics {
        +total_count : int
        +pending_count : int
        +in_progress_count : int
        +done_count : int
        +overdue_count : int
        +with_due_date_count : int
    }
    note right of Task
        to_dict() conditionally includes due_date
        from_dict() safely parses due_date with backward compatibility
        is_overdue() returns True if due_date is set,
        task is not DONE, and current time is past due_date
    end note

    class TaskComment {
        +id : String
        +task_id : String
        +content : String
        +author : String [0..1]
        +created_at : DateTime
        +updated_at : DateTime [0..1]
        --
        +to_dict() : Dictionary
        +from_dict(data: Dictionary) : TaskComment
    }
    Task "1" -- "0..*" TaskComment : "has (via task_id)"
    note right of TaskComment
        Foreign key reference to Task via task_id
        Supports optional author and update timestamp
    end note

    Task "0..*" -- "0..1" Project : "assigned to"
    note right of Project
        Projects group tasks. Deleting a project
        unassigns (not cascades) its tasks.
    end note
}

package "storage" #FFF3CC {
    class JsonStorage {
        -path : String
        --
        +JsonStorage(path: String [0..1])
        +load() : List<Dictionary>
        +save(tasks: List<Dictionary>) : void
    }
}

package "utils" #F0E5FF {
    class TimezoneUtils <<utility>> {
        --
        +now_in_cest() : DateTime
        +is_overdue_cest(due_date: DateTime) : Boolean
        +utc_to_cest(dt: DateTime) : DateTime
    }
    note right of TimezoneUtils
        Utility module for CEST (Europe/Paris) timezone handling.
        now_in_cest(): Returns current time in CEST.
        is_overdue_cest(): Checks if due_date is past current CEST time.
        utc_to_cest(): Converts UTC or timezone-aware datetime to CEST.
    end note
}

package "services" #DDFFD4 {
    exception TaskNotFoundError
    exception CommentNotFoundError
    exception ImportExportError
    exception ProjectNotFoundError

    class TaskManager {
        -storage : JsonStorage
        -tasks : Dictionary<String, Task>
        --
        +TaskManager(storage: JsonStorage [0..1])
        +add(title: String, description: String [0..1]) : Task
        +get(task_id: String) : Task
        +list_all() : List<Task>
        +list_by_status(status: TaskStatus) : List<Task>
        +list_by_filter(status: TaskStatus [0..1], due_after: DateTime [0..1], due_before: DateTime [0..1], overdue: Boolean [0..1]) : List<Task>
        +update(task_id: String, title: String [0..1], description: String [0..1]) : Task
        +set_status(task_id: String, status: TaskStatus) : Task
        +delete(task_id: String) : void
        +list_by_project(project_id: String) : List<Task>
        +assign_to_project(task_id: String, project_id: String) : Task
        +unassign_from_project(task_id: String) : Task
        -load() : void
        -persist() : void
    }
    note right of TaskManager
        list_by_filter() combines status, date range, and overdue filters.
        Raises ValueError if due_after > due_before.
        list_by_project() filters tasks by project_id.
    end note

    class CommentManager {
        -storage : JsonStorage
        -comments : Dictionary<String, TaskComment>
        --
        +CommentManager(storage: JsonStorage [0..1])
        +add(task_id: String, content: String, author: String [0..1]) : TaskComment
        +get(comment_id: String) : TaskComment
        +list_all() : List<TaskComment>
        +list_by_task(task_id: String) : List<TaskComment>
        +delete(comment_id: String) : void
        +delete_all_by_task(task_id: String) : void
        -load() : void
        -persist() : void
    }

    class ProjectManager {
        -storage : JsonStorage
        -projects : Dictionary<String, Project>
        --
        +ProjectManager(storage: JsonStorage [0..1])
        +add(name: String) : Project
        +get(project_id: String) : Project
        +list_all() : List<Project>
        +delete(project_id: String) : void
        +update(project_id: String, name: String) : Project
        -load() : void
        -persist() : void
    }
    note right of ProjectManager
        Stores projects in a separate JSON file.
        Supports ID prefix lookup for get/delete/update.
    end note

    class TodoService {
        -manager : TaskManager
        -comment_manager : CommentManager
        -project_manager : ProjectManager
        --
        +TodoService(storage: JsonStorage [0..1])
        +add_task(title: String, description: String [0..1]) : Task
        +get_task(task_id: String) : Task
        +list_tasks(status: TaskStatus [0..1], due_after: DateTime [0..1], due_before: DateTime [0..1], overdue: Boolean [0..1]) : List<Task>
        +start_task(task_id: String) : Task
        +complete_task(task_id: String) : Task
        +reopen_task(task_id: String) : Task
        +update_task(task_id: String, title: String [0..1], description: String [0..1]) : Task
        +delete_task(task_id: String) : void
        +add_comment(task_id: String, content: String, author: String [0..1]) : TaskComment
        +get_comments(task_id: String) : List<TaskComment>
        +delete_comment(comment_id: String) : void
        +get_statistics() : TaskStatistics
        +create_project(name: String) : Project
        +list_projects() : List<Project>
        +get_project(project_id: String) : Project
        +delete_project(project_id: String) : void
        +list_tasks_by_project(project_id: String) : List<Task>
        +assign_task_to_project(task_id: String, project_id: String) : Task
        +unassign_task_from_project(task_id: String) : Task
        +update_project(project_id: String, name: String) : Project
        +export_tasks_and_comments(filepath: String) : tuple[int, int, int]
        +import_tasks_and_comments(filepath: String, mode: String) : tuple[int, int, int, int]
    }
    note right of TodoService
        delete_task() cascades: deletes all comments.
        delete_project() unassigns (not cascades) tasks.
        export/import now handle projects as well.
    end note

    class ExportService {
        -task_manager : TaskManager
        -comment_manager : CommentManager
        -project_manager : ProjectManager
        --
        +ExportService(task_manager: TaskManager, comment_manager: CommentManager, project_manager: ProjectManager)
        +export_to_file(filepath: String) : tuple[int, int, int]
    }
    note right of ExportService
        Exports all tasks, comments, and projects to JSON file.
        Returns (tasks_exported, comments_exported, projects_exported).
        Raises ImportExportError if file cannot be written.
    end note

    class ImportService {
        -task_manager : TaskManager
        -comment_manager : CommentManager
        -project_manager : ProjectManager
        --
        +ImportService(task_manager: TaskManager, comment_manager: CommentManager, project_manager: ProjectManager)
        +import_from_file(filepath: String, mode: String) : tuple[int, int, int, int]
        -_validate_schema(data: Dictionary) : void
    }
    note right of ImportService
        Imports tasks, comments, and projects from JSON file.
        Mode: 'fail' (stop on conflict), 'skip' (skip conflicts),
        or 'replace' (overwrite existing).
        Returns (tasks_imported, comments_imported, projects_imported, conflicts_detected).
    end note
}

package "cli" #FFE5E5 {
    class TodoCLI {
        -service : TodoService
        --
        +TodoCLI(storage_path: String [0..1])
        +run(argv: List<String> [0..1]) : Integer
        -_cmd_export(args: Namespace) : Integer
        -_cmd_import(args: Namespace) : Integer
    }

    class InteractiveMenu {
        -service : TodoService
        --
        +InteractiveMenu(storage_path: String [0..1])
        +run() : void
        -_do_import_export() : void
        -_do_export() : void
        -_do_import() : void
    }
}

Task --> TaskStatus : status
TaskManager --> JsonStorage : storage
TaskManager ..> TaskNotFoundError : raises
CommentManager --> JsonStorage : storage
CommentManager ..> CommentNotFoundError : raises
ProjectManager --> JsonStorage : storage
ProjectManager ..> ProjectNotFoundError : raises
TodoService --> TaskManager : manager
TodoService --> CommentManager : comment_manager
TodoService --> ProjectManager : project_manager
TodoService ..> TaskStatistics : returns
TodoService --> ExportService : uses (export)
TodoService --> ImportService : uses (import)
ExportService --> TaskManager : task_manager
ExportService --> CommentManager : comment_manager
ExportService --> ProjectManager : project_manager
ExportService ..> ImportExportError : raises
ImportService --> TaskManager : task_manager
ImportService --> CommentManager : comment_manager
ImportService --> ProjectManager : project_manager
ImportService ..> ImportExportError : raises
TodoCLI --> TodoService : service
InteractiveMenu --> TodoService : service

@enduml