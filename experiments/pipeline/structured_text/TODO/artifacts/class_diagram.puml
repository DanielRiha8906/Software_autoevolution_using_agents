@startuml class_diagram

skinparam classAttributeIconSize 0
skinparam classFontStyle bold

package "models" #DDEEFF {
    enum TaskStatus {
        PENDING
        IN_PROGRESS
        DONE
    }

    class Task {
        +id : String
        +title : String
        +description : String [0..1]
        +status : TaskStatus
        +dueDate : DateTime [0..1]
        +createdAt : DateTime
        +updatedAt : DateTime
        --
        +toDict() : Dictionary
        +fromDict(data: Dictionary) : Task
        +isOverdue() : Boolean
        +markInProgress() : Task
        +markDone() : Task
        +reopen() : Task
        +isCompleted() : Boolean
    }
    note right of Task
        toDict() conditionally includes due_date
        fromDict() safely parses due_date with backward compatibility
        isOverdue() returns True if due_date is set,
        task is not DONE, and current time is past due_date
    end note

    class TaskComment {
        +id : String
        +task_id : String
        +content : String
        +author : String [0..1]
        +created_at : DateTime
        +updated_at : DateTime [0..1]
        --
        +to_dict() : Dictionary
        +from_dict(data: Dictionary) : TaskComment
    }
    note right of TaskComment
        Foreign key reference to Task via task_id
        Supports optional author and update timestamp
    end note
}

package "storage" #FFF3CC {
    class JsonStorage {
        -path : String
        --
        +JsonStorage(path: String [0..1])
        +load() : List<Dictionary>
        +save(tasks: List<Dictionary>) : void
    }
}

package "services" #DDFFD4 {
    exception TaskNotFoundError
    exception CommentNotFoundError

    class TaskManager {
        -storage : JsonStorage
        -tasks : Dictionary<String, Task>
        --
        +TaskManager(storage: JsonStorage [0..1])
        +add(title: String, description: String [0..1]) : Task
        +get(taskId: String) : Task
        +listAll() : List<Task>
        +listByStatus(status: TaskStatus) : List<Task>
        +update(taskId: String, title: String [0..1], description: String [0..1]) : Task
        +setStatus(taskId: String, status: TaskStatus) : Task
        +delete(taskId: String) : void
        -load() : void
        -persist() : void
    }

    class CommentManager {
        -storage : JsonStorage
        -comments : Dictionary<String, TaskComment>
        --
        +CommentManager(storage: JsonStorage [0..1])
        +add(taskId: String, content: String, author: String [0..1]) : TaskComment
        +get(commentId: String) : TaskComment
        +listAll() : List<TaskComment>
        +listByTask(taskId: String) : List<TaskComment>
        +delete(commentId: String) : void
        +deleteAllByTask(taskId: String) : void
        -load() : void
        -persist() : void
    }

    class TodoService {
        -manager : TaskManager
        -comment_manager : CommentManager
        --
        +TodoService(storage: JsonStorage [0..1])
        +addTask(title: String, description: String [0..1]) : Task
        +getTask(taskId: String) : Task
        +listTasks(status: TaskStatus [0..1]) : List<Task>
        +startTask(taskId: String) : Task
        +completeTask(taskId: String) : Task
        +reopenTask(taskId: String) : Task
        +updateTask(taskId: String, title: String [0..1], description: String [0..1]) : Task
        +deleteTask(taskId: String) : void
        +addComment(taskId: String, content: String, author: String [0..1]) : TaskComment
        +getComments(taskId: String) : List<TaskComment>
        +deleteComment(commentId: String) : void
    }
}

package "cli" #FFE5E5 {
    class TodoCLI {
        -service : TodoService
        --
        +TodoCLI(storagePath: String [0..1])
        +run(argv: List<String> [0..1]) : Integer
    }

    class InteractiveMenu {
        -service : TodoService
        --
        +InteractiveMenu(storagePath: String [0..1])
        +run() : void
    }
}

Task --> TaskStatus : status
Task "1" --> "0..*" TaskComment : has
TaskManager --> JsonStorage : storage
TaskManager ..> TaskNotFoundError : raises
CommentManager --> JsonStorage : storage
CommentManager ..> CommentNotFoundError : raises
TodoService --> TaskManager : manager
TodoService --> CommentManager : comment_manager
TodoCLI --> TodoService : service
InteractiveMenu --> TodoService : service

@enduml