package "exceptions" #FFD9E5 {
    exception DomainError
    exception TaskNotFoundError
    exception CommentNotFoundError
    exception ProjectNotFoundError
    exception ImportExportError

    DomainError <|-- TaskNotFoundError
    DomainError <|-- CommentNotFoundError
    DomainError <|-- ProjectNotFoundError
    DomainError <|-- ImportExportError
}

package "models" #DDEEFF {
    enum TaskStatus {
        PENDING
        IN_PROGRESS
        DONE
    }

    class Task {
        +id : String
        +title : String
        +description : String [0..1]
        +status : TaskStatus
        +due_date : DateTime [0..1]
        +project_id : String [0..1]
        +created_at : DateTime
        +updated_at : DateTime
        --
        +to_dict() : Dictionary
        +from_dict(data: Dictionary) : Task
        +is_overdue() : Boolean
        +mark_in_progress() : Task
        +mark_done() : Task
        +reopen() : Task
        +is_completed() : Boolean
    }

    class Project {
        +id : String
        +name : String
        +created_at : DateTime
        --
        +to_dict() : Dictionary
        +from_dict(data: Dictionary) : Project
    }

    class TaskStatistics {
        +total_count : int
        +pending_count : int
        +in_progress_count : int
        +done_count : int
        +overdue_count : int
        +with_due_date_count : int
    }

    class TaskComment {
        +id : String
        +task_id : String
        +content : String
        +author : String [0..1]
        +created_at : DateTime
        +updated_at : DateTime [0..1]
        --
        +to_dict() : Dictionary
        +from_dict(data: Dictionary) : TaskComment
    }

    Task "1" -- "0..*" TaskComment : "has (via task_id)"
    Task "0..*" -- "0..1" Project : "assigned to"
    Task --> TaskStatus : status
}

package "storage" #FFF3CC {
    class JsonStorage {
        -path : String
        --
        +JsonStorage(path: String [0..1])
        +load() : List<Dictionary>
        +save(tasks: List<Dictionary>) : void
    }

    class StoragePathProvider {
        -tasks_path : Path
        --
        +StoragePathProvider(tasks_path: String [0..1])
        +get_tasks_path() : Path
        +get_comments_path() : Path
        +get_projects_path() : Path
    }
}

package "repositories" #E5F3FF {
    abstract class BaseRepository<T> <<abstract, generic>> {
        #_storage : JsonStorage
        #_items : Dictionary<String, T>
        --
        +get(item_id: String) : T
        +list_all() : List<T>
        +delete(item_id: String) : void
        #_load() : void
        #_persist() : void
        #{abstract}_deserialize(data: Dictionary) : T
        #{abstract}_serialize(item: T) : Dictionary
        #{abstract}_item_not_found(message: String) : Exception
    }

    class TaskRepository <<Repository>> {
        --
        +add(title: String, description: String [0..1]) : Task
        +list_by_status(status: TaskStatus) : List<Task>
        +list_by_filter(status: TaskStatus [0..1], due_after: DateTime [0..1], due_before: DateTime [0..1], overdue: Boolean [0..1]) : List<Task>
        +update(task_id: String, title: String [0..1], description: String [0..1]) : Task
        +set_status(task_id: String, status: TaskStatus) : Task
        +list_by_project(project_id: String) : List<Task>
        +assign_to_project(task_id: String, project_id: String) : Task
        +unassign_from_project(task_id: String) : Task
    }

    class CommentRepository <<Repository>> {
        --
        +add(task_id: String, content: String, author: String [0..1]) : TaskComment
        +list_by_task(task_id: String) : List<TaskComment>
        +delete_all_by_task(task_id: String) : void
    }

    class ProjectRepository <<Repository>> {
        --
        +add(name: String) : Project
        +update(project_id: String, name: String) : Project
    }

    BaseRepository <|-- TaskRepository
    BaseRepository <|-- CommentRepository
    BaseRepository <|-- ProjectRepository

    TaskRepository --> JsonStorage : uses
    CommentRepository --> JsonStorage : uses
    ProjectRepository --> JsonStorage : uses

    TaskRepository ..> TaskNotFoundError : raises
    CommentRepository ..> CommentNotFoundError : raises
    ProjectRepository ..> ProjectNotFoundError : raises
}

package "services" #DDFFD4 {
    class TodoService {
        -task_repository : TaskRepository
        -comment_repository : CommentRepository
        -project_repository : ProjectRepository
        --
        +TodoService(task_repository: TaskRepository, comment_repository: CommentRepository, project_repository: ProjectRepository)
        +add_task(title: String, description: String [0..1]) : Task
        +get_task(task_id: String) : Task
        +list_tasks(status: TaskStatus [0..1], due_after: DateTime [0..1], due_before: DateTime [0..1], overdue: Boolean [0..1]) : List<Task>
        +start_task(task_id: String) : Task
        +complete_task(task_id: String) : Task
        +reopen_task(task_id: String) : Task
        +update_task(task_id: String, title: String [0..1], description: String [0..1]) : Task
        +delete_task(task_id: String) : void
        +add_comment(task_id: String, content: String, author: String [0..1]) : TaskComment
        +get_comments(task_id: String) : List<TaskComment>
        +delete_comment(comment_id: String) : void
        +get_statistics() : TaskStatistics
        +create_project(name: String) : Project
        +list_projects() : List<Project>
        +get_project(project_id: String) : Project
        +delete_project(project_id: String) : void
        +list_tasks_by_project(project_id: String) : List<Task>
        +assign_task_to_project(task_id: String, project_id: String) : Task
        +unassign_task_from_project(task_id: String) : Task
        +update_project(project_id: String, name: String) : Project
        +export_tasks_and_comments(filepath: String) : tuple[int, int, int]
        +import_tasks_and_comments(filepath: String, mode: String) : tuple[int, int, int, int]
    }

    class ExportService {
        -task_repository : TaskRepository
        -comment_repository : CommentRepository
        -project_repository : ProjectRepository
        --
        +ExportService(task_repository: TaskRepository, comment_repository: CommentRepository, project_repository: ProjectRepository)
        +export_to_file(filepath: String) : tuple[int, int, int]
    }

    class ImportService {
        -task_repository : TaskRepository
        -comment_repository : CommentRepository
        -project_repository : ProjectRepository
        --
        +ImportService(task_repository: TaskRepository, comment_repository: CommentRepository, project_repository: ProjectRepository)
        +import_from_file(filepath: String, mode: String) : tuple[int, int, int, int]
        -_validate_schema(data: Dictionary) : void
    }

    TodoService --> TaskRepository : task_repository
    TodoService --> CommentRepository : comment_repository
    TodoService --> ProjectRepository : project_repository
    TodoService --> ExportService : uses
    TodoService --> ImportService : uses
    TodoService ..> TaskStatistics : returns

    ExportService --> TaskRepository : task_repository
    ExportService --> CommentRepository : comment_repository
    ExportService --> ProjectRepository : project_repository
    ExportService ..> ImportExportError : raises

    ImportService --> TaskRepository : task_repository
    ImportService --> CommentRepository : comment_repository
    ImportService --> ProjectRepository : project_repository
    ImportService ..> ImportExportError : raises
}

package "container" #F0F0F0 {
    class Container {
        -storage_path : String [0..1]
        -path_provider : StoragePathProvider
        -task_repository : TaskRepository
        -comment_repository : CommentRepository
        -project_repository : ProjectRepository
        -service : TodoService
        --
        +Container(storage_path: String [0..1])
        +get_task_repository() : TaskRepository
        +get_comment_repository() : CommentRepository
        +get_project_repository() : ProjectRepository
        +get_todo_service() : TodoService
    }

    note right of Container
        Manages dependency injection for repositories
        and service. Lazy-initializes each component.
    end note

    Container --> StoragePathProvider : creates
    Container --> TaskRepository : creates
    Container --> CommentRepository : creates
    Container --> ProjectRepository : creates
    Container --> TodoService : creates
}

