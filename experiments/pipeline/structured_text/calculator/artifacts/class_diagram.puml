@startuml class_diagram

skinparam classAttributeIconSize 0
skinparam classFontStyle bold

package "models" #DDEEFF {
    enum Operation {
        ADD
        SUBTRACT
        MULTIPLY
        DIVIDE
        SQUARE
        SQRT
        POWER
        MODULO
        --
        +fromString(value: String) : Operation
        +displayName() : String
    }

    class CalculationResult {
        +operation : String
        +operand_a : float
        +operand_b : float
        +result : float
        +timestamp : String
        +execution_time_ms : float
        --
        +__post_init__() : void
        +to_dict() : Dictionary
        +from_dict(data: Dictionary) : CalculationResult
        +__str__() : String
    }

    class MemoryEntry {
        +operation : String
        +operand_a : float
        +operand_b : float
        +result : Optional[float]
        +success : bool
        +error_message : Optional[String]
        +execution_timestamp : String
        +execution_time_ms : float
        +memory_entry_id : Optional[String]
        --
        +__post_init__() : void
        +to_dict() : Dictionary
        +from_dict(data: Dictionary) : MemoryEntry
        +__str__() : String
        +__repr__() : String
    }
}

package "services" #DDFFD4 {
    class Calculator {
        +add(a: float, b: float) : float
        +subtract(a: float, b: float) : float
        +multiply(a: float, b: float) : float
        +divide(a: float, b: float) : float
        +square(a: float, b: float) : float
        +sqrt(a: float, b: float) : float
        +power(a: float, b: float) : float
        +modulo(a: float, b: float) : float
        +calculate(op: Operation, a: float, b: float) : float
    }

    class CalculatorService {
        -calculator : Calculator
        -storage : JsonStorage
        --
        +CalculatorService(calculator: Calculator, storage: JsonStorage)
        +perform(operation: Operation, a: float, b: float) : CalculationResult
        +getHistory() : List<CalculationResult>
    }

    class MemoryService {
        -storage : MemoryJsonStorage
        --
        +MemoryService(storage: MemoryJsonStorage)
        +store(entry: MemoryEntry) : void
        +retrieve_all() : List<MemoryEntry>
        +filter_by_operation(operation_name: str) : List<MemoryEntry>
        +filter_by_success(success: bool) : List<MemoryEntry>
        +filter_by_execution_time(min_ms: float, max_ms: float) : List<MemoryEntry>
    }
}

package "storage" #FFF3CC {
    class JsonStorage {
        -filepath : String
        --
        +JsonStorage(filepath: String)
        +save(result: CalculationResult) : void
        +loadAll() : List<CalculationResult>
        -readRaw() : List<Dictionary>
        -writeRaw(records: List<Dictionary>) : void
    }

    class MemoryJsonStorage {
        -filepath : Path | str
        --
        +MemoryJsonStorage(filepath: Path | str)
        +save(entry: MemoryEntry) : void
        +load_all() : List<MemoryEntry>
        -_read_raw() : List<Dictionary>
        -_write_raw(records: List<Dictionary>) : void
    }
}

package "cli" #FFE5E5 {
    class CalculatorCLI {
        -MENU : List<Tuple<Operation, String>>
        -service : CalculatorService
        -memory_service : MemoryService | None
        --
        +CalculatorCLI(service: CalculatorService, memory_service: MemoryService | None)
        +run_interactive() : void
        +run_command(operation: String, a: float, b: float) : void
        +show_memory() : void
        -_print_menu() : void
        -_resolve_menu_choice(choice: String) : Operation [0..1]
        -_prompt_number(prompt: String) : float [0..1]
        -_show_history() : void
        -_show_memory() : void
        -_filter_memory_by_operation() : void
        -_filter_memory_by_status() : void
    }
}

CalculatorCLI --> CalculatorService : service
CalculatorCLI --> MemoryService : memory_service
CalculatorService --> Calculator : calculator
CalculatorService --> JsonStorage : storage
MemoryService --> MemoryJsonStorage : storage

CalculatorService ..> CalculationResult : create
CalculatorService ..> Operation
CalculatorCLI ..> Operation
Calculator ..> Operation
JsonStorage ..> CalculationResult : stores
MemoryService ..> MemoryEntry : manages
MemoryJsonStorage ..> MemoryEntry : persists

note right of MemoryEntry
  Captures both successful
  and failed calculations
  with error tracking and ID
end note

@enduml