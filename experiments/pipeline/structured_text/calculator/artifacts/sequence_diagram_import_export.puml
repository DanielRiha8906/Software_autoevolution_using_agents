@startuml sequence_diagram_import_export

skinparam defaultFontSize 12
participant User as U
participant CalculatorCLI as CLI
participant "MemoryService\n(interface)" as MSProto
participant "MemoryService\n(impl)" as MS
participant "Storage<MemoryEntry>\n(interface)" as StorageProto
participant MemoryJsonStorage as MJS
participant "JSON File" as FILE

== Export Flow ==

U -> CLI: export_memory(filepath)
activate CLI
  CLI -> MSProto: export_to_file(filepath)
  activate MSProto
  MSProto -> MS: export_to_file(filepath)
  activate MS
    MS -> StorageProto: load_all()
    activate StorageProto
    StorageProto -> MJS: load_all()
    activate MJS
    MJS --> StorageProto: List<MemoryEntry>
    deactivate MJS
    StorageProto --> MS: List<MemoryEntry>
    deactivate StorageProto
    note right MS
      Convert entries to dicts
      for JSON serialization
    end note
    MS -> FILE: Write JSON array
    activate FILE
    FILE --> MS: (file written)
    deactivate FILE
    MS -> MS: return count of entries
  MS --> MSProto: count
  deactivate MS
  MSProto --> CLI: count
  deactivate MSProto
  CLI -> U: Print success + count
deactivate CLI

== Import Flow ==

U -> CLI: import_memory(filepath, skip_invalid)
activate CLI
  CLI -> MSProto: import_from_file(filepath, skip_invalid)
  activate MSProto
  MSProto -> MS: import_from_file(filepath, skip_invalid)
  activate MS
    MS -> FILE: Read JSON file
    activate FILE
    FILE --> MS: JSON array
    deactivate FILE
    note right MS
      Validate JSON is array type
    end note
    MS -> MS: for each entry_data in array
    activate MS
      note right MS
        For each entry:
        1. Validate it's a dict
        2. Create MemoryEntry via from_dict()
        3. Store via self.store(entry)

        If skip_invalid=True:
          - Skip invalid entries
          - Record in skipped list
        Else:
          - Raise on first error
      end note
    deactivate MS
    MS -> StorageProto: save(entry) [for each valid entry]
    activate StorageProto
    StorageProto -> MJS: save(entry)
    activate MJS
    MJS --> StorageProto: void
    deactivate MJS
    StorageProto --> MS: void
    deactivate StorageProto
    MS -> MS: return (imported_count, skipped_list)
  MS --> MSProto: (count, skipped)
  deactivate MS
  MSProto --> CLI: (count, skipped)
  deactivate MSProto
  CLI -> U: Print success + count + skipped errors
deactivate CLI

note over U, FILE
  JSON file format: array of MemoryEntry dicts
  [
    {
      "operation": "add",
      "operand_a": 5.0,
      "operand_b": 3.0,
      "result": 8.0,
      "success": true,
      "error_message": null,
      ...
    },
    ...
  ]
end note

@enduml
