@startuml component_diagram

skinparam componentStyle uml2
skinparam defaultFontSize 13
left to right direction

package "Calculator Application" {

    component "Entry Point\n(__main__)" as Main

    package "Presentation Layer" {
        component "CLI Interface\n(CalculatorCLI)" as CLI
        component "GUI Interface\n(CalculatorGUI)" as GUI
    }

    package "Protocols (Interfaces)" {
        interface "CalculationService" as CalcServiceProto
        interface "MemoryService" as MemServiceProto
        interface "Storage<T>" as StorageProto
    }

    component "Service Implementations" {
        component "CalculatorService\n(CalculatorServiceImpl)" as Service
        component "MemoryService\n(MemoryServiceImpl)" as MemService
    }

    component "Calculation Engine\n(Calculator)" as Calc

    package "Storage Implementations" {
        component "JSON Storage\n(JsonStorage)" as Store
        component "Memory JSON Storage\n(MemoryJsonStorage)" as MemStore
    }

    component "Domain Models\n(Operation, CalculationResult, MemoryEntry, CalculationStatistics)" as Models

    Main --> CLI : initializes (--gui flag disabled)
    Main --> GUI : initializes (--gui flag enabled)
    Main --> Service : initializes
    Main --> MemService : initializes

    CLI --> CalcServiceProto : depends on
    CLI --> MemServiceProto : depends on

    GUI --> CalcServiceProto : depends on
    GUI --> MemServiceProto : depends on

    Service ..|> CalcServiceProto : implements
    MemService ..|> MemServiceProto : implements

    Service --> Calc : uses
    Service --> StorageProto : depends on
    MemService --> StorageProto : depends on

    Store ..|> StorageProto : implements
    MemStore ..|> StorageProto : implements

    Service ..> Models : uses
    Store ..> Models : uses
    MemService ..> Models : uses
    MemStore ..> Models : uses
    Calc ..> Models : uses
}

database "calculations.json" as DB
database "memory_entries.json" as MemDB
database "User Files\n(import/export)" as UserFiles

Store --> DB : read/write
MemStore --> MemDB : read/write
MemStore --> UserFiles : import/export JSON
MemService --> UserFiles : import/export JSON

note on link MemService, UserFiles
  Export: serialize memory entries to JSON
  Import: load and validate JSON array
  Support --export, --import, --skip-invalid flags
end note

note on link StorageProto
  Generic protocol decoupling
  services from storage implementation
end note

@enduml