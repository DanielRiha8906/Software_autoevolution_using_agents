@startuml state_diagram_interactive

skinparam defaultFontSize 13
skinparam stateFontStyle bold

top to bottom direction

[*] --> Menu

Menu --> FirstOperand : operation selected
Menu --> Feedback : history selected
Menu --> FilterOperation : filter by operation selected
Menu --> FilterStatus : filter by status selected
Menu --> Statistics : statistics selected
Menu --> Export : export selected
Menu --> Import : import selected
Menu --> Feedback : invalid choice
Menu --> [*] : exit

FilterOperation --> Feedback : filtering complete
FilterStatus --> Feedback : filtering complete
Statistics --> Feedback : statistics displayed
Export --> Feedback : export complete
Import --> Feedback : import complete

FirstOperand --> SecondOperand : valid number
FirstOperand --> Feedback : invalid number

SecondOperand --> Calculating : valid number
SecondOperand --> Feedback : invalid number

Calculating --> Feedback : success / show result
Calculating --> Feedback : error / show error
Feedback --> Menu

@enduml