@startuml sequence_diagram_memory

skinparam sequenceActorBackgroundColor #DDEEFF
skinparam sequenceActorBorderColor #3366AA
skinparam sequenceParticipantBackgroundColor #DDFFD4
skinparam sequenceParticipantBorderColor #66AA33

actor User
participant "CalculatorCLI" as CLI
participant "MemoryService" as MemService
participant "MemoryJsonStorage" as MemStore
database "memory_entries.json" as DB

== Store Memory Entry ==

User -> CLI: show_memory()
activate CLI
CLI -> MemService: retrieve_all()
activate MemService
MemService -> MemStore: load_all()
activate MemStore
MemStore -> DB: read file
activate DB
DB --> MemStore: JSON data
deactivate DB
MemStore -> MemStore: parse entries to MemoryEntry objects
MemStore --> MemService: List<MemoryEntry>
deactivate MemStore
MemService --> CLI: List<MemoryEntry>
deactivate MemService
CLI -> CLI: display entries
CLI --> User: show memory list
deactivate CLI

== Filter Memory Entries ==

User -> CLI: filter_by_operation(operation_name)
activate CLI
CLI -> MemService: filter_by_operation(operation_name)
activate MemService
MemService -> MemStore: load_all()
activate MemStore
MemStore -> DB: read file
activate DB
DB --> MemStore: JSON data
deactivate DB
MemStore --> MemService: List<MemoryEntry>
deactivate MemStore
MemService -> MemService: filter by operation name
MemService --> CLI: filtered List<MemoryEntry>
deactivate MemService
CLI -> CLI: display filtered entries
CLI --> User: show filtered memory list
deactivate CLI

== Store New Entry (implicit via CalculatorService) ==

User -> CLI: run_command(operation)
activate CLI
CLI -> CLI: perform calculation via CalculatorService
CLI -> CLI: create MemoryEntry from result
note right of CLI: Application layer creates entry

User -> CLI: CLI calls store indirectly
MemService -> MemStore: save(entry: MemoryEntry)
activate MemStore
MemStore -> MemStore: _read_raw()
note right of MemStore: Load existing entries
MemStore -> MemStore: entry.to_dict()
note right of MemStore: Convert to dictionary
MemStore -> MemStore: _write_raw(records)
note right of MemStore: Write updated list to file
MemStore -> DB: write JSON array
activate DB
deactivate DB
MemStore --> MemService: void
deactivate MemStore
MemService --> CLI: complete
deactivate CLI

== Compute Statistics ==

User -> CLI: show_statistics()
activate CLI
CLI -> MemService: compute_statistics()
activate MemService
MemService -> MemStore: load_all()
activate MemStore
MemStore -> DB: read file
activate DB
DB --> MemStore: JSON data
deactivate DB
MemStore --> MemService: List<MemoryEntry>
deactivate MemStore
MemService -> MemService: aggregate stats (counts, errors, times)
MemService --> CLI: CalculationStatistics
deactivate MemService
CLI -> CLI: format and display statistics
CLI --> User: show statistics report
deactivate CLI

@enduml
