@startuml sequence_diagram_memory

skinparam sequenceActorBackgroundColor #DDEEFF
skinparam sequenceActorBorderColor #3366AA
skinparam sequenceParticipantBackgroundColor #DDFFD4
skinparam sequenceParticipantBorderColor #66AA33

actor User
participant "CalculatorCLI" as CLI
participant "MemoryService\n(interface)" as MemServiceProto
participant "MemoryService\n(impl)" as MemService
participant "Storage<MemoryEntry>\n(interface)" as StorageProto
participant "MemoryJsonStorage" as MemStore
database "memory_entries.json" as DB

== Store Memory Entry ==

User -> CLI: show_memory()
activate CLI
CLI -> MemServiceProto: retrieve_all()
activate MemServiceProto
MemServiceProto -> MemService: retrieve_all()
activate MemService
MemService -> StorageProto: load_all()
activate StorageProto
StorageProto -> MemStore: load_all()
activate MemStore
MemStore -> DB: read file
activate DB
DB --> MemStore: JSON data
deactivate DB
MemStore -> MemStore: parse entries to MemoryEntry objects
MemStore --> StorageProto: List<MemoryEntry>
deactivate MemStore
StorageProto --> MemService: List<MemoryEntry>
deactivate StorageProto
MemService --> MemServiceProto: List<MemoryEntry>
deactivate MemService
MemServiceProto --> CLI: List<MemoryEntry>
deactivate MemServiceProto
CLI -> CLI: display entries
CLI --> User: show memory list
deactivate CLI

== Filter Memory Entries ==

User -> CLI: filter_by_operation(operation_name)
activate CLI
CLI -> MemServiceProto: filter_by_operation(operation_name)
activate MemServiceProto
MemServiceProto -> MemService: filter_by_operation(operation_name)
activate MemService
MemService -> StorageProto: load_all()
activate StorageProto
StorageProto -> MemStore: load_all()
activate MemStore
MemStore -> DB: read file
activate DB
DB --> MemStore: JSON data
deactivate DB
MemStore --> StorageProto: List<MemoryEntry>
deactivate MemStore
StorageProto --> MemService: List<MemoryEntry>
deactivate StorageProto
MemService -> MemService: filter by operation name
MemService --> MemServiceProto: filtered List<MemoryEntry>
deactivate MemService
MemServiceProto --> CLI: filtered List<MemoryEntry>
deactivate MemServiceProto
CLI -> CLI: display filtered entries
CLI --> User: show filtered memory list
deactivate CLI

== Compute Statistics ==

User -> CLI: show_statistics()
activate CLI
CLI -> MemServiceProto: compute_statistics()
activate MemServiceProto
MemServiceProto -> MemService: compute_statistics()
activate MemService
MemService -> StorageProto: load_all()
activate StorageProto
StorageProto -> MemStore: load_all()
activate MemStore
MemStore -> DB: read file
activate DB
DB --> MemStore: JSON data
deactivate DB
MemStore --> StorageProto: List<MemoryEntry>
deactivate MemStore
StorageProto --> MemService: List<MemoryEntry>
deactivate StorageProto
MemService -> MemService: aggregate stats (counts, errors, times)
MemService --> MemServiceProto: CalculationStatistics
deactivate MemService
MemServiceProto --> CLI: CalculationStatistics
deactivate MemServiceProto
CLI -> CLI: format and display statistics
CLI --> User: show statistics report
deactivate CLI

@enduml
