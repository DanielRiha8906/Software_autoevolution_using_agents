@startuml activity_diagram_interactive

skinparam activityBackgroundColor #DDEEFF
skinparam activityBorderColor     #3366AA
skinparam activityDiamondBackgroundColor #FFF3CC

start

:Display interactive menu;

repeat

  :Wait for user selection;

  switch (choice)

    case (1 — Add workflow run)
      :Prompt workflow name;
      :Prompt branch;
      :Choose status from list;
      :Choose conclusion (optional, 0 to skip);
      :Prompt run number (optional);
      :Prompt commit SHA (optional);
      :Prompt duration in seconds (optional);
      :WorkflowRunTracker.track();
      :Print "Added run <id>";

    case (2 — Create workflow attempt)
      :Prompt run ID;
      :Prompt attempt number;
      :Choose status from list;
      :Choose conclusion (optional, 0 to skip);
      :Prompt completion time (optional);
      :Prompt duration in seconds (optional);
      :Prompt logs URL (optional);
      :WorkflowAttemptTracker.create_attempt();
      if (validation error?\n(duplicate id or\n(run_id, attempt_number)?) then (yes)
        :Print error message to stderr;
      else (no)
        :Print "Created attempt <id>";
      endif

    case (3 — List all runs)
      :WorkflowRunService.list_runs();
      if (no runs?) then (yes)
        :Print "No runs recorded.";
      else (no)
        :Print all runs;
      endif

    case (4 — Get run detail)
      :Prompt run ID;
      :WorkflowRunService.get_run_detail(run_id);
      if (found?) then (yes)
        :Print run details;
      else (no)
        :Print "No run found with id '<id>'";
      endif

    case (5 — List attempts by run)
      :Prompt run ID;
      :WorkflowAttemptService.filter_by_run_id(run_id);
      note right
        Returns attempts sorted by
        attempt_number (ascending)
      end note
      if (no attempts?) then (yes)
        :Print "No attempts for this run.";
      else (no)
        :Print all attempts\n(sorted by attempt_number);
      endif

    case (6 — Filter runs)
      :Choose filter type\n(branch / status / conclusion);
      if (branch?) then (yes)
        :Prompt branch name;
        :filter_by_branch();
      elseif (status?) then (yes)
        :Choose status from list;
        :filter_by_status();
      else (conclusion)
        :Choose conclusion from list;
        :filter_by_conclusion();
      endif
      if (no matches?) then (yes)
        :Print "No matching runs.";
      else (no)
        :Print matching runs;
      endif

    case (7 — Query workflow state)
      :Prompt run ID;
      :WorkflowRunService.get_run_detail(run_id);
      if (found?) then (yes)
        :Query state:\n  is_terminal()\n  is_running()\n  is_successful()\n  is_failed()\n  is_cancelled();
        :Print run state;
      else (no)
        :Print "No run found with id '<id>'";
      endif

    case (8 — Exit)
      :Print "Goodbye.";
      stop

  endswitch

repeat while (user continues)

@enduml
