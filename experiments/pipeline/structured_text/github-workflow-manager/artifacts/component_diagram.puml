@startuml component_diagram

skinparam componentStyle rectangle
skinparam linetype ortho
top to bottom direction

package "GitHub Workflow Manager" {

  package "Application entrypoint" {
    component "main" as MAIN
  }

  package "Interface layer" {
    component "workflow_cli" as CLI
    component "interactive_menu" as IM
    component "gui_viewer" as GUI
  }

  package "Utilities layer" {
    component "timezone_converter" as TZ
  }

  package "Service layer" {
    component "WorkflowRunTracker" as TRACKER
    component "WorkflowAttemptTracker" as ATRACKER
    component "WorkflowRunService" as SVC
    component "WorkflowAttemptService" as ASVC
    component "WorkflowStatisticsService" as STATS
    component "WorkflowDataPortabilityService" as PORTABILITY
    component "GitHubIntegrationService" as GITHUB
  }

  package "GitHub adapter layer" {
    component "GitHubTokenResolver" as TOKEN_RESOLVER
    component "GitHubApiClient" as API_CLIENT
    component "GitHubCliAdapter" as CLI_ADAPTER
    component "GitHubToWorkflowConverter" as CONVERTER
  }

  package "Persistence layer" {
    interface "WorkflowRunRepository" as RUN_REPO <<protocol>>
    interface "WorkflowAttemptRepository" as ATT_REPO <<protocol>>
    component "WorkflowJsonStorage" as STOR
    component "WorkflowAttemptJsonStorage" as ASTOR
    artifact "workflow_runs.json" as JSON_FILE
    artifact "workflow_attempts.json" as AJSON_FILE
    artifact "exported_runs.json" as EXP_RUNS_FILE
    artifact "exported_attempts.json" as EXP_ATTEMPTS_FILE
  }

  package "Domain model" {
    component "WorkflowRun" as RUN
    component "WorkflowRunAttempt" as ATTEMPT
    component "WorkflowStatus" as STATUS
    component "WorkflowConclusion" as CONCLUSION
    component "WorkflowStatisticsReport" as REPORT
  }
}

MAIN --> CLI
MAIN --> IM
MAIN --> GUI

CLI --> TZ
IM --> TZ

CLI --> TRACKER
IM --> TRACKER
GUI --> SVC
GUI --> ASVC

CLI --> ATRACKER
IM --> ATRACKER

CLI --> SVC
IM --> SVC
CLI --> ASVC
IM --> ASVC
CLI --> STATS
IM --> STATS
CLI --> PORTABILITY
IM --> PORTABILITY

IM --> GITHUB
GITHUB --> TOKEN_RESOLVER
GITHUB --> API_CLIENT
GITHUB --> CLI_ADAPTER
GITHUB --> CONVERTER

TRACKER --> SVC
TRACKER --> ASVC
ATRACKER --> ASVC
SVC --> RUN_REPO
ASVC --> ATT_REPO
STOR ..|> RUN_REPO
ASTOR ..|> ATT_REPO
STOR --> JSON_FILE
ASTOR --> AJSON_FILE

STATS --> SVC
STATS --> ASVC

PORTABILITY --> SVC
PORTABILITY --> ASVC
PORTABILITY --> EXP_RUNS_FILE
PORTABILITY --> EXP_ATTEMPTS_FILE

GITHUB ..> RUN : returns
GITHUB ..> ATTEMPT : returns
CONVERTER ..> RUN
CONVERTER ..> ATTEMPT

SVC ..> RUN
RUN --> STATUS
RUN --> CONCLUSION
RUN --> ATTEMPT

ASVC ..> ATTEMPT
ATTEMPT --> STATUS
ATTEMPT --> CONCLUSION

STATS ..> REPORT
STATS ..> RUN
STATS ..> ATTEMPT

PORTABILITY ..> RUN : exports/imports
PORTABILITY ..> ATTEMPT : exports/imports

@enduml