@startuml component_diagram

skinparam componentStyle rectangle
skinparam linetype ortho
top to bottom direction

package "GitHub Workflow Manager" {

  package "Application entrypoint" {
    component "main" as MAIN
  }

  package "Interface layer" {
    component "workflow_cli" as CLI
    component "interactive_menu" as IM
  }

  package "Utilities layer" {
    component "timezone_converter" as TZ
  }

  package "Service layer" {
    component "WorkflowRunTracker" as TRACKER
    component "WorkflowAttemptTracker" as ATRACKER
    component "WorkflowRunService" as SVC
    component "WorkflowAttemptService" as ASVC
    component "WorkflowStatisticsService" as STATS
  }

  package "Persistence layer" {
    component "WorkflowJsonStorage" as STOR
    component "WorkflowAttemptJsonStorage" as ASTOR
    artifact "workflow_runs.json" as JSON_FILE
    artifact "workflow_attempts.json" as AJSON_FILE
  }

  package "Domain model" {
    component "WorkflowRun" as RUN
    component "WorkflowRunAttempt" as ATTEMPT
    component "WorkflowStatus" as STATUS
    component "WorkflowConclusion" as CONCLUSION
    component "WorkflowStatisticsReport" as REPORT
  }
}

MAIN --> CLI
MAIN --> IM

CLI --> TZ
IM --> TZ

CLI --> TRACKER
IM --> TRACKER
CLI --> ATRACKER
IM --> ATRACKER

CLI --> SVC
IM --> SVC
CLI --> ASVC
IM --> ASVC
CLI --> STATS
IM --> STATS

TRACKER --> SVC
TRACKER --> ASVC
ATRACKER --> ASVC
SVC --> STOR
ASVC --> ASTOR
STOR --> JSON_FILE
ASTOR --> AJSON_FILE

STATS --> SVC
STATS --> ASVC

SVC ..> RUN
RUN --> STATUS
RUN --> CONCLUSION
RUN --> ATTEMPT

ASVC ..> ATTEMPT
ATTEMPT --> STATUS
ATTEMPT --> CONCLUSION

STATS ..> REPORT
STATS ..> RUN
STATS ..> ATTEMPT

@enduml