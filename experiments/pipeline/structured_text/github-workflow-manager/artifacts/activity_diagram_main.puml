@startuml activity_diagram_main

skinparam activityBackgroundColor #DDEEFF
skinparam activityBorderColor     #3366AA
skinparam activityDiamondBackgroundColor #FFF3CC

start

:Load WorkflowJsonStorage,\nWorkflowAttemptJsonStorage,\nWorkflowRunService &\nWorkflowAttemptService;

if (CLI arguments provided?) then (yes)
  :Parse args with argparse;
  switch (subcommand)

    case (add)
      :Read name, branch, status\nconclusion, run-number, commit-sha,\nduration-seconds;
      :WorkflowRunTracker.track();
      :Print "Added run <id>";

    case (attempt)
      switch (attempt subcommand)
        case (add)
          :Read run-id, attempt-number, status\nconclusion, completed-at,\nduration-seconds, logs-url;
          :WorkflowAttemptTracker.create_attempt();
          if (validation error?) then (yes)
            :Print error message to stderr;
            :Exit code 1;
          else (no)
            :Print "Added attempt <id>";
          endif
        case (list)
          :Parse composite filter flags:\n--run-id, --status, --conclusion,\n--duration-min/max,\n--started-before/after,\n--completed-before/after,\n--timezone;
          if (timezone-specific\ntimestamps?) then (yes)
            :parse_datetime_with_timezone();
          endif
          :WorkflowAttemptService.filter_attempts()\n(composite filter);
          if (no attempts?) then (yes)
            :Print "No attempts found.";
          else (no)
            :Print formatted attempt list;
          endif
        case (detail)
          :WorkflowAttemptService.get_attempt_detail(attempt_id);
          if (attempt found?) then (yes)
            :Print attempt details;
          else (no)
            :Print error to stderr;
            :Exit code 1;
          endif
        case (query-state)
          :WorkflowAttemptService.get_attempt_detail(attempt_id);
          if (attempt found?) then (yes)
            :Query state:\n  is_terminal()\n  is_running()\n  is_successful()\n  is_failed()\n  is_cancelled();
            :Print attempt state;
          else (no)
            :Print error to stderr;
            :Exit code 1;
          endif
      endswitch

    case (list)
      :Parse composite filter flags:\n--branch, --status, --conclusion,\n--duration-min/max,\n--created-before/after,\n--updated-before/after,\n--with/without-attempts,\n--timezone;
      if (timezone-specific\ntimestamps?) then (yes)
        :parse_datetime_with_timezone();
      endif
      :WorkflowRunService.filter_runs()\n(composite filter);
      if (no runs?) then (yes)
        :Print "No runs found.";
      else (no)
        :Print formatted run list;
      endif

    case (detail)
      :WorkflowRunService.get_run_detail(run_id);
      if (run found?) then (yes)
        :Print run details;
      else (no)
        :Print error to stderr;
        :Exit code 1;
      endif

    case (query-state)
      :WorkflowRunService.get_run_detail(run_id);
      if (run found?) then (yes)
        :Query state:\n  is_terminal()\n  is_running()\n  is_successful()\n  is_failed()\n  is_cancelled();
        :Print workflow state;
      else (no)
        :Print error to stderr;
        :Exit code 1;
      endif

    case (report)
      :Parse output format flag:\n--format [text|json];
      :WorkflowStatisticsService.compute_report();
      if (format == json?) then (yes)
        :Serialize report.to_dict() as JSON;
        :Print formatted JSON;
      else (text)
        :Print formatted text report:\n  total runs\n  conclusion counts\n  duration stats\n  attempt stats\n  generated_at;
      endif

  endswitch
  stop

else (no)
  :Launch interactive menu\n(see activity_diagram_interactive);
  stop
endif

@enduml
