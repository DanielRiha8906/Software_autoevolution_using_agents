@startuml activity_diagram_main

skinparam activityBackgroundColor #DDEEFF
skinparam activityBorderColor     #3366AA
skinparam activityDiamondBackgroundColor #FFF3CC

start

:Load WorkflowJsonStorage,\nWorkflowAttemptJsonStorage,\nWorkflowRunService &\nWorkflowAttemptService;

if (CLI arguments provided?) then (yes)
  :Parse args with argparse;
  switch (subcommand)

    case (add)
      :Read name, branch, status\nconclusion, run-number, commit-sha,\nduration-seconds;
      :WorkflowRunTracker.track();
      :Print "Added run <id>";

    case (create-attempt)
      :Read run-id, attempt-number, status\nconclusion, completed-at,\nduration-seconds, logs-url;
      :WorkflowAttemptTracker.create_attempt();
      if (validation error?\n(duplicate id or\n(run_id, attempt_number)?) then (yes)
        :Print error message to stderr;
        :Exit code 1;
      else (no)
        :Print "Created attempt <id>";
      endif

    case (list)
      :WorkflowRunService.list_runs();
      if (--branch?) then (yes)
        :filter_by_branch();
      elseif (--status?) then (yes)
        :filter_by_status();
      elseif (--conclusion?) then (yes)
        :filter_by_conclusion();
      endif
      if (no runs?) then (yes)
        :Print "No runs found.";
      else (no)
        :Print formatted run list;
      endif

    case (detail)
      :WorkflowRunService.get_run_detail(run_id);
      if (run found?) then (yes)
        :Print run details;
      else (no)
        :Print error to stderr;
        :Exit code 1;
      endif

    case (list-attempts)
      :WorkflowAttemptService.filter_by_run_id(run_id);
      note right
        Returns attempts sorted by
        attempt_number (ascending)
      end note
      if (no attempts?) then (yes)
        :Print "No attempts for this run.";
      else (no)
        :Print formatted attempt list\n(sorted by attempt_number);
      endif

    case (query-state)
      :WorkflowRunService.get_run_detail(run_id);
      if (run found?) then (yes)
        :Query state using:\n  is_terminal()\n  is_running()\n  is_successful()\n  is_failed()\n  is_cancelled();
        :Print workflow state;
      else (no)
        :Print error to stderr;
        :Exit code 1;
      endif

  endswitch
  stop

else (no)
  :Launch interactive menu\n(see activity_diagram_interactive);
  stop
endif

@enduml
