@startuml sequence_github_integration

skinparam sequenceParticipant underline
skinparam backgroundColor transparent

participant "User" as USR
participant "InteractiveMenu" as MENU
participant "GitHubIntegrationService" as GIS
participant "GitHubTokenResolver" as TR
participant "GitHubApiClient\n/ GitHubCliAdapter" as CLIENT
participant "GitHubToWorkflowConverter" as CONVERTER
participant "GitHub API\n(REST or gh CLI)" as GITHUB
participant "WorkflowRunService" as WRS
participant "WorkflowAttemptService" as WAS
participant "Domain Models\n(WorkflowRun,\nWorkflowRunAttempt)" as MODELS

== Token Resolution ==
activate MENU
MENU -> GIS: fetch_runs(\nowner, repo,\nworkflow_name,\nlimit, token?)
activate GIS

alt token provided explicitly
    GIS --> GIS: Use provided token
else token not provided
    GIS -> TR: resolve()
    activate TR
    TR -> TR: Check GITHUB_TOKEN\nenvironment variable
    alt env var set
        TR --> TR: Return env token
    else env var not set
        TR -> TR: Check secrets/.env file
        alt file exists and\nGITHUB_TOKEN= found
            TR --> TR: Return file token
        else file missing or\nno GITHUB_TOKEN key
            TR -> USR: Prompt for token
            USR --> TR: token input
            TR --> TR: Return input token
        end
    end
    TR --> GIS: token
    deactivate TR
end

== Token Validation ==
GIS -> TR: validate(token, fetch_mode)
activate TR
alt fetch_mode == "cli"
    TR -> GITHUB: gh auth status
    GITHUB --> TR: status code
    alt status code == 0
        TR --> TR: token valid
    else status code != 0
        TR --> TR: token invalid\nRaise RuntimeError
    end
else fetch_mode == "api"
    TR -> GITHUB: GET /user\nAuthorization: token
    GITHUB --> TR: 200 | 401 | other
    alt status == 200
        TR --> TR: token valid
    else status == 401
        TR --> TR: token invalid\nRaise RuntimeError
    else other status
        TR --> TR: token validation uncertain\nRaise RuntimeError
    end
end
TR --> GIS: bool
deactivate TR

== Fetch Runs from GitHub ==
alt fetch_mode == "api"
    GIS -> CLIENT: get_runs(owner, repo, limit)
    activate CLIENT
    CLIENT -> GITHUB: GET /repos/{owner}/{repo}/actions/runs\n?per_page={limit}\nAuthorization: token
else fetch_mode == "cli"
    GIS -> CLIENT: get_runs(owner, repo, limit)
    activate CLIENT
    CLIENT -> GITHUB: gh run list -R {owner}/{repo}\n-L {limit} --json id,name,status,...
end

GITHUB --> CLIENT: JSON response
CLIENT --> GIS: List[Dict]
deactivate CLIENT

== Convert API Response ==
GIS -> CONVERTER: For each run:\nconvert_run(api_data, repo)
activate CONVERTER
    CONVERTER -> CONVERTER: Parse timestamps\n_parse_github_timestamp()
    CONVERTER -> CONVERTER: Extract status, conclusion\nValidate enum values
    CONVERTER -> CONVERTER: Calculate duration\nfrom timestamps
    CONVERTER -> MODELS: Create WorkflowRun
    MODELS --> CONVERTER: WorkflowRun instance
CONVERTER --> GIS: WorkflowRun
deactivate CONVERTER

GIS --> MENU: List[WorkflowRun]
deactivate GIS

== Add Runs to Storage ==
MENU -> MENU: For each run:\nCheck if duplicate
alt run already exists
    MENU -> MENU: Skip (log info)
else run is new
    MENU -> WRS: add_workflow_run(run)
    activate WRS
    WRS -> WRS: Validate, persist
    WRS --> MENU: WorkflowRun
    deactivate WRS
end

MENU --> USR: Display: Added N, Skipped M
deactivate MENU

== Fetch Attempts for Selected Run ==
MENU -> GIS: fetch_run_attempts(\nowner, repo, run_id, token?)
activate GIS

alt token provided
    GIS --> GIS: Use provided token
else
    GIS -> GIS: Use cached token\nor re-resolve
end

GIS -> TR: validate(token, fetch_mode)
activate TR
TR --> GIS: bool
deactivate TR

alt fetch_mode == "api"
    GIS -> CLIENT: get_run_attempts(owner, repo, run_id)
    activate CLIENT
    CLIENT -> GITHUB: GET /repos/{owner}/{repo}/actions/runs/{run_id}/attempts\nAuthorization: token
else fetch_mode == "cli"
    GIS -> CLIENT: get_run_attempts(owner, repo, run_id)
    activate CLIENT
    CLIENT -> GITHUB: gh run view {run_id} -R {owner}/{repo}\n--json attemptNumber,status,conclusion,...
end

GITHUB --> CLIENT: JSON response
CLIENT --> GIS: List[Dict]
deactivate CLIENT

== Convert Attempt Response ==
GIS -> CONVERTER: For each attempt:\nconvert_attempt(api_data, run_id, repo)
activate CONVERTER
    CONVERTER -> CONVERTER: Parse timestamps
    CONVERTER -> CONVERTER: Extract status, conclusion\nValidate enum values
    CONVERTER -> CONVERTER: Calculate duration
    CONVERTER -> MODELS: Create WorkflowRunAttempt
    MODELS --> CONVERTER: WorkflowRunAttempt instance
CONVERTER --> GIS: WorkflowRunAttempt
deactivate CONVERTER

GIS --> MENU: List[WorkflowRunAttempt]
deactivate GIS

== Add Attempts to Storage ==
MENU -> MENU: For each attempt:\nCheck if duplicate
alt attempt already exists
    MENU -> MENU: Skip (log info)
else attempt is new
    MENU -> WAS: add_attempt(attempt)
    activate WAS
    WAS -> WAS: Validate (unique id,\nunique run_id+attempt_number)
    WAS -> WAS: Persist
    WAS --> MENU: WorkflowRunAttempt
    deactivate WAS
end

MENU --> USR: Display: Added N, Skipped M

@enduml
