package "models" #DDEEFF {
    enum WorkflowStatus {
        QUEUED = "queued"
        IN_PROGRESS = "in_progress"
        COMPLETED = "completed"
        WAITING = "waiting"
        REQUESTED = "requested"
        PENDING = "pending"
    }

    enum WorkflowConclusion {
        SUCCESS = "success"
        FAILURE = "failure"
        CANCELLED = "cancelled"
        SKIPPED = "skipped"
        TIMED_OUT = "timed_out"
        ACTION_REQUIRED = "action_required"
        NEUTRAL = "neutral"
        STALE = "stale"
    }

    class WorkflowRun {
        +id               : str
        +workflow_name    : str
        +branch           : str
        +status           : WorkflowStatus
        +conclusion       : Optional[WorkflowConclusion]
        +created_at       : datetime
        +updated_at       : Optional[datetime]
        +run_number       : Optional[int]
        +commit_sha       : Optional[str]
        +duration_seconds : float
        --
        +to_dict() : dict
        +{static} from_dict(data: dict) : WorkflowRun
        +is_terminal() : bool
        +is_running() : bool
        +is_successful() : bool
        +is_failed() : bool
        +is_cancelled() : bool
    }

    class WorkflowRunAttempt {
        +id               : str
        +run_id           : str
        +attempt_number   : int
        +status           : WorkflowStatus
        +conclusion       : Optional[WorkflowConclusion]
        +started_at       : datetime
        +completed_at     : Optional[datetime]
        +duration_seconds : float
        +logs_url         : Optional[str]
        --
        +to_dict() : dict
        +{static} from_dict(data: dict) : WorkflowRunAttempt
        +is_terminal() : bool
        +is_running() : bool
        +is_successful() : bool
        +is_failed() : bool
        +is_cancelled() : bool
    }

    class WorkflowStatisticsReport {
        +total_runs                 : int
        +conclusion_counts          : Dict[Optional[str], int]
        +average_duration_seconds   : float
        +min_duration_seconds       : Optional[float]
        +max_duration_seconds       : Optional[float]
        +duration_by_conclusion     : Dict[Optional[str], float]
        +total_attempts             : int
        +average_attempts_per_run   : float
        +runs_with_no_attempts      : int
        +runs_with_attempts         : int
        +generated_at               : datetime
        --
        +to_dict() : dict
    }
}

