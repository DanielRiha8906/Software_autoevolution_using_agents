@startuml class_diagram

skinparam classAttributeIconSize 0
skinparam classFontStyle bold

package "models" #DDEEFF {
    enum WorkflowStatus {
        QUEUED = "queued"
        IN_PROGRESS = "in_progress"
        COMPLETED = "completed"
        WAITING = "waiting"
        REQUESTED = "requested"
        PENDING = "pending"
    }

    enum WorkflowConclusion {
        SUCCESS = "success"
        FAILURE = "failure"
        CANCELLED = "cancelled"
        SKIPPED = "skipped"
        TIMED_OUT = "timed_out"
        ACTION_REQUIRED = "action_required"
        NEUTRAL = "neutral"
        STALE = "stale"
    }

    class WorkflowRun {
        +id               : str
        +workflow_name    : str
        +branch           : str
        +status           : WorkflowStatus
        +conclusion       : Optional[WorkflowConclusion]
        +created_at       : datetime
        +updated_at       : Optional[datetime]
        +run_number       : Optional[int]
        +commit_sha       : Optional[str]
        +duration_seconds : float
        --
        +to_dict() : dict
        +{static} from_dict(data: dict) : WorkflowRun
        +is_terminal() : bool
        +is_running() : bool
        +is_successful() : bool
        +is_failed() : bool
        +is_cancelled() : bool
    }

    class WorkflowRunAttempt {
        +id               : str
        +run_id           : str
        +attempt_number   : int
        +status           : WorkflowStatus
        +conclusion       : Optional[WorkflowConclusion]
        +started_at       : datetime
        +completed_at     : Optional[datetime]
        +duration_seconds : float
        +logs_url         : Optional[str]
        --
        +to_dict() : dict
        +{static} from_dict(data: dict) : WorkflowRunAttempt
        +is_terminal() : bool
        +is_running() : bool
        +is_successful() : bool
        +is_failed() : bool
        +is_cancelled() : bool
    }
}

package "storage" #FFF3CC {
    class WorkflowJsonStorage {
        +filepath : str
        --
        +__init__(filepath: str)
        +save(runs: List[WorkflowRun]) : None
        +load() : List[WorkflowRun]
    }

    class WorkflowAttemptJsonStorage {
        +filepath : str
        --
        +__init__(filepath: str)
        +save(attempts: List[WorkflowRunAttempt]) : None
        +load() : List[WorkflowRunAttempt]
    }
}

package "services" #DDFFD4 {
    class WorkflowRunService {
        -_storage : WorkflowJsonStorage
        -_runs    : List[WorkflowRun]
        --
        +__init__(storage: WorkflowJsonStorage)
        +add_workflow_run(run: WorkflowRun) : WorkflowRun
        +list_runs() : List[WorkflowRun]
        +get_run_detail(run_id: str) : Optional[WorkflowRun]
        +filter_by_branch(branch: str) : List[WorkflowRun]
        +filter_by_status(status: WorkflowStatus) : List[WorkflowRun]
        +filter_by_conclusion(conclusion: WorkflowConclusion) : List[WorkflowRun]
        -_persist() : None
    }

    class WorkflowAttemptService {
        -_storage   : WorkflowAttemptJsonStorage
        -_attempts  : List[WorkflowRunAttempt]
        --
        +__init__(storage: WorkflowAttemptJsonStorage)
        +add_attempt(attempt: WorkflowRunAttempt) : WorkflowRunAttempt
        +list_attempts() : List[WorkflowRunAttempt]
        +get_attempt_detail(attempt_id: str) : Optional[WorkflowRunAttempt]
        +filter_by_run_id(run_id: str) : List[WorkflowRunAttempt]
        +filter_by_status(status: WorkflowStatus) : List[WorkflowRunAttempt]
        +filter_by_conclusion(conclusion: WorkflowConclusion) : List[WorkflowRunAttempt]
        -_persist() : None
    }

    class WorkflowRunTracker {
        -_service           : WorkflowRunService
        -_attempt_service   : Optional[WorkflowAttemptService]
        --
        +__init__(service: WorkflowRunService,\n  attempt_service: Optional[WorkflowAttemptService])
        +track(workflow_name: str, branch: str,\n  status: WorkflowStatus,\n  conclusion: Optional[WorkflowConclusion],\n  run_number: Optional[int],\n  commit_sha: Optional[str],\n  run_id: Optional[str],\n  duration_seconds: float) : WorkflowRun
        +create_attempt(run_id: str, attempt_number: int,\n  status: WorkflowStatus,\n  conclusion: Optional[WorkflowConclusion],\n  completed_at: Optional[datetime],\n  duration_seconds: float,\n  logs_url: Optional[str],\n  attempt_id: Optional[str]) : WorkflowRunAttempt
    }

    class WorkflowAttemptTracker {
        -_service : WorkflowAttemptService
        --
        +__init__(service: WorkflowAttemptService)
        +create_attempt(run_id: str, attempt_number: int,\n  status: WorkflowStatus,\n  conclusion: Optional[WorkflowConclusion],\n  completed_at: Optional[datetime],\n  duration_seconds: float,\n  logs_url: Optional[str],\n  attempt_id: Optional[str]) : WorkflowRunAttempt
    }

    note right of WorkflowAttemptService
        **add_attempt()** validates:
        • attempt.id is globally unique
        • (run_id, attempt_number) pair is unique
        • Raises ValueError with message:
          "Attempt number {N} already exists for run '{id}'."

        **filter_by_run_id()** returns:
        • All attempts for given run_id
        • Sorted by attempt_number (ascending)
    end note
}

package "cli" #FFE5E5 {
    class "workflow_cli" <<module>> {
        +build_parser() : ArgumentParser
        +run_cli(service: WorkflowRunService, args) : None
        -_fmt_run(run: WorkflowRun) : str
    }

    class "interactive_menu" <<module>> {
        +run_interactive(service: WorkflowRunService) : None
        -_add_run(service: WorkflowRunService) : None
        -_list_runs(service: WorkflowRunService) : None
        -_detail_run(service: WorkflowRunService) : None
        -_filter_menu(service: WorkflowRunService) : None
    }
}

