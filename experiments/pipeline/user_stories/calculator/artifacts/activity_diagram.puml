@startuml activity_diagram

skinparam activityBackgroundColor #DDEEFF
skinparam activityBorderColor #3366AA
skinparam activityDiamondBackgroundColor #FFF3CC

start

if (GUI or CLI mode?) then (GUI: --gui flag)

  :Initialize services;
  :Launch Tkinter MainWindow;
  :Show GUI;

  repeat
    :User selects mode (Standard/Scientific);
    :User selects operation;
    :User enters operands;
    :User clicks Calculate button;

    :InputPanel validates input;

    if (Input valid?) then (yes)
      :InputPanel calls GUIController.perform_calculation();

      if (No error?) then (yes)
        :GUIController stores MemoryEntry;
        :ResultPanel displays result;
        :HistoryPanel refreshes;
      else (no)
        :ResultPanel displays error;
        :HistoryPanel refreshes with error entry;
      endif

    else (no)
      :InputPanel displays error message;
    endif

  repeat while (GUI window open?) is (yes)

else (CLI mode)

  if (--gui flag provided?) then (no)
    :Check for other CLI flags;
  endif

  if (CLI operation provided?) then (yes)

  :Validate operation and operands;

  if (Input valid?) then (yes)
    :Perform calculation;

    if (No error?) then (yes)
      :Save MemoryEntry to history;
      :Show result;
      stop
    else (no)
      :Save error MemoryEntry to history;
      :Show error message;
      stop
    endif

  else (no)
    :Show usage error;
    stop
  endif

else (no)

  repeat
    :Show menu;
    :Read user choice;

    switch (User choice?)

      case (Exit)
        :Show goodbye message;
        stop

      case (History)
        :Load calculation history;
        :Show history;

      case (Filter)
        :Prompt for operation selection;
        :Prompt for state selection;
        :Apply filters to history;
        :Show filtered results;

      case (Statistics)
        :Calculate statistics from history;
        :Show total calculations;
        :Show error rate;
        :Show average execution time;
        :Show operation counts;

      case (Export)
        :Prompt for export filepath;
        :Validate JSON extension;
        :Serialize history to JSON;
        :Write file;
        :Show success message;

      case (Import)
        :Prompt for import filepath;
        :Prompt for import mode (merge/replace);
        :Read and parse JSON file;
        :Validate entries;
        :Detect duplicates;
        :Store valid entries;
        :Show import summary;

      case (Operation)
        :Read operands;

        if (Input valid?) then (yes)
          :Perform calculation;

          if (No error?) then (yes)
            :Save MemoryEntry to history;
            :Show result;
          else (no)
            :Save error MemoryEntry to history;
            :Show error message;
          endif

        else (no)
          :Show input error;
        endif

      case (Invalid choice)
        :Show invalid choice message;

    endswitch

  repeat while (Menu active?) is (yes)

endif

endif

stop

@enduml