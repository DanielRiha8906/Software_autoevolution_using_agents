@startuml component_diagram

skinparam componentStyle uml2
skinparam defaultFontSize 13
left to right direction

package "Calculator Application" {

    component "Entry Point\n(__main__)" as Main
    component "CLI Interface\n(CalculatorCLI)" as CLI
    component "Application Service\n(CalculatorService)" as Service
    component "Memory Service\n(MemoryService)" as Memory
    component "Calculation Engine\n(Calculator)" as Calc
    component "JSON Storage\n(JsonStorage)" as Store
    component "Storage Interface\n(MemoryEntryStorage)" as StorageInterface
    component "Domain Models\n(Operation, CalculationResult,\nMemoryEntry)" as Models

    Main --> CLI : initializes
    Main --> Service : initializes
    Main --> Memory : initializes

    CLI --> Service : uses
    Service --> Calc : uses
    Service --> Store : uses
    Memory --> StorageInterface : uses

    Service ..> Models
    Memory ..> Models
    Store ..> Models
}

database "calculations.json" as DB

Store --> DB : read/write

@enduml