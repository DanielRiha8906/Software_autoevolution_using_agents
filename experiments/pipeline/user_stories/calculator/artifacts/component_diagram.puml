@startuml component_diagram

skinparam componentStyle uml2
skinparam defaultFontSize 13
left to right direction

package "Calculator Application (CLI + GUI Layers)" {

    component "Entry Point\n(__main__)" as Main

    component "GUI Layer" {
        component "Main Window\n(MainWindow)" as Window
        component "Input Panel\n(operation, operand entry)" as InputPanel
        component "Result Panel\n(success/error display)" as ResultPanel
        component "History Panel\n(scrollable list)" as HistoryPanel
        component "Mode Selector\n(standard/scientific)" as ModeSelector
        component "GUI Controller\n(GUIController)" as GUICtrl
    }

    component "CLI Layer" {
        component "Command Router\n(CalculatorCLI)" as CLI
        component "Commands\n(Calculate, History,\nStatistics, Export,\nImport, Filter)" as Commands
        component "Formatters\n(MemoryEntry, Statistics,\nImportResult)" as Formatters
    }

    component "Service Layer" {
        component "Calculator Service\n(CalculatorService)" as Service
        component "Statistics Service\n(StatisticsService)" as Statistics
        component "Import/Export Service\n(ImportExportService)" as ImportExport
        component "Memory Service\n(MemoryService)" as Memory
        component "History Filters\n(OperationFilter,\nStateFilter,\nCompositeFilter)" as HistoryFilters
    }

    component "Storage Layer" {
        component "Storage Backend\n(Interface)" as StorageInterface
        component "JSON Storage\n(JsonStorage)" as Store
    }

    component "Domain Models\n(MemoryEntry,\nOperation,\nCalculationStatistics)" as Models

    Main --> Window : initializes (--gui)
    Main --> CLI : initializes (interactive)
    Main --> Service : initializes
    Main --> Statistics : initializes
    Main --> ImportExport : initializes

    Window --> InputPanel : manages
    Window --> ResultPanel : manages
    Window --> HistoryPanel : manages
    Window --> ModeSelector : manages
    Window --> GUICtrl : uses

    InputPanel --> GUICtrl : calls on Calculate
    ResultPanel --> GUICtrl : displays results from
    HistoryPanel --> GUICtrl : refreshes from
    ModeSelector --> InputPanel : updates operation list

    GUICtrl --> Service : uses
    GUICtrl --> Memory : queries
    GUICtrl --> Statistics : queries

    CLI --> Commands : routes to
    CLI --> Formatters : uses
    CLI --> Service : uses
    CLI --> Statistics : uses
    CLI --> ImportExport : uses
    CLI --> Memory : queries

    Commands --> Service : uses
    Commands --> Statistics : uses
    Commands --> ImportExport : uses
    Commands --> Memory : queries
    Commands --> Formatters : uses

    Service --> Memory : uses
    Statistics --> Memory : uses
    ImportExport --> Memory : uses

    Memory --> HistoryFilters : delegates
    Memory --> StorageInterface : depends on

    StorageInterface <|-- Store : implements

    Service ..> Models
    Statistics ..> Models
    ImportExport ..> Models
    Memory ..> Models
    Store ..> Models
    Commands ..> Models
    Formatters ..> Models
}

database "calculations.json" as DB

Store --> DB : read/write

note right of Window
    Tkinter root window;
    coordinates GUI components
    and delegates to GUIController
end note

note right of GUICtrl
    Bridge between GUI and services;
    no business logic, only
    delegation to services
end note

note right of CLI
    Entry point for command-line
    interactions; orchestrates
    commands and formatters
end note

note right of Memory
    Depends on StorageBackend
    abstraction, not concrete
    JsonStorage; delegates
    filtering to HistoryFilter
    implementations
end note

note right of Store
    Implements StorageBackend
    protocol; can be swapped
    for alternative persistence
end note

@enduml
