@startuml class_diagram

skinparam classAttributeIconSize 0
skinparam classFontStyle bold

package "models" #DDEEFF {
    enum Operation {
        ADD
        SUBTRACT
        MULTIPLY
        DIVIDE
        SQUARE
        SQRT
        POWER
        MODULO
        --
        +from_string(value: str) : Operation
        +display_name() : str
    }

    class MemoryEntry {
        +operation : str
        +operand_a : float
        +operand_b : float
        +result : float | None
        +error : str | None
        +error_type : str | None
        +timestamp : str
        +uuid : str
        --
        +__post_init__() : void
        +to_dict() : dict
        +from_dict(data: dict) : MemoryEntry
        +__str__() : str
    }

    class CalculationResult {
        +operation : str
        +operand_a : float
        +operand_b : float
        +result : float
        +timestamp : str
        +execution_time_ms : float
        --
        +__post_init__() : void
        +to_dict() : dict
        +from_dict(data: dict) : CalculationResult
        +__str__() : str
        ..
        note on right : Legacy; retained for compatibility
    }
}

package "services" #DDFFD4 {
    class Calculator {
        +add(a: float, b: float) : float
        +subtract(a: float, b: float) : float
        +multiply(a: float, b: float) : float
        +divide(a: float, b: float) : float
        +square(a: float, b: float) : float
        +sqrt(a: float, b: float) : float
        +power(a: float, b: float) : float
        +modulo(a: float, b: float) : float
        +calculate(op: Operation, a: float, b: float) : float
    }

    class CalculatorService {
        -calculator : Calculator
        -storage : JsonStorage
        --
        +CalculatorService(calculator: Calculator, storage: JsonStorage)
        +perform(operation: Operation, a: float, b: float) : MemoryEntry
        +get_history() : list[MemoryEntry]
        ..
        note on right : Wraps results with error handling;\\nsaves to storage
    }
}

package "storage" #FFF3CC {
    class JsonStorage {
        -filepath : Path | str
        --
        +JsonStorage(filepath: Path | str)
        +save(result: MemoryEntry) : void
        +load_all() : list[MemoryEntry]
        -_read_raw() : list
        -_write_raw(records: list) : void
    }
}

package "cli" #FFE5E5 {
    class CalculatorCLI {
        -_MENU : list[tuple[Operation, str]]
        -service : CalculatorService
        --
        +CalculatorCLI(service: CalculatorService)
        +run_interactive() : void
        +run_command(operation: str, a: float, b: float) : void
        -_print_menu() : void
        -_resolve_menu_choice(choice: str) : Operation [0..1]
        -_prompt_number(prompt: str) : float [0..1]
        -_show_history() : void
    }
}

CalculatorCLI --> CalculatorService : service
CalculatorService --> Calculator : calculator
CalculatorService --> JsonStorage : storage

CalculatorService ..> MemoryEntry : create, return
CalculatorService ..> Operation
CalculatorCLI ..> Operation
CalculatorCLI ..> MemoryEntry : receive, display
Calculator ..> Operation
JsonStorage ..> MemoryEntry : save, load

@enduml