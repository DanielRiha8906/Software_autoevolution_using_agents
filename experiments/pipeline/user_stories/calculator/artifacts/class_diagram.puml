@startuml class_diagram

skinparam classAttributeIconSize 0
skinparam classFontStyle bold

package "models" #DDEEFF {
    enum Operation {
        ADD
        SUBTRACT
        MULTIPLY
        DIVIDE
        SQUARE
        SQRT
        POWER
        MODULO
        --
        +from_string(value: str) : Operation
        +display_name() : str
    }

    class MemoryEntry {
        +operation : str
        +operand_a : float
        +operand_b : float
        +result : float | None
        +error : str | None
        +error_type : str | None
        +execution_time_ms : float
        +timestamp : str
        +uuid : str
        --
        +__post_init__() : void
        +to_dict() : dict
        +from_dict(data: dict) : MemoryEntry
        +__str__() : str
    }

    class CalculationResult {
        +operation : str
        +operand_a : float
        +operand_b : float
        +result : float
        +timestamp : str
        +execution_time_ms : float
        --
        +__post_init__() : void
        +to_dict() : dict
        +from_dict(data: dict) : CalculationResult
        +__str__() : str
        ..
        note on right : Legacy; retained for compatibility
    }

    class CalculationStatistics {
        +total_calculations : int
        +total_errors : int
        +error_rate_percent : float
        +operations_count : dict[str, int]
        +average_execution_time_ms : float
        --
        +__post_init__() : void
        ..
        note on right : Aggregated metrics from\\nMemoryEntry history
    }
}

package "services" #DDFFD4 {
    class Calculator {
        +add(a: float, b: float) : float
        +subtract(a: float, b: float) : float
        +multiply(a: float, b: float) : float
        +divide(a: float, b: float) : float
        +square(a: float, b: float) : float
        +sqrt(a: float, b: float) : float
        +power(a: float, b: float) : float
        +modulo(a: float, b: float) : float
        +calculate(op: Operation, a: float, b: float) : float
    }

    class MemoryService {
        -storage : JsonStorage
        --
        +MemoryService(storage: JsonStorage)
        +store(entry: MemoryEntry) : void
        +retrieve() : list[MemoryEntry]
        +filter_by_operation(operation_name: str) : list[MemoryEntry]
        +filter_by_operations(operation_names: list[str]) : list[MemoryEntry]
        +filter_by_state(state: str) : list[MemoryEntry]
        +filter(operations: list[str] | None, state: str | None) : list[MemoryEntry]
        ..
        note on right : Encapsulates storage access;\\nabstraction over JsonStorage;\\nfiltering by operation/state
    }

    class CalculatorService {
        -calculator : Calculator
        -memory_service : MemoryService
        --
        +CalculatorService(calculator: Calculator, memory_service: MemoryService)
        +perform(operation: Operation, a: float, b: float) : MemoryEntry
        +get_history() : list[MemoryEntry]
        +filter_history(operations: list[str] | None, state: str | None) : list[MemoryEntry]
        ..
        note on right : Wraps results with error handling;\\nsaves via MemoryService;\\ndelegate filtering
    }

    class StatisticsService {
        -memory_service : MemoryService
        --
        +StatisticsService(memory_service: MemoryService)
        +calculate_statistics() : CalculationStatistics
        ..
        note on right : Computes aggregated metrics\\nfrom stored calculation history
    }

    class ImportExportService {
        -memory_service : MemoryService
        --
        +ImportExportService(memory_service: MemoryService)
        +export_history(filepath: Path|str, entries: list|None) : dict
        +import_history(filepath: Path|str, mode: str) : dict
        -_validate_entry(data: dict) : tuple[bool, str|None]
        -_detect_duplicate(entry: MemoryEntry, existing: list) : bool
        ..
        note on right : Handles JSON export/import\\nwith validation and duplicate detection
    }
}

package "storage" #FFF3CC {
    class JsonStorage {
        -filepath : Path | str
        --
        +JsonStorage(filepath: Path | str)
        +save(result: MemoryEntry) : void
        +load_all() : list[MemoryEntry]
        -_read_raw() : list
        -_write_raw(records: list) : void
    }
}

package "cli" #FFE5E5 {
    class CalculatorCLI {
        -_MENU : list[tuple[Operation, str]]
        -service : CalculatorService
        -statistics_service : StatisticsService
        -import_export_service : ImportExportService | None
        --
        +CalculatorCLI(service: CalculatorService, statistics_service: StatisticsService, import_export_service: ImportExportService | None)
        +run_interactive() : void
        +run_command(operation: str, a: float, b: float) : void
        -_print_menu() : void
        -_resolve_menu_choice(choice: str) : Operation [0..1]
        -_prompt_number(prompt: str) : float [0..1]
        -_show_history() : void
        -_run_filter_menu() : void
        -_prompt_operation_selection() : list[str] | None
        -_prompt_state_selection() : str | None
        -_show_filtered_history(operations: list[str] | None, state: str | None) : void
        -_show_statistics() : void
        -_export_history() : void
        -_import_history(filepath: str | None, mode: str) : void
        -_show_import_result(result: dict) : void
    }
}

CalculatorCLI --> CalculatorService : service
CalculatorCLI --> StatisticsService : statistics_service
CalculatorCLI --> ImportExportService : import_export_service
CalculatorService --> Calculator : calculator
CalculatorService --> MemoryService : memory_service
StatisticsService --> MemoryService : memory_service
ImportExportService --> MemoryService : memory_service
MemoryService --> JsonStorage : storage

CalculatorService ..> MemoryEntry : create, return
StatisticsService ..> CalculationStatistics : create, return
CalculatorService ..> Operation
CalculatorCLI ..> Operation
CalculatorCLI ..> MemoryEntry : receive, display
CalculatorCLI ..> CalculationStatistics : display
Calculator ..> Operation
MemoryService ..> MemoryEntry : store, retrieve
JsonStorage ..> MemoryEntry : save, load

@enduml