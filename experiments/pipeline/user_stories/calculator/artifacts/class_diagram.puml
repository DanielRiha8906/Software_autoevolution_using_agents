@startuml class_diagram

skinparam classAttributeIconSize 0
skinparam classFontStyle bold

' ============================================================================
' GUI LAYER (tkinter components)
' ============================================================================
package "gui" #FFE5CC {
    class MainWindow {
        -gui_controller : GUIController
        --
        +__init__(gui_controller: GUIController) : void
        +_setup_ui() : void
        +_setup_callbacks() : void
        +_on_calculate(operation_str: str, a: float, b: float) : void
        +_on_mode_changed(mode: str) : void
        +_refresh_history() : void
        +run() : void
        ..
        note on right : Root Tkinter window;\\nmanages all GUI panels;\\nroutes events to GUIController
    }

    class InputPanel {
        -current_mode : str
        -operation_var : StringVar
        -operand_a_var : StringVar
        -operand_b_var : StringVar
        -calculate_callback : callable | None
        --
        +set_calculate_callback(callback) : void
        +_on_calculate() : void
        +_on_clear() : void
        +set_mode(mode: str) : void
        +get_operands() : tuple[float, float]
        +get_operation() : str
        +set_error_message(message: str) : void
        +_on_operation_changed() : void
        ..
        note on right : Handles operation selection\\nand operand entry;\\nno business logic
    }

    class ResultPanel {
        -result_label : Label
        --
        +display_result(entry: MemoryEntry) : void
        +clear() : void
        ..
        note on right : Displays result or error\\nfrom last calculation
    }

    class HistoryPanel {
        -history_listbox : Listbox
        -entries : list[MemoryEntry]
        --
        +refresh(entries: list[MemoryEntry]) : void
        +clear() : void
        +get_entries() : list[MemoryEntry]
        ..
        note on right : Scrollable list of\\ncalculation history
    }

    class ModeSelector {
        -mode_var : StringVar
        -current_mode : str
        -mode_changed_callback : callable | None
        --
        +set_mode_changed_callback(callback) : void
        +_on_mode_changed() : void
        +get_mode() : str
        ..
        note on right : Toggle between standard\\nand scientific modes
    }

    class GUIController {
        -calculator_service : CalculatorService
        -memory_service : MemoryService
        -statistics_service : StatisticsService
        --
        +perform_calculation(operation_str: str, a: float, b: float) : MemoryEntry
        +get_history() : list[MemoryEntry]
        +filter_history(operations: list[str] | None, state: str | None) : list[MemoryEntry]
        +get_statistics() : CalculationStatistics
        ..
        note on right : Bridge to services;\\nno business logic;\\npure delegation
    }

    MainWindow --> InputPanel : creates, manages
    MainWindow --> ResultPanel : creates, manages
    MainWindow --> HistoryPanel : creates, manages
    MainWindow --> ModeSelector : creates, manages
    MainWindow --> GUIController : delegates to
    InputPanel --> GUIController : calls
    ResultPanel --> GUIController : receives from
    HistoryPanel --> GUIController : queries
    ModeSelector --> InputPanel : notifies
}

' ============================================================================
' MODELS LAYER
' ============================================================================
package "models" #DDEEFF {
    enum Operation {
        ADD
        SUBTRACT
        MULTIPLY
        DIVIDE
        SQUARE
        SQRT
        POWER
        MODULO
        SIN
        COS
        TAN
        LOG
        LN
        EXP
        --
        +from_string(value: str) : Operation
        +display_name() : str
    }

    class MemoryEntry {
        +operation : str
        +operand_a : float
        +operand_b : float
        +result : float | None
        +error : str | None
        +error_type : str | None
        +execution_time_ms : float
        +timestamp : str
        +uuid : str
        --
        +__post_init__() : void
        +to_dict() : dict
        +from_dict(data: dict) : MemoryEntry
        +__str__() : str
    }

    class CalculationResult {
        +operation : str
        +operand_a : float
        +operand_b : float
        +result : float
        +timestamp : str
        +execution_time_ms : float
        --
        +__post_init__() : void
        +to_dict() : dict
        +from_dict(data: dict) : CalculationResult
        +__str__() : str
        ..
        note on right : Legacy; retained for compatibility
    }

    class CalculationStatistics {
        +total_calculations : int
        +total_errors : int
        +error_rate_percent : float
        +operations_count : dict[str, int]
        +average_execution_time_ms : float
        --
        +__post_init__() : void
        ..
        note on right : Aggregated metrics from\\nMemoryEntry history
    }
}

' ============================================================================
' STORAGE LAYER (abstraction + implementations)
' ============================================================================
package "storage" #FFF3CC {
    interface StorageBackend {
        {abstract} +save(entry: MemoryEntry) : void
        {abstract} +load_all() : list[MemoryEntry]
        {abstract} +save_all(entries: list[MemoryEntry]) : void
        ..
        note on right : Abstract interface for persistent\\nstorage of MemoryEntry objects
    }

    class JsonStorage {
        -filepath : Path | str
        --
        +JsonStorage(filepath: Path | str)
        +save(entry: MemoryEntry) : void
        +load_all() : list[MemoryEntry]
        +save_all(entries: list[MemoryEntry]) : void
        -_read_raw() : list
        -_write_raw(records: list) : void
    }

    JsonStorage ..|> StorageBackend : implements
}

' ============================================================================
' MEMORY/HISTORY LAYER (filters + filtering service)
' ============================================================================
package "services.memory" #E5F5E5 {
    interface HistoryFilter {
        {abstract} +apply(entries: list[MemoryEntry]) : list[MemoryEntry]
        ..
        note on right : Abstract interface for\\nhistory filtering strategies
    }

    class OperationFilter {
        -operations : list[str]
        --
        +OperationFilter(operations: list[str])
        +apply(entries: list[MemoryEntry]) : list[MemoryEntry]
        ..
        note on right : Filter by operation name(s)
    }

    class StateFilter {
        -state : str
        --
        +StateFilter(state: str)
        +apply(entries: list[MemoryEntry]) : list[MemoryEntry]
        ..
        note on right : Filter by success/error state
    }

    class CompositeFilter {
        -filters : list[HistoryFilter]
        --
        +CompositeFilter(filters: list[HistoryFilter])
        +apply(entries: list[MemoryEntry]) : list[MemoryEntry]
        ..
        note on right : Compose multiple filters\\napplied sequentially
    }

    OperationFilter ..|> HistoryFilter : implements
    StateFilter ..|> HistoryFilter : implements
    CompositeFilter ..|> HistoryFilter : implements
    CompositeFilter --> HistoryFilter : filters
}

' ============================================================================
' SERVICES LAYER (core business logic)
' ============================================================================
package "services" #DDFFD4 {
    class Calculator {
        +add(a: float, b: float) : float
        +subtract(a: float, b: float) : float
        +multiply(a: float, b: float) : float
        +divide(a: float, b: float) : float
        +square(a: float, b: float) : float
        +sqrt(a: float, b: float) : float
        +power(a: float, b: float) : float
        +modulo(a: float, b: float) : float
        +sin(a: float, b: float) : float
        +cos(a: float, b: float) : float
        +tan(a: float, b: float) : float
        +log(a: float, b: float) : float
        +ln(a: float, b: float) : float
        +exp(a: float, b: float) : float
        +calculate(op: Operation, a: float, b: float) : float
        ..
        note on right : Pure arithmetic engine;\\nno side effects
    }

    class MemoryService {
        -storage : StorageBackend
        --
        +MemoryService(storage: StorageBackend)
        +store(entry: MemoryEntry) : void
        +retrieve() : list[MemoryEntry]
        +filter(filters: list[HistoryFilter] | None,\\noperations: list[str] | None, state: str | None) : list[MemoryEntry]
        +clear() : void
        +filter_by_operation(operation_name: str) : list[MemoryEntry]
        +filter_by_operations(operation_names: list[str]) : list[MemoryEntry]
        +filter_by_state(state: str) : list[MemoryEntry]
        ..
        note on right : Depends on StorageBackend abstraction;\\ndelegate filtering to HistoryFilter;\\nlegacy methods for compatibility
    }

    class CalculatorService {
        -calculator : Calculator
        -memory_service : MemoryService
        --
        +CalculatorService(calculator: Calculator, memory_service: MemoryService)
        +perform(operation: Operation, a: float, b: float) : MemoryEntry
        +get_history() : list[MemoryEntry]
        +filter_history(operations: list[str] | None, state: str | None) : list[MemoryEntry]
        ..
        note on right : Orchestrates calculations;\\nwraps with error handling;\\nsaves via MemoryService
    }

    class StatisticsService {
        -memory_service : MemoryService
        --
        +StatisticsService(memory_service: MemoryService)
        +calculate_statistics() : CalculationStatistics
        ..
        note on right : Computes aggregated metrics\\nfrom MemoryService history
    }

    class ImportExportService {
        -memory_service : MemoryService
        --
        +ImportExportService(memory_service: MemoryService)
        +export_history(filepath: Path|str, entries: list|None) : dict
        +import_history(filepath: Path|str, mode: str) : dict
        -_validate_entry(data: dict) : tuple[bool, str|None]
        -_detect_duplicate(entry: MemoryEntry, existing: list) : bool
        ..
        note on right : Handles JSON export/import;\\nuses memory_service.clear()\\nfor replace mode
    }

    ' Dependencies within services layer
    MemoryService --> "services.memory" : imports filters
    MemoryService --> StorageBackend : depends on
    CalculatorService --> Calculator : uses
    CalculatorService --> MemoryService : uses
    StatisticsService --> MemoryService : uses
    ImportExportService --> MemoryService : uses
}

' ============================================================================
' INTERFACE LAYER (formatters + commands)
' ============================================================================
package "cli.formatters" #FFE5E5 {
    interface OutputFormatter {
        {abstract} +format(data: Any) : str
        ..
        note on right : Abstract interface for\\noutput formatting strategies
    }

    class MemoryEntryFormatter {
        +format(entry: MemoryEntry) : str
    }

    class MemoryEntryListFormatter {
        -entry_formatter : MemoryEntryFormatter | None
        --
        +MemoryEntryListFormatter(entry_formatter: MemoryEntryFormatter | None)
        +format(entries: list[MemoryEntry]) : str
    }

    class StatisticsFormatter {
        +format(stats: CalculationStatistics) : str
    }

    class ImportResultFormatter {
        +format(result: dict) : str
    }

    MemoryEntryFormatter ..|> OutputFormatter : implements
    MemoryEntryListFormatter ..|> OutputFormatter : implements
    StatisticsFormatter ..|> OutputFormatter : implements
    ImportResultFormatter ..|> OutputFormatter : implements
    MemoryEntryListFormatter --> MemoryEntryFormatter : uses
}

package "cli.commands" #FFE5CC {
    interface Command {
        {abstract} +execute() : void
        ..
        note on right : Abstract interface for\\nCLI command execution
    }

    class CalculateCommand {
        -calculator_service : CalculatorService
        -operation_str : str
        -a : float
        -b : float
        --
        +CalculateCommand(calculator_service, operation_str, a, b)
        +execute() : void
    }

    class HistoryCommand {
        -memory_service : MemoryService
        -formatter : OutputFormatter | None
        -filters : list[HistoryFilter] | None
        --
        +HistoryCommand(memory_service, formatter, filters)
        +execute() : void
    }

    class StatisticsCommand {
        -statistics_service : StatisticsService
        -formatter : OutputFormatter | None
        --
        +StatisticsCommand(statistics_service, formatter)
        +execute() : void
    }

    class ExportCommand {
        -import_export_service : ImportExportService
        -filepath : str
        -exit_on_error : bool
        --
        +ExportCommand(import_export_service, filepath, exit_on_error)
        +execute() : void
    }

    class ImportCommand {
        -import_export_service : ImportExportService
        -filepath : str
        -mode : str
        -formatter : OutputFormatter | None
        -exit_on_error : bool
        --
        +ImportCommand(import_export_service, filepath, mode, formatter, exit_on_error)
        +execute() : void
    }

    class FilterCommand {
        -memory_service : MemoryService
        -filters : list[HistoryFilter]
        -formatter : OutputFormatter | None
        --
        +FilterCommand(memory_service, filters, formatter)
        +execute() : void
    }

    CalculateCommand ..|> Command : implements
    HistoryCommand ..|> Command : implements
    StatisticsCommand ..|> Command : implements
    ExportCommand ..|> Command : implements
    ImportCommand ..|> Command : implements
    FilterCommand ..|> Command : implements

    ' Command dependencies
    CalculateCommand --> CalculatorService : uses
    HistoryCommand --> MemoryService : uses
    HistoryCommand --> OutputFormatter : uses
    HistoryCommand --> HistoryFilter : uses
    StatisticsCommand --> StatisticsService : uses
    StatisticsCommand --> OutputFormatter : uses
    ExportCommand --> ImportExportService : uses
    ImportCommand --> ImportExportService : uses
    ImportCommand --> OutputFormatter : uses
    FilterCommand --> MemoryService : uses
    FilterCommand --> HistoryFilter : uses
    FilterCommand --> OutputFormatter : uses
}

package "cli" #FFE5E5 {
    class CalculatorCLI {
        -_MENU : list[tuple[Operation, str]]
        -service : CalculatorService
        -statistics_service : StatisticsService
        -import_export_service : ImportExportService | None
        -memory_service : MemoryService | None
        -memory_formatter : MemoryEntryListFormatter
        -statistics_formatter : StatisticsFormatter
        -import_formatter : ImportResultFormatter
        --
        +CalculatorCLI(service, statistics_service, import_export_service, memory_service)
        +run_interactive() : void
        +run_command(operation_str: str, a: float, b: float) : void
        -_show_history() : void
        -_run_filter_menu() : void
        -_show_filtered_history(operations, state) : void
        -_show_statistics() : void
        -_export_history() : void
        -_import_history(filepath, mode) : void
        ..
        note on right : Orchestrates commands and formatters;\\nroutes user input to appropriate handlers
    }

    CalculatorCLI --> CalculatorService : uses
    CalculatorCLI --> StatisticsService : uses
    CalculatorCLI --> ImportExportService : uses
    CalculatorCLI --> MemoryService : uses
    CalculatorCLI --> MemoryEntryListFormatter : uses
    CalculatorCLI --> StatisticsFormatter : uses
    CalculatorCLI --> ImportResultFormatter : uses
    CalculatorCLI --> HistoryCommand : creates/executes
    CalculatorCLI --> FilterCommand : creates/executes
    CalculatorCLI --> StatisticsCommand : creates/executes
    CalculatorCLI --> ExportCommand : creates/executes
    CalculatorCLI --> ImportCommand : creates/executes
}

' ============================================================================
' DEPENDENCY DIAGRAM (model interactions)
' ============================================================================

' Model usage
CalculatorService ..> Operation : uses
CalculatorService ..> MemoryEntry : creates, returns
StatisticsService ..> CalculationStatistics : creates, returns
ImportExportService ..> MemoryEntry : processes
Calculator ..> Operation : uses
MemoryService ..> MemoryEntry : stores, retrieves
JsonStorage ..> MemoryEntry : persists, loads

' GUI model usage
GUIController ..> MemoryEntry : returns
GUIController ..> CalculationStatistics : returns
InputPanel ..> MemoryEntry : receives
ResultPanel ..> MemoryEntry : displays
HistoryPanel ..> MemoryEntry : displays

@enduml
