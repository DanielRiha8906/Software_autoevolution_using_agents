@startuml

start
:Launch application;

repeat
  :Display task list + main menu;
  :Wait for user input;

  switch (choice)
    case (1 — List/filter)
      :Display filter submenu;
      repeat
        :Show filter options:
        - Status
        - Due date range
        - Week (YYYY-Www)
        - Month (YYYY-MM)
        - Year (YYYY)
        - Overdue only;
        :Wait for filter choice;
        switch (filter)
          case (status)
            :Pick status filter;
          case (due date range)
            :Parse before/after dates;
          case (week)
            :Parse YYYY-Www format;
            :Get week boundaries;
            :List tasks in week;
          case (month)
            :Parse YYYY-MM format;
            :Get month boundaries;
            :List tasks in month;
          case (year)
            :Parse YYYY format;
            :Get year boundaries;
            :List tasks in year;
          case (overdue)
            :Toggle overdue filter;
          case (view results)
            :Apply all filters;
            :Display filtered task list;
        endswitch
      repeat while (not back)
    case (2 — Add task)
      :Run add task flow;
    case (3 — Show details)
      :Run show details flow;
    case (4 — Change status)
      :Run change status flow;
    case (5 — Update task)
      :Run update task flow;
    case (6 — Set due date)
      :Run set due date flow;
    case (7 — Delete task)
      :Run delete task flow;
    case (8 — Manage projects)
      :Run manage projects flow;
    case (9 — Manage comments)
      :Run manage comments flow;
    case (0/q — Quit)
      :Clear screen;
      stop
    case (other)
      :Show unknown option;
  endswitch

repeat while (user continues)

@enduml