@startuml class_diagram

skinparam classAttributeIconSize 0
skinparam classFontStyle bold

package "models" #DDEEFF {
    enum TaskStatus {
        PENDING
        IN_PROGRESS
        DONE
    }

    class Task {
        +id : String
        +title : String
        +description : String [0..1]
        +status : TaskStatus
        +created_at : DateTime
        +updated_at : DateTime
        +due_date : DateTime [0..1]
        +comments : List<TaskComment>
        --
        +__post_init__() : void
        +is_pending() : boolean
        +is_in_progress() : boolean
        +is_completed() : boolean
        +is_overdue() : boolean
        +mark_in_progress() : Task
        +mark_done() : Task
        +reopen() : Task
        +to_dict() : Dictionary
        +from_dict(data: Dictionary) : Task
    }

    class TaskComment {
        +id : String
        +task_id : String
        +content : String
        +created_at : DateTime
        +author : String [0..1]
        +updated_at : DateTime [0..1]
        --
        +__post_init__() : void
        +to_dict() : Dictionary
        +from_dict(data: Dictionary) : TaskComment
    }
}

package "storage" #FFF3CC {
    class JsonStorage {
        -path : String
        --
        +JsonStorage(path: String [0..1])
        +load() : List<Dictionary>
        +save(tasks: List<Dictionary>) : void
    }
}

package "services" #DDFFD4 {
    exception TaskNotFoundError

    class TaskManager {
        -storage : JsonStorage
        -tasks : Dictionary<String, Task>
        --
        +TaskManager(storage: JsonStorage [0..1])
        +add(title: String, description: String [0..1], due_date: DateTime [0..1]) : Task
        +get(task_id: String) : Task
        +list_all() : List<Task>
        +list_by_status(status: TaskStatus) : List<Task>
        +update(task_id: String, title: String [0..1], description: String [0..1], due_date: DateTime [0..1]) : Task
        +set_status(task_id: String, status: TaskStatus) : Task
        +set_due_date(task_id: String, due_date: DateTime [0..1]) : Task
        +delete(task_id: String) : void
        +add_comment(task_id: String, content: String, author: String [0..1]) : TaskComment
        +get_comments(task_id: String) : List<TaskComment>
        +delete_comment(task_id: String, comment_id: String) : void
        +edit_comment(task_id: String, comment_id: String, content: String) : TaskComment
        -load() : void
        -persist() : void
    }

    class TodoService {
        -manager : TaskManager
        --
        +TodoService(storage: JsonStorage [0..1])
        +add_task(title: String, description: String [0..1], due_date: DateTime [0..1]) : Task
        +get_task(task_id: String) : Task
        +list_tasks(status: TaskStatus [0..1]) : List<Task>
        +start_task(task_id: String) : Task
        +complete_task(task_id: String) : Task
        +reopen_task(task_id: String) : Task
        +update_task(task_id: String, title: String [0..1], description: String [0..1], due_date: DateTime [0..1]) : Task
        +set_due_date(task_id: String, due_date: DateTime [0..1]) : Task
        +delete_task(task_id: String) : void
        +add_comment(task_id: String, content: String, author: String [0..1]) : TaskComment
        +get_comments(task_id: String) : List<TaskComment>
        +delete_comment(task_id: String, comment_id: String) : void
        +edit_comment(task_id: String, comment_id: String, content: String) : TaskComment
    }
}

package "cli" #FFE5E5 {
    class TodoCLI {
        -service : TodoService
        --
        +TodoCLI(storagePath: String [0..1])
        +run(argv: List<String> [0..1]) : Integer
    }

    class InteractiveMenu {
        -service : TodoService
        --
        +InteractiveMenu(storagePath: String [0..1])
        +run() : void
    }
}

Task --> TaskStatus : status
Task *-- TaskComment : comments
TaskManager --> JsonStorage : storage
TaskManager ..> TaskNotFoundError : raises
TodoService --> TaskManager : manager
TodoCLI --> TodoService : service
InteractiveMenu --> TodoService : service

@enduml