@startuml class_diagram

!define PUBLIC_COLOR DDFFD4
!define INTERNAL_COLOR D4E8D4
!define MODELS_COLOR DDEEFF
!define STORAGE_COLOR FFF3CC
!define INTERFACE_COLOR FFE5E5

skinparam classAttributeIconSize 0
skinparam classFontStyle bold
skinparam noteBkgColor FFFFCC
skinparam noteTextColor 333333

note top of Task
  Phase 1: Layer Separation
  Only TodoService is public from services.
  Models and Storage have no internal dependencies.
end note

package "DOMAIN MODELS" #MODELS_COLOR {
    enum TaskStatus {
        PENDING
        IN_PROGRESS
        DONE
    }

    class Task {
        +id : String
        +title : String
        +description : String [0..1]
        +status : TaskStatus
        +created_at : DateTime
        +updated_at : DateTime
        +due_date : DateTime [0..1]
        +comments : List<TaskComment>
        +project_id : String [0..1]
        --
        +__post_init__() : void
        +is_pending() : boolean
        +is_in_progress() : boolean
        +is_completed() : boolean
        +is_overdue() : boolean
        +mark_in_progress() : Task
        +mark_done() : Task
        +reopen() : Task
        +to_dict() : Dictionary
        +from_dict(data: Dictionary) : Task
    }

    class TaskComment {
        +id : String
        +task_id : String
        +content : String
        +created_at : DateTime
        +author : String [0..1]
        +updated_at : DateTime [0..1]
        --
        +__post_init__() : void
        +to_dict() : Dictionary
        +from_dict(data: Dictionary) : TaskComment
    }

    class Project {
        +id : String
        +name : String
        --
        +__post_init__() : void
        +to_dict() : Dictionary
        +from_dict(data: Dictionary) : Project
    }

    class TaskSummaryReport {
        +total_count : int
        +pending_count : int
        +in_progress_count : int
        +done_count : int
        +overdue_count : int
        +due_date_set_count : int
        +completion_rate : float
        +avg_days_to_completion : float [0..1]
    }
}

package "PERSISTENCE LAYER" #STORAGE_COLOR {
    class JsonStorage {
        -path : String
        --
        +JsonStorage(path: String [0..1])
        +load() : List<Dictionary>
        +save(tasks: List<Dictionary>) : void
    }
}

package "SERVICE LAYER (Internal)" #INTERNAL_COLOR {
    note bottom of ServiceError
        Exception hierarchy - base
        for all service errors
    end note

    exception ServiceError {
        Base exception for service layer
    }

    exception TaskNotFoundError extends ServiceError
    exception ProjectNotFoundError extends ServiceError

    class ImportValidator {
        --
        +validate_file(file_path: String) : Tuple<List<Dictionary>, List<Dictionary>>
        +{static} validate_task_dict(task_dict: Dictionary, index: Integer) : String [0..1]
    }

    class TaskManager {
        -storage : JsonStorage
        -tasks : Dictionary<String, Task>
        --
        +TaskManager(storage: JsonStorage [0..1])
        +add(title: String, description: String [0..1], due_date: DateTime [0..1]) : Task
        +get(task_id: String) : Task
        +list_all() : List<Task>
        +list_by_status(status: TaskStatus) : List<Task>
        +list_by_project(project_id: String) : List<Task>
        +list_by_due_date_range(before: DateTime [0..1], after: DateTime [0..1], status: TaskStatus [0..1], overdue_only: Boolean) : List<Task>
        +get_week_boundaries(year: Integer, week: Integer) : Tuple<DateTime, DateTime>
        +get_month_boundaries(year: Integer, month: Integer) : Tuple<DateTime, DateTime>
        +get_year_boundaries(year: Integer) : Tuple<DateTime, DateTime>
        +update(task_id: String, title: String [0..1], description: String [0..1], due_date: DateTime [0..1]) : Task
        +set_status(task_id: String, status: TaskStatus) : Task
        +set_due_date(task_id: String, due_date: DateTime [0..1]) : Task
        +set_project(task_id: String, project_id: String [0..1]) : Task
        +set_task(task_id: String, task: Task) : void
        +delete(task_id: String) : void
        +orphan_project_tasks(project_id: String) : Integer
        +add_comment(task_id: String, content: String, author: String [0..1]) : TaskComment
        +get_comments(task_id: String) : List<TaskComment>
        +delete_comment(task_id: String, comment_id: String) : void
        +edit_comment(task_id: String, comment_id: String, content: String) : TaskComment
        -load() : void
        -persist() : void
    }

    class ProjectManager {
        -storage : JsonStorage
        -projects : Dictionary<String, Project>
        --
        +ProjectManager(storage: JsonStorage [0..1])
        +add(name: String) : Project
        +get(project_id: String) : Project
        +list_all() : List<Project>
        +delete(project_id: String) : void
        -load() : void
        -persist() : void
    }
}

package "SERVICE LAYER (Public)" #PUBLIC_COLOR {
    class TodoService {
        -manager : TaskManager
        -project_manager : ProjectManager
        --
        +TodoService(storage: JsonStorage [0..1])
        +add_task(title: String, description: String [0..1], due_date: DateTime [0..1]) : Task
        +get_task(task_id: String) : Task
        +list_tasks(status: TaskStatus [0..1], before: DateTime [0..1], after: DateTime [0..1], overdue_only: Boolean) : List<Task>
        +list_tasks_by_week(year: Integer, week: Integer, status: TaskStatus [0..1]) : List<Task>
        +list_tasks_by_month(year: Integer, month: Integer, status: TaskStatus [0..1]) : List<Task>
        +list_tasks_by_year(year: Integer, status: TaskStatus [0..1]) : List<Task>
        +list_tasks_by_project(project_id: String) : List<Task>
        +create_project(name: String) : Project
        +list_projects() : List<Project>
        +get_project(project_id: String) : Project
        +delete_project(project_id: String) : void
        +move_task_to_project(task_id: String, project_id: String [0..1]) : Task
        +start_task(task_id: String) : Task
        +complete_task(task_id: String) : Task
        +reopen_task(task_id: String) : Task
        +update_task(task_id: String, title: String [0..1], description: String [0..1], due_date: DateTime [0..1]) : Task
        +set_due_date(task_id: String, due_date: DateTime [0..1]) : Task
        +delete_task(task_id: String) : void
        +add_comment(task_id: String, content: String, author: String [0..1]) : TaskComment
        +get_comments(task_id: String) : List<TaskComment>
        +delete_comment(task_id: String, comment_id: String) : void
        +edit_comment(task_id: String, comment_id: String, content: String) : TaskComment
        +generate_report() : TaskSummaryReport
        +export_tasks(file_path: String [0..1]) : Integer
        +import_tasks(file_path: String, duplicate_strategy: String) : Dictionary
    }
}

package "INTERFACE LAYER" #INTERFACE_COLOR {
    class TodoCLI {
        -service : TodoService
        --
        +TodoCLI(storagePath: String [0..1])
        +run(argv: List<String> [0..1]) : Integer
        -_parse_and_list_by_week(week: String, status: TaskStatus [0..1]) : List<Task>
        -_parse_and_list_by_month(month: String, status: TaskStatus [0..1]) : List<Task>
        -_parse_and_list_by_year(year: String, status: TaskStatus [0..1]) : List<Task>
        -_cmd_report(args: Namespace) : Integer
        -_cmd_export(args: Namespace) : Integer
        -_cmd_import(args: Namespace) : Integer
    }

    class InteractiveMenu {
        -service : TodoService
        --
        +InteractiveMenu(storagePath: String [0..1])
        +run() : void
        -_do_list() : void
        -_do_pick_due_date_range() : Tuple<DateTime [0..1], DateTime [0..1]>
        -_do_pick_week(status: TaskStatus [0..1]) : List<Task> [0..1]
        -_do_pick_month(status: TaskStatus [0..1]) : List<Task> [0..1]
        -_do_pick_year(status: TaskStatus [0..1]) : List<Task> [0..1]
        -_display_task_list_with_summary(tasks: List<Task>, status: TaskStatus [0..1], before: DateTime [0..1], after: DateTime [0..1], overdue_only: Boolean) : void
        -_do_report() : void
        -_do_export() : void
        -_do_import() : void
    }
}

note bottom of TodoCLI
  Interface layer imports:
  - TodoService (public API)
  - Exceptions from services
  - Models for type hints only
end note

Task --> TaskStatus : status
Task *-- TaskComment : comments
Task --> Project : project_id [0..1]

TodoService --> TaskSummaryReport : generates
TodoService --> TaskManager : <<internal>>
TodoService --> ProjectManager : <<internal>>
TodoService --> ImportValidator : <<internal>>

TaskManager --> JsonStorage : imports
TaskManager --> Task : manages
TaskManager --> TaskComment : manages
TaskManager ..> TaskNotFoundError : raises

ProjectManager --> JsonStorage : imports
ProjectManager --> Project : manages
ProjectManager ..> ProjectNotFoundError : raises

ServiceError <|-- TaskNotFoundError
ServiceError <|-- ProjectNotFoundError

TodoCLI --> TodoService : imports
TodoCLI --> TaskNotFoundError : catches
TodoCLI --> ProjectNotFoundError : catches

InteractiveMenu --> TodoService : imports
InteractiveMenu --> TaskNotFoundError : catches
InteractiveMenu --> ProjectNotFoundError : catches

@enduml