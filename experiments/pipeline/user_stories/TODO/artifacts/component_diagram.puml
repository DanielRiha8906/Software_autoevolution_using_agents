@startuml component_diagram

skinparam componentStyle uml2
skinparam defaultFontSize 13
skinparam noteBkgColor FFFFCC
skinparam noteTextColor 333333

left to right direction

package "TODO Application" {

    component "Entry Point\n(main)" as Main

    package "INTERFACE LAYER\n(Public: TodoService only)" <<boundary>> {
        component "Interactive Menu" as IM
        component "Command-line Interface\n(TodoCLI)" as CLI

        package "GUI Layer (tkinter)" {
            component "Main Window\n(MainWindow)" as MainWin
            component "Filter Frame\n(FilterFrame)" as FilterFrm
            component "Task List Frame\n(TaskListFrame)" as TaskListFrm
            component "Task Details Frame\n(TaskDetailsFrame)" as TaskDetailsFrm
            component "Action Buttons\n(ActionButtonFrame)" as ActionBtn
            component "Add Task Dialog\n(AddTaskDialog)" as AddDlg
            component "Edit Task Dialog\n(EditTaskDialog)" as EditDlg
            component "Comment Dialog\n(CommentDialog)" as CommentDlg
        }

        component "GUI Application\n(TodoGUI)" as GUI
    }

    package "SERVICE LAYER\n(Public: TodoService | Internal: TaskManager, ProjectManager, exceptions)" <<boundary>> {
        component "Todo Service\n[PUBLIC API]" as SVC

        package "INTERNAL" {
            component "Task Manager" as MGR
            component "Project Manager" as PMGR
            component "Date Filtering\n(week, month, year boundaries)" as DateFilter
            component "Comment Management\n(add, view, edit, delete)" as CMT
            component "Project Assignment\n(assign, list by project)" as ProjectAssign
            component "Report Generation\n(summary statistics)" as Report
            component "Import Validator\n(validate JSON files)" as ImportVal
            component "Exception Hierarchy\n(ServiceError base,\nTaskNotFoundError,\nProjectNotFoundError)" as Exceptions
        }
    }

    package "DOMAIN MODELS\n(No internal dependencies)" <<boundary>> {
        component "Task Model\n(Task, TaskStatus)" as Model
        component "Project Model\n(Project)" as ProjectModel
        component "Task Comment Model\n(TaskComment)" as CommentModel
        component "Summary Report Model\n(TaskSummaryReport)" as ReportModel
    }

    package "PERSISTENCE LAYER\n(No internal dependencies)" <<boundary>> {
        component "JSON Storage\n(JsonStorage)" as Storage
    }
}

database "todo_data.json" as DB

note bottom of SVC
    Phase 1: Layer Separation
    - Only TodoService exported from services
    - TaskManager, ProjectManager internal
    - All exceptions in dedicated module
    - Clear dependency boundaries

    Task 10: GUI Layer Added
    - New GUI component alongside CLI
    - 9 classes: TodoGUI + MainWindow + 6 frames/dialogs
    - All GUI components use TodoService
    - Real-time filtering and state management
end note

Main --> IM : interactive mode
Main --> CLI : command mode
Main --> GUI : gui flag (--gui)

IM --> SVC : public API
CLI --> SVC : public API
GUI --> SVC : public API

GUI --> MainWin : creates
MainWin --> FilterFrm : contains
MainWin --> TaskListFrm : contains
MainWin --> TaskDetailsFrm : contains
MainWin --> ActionBtn : contains

FilterFrm --> SVC : lists projects
TaskListFrm --> SVC : lists tasks
TaskDetailsFrm --> SVC : gets task, comments
ActionBtn --> SVC : modifies tasks
ActionBtn --> AddDlg : creates dialog
ActionBtn --> EditDlg : creates dialog
TaskDetailsFrm --> CommentDlg : creates dialog

SVC --> MGR : internal
SVC --> PMGR : internal
SVC --> Exceptions : internal

MGR --> DateFilter : internal
MGR --> CMT : internal
MGR --> ProjectAssign : internal
MGR --> Report : internal

ProjectAssign --> PMGR : internal

MGR --> Storage : imports
PMGR --> Storage : imports

MGR ..> Model : uses
MGR ..> CommentModel : uses
PMGR ..> ProjectModel : uses
CMT ..> CommentModel : uses
Report ..> ReportModel : uses
Report ..> MGR : internal
ImportVal ..> MGR : internal

Storage --> DB : read/write

@enduml