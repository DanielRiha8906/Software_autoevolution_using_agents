@startuml activity_diagram_interactive

skinparam activityBackgroundColor #DDEEFF
skinparam activityBorderColor     #3366AA
skinparam activityDiamondBackgroundColor #FFF3CC

start

:Display interactive menu;

repeat

  :Wait for user selection;

  switch (choice)

    case (1 — Add workflow run)
      :Prompt workflow name;
      :Prompt branch;
      :Choose status from list;
      :Choose conclusion (optional, 0 to skip);
      :Prompt run number (optional);
      :Prompt commit SHA (optional);
      :Prompt duration in seconds;
      :WorkflowRunTracker.track();
      :Print "Added run <id>";

    case (2 — List all runs)
      :WorkflowRunService.list_runs();
      if (no runs?) then (yes)
        :Print "No runs recorded.";
      else (no)
        :Print all runs;
      endif

    case (3 — Get run detail)
      :Prompt run ID;
      :WorkflowRunService.get_run_detail(run_id);
      if (found?) then (yes)
        :Print run details;
      else (no)
        :Print "No run found with id '<id>'";
      endif

    case (4 — Check run state)
      :Prompt run ID;
      :WorkflowRunService.get_run_detail(run_id);
      if (found?) then (yes)
        :Print is_terminal, is_successful,\nis_failed, is_running, is_cancelled;
      else (no)
        :Print "No run found with id '<id>'";
      endif

    case (5 — Filter runs)
      :Choose filter type\n(branch / status / conclusion);
      if (branch?) then (yes)
        :Prompt branch name;
        :filter_by_branch();
      elseif (status?) then (yes)
        :Choose status from list;
        :filter_by_status();
      else (conclusion)
        :Choose conclusion from list;
        :filter_by_conclusion();
      endif
      if (no matches?) then (yes)
        :Print "No matching runs.";
      else (no)
        :Print matching runs;
      endif

    case (6 — Advanced filter runs)
      :Optional branch filter;
      :Optional status filter;
      :Optional conclusion filter;
      :Optional created-after date filter;
      :Optional created-before date filter;
      :Optional duration-min filter;
      :Optional duration-max filter;
      :Optional attempt presence filter;
      :service.query() with all selected filters;
      if (no matches?) then (yes)
        :Print "No matching runs.";
      else (no)
        :Print matching runs;
      endif

    case (7 — Get statistics)
      :Optional branch filter;
      :Optional status filter;
      :Optional conclusion filter;
      :Optional created-after date filter;
      :Optional created-before date filter;
      :Optional duration-min filter;
      :Optional duration-max filter;
      :Optional attempt presence filter;
      :service.query() with all selected filters;
      :StatisticsService.calculate_statistics();
      :Print count_by_conclusion;
      :Print average_duration_seconds;
      :Print average_attempts_per_run;
      :Print min/max duration;
      :Print duration_by_status;

    case (8 — Add workflow run attempt)
      :Prompt attempt ID (integer);
      :Prompt parent run ID (integer);
      :Prompt attempt number (positive integer);
      :Prompt status;
      :Prompt conclusion (optional);
      :Prompt duration in seconds;
      :WorkflowRunAttemptService.add_attempt();
      :Print "Added attempt <id>";

    case (9 — List all attempts)
      :Choose "Sort by attempt number?";
      :WorkflowRunAttemptService.list_attempts(sorted=choice);
      if (no attempts?) then (yes)
        :Print "No attempts recorded.";
      else (no)
        :Print all attempts;
      endif

    case (10 — Get attempt detail)
      :Prompt attempt ID;
      :WorkflowRunAttemptService.get_attempt(attempt_id);
      if (found?) then (yes)
        :Print attempt details;
      else (no)
        :Print "No attempt found with id <id>";
      endif

    case (11 — List attempts for run)
      :Prompt parent run ID;
      :Choose "Sort by attempt number?";
      :WorkflowRunAttemptService.get_attempts_for_run(run_id, sorted=choice);
      if (no attempts?) then (yes)
        :Print "No attempts found for run <id>.";
      else (no)
        :Print attempts for run;
      endif

    case (12 — Exit)
      :Print "Goodbye.";
      stop

  endswitch

repeat while (user continues)

@enduml
