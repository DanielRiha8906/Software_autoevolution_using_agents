@startuml component_diagram

skinparam componentStyle rectangle
skinparam linetype ortho
top to bottom direction

package "GitHub Workflow Manager" {

  package "Application entrypoint" {
    component "main" as MAIN
  }

  package "Interface layer (CLI)" {
    component "workflow_cli" as CLI
    component "interactive_menu" as IM
  }

  package "Interface layer (GUI)" {
    component "WorkflowRunMainWindow" as GUI_MAIN
    component "WorkflowRunDetailsDialog" as GUI_DETAILS
    component "WorkflowRunEditDialog" as GUI_EDIT
  }

  package "Service layer" {
    component "WorkflowRunTracker" as TRACKER
    component "WorkflowRunService" as SVC
    component "WorkflowRunAttemptService" as ATTEMPT_SVC
    component "StatisticsService" as STATS_SVC
    component "WorkflowRunExportImportService" as EXPORT_SVC
  }

  package "GitHub Adapter layer" {
    component "WorkflowFetcher (protocol)" as FETCHER_PROTO
    component "GitHubAPIFetcher" as API_FETCH
    component "GitHubCLIFetcher" as CLI_FETCH
    component "GitHubWorkflowRunFactory" as GH_FACTORY
    component "GitHubAuthManager" as AUTH_MGR
    component "GitHub Exceptions" as GH_ERRORS
  }

  package "Storage abstraction layer" {
    component "WorkflowRunStorage (protocol)" as STORAGE_PROTO
    component "WorkflowRunAttemptStorage (protocol)" as ATTEMPT_STORAGE_PROTO
    component "WorkflowJsonStorage (impl)" as STOR
    artifact "workflow_runs.json" as JSON_FILE
    artifact "workflow_run_attempts.json" as ATTEMPTS_FILE
  }

  package "Domain model" {
    component "WorkflowRun" as RUN
    component "WorkflowRunAttempt" as ATTEMPT
    component "WorkflowStatus" as STATUS
    component "WorkflowConclusion" as CONCLUSION
    component "StatisticsReport" as REPORT
    component "ImportResult" as IMPORT_RESULT
  }
}

MAIN --> CLI
MAIN --> IM
MAIN --> GUI_MAIN : with --gui flag

CLI --> TRACKER
IM --> TRACKER

CLI --> SVC
IM --> SVC
GUI_MAIN --> SVC

CLI --> ATTEMPT_SVC
IM --> ATTEMPT_SVC
GUI_MAIN --> ATTEMPT_SVC

CLI --> STATS_SVC
IM --> STATS_SVC

CLI --> EXPORT_SVC
IM --> EXPORT_SVC

GUI_MAIN --> GUI_DETAILS : creates
GUI_MAIN --> GUI_EDIT : creates
GUI_DETAILS --> ATTEMPT_SVC
GUI_EDIT --> SVC

CLI --> API_FETCH
IM --> API_FETCH
CLI --> CLI_FETCH
IM --> CLI_FETCH

API_FETCH ..|> FETCHER_PROTO
CLI_FETCH ..|> FETCHER_PROTO

API_FETCH --> AUTH_MGR
API_FETCH --> GH_FACTORY
CLI_FETCH --> GH_FACTORY

API_FETCH --> SVC
CLI_FETCH --> SVC

API_FETCH ..> GH_ERRORS
CLI_FETCH ..> GH_ERRORS

AUTH_MGR ..> GH_ERRORS

TRACKER --> SVC
SVC ..|> STORAGE_PROTO
ATTEMPT_SVC ..|> ATTEMPT_STORAGE_PROTO

STOR ..|> STORAGE_PROTO
STOR ..|> ATTEMPT_STORAGE_PROTO
STOR --> JSON_FILE
STOR --> ATTEMPTS_FILE

EXPORT_SVC --> SVC
EXPORT_SVC --> ATTEMPT_SVC
EXPORT_SVC --> JSON_FILE
EXPORT_SVC --> ATTEMPTS_FILE

SVC ..> RUN
ATTEMPT_SVC ..> ATTEMPT
STATS_SVC ..> REPORT
EXPORT_SVC ..> IMPORT_RESULT
GH_FACTORY ..> RUN
RUN --> STATUS
RUN --> CONCLUSION
RUN "1" --> "N" ATTEMPT : relationship

note right of STORAGE_PROTO
  **Dependency Inversion Pattern**
  Services depend on protocols,
  not concrete implementations
end note

@enduml
