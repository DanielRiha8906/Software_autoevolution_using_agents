@startuml activity_diagram_main

skinparam activityBackgroundColor #DDEEFF
skinparam activityBorderColor     #3366AA
skinparam activityDiamondBackgroundColor #FFF3CC

start

:Load WorkflowJsonStorage\n& WorkflowRunService;

if (CLI arguments provided?) then (yes)
  :Parse args with argparse;
  switch (subcommand)

    case (add)
      :Read name, branch, status,\nconclusion, run-number, commit-sha,\nduration-seconds;
      :WorkflowRunTracker.track();
      :Print "Added run <id>";

    case (list)
      :WorkflowRunService.list_runs();
      if (--branch?) then (yes)
        :filter_by_branch();
      elseif (--status?) then (yes)
        :filter_by_status();
      elseif (--conclusion?) then (yes)
        :filter_by_conclusion();
      endif
      if (no runs?) then (yes)
        :Print "No runs found.";
      else (no)
        :Print formatted run list;
      endif

    case (detail)
      :WorkflowRunService.get_run_detail(run_id);
      if (run found?) then (yes)
        :Print run details;
      else (no)
        :Print error to stderr;
        :Exit code 1;
      endif

    case (check)
      :WorkflowRunService.get_run_detail(run_id);
      if (run found?) then (yes)
        if (state flag specified?) then (yes)
          :Print queried state\n(is_terminal / is_successful /\nis_failed / is_running / is_cancelled);
        else (no)
          :Print all states;
        endif
      else (no)
        :Print error to stderr;
        :Exit code 1;
      endif

    case (attempt-add)
      :Read attempt ID, run ID, attempt number,\nstatus, conclusion, duration-seconds;
      :WorkflowRunAttemptService.add_attempt();
      :Print "Added attempt <id>";

    case (attempt-list)
      :Determine sorted_param\n(not --no-sort flag);
      if (--run-id specified?) then (yes)
        :WorkflowRunAttemptService.get_attempts_for_run(\nrun_id, sorted=sorted_param);
      else (no)
        :WorkflowRunAttemptService.list_attempts(\nsorted=sorted_param);
      endif
      if (no attempts?) then (yes)
        :Print "No attempts found.";
      else (no)
        :Print formatted attempt list;
      endif

    case (attempt-detail)
      :WorkflowRunAttemptService.get_attempt(attempt_id);
      if (attempt found?) then (yes)
        :Print attempt details;
      else (no)
        :Print error to stderr;
        :Exit code 1;
      endif

  endswitch
  stop

else (no)
  :Launch interactive menu\n(see activity_diagram_interactive);
  stop
endif

@enduml
