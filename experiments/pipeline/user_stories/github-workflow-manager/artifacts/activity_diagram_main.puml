@startuml activity_diagram_main

skinparam activityBackgroundColor #DDEEFF
skinparam activityBorderColor     #3366AA
skinparam activityDiamondBackgroundColor #FFF3CC

start

:Load WorkflowJsonStorage\n& WorkflowRunService;

if (CLI arguments provided?) then (yes)
  :Parse args with argparse;
  switch (subcommand)

    case (add)
      :Read name, branch, status,\nconclusion, run-number, commit-sha,\nduration-seconds;
      :WorkflowRunTracker.track();
      :Print "Added run <id>";

    case (list)
      :Parse datetime and duration args;
      if (--has-attempts and --no-attempts?) then (yes)
        :Print error: mutually exclusive;
        :Exit code 1;
      endif
      :service.query() with all filters\n(branch, status, conclusion, created-after,\ncreated-before, duration-min,\nduration-max, has-attempts);
      if (no runs?) then (yes)
        :Print "No runs found.";
      else (no)
        :Print formatted run list;
      endif

    case (detail)
      :WorkflowRunService.get_run_detail(run_id);
      if (run found?) then (yes)
        :Print run details;
      else (no)
        :Print error to stderr;
        :Exit code 1;
      endif

    case (check)
      :WorkflowRunService.get_run_detail(run_id);
      if (run found?) then (yes)
        if (state flag specified?) then (yes)
          :Print queried state\n(is_terminal / is_successful /\nis_failed / is_running / is_cancelled);
        else (no)
          :Print all states;
        endif
      else (no)
        :Print error to stderr;
        :Exit code 1;
      endif

    case (attempt-add)
      :Read attempt ID, run ID, attempt number,\nstatus, conclusion, duration-seconds;
      :WorkflowRunAttemptService.add_attempt();
      :Print "Added attempt <id>";

    case (attempt-list)
      :Determine sorted_param\n(not --no-sort flag);
      if (--run-id specified?) then (yes)
        :WorkflowRunAttemptService.get_attempts_for_run(\nrun_id, sorted=sorted_param);
      else (no)
        :WorkflowRunAttemptService.list_attempts(\nsorted=sorted_param);
      endif
      if (no attempts?) then (yes)
        :Print "No attempts found.";
      else (no)
        :Print formatted attempt list;
      endif

    case (attempt-detail)
      :WorkflowRunAttemptService.get_attempt(attempt_id);
      if (attempt found?) then (yes)
        :Print attempt details;
      else (no)
        :Print error to stderr;
        :Exit code 1;
      endif

    case (stats)
      :Parse datetime and duration args;
      if (--has-attempts and --no-attempts?) then (yes)
        :Print error: mutually exclusive;
        :Exit code 1;
      endif
      :service.query() with all filters\n(branch, status, conclusion, created-after,\ncreated-before, duration-min,\nduration-max, has-attempts);
      :StatisticsService.calculate_statistics();
      :Print statistics report\n(count_by_conclusion, average_duration,\naverage_attempts, min/max duration,\nduration_by_status);

    case (export)
      :Parse --filepath argument;
      :Determine --include-attempts flag;
      :WorkflowRunExportImportService.export_to_file();
      :Write runs to filepath (JSON);
      if (include-attempts?) then (yes)
        :Write attempts to filepath_attempts.json;
      endif
      :Print "Exported <count> run(s) to <filepath>";

    case (import)
      :Parse --filepath, --overwrite, --dry-run args;
      :WorkflowRunExportImportService.import_from_file();
      :Validate JSON structure;
      :For each record: validate_and_build_run();
      :For each record: validate_and_build_attempt();
      if (dry-run?) then (yes)
        :Skip persist (validation only);
      else (no)
        :Persist imported runs and attempts;
      endif
      :Print ImportResult\n(total_records, imported_runs, skipped_runs,\nimported_attempts, skipped_attempts, errors);

  endswitch
  stop

else (no)
  :Launch interactive menu\n(see activity_diagram_interactive);
  stop
endif

@enduml
