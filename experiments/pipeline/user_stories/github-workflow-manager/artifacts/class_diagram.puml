@startuml class_diagram

skinparam classAttributeIconSize 0
skinparam classFontStyle bold

package "models" #DDEEFF {
    enum WorkflowStatus {
        QUEUED = "queued"
        IN_PROGRESS = "in_progress"
        COMPLETED = "completed"
        WAITING = "waiting"
        REQUESTED = "requested"
        PENDING = "pending"
    }

    enum WorkflowConclusion {
        SUCCESS = "success"
        FAILURE = "failure"
        CANCELLED = "cancelled"
        SKIPPED = "skipped"
        TIMED_OUT = "timed_out"
        ACTION_REQUIRED = "action_required"
        NEUTRAL = "neutral"
        STALE = "stale"
    }

    class WorkflowRun {
        +id               : str
        +workflow_name    : str
        +branch           : str
        +status           : WorkflowStatus
        +conclusion       : Optional[WorkflowConclusion]
        +created_at       : datetime
        +updated_at       : Optional[datetime]
        +run_number       : Optional[int]
        +commit_sha       : Optional[str]
        +duration_seconds : float = 0.0
        --
        +__post_init__() : None
        +to_dict() : dict
        +{static} from_dict(data: dict) : WorkflowRun
        +is_terminal() : bool
        +is_successful() : bool
        +is_failed() : bool
        +is_running() : bool
        +is_cancelled() : bool
    }

    class WorkflowRunAttempt {
        +id               : int
        +run_id           : int
        +attempt_number   : int
        +status           : str
        +conclusion       : Optional[str]
        +created_at       : datetime
        +duration_seconds : float = 0.0
        --
        +__post_init__() : None
        +to_dict() : dict
        +{static} from_dict(data: dict) : WorkflowRunAttempt
    }
}

package "storage" #FFF3CC {
    class WorkflowJsonStorage {
        +filepath          : str
        +attempts_filepath : str
        --
        +__init__(filepath: str, attempts_filepath: str)
        +save(runs: List[WorkflowRun]) : None
        +load() : List[WorkflowRun]
        +save_attempts(attempts: List[WorkflowRunAttempt]) : None
        +load_attempts() : List[WorkflowRunAttempt]
    }
}

package "services" #DDFFD4 {
    class WorkflowRunService {
        -_storage : WorkflowJsonStorage
        -_runs    : List[WorkflowRun]
        --
        +__init__(storage: WorkflowJsonStorage)
        +add_workflow_run(run: WorkflowRun) : WorkflowRun
        +list_runs() : List[WorkflowRun]
        +get_run_detail(run_id: str) : Optional[WorkflowRun]
        +filter_by_branch(branch: str) : List[WorkflowRun]
        +filter_by_status(status: WorkflowStatus) : List[WorkflowRun]
        +filter_by_conclusion(conclusion: WorkflowConclusion) : List[WorkflowRun]
        +filter_by_created_after(threshold_date: datetime) : List[WorkflowRun]
        +filter_by_created_before(threshold_date: datetime) : List[WorkflowRun]
        +filter_by_duration_min(min_seconds: float) : List[WorkflowRun]
        +filter_by_duration_max(max_seconds: float) : List[WorkflowRun]
        +filter_by_attempt_presence(attempt_service, has_attempts: bool) : List[WorkflowRun]
        +query(created_after, created_before, duration_min,\nduration_max, attempt_service, has_attempts,\nbranch, status, conclusion) : List[WorkflowRun]
        -_persist() : None
    }

    class WorkflowRunAttemptService {
        -_storage  : WorkflowJsonStorage
        -_attempts : List[WorkflowRunAttempt]
        --
        +__init__(storage: WorkflowJsonStorage)
        +add_attempt(attempt: WorkflowRunAttempt) : WorkflowRunAttempt
        +list_attempts(sorted: bool = True) : List[WorkflowRunAttempt]
        +get_attempt(attempt_id: int) : Optional[WorkflowRunAttempt]
        +get_attempts_for_run(run_id: int, sorted: bool = True) : List[WorkflowRunAttempt]
        -_persist() : None
    }

    class WorkflowRunTracker {
        -_service : WorkflowRunService
        --
        +__init__(service: WorkflowRunService)
        +track(workflow_name: str, branch: str,\n  status: WorkflowStatus,\n  conclusion: Optional[WorkflowConclusion],\n  run_number: Optional[int],\n  commit_sha: Optional[str],\n  run_id: Optional[str],\n  duration_seconds: float = 0.0) : WorkflowRun
    }
}

package "cli" #FFE5E5 {
    class "workflow_cli" <<module>> {
        +build_parser() : ArgumentParser
        +run_cli(service: WorkflowRunService, attempt_service: WorkflowRunAttemptService, args) : None
        -_fmt_run(run: WorkflowRun) : str
        -_fmt_attempt(attempt: WorkflowRunAttempt) : str
    }

    class "interactive_menu" <<module>> {
        +run_interactive(service: WorkflowRunService, attempt_service: WorkflowRunAttemptService) : None
        -_add_run(service: WorkflowRunService) : None
        -_list_runs(service: WorkflowRunService) : None
        -_detail_run(service: WorkflowRunService) : None
        -_filter_menu(service: WorkflowRunService) : None
        -_advanced_filter_menu(service, attempt_service) : None
        -_check_run_state(service: WorkflowRunService) : None
        -_add_attempt(attempt_service: WorkflowRunAttemptService) : None
        -_list_attempts(attempt_service: WorkflowRunAttemptService) : None
        -_detail_attempt(attempt_service: WorkflowRunAttemptService) : None
        -_list_attempts_for_run(attempt_service: WorkflowRunAttemptService) : None
    }
}

WorkflowRun                   ..>  WorkflowStatus        : status
WorkflowRun                   ..>  WorkflowConclusion    : conclusion
WorkflowRun         "1" <--> "N" WorkflowRunAttempt     : run_id
WorkflowRunService      "1" --> "1" WorkflowJsonStorage : -_storage
WorkflowRunService           ..>  WorkflowRun
WorkflowRunService           ..>  WorkflowStatus
WorkflowRunService           ..>  WorkflowConclusion
WorkflowRunAttemptService    "1" --> "1" WorkflowJsonStorage : -_storage
WorkflowRunAttemptService         ..>  WorkflowRunAttempt
WorkflowRunTracker      "1" --> "1" WorkflowRunService  : -_service
WorkflowRunTracker           ..>  WorkflowRun
"workflow_cli"               ..>  WorkflowRunService
"workflow_cli"               ..>  WorkflowRunAttemptService
"workflow_cli"               ..>  WorkflowRunTracker
"interactive_menu"           ..>  WorkflowRunService
"interactive_menu"           ..>  WorkflowRunAttemptService
"interactive_menu"           ..>  WorkflowRunTracker

@enduml
