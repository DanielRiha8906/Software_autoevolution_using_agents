@startuml class_diagram

skinparam classAttributeIconSize 0
skinparam classFontStyle bold

' ============================================================================
' STORAGE LAYER (Protocol Definitions)
' ============================================================================
package "storage" #FFF3CC {
    interface WorkflowRunStorage <<protocol>> {
        +save(runs: List[WorkflowRun]) : None
        +load() : List[WorkflowRun]
    }

    interface WorkflowRunAttemptStorage <<protocol>> {
        +save_attempts(attempts: List[WorkflowRunAttempt]) : None
        +load_attempts() : List[WorkflowRunAttempt]
    }

    class WorkflowJsonStorage {
        +filepath          : str
        +attempts_filepath : str
        --
        +__init__(filepath: str, attempts_filepath: str)
        +save(runs: List[WorkflowRun]) : None
        +load() : List[WorkflowRun]
        +save_attempts(attempts: List[WorkflowRunAttempt]) : None
        +load_attempts() : List[WorkflowRunAttempt]
    }

    WorkflowJsonStorage ..|> WorkflowRunStorage : implements
    WorkflowJsonStorage ..|> WorkflowRunAttemptStorage : implements
}

' ============================================================================
' ADAPTERS LAYER - GitHub Integration
' ============================================================================
package "adapters.github" #FFE8CC {
    interface WorkflowFetcher <<protocol>> {
        +fetch_runs(owner: str, repo: str, \n  status: Optional[str],\n  branch: Optional[str],\n  created_after: Optional[datetime]) : List[WorkflowRun]
    }

    class GitHubAPIFetcher {
        -_token : str
        -_headers : dict
        --
        +__init__(token: str)
        +fetch_runs(owner, repo, status, branch,\n  created_after, per_page) : List[WorkflowRun]
        -_fetch_page(owner, repo, status, branch,\n  created_after, page, per_page) : requests.Response
    }

    class GitHubCLIFetcher {
        +is_available() : bool
        +fetch_runs(owner, repo, status, branch,\n  created_after) : List[WorkflowRun]
    }

    class GitHubWorkflowRunFactory {
        +{static} from_github_api_response(data: dict) : WorkflowRun
        -{static} _parse_status(status_str: str) : WorkflowStatus
        -{static} _parse_conclusion(conclusion_str: Optional[str]) : Optional[WorkflowConclusion]
        -{static} _parse_datetime(datetime_str: str) : datetime
        -{static} _calculate_duration(created_at, updated_at) : float
    }

    class GitHubAuthManager {
        -SECRETS_FILE_PATH : str
        -TOKEN_ENV_VAR : str
        -TOKEN_PREFIX_PATTERN : str
        --
        +get_token(explicit_token: Optional[str]) : str
        +validate_token(token: str) : bool
        -_load_token_from_file() : Optional[str]
        -_prompt_for_token() : Optional[str]
    }

    class GitHubAuthError <<Exception>>
    class GitHubAPIError <<Exception>>
    class GitHubNetworkError <<Exception>>
    class GitHubRateLimitError <<Exception>>

    GitHubAPIFetcher ..|> WorkflowFetcher : implements
    GitHubCLIFetcher ..|> WorkflowFetcher : implements
    GitHubAPIFetcher --> GitHubWorkflowRunFactory : uses
    GitHubCLIFetcher --> GitHubWorkflowRunFactory : uses
    GitHubAPIFetcher ..> GitHubAuthError : throws
    GitHubAPIFetcher ..> GitHubAPIError : throws
    GitHubAPIFetcher ..> GitHubNetworkError : throws
    GitHubAPIFetcher ..> GitHubRateLimitError : throws
    GitHubCLIFetcher ..> GitHubAPIError : throws
    GitHubCLIFetcher ..> GitHubNetworkError : throws
    GitHubAuthManager ..> GitHubAuthError : throws
}

' ============================================================================
' MODELS LAYER
' ============================================================================
package "models" #DDEEFF {
    enum WorkflowStatus {
        QUEUED = "queued"
        IN_PROGRESS = "in_progress"
        COMPLETED = "completed"
        WAITING = "waiting"
        REQUESTED = "requested"
        PENDING = "pending"
    }

    enum WorkflowConclusion {
        SUCCESS = "success"
        FAILURE = "failure"
        CANCELLED = "cancelled"
        SKIPPED = "skipped"
        TIMED_OUT = "timed_out"
        ACTION_REQUIRED = "action_required"
        NEUTRAL = "neutral"
        STALE = "stale"
    }

    class WorkflowRun {
        +id               : str
        +workflow_name    : str
        +branch           : str
        +status           : WorkflowStatus
        +conclusion       : Optional[WorkflowConclusion]
        +created_at       : datetime
        +updated_at       : Optional[datetime]
        +run_number       : Optional[int]
        +commit_sha       : Optional[str]
        +duration_seconds : float = 0.0
        --
        +__post_init__() : None
        +to_dict() : dict
        +{static} from_dict(data: dict) : WorkflowRun
        +is_terminal() : bool
        +is_successful() : bool
        +is_failed() : bool
        +is_running() : bool
        +is_cancelled() : bool
    }

    class WorkflowRunAttempt {
        +id               : int
        +run_id           : int
        +attempt_number   : int
        +status           : str
        +conclusion       : Optional[str]
        +created_at       : datetime
        +duration_seconds : float = 0.0
        --
        +__post_init__() : None
        +to_dict() : dict
        +{static} from_dict(data: dict) : WorkflowRunAttempt
    }

    class StatisticsReport {
        +count_by_conclusion        : dict[str, int]
        +average_duration_seconds   : float
        +average_attempts_per_run   : float
        +min_duration_seconds       : Optional[float]
        +max_duration_seconds       : Optional[float]
        +duration_by_status         : dict[str, float]
    }

    class ImportResult {
        +filepath              : str
        +total_records         : int
        +imported_runs         : int
        +skipped_runs          : int
        +imported_attempts     : int
        +skipped_attempts      : int
        +errors                : List[str]
        +had_overwrite         : bool
    }

    WorkflowRun --> WorkflowStatus : uses
    WorkflowRun --> WorkflowConclusion : uses
    WorkflowRun "1" <-- "N" WorkflowRunAttempt : related to
}

' ============================================================================
' SERVICES LAYER (Business Logic) - Uses Protocols
' ============================================================================
package "services" #DDFFD4 {
    class WorkflowRunService {
        -_storage : WorkflowRunStorage
        -_runs    : List[WorkflowRun]
        --
        +__init__(storage: WorkflowRunStorage)
        +add_workflow_run(run: WorkflowRun) : WorkflowRun
        +replace_run(run: WorkflowRun) : None
        +delete_run(run_id: str) : bool
        +list_runs() : List[WorkflowRun]
        +get_run_detail(run_id: str) : Optional[WorkflowRun]
        +filter_by_branch(branch: str) : List[WorkflowRun]
        +filter_by_status(status: WorkflowStatus) : List[WorkflowRun]
        +filter_by_conclusion(conclusion: WorkflowConclusion) : List[WorkflowRun]
        +filter_by_created_after(threshold_date: datetime) : List[WorkflowRun]
        +filter_by_created_before(threshold_date: datetime) : List[WorkflowRun]
        +filter_by_duration_min(min_seconds: float) : List[WorkflowRun]
        +filter_by_duration_max(max_seconds: float) : List[WorkflowRun]
        +filter_by_attempt_presence(attempt_service, has_attempts: bool) : List[WorkflowRun]
        +query(...) : List[WorkflowRun]
        -_persist() : None
    }

    class WorkflowRunAttemptService {
        -_storage  : WorkflowRunAttemptStorage
        -_attempts : List[WorkflowRunAttempt]
        --
        +__init__(storage: WorkflowRunAttemptStorage)
        +add_attempt(attempt: WorkflowRunAttempt) : WorkflowRunAttempt
        +replace_attempt(attempt: WorkflowRunAttempt) : None
        +delete_attempt(attempt_id: int) : bool
        +list_attempts(sorted: bool = True) : List[WorkflowRunAttempt]
        +get_attempt(attempt_id: int) : Optional[WorkflowRunAttempt]
        +get_attempts_for_run(run_id: int, sorted: bool = True) : List[WorkflowRunAttempt]
        -_persist() : None
    }

    class WorkflowRunTracker {
        -_service : WorkflowRunService
        --
        +__init__(service: WorkflowRunService)
        +track(workflow_name: str, branch: str,\n  status: WorkflowStatus,\n  conclusion: Optional[WorkflowConclusion],\n  run_number: Optional[int],\n  commit_sha: Optional[str],\n  run_id: Optional[str],\n  duration_seconds: float = 0.0) : WorkflowRun
    }

    class StatisticsService {
        +calculate_statistics(runs: List[WorkflowRun],\n  attempt_service: Optional[WorkflowRunAttemptService]) : StatisticsReport
    }

    class WorkflowRunExportImportService {
        +{static} export_to_file(filepath: str, service: WorkflowRunService,\n  attempt_service: Optional[WorkflowRunAttemptService],\n  include_attempts: bool) : None
        +{static} import_from_file(filepath: str, service: WorkflowRunService,\n  attempt_service: Optional[WorkflowRunAttemptService],\n  overwrite: bool, dry_run: bool) : ImportResult
        -{static} _validate_and_build_run(data: dict, record_index: int) : WorkflowRun
        -{static} _validate_and_build_attempt(data: dict, record_index: int) : WorkflowRunAttempt
    }

    WorkflowRunService --> WorkflowRunStorage : depends on (protocol)
    WorkflowRunAttemptService --> WorkflowRunAttemptStorage : depends on (protocol)
    WorkflowRunTracker --> WorkflowRunService : uses
    StatisticsService ..> WorkflowRun : analyzes
    StatisticsService ..> StatisticsReport : returns
    WorkflowRunExportImportService ..> WorkflowRunService : uses
    WorkflowRunExportImportService ..> WorkflowRunAttemptService : uses
    WorkflowRunExportImportService ..> ImportResult : returns
}

