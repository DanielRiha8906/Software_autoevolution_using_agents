@startuml activity_diagram_interactive

skinparam activityBackgroundColor #DDEEFF
skinparam activityBorderColor     #3366AA
skinparam activityDiamondBackgroundColor #FFF3CC

start

:Display interactive menu;

repeat

  :Wait for user selection;

  switch (choice)

    case (1 — Add workflow run)
      :Prompt workflow name;
      :Prompt branch;
      :Choose status from list;
      :Choose conclusion (optional, 0 to skip);
      :Prompt run number (optional);
      :Prompt commit SHA (optional);
      :WorkflowRunTracker.track();
      :Print "Added run <id>";

    case (2 — List all runs)
      :WorkflowRunService.list_runs();
      if (no runs?) then (yes)
        :Print "No runs recorded.";
      else (no)
        :Print all runs;
      endif

    case (3 — Get run detail)
      :Prompt run ID;
      :WorkflowRunService.get_run_detail(run_id);
      if (found?) then (yes)
        :Print run details;
      else (no)
        :Print "No run found with id '<id>'";
      endif

    case (4 — Filter runs)
      :Choose filter type\n(branch / status / conclusion /\nduration / timestamp / attempts);
      if (branch?) then (yes)
        :Prompt branch name;
        :filter_by_branch();
      elseif (status?) then (yes)
        :Choose status from list;
        :filter_by_status();
      elseif (conclusion?) then (yes)
        :Choose conclusion from list;
        :filter_by_conclusion();
      elseif (duration?) then (yes)
        :Prompt min duration (optional);
        :Prompt max duration (optional);
        :filter_by_duration_range();
      elseif (timestamp?) then (yes)
        :Choose timestamp type\n(created_before / created_after /\nupdated_before / updated_after);
        :Prompt timestamp (ISO format);
        :Apply filter_by_*_timestamp();
      else (attempts)
        :Choose attempt filter\n(with_attempts / without_attempts);
        :Apply filter_with/without_attempts();
      endif
      if (no matches?) then (yes)
        :Print "No matching runs.";
      else (no)
        :Print matching runs;
      endif

    case (5 — Check run state)
      :Prompt run ID;
      :WorkflowRunService.get_run_detail(run_id);
      if (found?) then (yes)
        :Print is_terminal, is_running,\nis_successful, is_failed, is_cancelled;
      else (no)
        :Print "No run found with id '<id>'";
      endif

    case (6 — Create attempt)
      :Prompt run ID;
      :Prompt attempt number;
      :Choose status from list;
      :Choose conclusion (optional);
      :Prompt duration (optional);
      :AttemptService.add_workflow_attempt();
      :Print "Added attempt";

    case (7 — List all attempts)
      :AttemptService.list_attempts();
      if (no attempts?) then (yes)
        :Print "No attempts recorded.";
      else (no)
        :Print all attempts;
      endif

    case (8 — Get attempts by run)
      :Prompt run ID;
      :AttemptService.get_attempts_by_run_id(run_id);
      if (no attempts?) then (yes)
        :Print "No attempts for this run.";
      else (no)
        :Print attempts for run;
      endif

    case (9 — View statistics)
      :StatisticsService.compute_statistics();
      :Print statistics report\n(total_runs, conclusions_count,\navg/min/max_duration_seconds,\navg_attempts_per_run);

    case (10 — Export runs to JSON)
      :Prompt for output filepath;
      if (filepath provided?) then (yes)
        :WorkflowRunService.export_runs(filepath);
        :Print "Successfully exported <count> runs";
      else (no)
        :Print "Export cancelled.";
      endif

    case (11 — Import runs from JSON)
      :Prompt for input filepath;
      if (filepath provided?) then (yes)
        :Choose duplicate handling\n(fail on duplicate / skip duplicate);
        :WorkflowRunService.import_runs(filepath, skip_duplicates);
        :Print "Successfully imported <count> runs";
        if (errors occurred?) then (yes)
          :Print warnings (first 5 errors);
        else (no)
        endif
      else (no)
        :Print "Import cancelled.";
      endif

    case (12 — Fetch from GitHub)
      :Prompt GitHub owner;
      :Prompt GitHub repo;
      :Prompt workflow ID (optional);
      :Choose duplicate handling;
      :GitHubFetchService.fetch_workflow_runs();
      :Import fetched runs;
      :Print "Successfully fetched <count> runs";

    case (13 — Launch GUI)
      :Initialize FilterModel;
      :Create WorkflowRunViewerGUI\nwith service and attempt_service;
      :Launch tkinter main loop;
      note right: User interacts with GUI\n(filtering, viewing runs)
      :When GUI closes, return to menu;

    case (14 — Exit)
      :Print "Goodbye.";
      stop

  endswitch

repeat while (user continues)

@enduml
