@startuml component_diagram

skinparam componentStyle rectangle
skinparam linetype ortho
top to bottom direction

package "GitHub Workflow Manager" {

  package "Application entrypoint" {
    component "main" as MAIN
  }

  package "Interface/CLI layer" {
    component "workflow_cli" as CLI
    component "interactive_menu" as IM
  }

  package "Service layer" {
    component "WorkflowRunTracker" as TRACKER
    component "WorkflowRunService" as SVC
    component "AttemptService" as ASVC
    component "StatisticsService" as STATS
    component "GitHubFetchService" as GHS
  }

  package "Adapter layer" {
    component "GitHubAdapter" as ADAPTER
  }

  package "Storage layer (Abstraction)" {
    component "WorkflowRunRepository" as WREPO
    component "AttemptRepository" as AREPO
  }

  package "Storage layer (Implementation)" {
    component "WorkflowJsonStorage" as STOR
    component "AttemptJsonStorage" as ASTOR
    artifact "workflow_runs.json" as JSON_FILE
    artifact "workflow_attempts.json" as AJSON_FILE
  }

  package "Domain model" {
    component "WorkflowRun" as RUN
    component "WorkflowRunAttempt" as ATTEMPT
    component "WorkflowStatus" as STATUS
    component "WorkflowConclusion" as CONCLUSION
  }
}

MAIN --> CLI
MAIN --> IM

CLI --> TRACKER
IM --> TRACKER

CLI --> SVC
IM --> SVC

CLI --> ASVC
IM --> ASVC

CLI --> STATS
IM --> STATS

CLI --> GHS
IM --> GHS

TRACKER --> SVC
SVC --> WREPO
ASVC --> AREPO

STATS --> SVC
STATS --> ASVC

GHS --> ADAPTER
ADAPTER ..> RUN

WREPO <|-- STOR
AREPO <|-- ASTOR

STOR --> JSON_FILE
ASTOR --> AJSON_FILE

SVC ..> RUN
ASVC ..> ATTEMPT
RUN --> STATUS
RUN --> CONCLUSION

@enduml