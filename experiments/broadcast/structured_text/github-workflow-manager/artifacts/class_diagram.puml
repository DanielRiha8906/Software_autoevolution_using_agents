@startuml class_diagram

skinparam classAttributeIconSize 0
skinparam classFontStyle bold

package "models" #DDEEFF {
    enum WorkflowStatus {
        QUEUED = "queued"
        IN_PROGRESS = "in_progress"
        COMPLETED = "completed"
        WAITING = "waiting"
        REQUESTED = "requested"
        PENDING = "pending"
    }

    enum WorkflowConclusion {
        SUCCESS = "success"
        FAILURE = "failure"
        CANCELLED = "cancelled"
        SKIPPED = "skipped"
        TIMED_OUT = "timed_out"
        ACTION_REQUIRED = "action_required"
        NEUTRAL = "neutral"
        STALE = "stale"
    }

    class WorkflowRun {
        +id               : str
        +workflow_name    : str
        +branch           : str
        +status           : WorkflowStatus
        +conclusion       : Optional[WorkflowConclusion]
        +created_at       : datetime
        +updated_at       : Optional[datetime]
        +run_number       : Optional[int]
        +commit_sha       : Optional[str]
        +duration_seconds : float
        --
        +is_terminal() : bool
        +is_running() : bool
        +is_successful() : bool
        +is_failed() : bool
        +is_cancelled() : bool
        +to_dict() : dict
        +{static} from_dict(data: dict) : WorkflowRun
    }

    class WorkflowRunAttempt {
        +id               : int
        +run_id           : int
        +attempt_number   : int
        +status           : str
        +conclusion       : Optional[str]
        +created_at       : datetime
        +duration_seconds : float
        --
        +is_terminal() : bool
        +is_running() : bool
        +is_successful() : bool
        +is_failed() : bool
        +is_cancelled() : bool
        +to_dict() : dict
        +{static} from_dict(data: dict) : WorkflowRunAttempt
    }
}

package "storage" #FFF3CC {
    abstract class WorkflowRunRepository {
        {abstract} +save(runs: List[WorkflowRun]) : None
        {abstract} +load() : List[WorkflowRun]
    }

    abstract class AttemptRepository {
        {abstract} +save(attempts: List[WorkflowRunAttempt]) : None
        {abstract} +load() : List[WorkflowRunAttempt]
    }

    class WorkflowJsonStorage {
        +filepath : str
        --
        +__init__(filepath: str)
        +save(runs: List[WorkflowRun]) : None
        +load() : List[WorkflowRun]
    }

    class AttemptJsonStorage {
        +filepath : str
        --
        +__init__(filepath: str)
        +save(attempts: List[WorkflowRunAttempt]) : None
        +load() : List[WorkflowRunAttempt]
    }

    WorkflowRunRepository <|-- WorkflowJsonStorage
    AttemptRepository <|-- AttemptJsonStorage
}

package "services" #DDFFD4 {
    class WorkflowRunService {
        -_repository : WorkflowRunRepository
        -_runs    : List[WorkflowRun]
        --
        +__init__(repository: WorkflowRunRepository)
        +add_workflow_run(run: WorkflowRun) : WorkflowRun
        +list_runs() : List[WorkflowRun]
        +get_run_detail(run_id: str) : Optional[WorkflowRun]
        +filter_by_branch(branch: str) : List[WorkflowRun]
        +filter_by_status(status: WorkflowStatus) : List[WorkflowRun]
        +filter_by_conclusion(conclusion: WorkflowConclusion) : List[WorkflowRun]
        +filter_by_duration_range(min_seconds, max_seconds) : List[WorkflowRun]
        +filter_by_created_before(timestamp) : List[WorkflowRun]
        +filter_by_created_after(timestamp) : List[WorkflowRun]
        +filter_by_updated_before(timestamp) : List[WorkflowRun]
        +filter_by_updated_after(timestamp) : List[WorkflowRun]
        +filter_with_attempts(attempt_service) : List[WorkflowRun]
        +filter_without_attempts(attempt_service) : List[WorkflowRun]
        +filter_runs(...) : List[WorkflowRun]
        +export_runs(filepath: str) : int
        +import_runs(filepath: str, skip_duplicates: bool) : tuple
        -_persist() : None
    }

    class WorkflowRunTracker {
        -_service : WorkflowRunService
        --
        +__init__(service: WorkflowRunService)
        +track(workflow_name: str, branch: str,\n  status: WorkflowStatus,\n  conclusion: Optional[WorkflowConclusion],\n  run_number: Optional[int],\n  commit_sha: Optional[str],\n  run_id: Optional[str]) : WorkflowRun
    }

    class AttemptService {
        -_repository : AttemptRepository
        -_attempts : List[WorkflowRunAttempt]
        --
        +__init__(repository: AttemptRepository)
        +add_workflow_attempt(attempt: WorkflowRunAttempt) : WorkflowRunAttempt
        +get_attempts_by_run_id(run_id: int) : List[WorkflowRunAttempt]
        +list_attempts() : List[WorkflowRunAttempt]
        -_persist() : None
    }

    class WorkflowStatisticsReport {
        +total_runs : int
        +conclusions_count : Dict[str, int]
        +avg_duration_seconds : float
        +min_duration_seconds : Optional[float]
        +max_duration_seconds : Optional[float]
        +avg_attempts_per_run : float
        --
        +to_dict() : dict
    }

    class StatisticsService {
        -_workflow_run_service : WorkflowRunService
        -_attempt_service : AttemptService
        --
        +__init__(workflow_run_service: WorkflowRunService,\n  attempt_service: AttemptService)
        +compute_statistics() : WorkflowStatisticsReport
    }

    class GitHubFetchService {
        -_adapter : GitHubAdapter
        --
        +__init__()
        +validate_token(token: str) : bool
        +fetch_workflow_runs(owner: str, repo: str,\n  workflow_id: Optional[str],\n  token: Optional[str]) : List[WorkflowRun]
    }
}

package "adapters" #FFE5CC {
    class GitHubAdapter {
        -_token : Optional[str]
        --
        +__init__()
        +_resolve_token(token: Optional[str]) : str
        +_read_env_file(env_path: Path) : Optional[str]
        +fetch_workflow_runs(owner: str, repo: str,\n  workflow_id: Optional[str],\n  token: Optional[str]) : List[WorkflowRun]
        -_convert_github_run(github_run: dict) : WorkflowRun
        -_map_github_status(github_status: str) : WorkflowStatus
        -_map_github_conclusion(github_conclusion: str) : WorkflowConclusion
    }
}

package "cli" #FFE5E5 {
    class "workflow_cli" <<module>> {
        +build_parser() : ArgumentParser
        +run_cli(service: WorkflowRunService, args) : None
        -_fmt_run(run: WorkflowRun) : str
    }

    class "interactive_menu" <<module>> {
        +run_interactive(service: WorkflowRunService) : None
        -_add_run(service: WorkflowRunService) : None
        -_list_runs(service: WorkflowRunService) : None
        -_detail_run(service: WorkflowRunService) : None
        -_filter_menu(service: WorkflowRunService) : None
    }
}

package "gui" #FFD9B3 {
    class FilterModel {
        -status_filter : Optional[WorkflowStatus]
        -conclusion_filter : Optional[WorkflowConclusion]
        --
        +__init__()
        +set_status(status_str: str) : None
        +set_conclusion(conclusion_str: str) : None
        +apply(runs: List[WorkflowRun],\n  attempt_service: AttemptService) : List[WorkflowRun]
        +reset() : None
    }

    class WorkflowRunViewerGUI {
        -root : tk.Tk
        -service : WorkflowRunService
        -attempt_service : AttemptService
        -filter_model : FilterModel
        -status_var : tk.StringVar
        -conclusion_var : tk.StringVar
        -tree : ttk.Treeview
        --
        +__init__(root: tk.Tk,\n  service: WorkflowRunService,\n  attempt_service: AttemptService)
        -_setup_ui() : None
        -_on_filter_change(event) : None
        -_reset_filters() : None
        -_refresh_data() : None
        -_get_row_tags(run: WorkflowRun) : tuple
    }

    class "run_gui" <<function>> {
        +run_gui(service: WorkflowRunService,\n  attempt_service: AttemptService) : None
    }

    WorkflowRunViewerGUI "1" --> "1" FilterModel : -filter_model
    run_gui ..> WorkflowRunViewerGUI : creates
}

