@startuml activity_diagram_main

skinparam activityBackgroundColor #DDEEFF
skinparam activityBorderColor     #3366AA
skinparam activityDiamondBackgroundColor #FFF3CC

start

:Load WorkflowJsonStorage,\nWorkflowRunService,\nAttemptJsonStorage,\n& AttemptService;

if (CLI arguments provided?) then (yes)
  :Parse args with argparse;
  switch (subcommand)

    case (add)
      :Read name, branch, status\nconclusion, run-number, commit-sha;
      :WorkflowRunTracker.track();
      :Print "Added run <id>";

    case (list)
      :WorkflowRunService.list_runs();
      if (--branch?) then (yes)
        :filter_by_branch();
      elseif (--status?) then (yes)
        :filter_by_status();
      elseif (--conclusion?) then (yes)
        :filter_by_conclusion();
      endif
      if (no runs?) then (yes)
        :Print "No runs found.";
      else (no)
        :Print formatted run list;
      endif

    case (detail)
      :WorkflowRunService.get_run_detail(run_id);
      if (run found?) then (yes)
        :Print run details;
      else (no)
        :Print error to stderr;
        :Exit code 1;
      endif

    case (check-state)
      :WorkflowRunService.get_run_detail(run_id);
      if (run found?) then (yes)
        :Get state method result (terminal/running/\nsuccessful/failed/cancelled);
        :Print result;
        :Exit code 0 if True, 1 if False;
      else (no)
        :Print error to stderr;
        :Exit code 1;
      endif

    case (create-attempt)
      :Read run_id, attempt_number,\nstatus, conclusion, duration;
      :AttemptService.add_workflow_attempt();
      :Print "Added attempt";

    case (list-attempts)
      :AttemptService.list_attempts();
      if (--run-id provided?) then (yes)
        :Filter by run_id;
      endif
      if (no attempts?) then (yes)
        :Print "No attempts found.";
      else (no)
        :Print formatted attempt list;
      endif

    case (filter-runs)
      :Parse optional filters:\n--min-duration, --max-duration,\n--created-before/after,\n--updated-before/after,\n--with/without-attempts;
      :Parse timestamp arguments\n(convert ISO to UTC datetime);
      :Determine has_attempts filter\n(None / True / False);
      :service.filter_runs() with all criteria;
      if (no matches?) then (yes)
        :Print "No matching runs.";
      else (no)
        :Print formatted run list;
      endif

    case (statistics)
      :StatisticsService.compute_statistics();
      :Print statistics report\n(total_runs, conclusions_count,\navg/min/max_duration_seconds,\navg_attempts_per_run);

  endswitch
  stop

else (no)
  :Launch interactive menu\n(see activity_diagram_interactive);
  stop
endif

@enduml
