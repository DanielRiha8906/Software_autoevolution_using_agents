@startuml
!theme plain
skinparam componentBackgroundColor #FAFAFA
skinparam componentBorderColor #333333
skinparam arrowColor #333333
skinparam fontName Courier

package "CLI Layer" {
  component [CalculatorCLI] as CLI
}

package "Service Layer" {
  component [CalculatorService] as CalcService
  component [MemoryService] as MemService
  component [QueryService] as QuerySvc
  component [Calculator] as CalcLogic
}

package "Storage Layer" {
  component [JsonStorage] as Storage
}

package "Data Layer" {
  component [calculations.json] as CalcFile
  component [memory.json] as MemFile
}

CLI --> CalcService: uses
CLI --> QuerySvc: uses for querying

CalcService --> CalcLogic: delegates calculation
CalcService --> Storage: stores CalculationResult
CalcService --> MemService: optionally stores MemoryEntry

MemService --> Storage: stores/retrieves MemoryEntry

QuerySvc --> MemService: queries MemoryEntry

Storage --> CalcFile: persists
Storage --> MemFile: persists

@enduml
