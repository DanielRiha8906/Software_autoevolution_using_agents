@startuml
!theme plain
skinparam componentBackgroundColor #FAFAFA
skinparam componentBorderColor #333333
skinparam arrowColor #333333
skinparam fontName Courier

package "Presentation (CalculatorUI Protocol)" as UI {
  component [CalculatorCLI] as CLI
  note right of CLI
    CLI Implementation
    - run_interactive()
    - run_command()
  end note
}

package "Calculation Engine (CalculationEngine Protocol)" as Calc {
  component [Calculator] as CalcImpl
  note right of CalcImpl
    Pure arithmetic
    - calculate()
    - 14 operations
  end note
}

package "Memory/History (HistoryStorage Protocol)" as Mem {
  component [MemoryService] as MemSvc
  component [HistoryManager] as HistMgr
  note right of MemSvc
    Memory Storage
    - store()
    - retrieve()
  end note
  note right of HistMgr
    History Management
    - export_to_file()
    - import_from_file()
  end note
}

package "Orchestration" as Orch {
  component [CalculatorService] as CalcService
  note right of CalcService
    Coordinator
    - Depends on protocols
    - Not concrete impls
  end note
}

package "Supporting Services" as Support {
  component [QueryService] as QuerySvc
  component [StatisticsService] as StatsSvc
}

package "Persistence" as Persist {
  component [JsonStorage] as Storage
  component [calculations.json]
  component [memory.json]
}

' Dependency relationships via protocols
CLI --> CalcService: orchestrates
CLI --> QuerySvc: queries
CLI --> HistMgr: export/import

CalcService --> CalcImpl: uses CalculationEngine
CalcService --> MemSvc: uses HistoryStorage
CalcService --> Storage: persistence

MemSvc --> Storage: read/write MemoryEntry
HistMgr --> Storage: file I/O

QuerySvc --> MemSvc: queries
StatsSvc --> MemSvc: analyzes

Storage --> calculations.json
Storage --> memory.json

@enduml
