@startuml
!theme plain
skinparam classBackgroundColor #FAFAFA
skinparam classBorderColor #333333
skinparam arrowColor #333333
skinparam fontName Courier

package "models" {
  enum Operation {
    ADD
    SUBTRACT
    MULTIPLY
    DIVIDE
    SQUARE
    SQRT
    POWER
    MODULO
    --
    +from_string(value: str): Operation
    +display_name(): str
  }

  class CalculationResult {
    +operation: str
    +operand_a: float
    +operand_b: float
    +result: float
    +timestamp: str
    +execution_time_ms: float
    --
    +to_dict(): dict
    +from_dict(data: dict): CalculationResult
    +__str__(): str
  }

  class MemoryEntry {
    +operation_name: str
    +operand_a: float
    +operand_b: float
    +result: Optional[float]
    +success: bool
    +error_message: Optional[str]
    +execution_timestamp: str
    +execution_time_ms: float
    --
    +to_dict(): dict
    +from_dict(data: dict): MemoryEntry
  }

  class StatisticsReport {
    +total_operations: int
    +operation_count: dict[str, int]
    +total_errors: int
    +error_frequency: dict[str, int]
    +error_rate: float
    +average_execution_time_ms: float
    +min_execution_time_ms: float
    +max_execution_time_ms: float
  }
}

package "services" {
  class Calculator {
    +calculate(op: Operation, a: float, b: float): float
  }

  class CalculatorService {
    -calculator: Calculator
    -storage: JsonStorage
    -memory_service: Optional[MemoryService]
    --
    +perform(op: Operation, a: float, b: float): CalculationResult
    +get_history(): list[CalculationResult]
  }

  class MemoryService {
    -storage: JsonStorage
    --
    +store(entry: MemoryEntry): None
    +retrieve(): list[MemoryEntry]
  }

  class HistoryManager {
    --
    +export_to_file(filepath: str | Path): tuple[int, list[str]]
    +import_from_file(filepath: str | Path, choice: str): tuple[int, list[str]]
    -_validate_entry(entry_dict: dict): bool
  }

  class QueryService {
    -memory_service: MemoryService
    --
    +query(operation_type: Optional[str], result_state: Optional[str]): list[MemoryEntry]
    +query_by_operation(operation_type: str): list[MemoryEntry]
    +query_by_state(result_state: str): list[MemoryEntry]
    +format_results(entries: list[MemoryEntry]): str
  }

  class StatisticsService {
    -memory_service: MemoryService
    --
    +compute_statistics(): StatisticsReport
  }
}

package "storage" {
  class JsonStorage {
    -filepath: Path
    --
    +save(result: CalculationResult): None
    +load_all(): list[CalculationResult]
    -_read_raw(): list
    -_write_raw(records: list): None
  }
}

package "cli" {
  class CalculatorCLI {
    -service: CalculatorService
    -query_service: Optional[QueryService]
    -statistics_service: Optional[StatisticsService]
    -history_manager: Optional[HistoryManager]
    --
    +run_interactive(): None
    +run_command(op_str: str, a: float, b: float): None
    -_print_menu(): None
    -_resolve_menu_choice(choice: str): Operation
    -_prompt_number(prompt: str): float
    -_show_history(): None
    -_query_interactive(): None
    -_show_statistics(): None
    -_export_history_interactive(): None
    -_import_history_interactive(): None
  }
}

' Relationships
CalculatorService --> Calculator
CalculatorService --> JsonStorage
CalculatorService --> Operation
CalculatorService --> MemoryService : optional

MemoryService --> JsonStorage
MemoryService --> MemoryEntry

HistoryManager --|> MemoryService
HistoryManager --> MemoryEntry

QueryService --> MemoryService
QueryService --> MemoryEntry

CalculatorCLI --> CalculatorService
CalculatorCLI --> QueryService
CalculatorCLI --> StatisticsService
CalculatorCLI --> HistoryManager : optional
CalculatorCLI --> Operation

QueryService --> MemoryEntry
StatisticsService --> MemoryEntry
StatisticsService --> StatisticsReport

JsonStorage --> CalculationResult
JsonStorage --> MemoryEntry

@enduml
