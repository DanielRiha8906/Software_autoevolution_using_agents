@startuml
!theme plain
skinparam classBackgroundColor #FAFAFA
skinparam classBorderColor #333333
skinparam arrowColor #333333
skinparam fontName Courier

package "models" {
  enum Operation {
    ADD
    SUBTRACT
    MULTIPLY
    DIVIDE
    SQUARE
    SQRT
    POWER
    MODULO
    --
    +from_string(value: str): Operation
    +display_name(): str
  }

  class CalculationResult {
    +operation: str
    +operand_a: float
    +operand_b: float
    +result: float
    +timestamp: str
    +execution_time_ms: float
    --
    +to_dict(): dict
    +from_dict(data: dict): CalculationResult
    +__str__(): str
  }

  class MemoryEntry {
    +operation_name: str
    +operand_a: float
    +operand_b: float
    +result: Optional[float]
    +success: bool
    +error_message: Optional[str]
    +execution_timestamp: str
    +execution_time_ms: float
    --
    +to_dict(): dict
    +from_dict(data: dict): MemoryEntry
  }
}

package "services" {
  class Calculator {
    +calculate(op: Operation, a: float, b: float): float
  }

  class CalculatorService {
    -calculator: Calculator
    -storage: JsonStorage
    --
    +perform(op: Operation, a: float, b: float): CalculationResult
    +get_history(): list[CalculationResult]
  }

  class MemoryService {
    -storage: JsonStorage
    --
    +store(entry: MemoryEntry): None
    +retrieve(): list[MemoryEntry]
  }
}

package "storage" {
  class JsonStorage {
    -filepath: Path
    --
    +save(result: CalculationResult): None
    +load_all(): list[CalculationResult]
    -_read_raw(): list
    -_write_raw(records: list): None
  }
}

package "cli" {
  class CalculatorCLI {
    -service: CalculatorService
    --
    +run_interactive(): None
    +run_command(op_str: str, a: float, b: float): None
    -_print_menu(): None
    -_resolve_menu_choice(choice: str): Operation
    -_prompt_number(prompt: str): float
    -_show_history(): None
  }
}

' Relationships
CalculatorService --> Calculator
CalculatorService --> JsonStorage
CalculatorService --> Operation

MemoryService --> JsonStorage
MemoryService --> MemoryEntry

CalculatorCLI --> CalculatorService
CalculatorCLI --> Operation

JsonStorage --> CalculationResult
JsonStorage --> MemoryEntry

@enduml
