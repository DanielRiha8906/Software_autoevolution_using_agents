@startuml
!theme plain
skinparam boxBackgroundColor #FAFAFA
skinparam boxBorderColor #333333
skinparam arrowColor #333333
skinparam fontName Courier

package "Presentation Layer" as Presentation {
  component "CalculatorCLI"
}

package "Service Layer" as Services {
  component "CalculatorService"
  component "MemoryService"
  component "HistoryManager"
  component "QueryService"
  component "StatisticsService"
  component "Calculator"
}

package "Domain Models" as Models {
  component "Operation"
  component "CalculationResult"
  component "MemoryEntry"
  component "StatisticsReport"
}

package "Storage/Persistence" as Persistence {
  component "JsonStorage"
  database "calculations.json"
  database "memory.json"
}

' Dependencies
Presentation --> CalculatorService: depends on
Presentation --> QueryService: depends on
Presentation --> StatisticsService: depends on
Presentation --> HistoryManager: depends on for export/import

CalculatorService --> Calculator: uses
CalculatorService --> CalculationResult: uses
CalculatorService --> MemoryService: optionally uses for storage
CalculatorService --> JsonStorage: uses for persistence

MemoryService --> MemoryEntry: manages
MemoryService --> JsonStorage: uses for persistence

HistoryManager --> MemoryEntry: exports/imports
HistoryManager --> JsonStorage: uses for persistence

QueryService --> MemoryService: queries
QueryService --> MemoryEntry: filters

StatisticsService --> MemoryService: queries
StatisticsService --> MemoryEntry: analyzes
StatisticsService --> StatisticsReport: produces

JsonStorage --> CalculationResult: serializes
JsonStorage --> MemoryEntry: serializes
JsonStorage --> calculations.json: reads/writes
JsonStorage --> memory.json: reads/writes

note right of Presentation
  CLI provides interactive menu
  and one-shot command mode.
  Supports standard and scientific modes:
  - Standard: 8 operations
  - Scientific: 14 operations (adds SIN, COS, TAN, LOG, LN, EXP)
end note

note right of Services
  Business logic separated
  from persistence and I/O
end note

note right of Models
  Pure domain objects
  implementing to_dict()/from_dict()
end note

note right of Persistence
  Generic storage abstraction
  supports multiple models
end note

@enduml
