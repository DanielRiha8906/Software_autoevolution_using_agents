@startuml component_diagram

skinparam componentStyle uml2
skinparam defaultFontSize 12
skinparam backgroundColor #FAFAFA

left to right direction

package "TODO Application - 5-Layer Architecture" {

    component "Entry Point\n(__main__)" as Main

    package "5. CLI Layer" {
        component "TodoCLI\n(commands)" as CLI
        component "InteractiveMenu\n(user interface)" as IM
    }

    package "4. Services Layer" {
        component "TodoService\n(main coordinator)" as SVC
        component "TaskService" as TaskSvc
        component "CommentService" as CommentSvc
        component "ProjectService" as ProjectSvc
        component "StatisticsService" as StatSvc
        component "ImportExportService" as ImpExpSvc
    }

    package "3. Repositories Layer" {
        component "TaskRepository\n(protocol)" as TaskRepo
        component "CommentRepository\n(protocol)" as CommentRepo
        component "ProjectRepository\n(protocol)" as ProjectRepo
        component "Json Implementations\n(JsonTaskRepository, etc)" as JsonImpls
    }

    package "2. Models Layer" {
        component "Task, TaskStatus" as TaskModel
        component "TaskComment" as CommentModel
        component "Project" as ProjectModel
        component "TaskStatistics" as StatsModel
    }

    package "1. Storage Layer" {
        component "StorageProtocol\n(interface)" as StorageProto
        component "JsonStorage\n(implementation)" as Storage
    }
}

database "~/.todo_data.json" as DB

Main --> CLI : command mode
Main --> IM : interactive mode

CLI --> SVC : uses
IM --> SVC : uses
CLI --> ImpExpSvc : uses
CLI --> StatSvc : uses

SVC --> TaskSvc : delegates
SVC --> CommentSvc : delegates
SVC --> ProjectSvc : delegates

TaskSvc --> TaskRepo : implements
CommentSvc --> CommentRepo : implements
ProjectSvc --> ProjectRepo : implements

JsonImpls --> Storage : uses
JsonImpls --> TaskModel : works with
JsonImpls --> CommentModel : works with
JsonImpls --> ProjectModel : works with

TaskRepo ..> TaskModel : returns
CommentRepo ..> CommentModel : returns
ProjectRepo ..> ProjectModel : returns
StatSvc ..> StatsModel : returns

Storage --|> StorageProto : implements
Storage --> DB : read/write

@enduml