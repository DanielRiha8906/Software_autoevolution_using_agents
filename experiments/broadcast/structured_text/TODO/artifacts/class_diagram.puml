@startuml class_diagram

skinparam classAttributeIconSize 0
skinparam classFontStyle bold

' ============================================================================
' MODELS LAYER - Layer 2
' ============================================================================
package "2. Models Layer" #DDEEFF {
    enum TaskStatus {
        PENDING
        IN_PROGRESS
        DONE
    }

    class Task {
        +id : String
        +title : String
        +description : String [0..1]
        +status : TaskStatus
        +created_at : DateTime
        +updated_at : DateTime
        +due_date : DateTime [0..1]
        +project_id : String [0..1]
        --
        +to_dict() : Dictionary
        +from_dict(data: Dictionary) : Task
        +is_overdue() : Boolean
    }

    class TaskComment {
        +id : String
        +task_id : String
        +content : String
        +created_at : DateTime
        +author : String [0..1]
        +updated_at : DateTime [0..1]
        --
        +to_dict() : Dictionary
        +from_dict(data: Dictionary) : TaskComment
    }

    class Project {
        +id : String
        +name : String
        --
        +to_dict() : Dictionary
        +from_dict(data: Dictionary) : Project
    }

    class TaskStatistics {
        +total_task_count : Integer
        +pending_count : Integer
        +in_progress_count : Integer
        +done_count : Integer
        +overdue_count : Integer
        +tasks_with_due_date_count : Integer
        +completion_rate : Float
    }
}

' ============================================================================
' STORAGE LAYER - Layer 1
' ============================================================================
package "1. Storage Layer" #FFF3CC {
    interface StorageProtocol {
        load() : Union[List<Dict>, Dict]
        save(data: Union[List<Dict>, Dict]) : void
    }

    class JsonStorage {
        -path : Path
        --
        +JsonStorage(path: String [0..1])
        +load() : Union[List<Dict>, Dict]
        +save(data: Union[List<Dict>, Dict]) : void
    }
}

' ============================================================================
' REPOSITORIES LAYER - Layer 3
' ============================================================================
package "3. Repositories Layer" #E8F5E9 {
    interface TaskRepository {
        add(title: String, ...) : Task
        get(task_id: String) : Task
        list_all() : List<Task>
        list_by_status(status: TaskStatus) : List<Task>
        list_by_project(project_id: String) : List<Task>
        list_overdue() : List<Task>
        update(task_id: String, ...) : Task
        set_status(task_id: String, status: TaskStatus) : Task
        delete(task_id: String) : void
    }

    interface CommentRepository {
        add(task_id: String, content: String, ...) : TaskComment
        get(comment_id: String) : TaskComment
        list_by_task(task_id: String) : List<TaskComment>
        update(comment_id: String, content: String) : TaskComment
        delete(comment_id: String) : void
        delete_by_task(task_id: String) : void
    }

    interface ProjectRepository {
        add(name: String) : Project
        get(project_id: String) : Project
        list_all() : List<Project>
        update(project_id: String, name: String) : Project
        delete(project_id: String) : void
    }

    class JsonTaskRepository {
        -storage : JsonStorage
        -tasks : Dict[String, Task]
        --
        -load() : void
        -persist() : void
    }

    class JsonCommentRepository {
        -storage : JsonStorage
        -comments : Dict[String, TaskComment]
        --
        -load() : void
        -persist() : void
    }

    class JsonProjectRepository {
        -storage : JsonStorage
        -projects : Dict[String, Project]
        --
        -load() : void
        -persist() : void
    }

    exception TaskNotFoundError
    exception CommentNotFoundError
    exception ProjectNotFoundError
}

' ============================================================================
' SERVICES LAYER - Layer 4
' ============================================================================
package "4. Services Layer" #FFF9C4 {
    class TodoService {
        -task_service : TaskService
        -comment_service : CommentService
        -project_service : ProjectService
        --
        +add_task(title: String, ...) : Task
        +get_task(task_id: String) : Task
        +list_tasks(...) : List<Task>
        +start_task(task_id: String) : Task
        +complete_task(task_id: String) : Task
        +reopen_task(task_id: String) : Task
        +update_task(task_id: String, ...) : Task
        +delete_task(task_id: String) : void
        +add_comment(task_id: String, ...) : TaskComment
        +list_comments(task_id: String) : List<TaskComment>
        +delete_comment(comment_id: String) : void
        +add_project(name: String) : Project
        +list_projects() : List<Project>
        +delete_project(project_id: String) : void
    }

    class TaskService {
        -repository : TaskRepository
        --
        +add_task(title: String, ...) : Task
        +get_task(task_id: String) : Task
        +list_tasks(...) : List<Task>
        +update_task(task_id: String, ...) : Task
        +set_status(task_id: String, status: TaskStatus) : Task
        +delete_task(task_id: String) : void
    }

    class CommentService {
        -repository : CommentRepository
        --
        +add_comment(task_id: String, ...) : TaskComment
        +get_comment(comment_id: String) : TaskComment
        +list_comments(task_id: String) : List<TaskComment>
        +update_comment(comment_id: String, ...) : TaskComment
        +delete_comment(comment_id: String) : void
    }

    class ProjectService {
        -repository : ProjectRepository
        --
        +add_project(name: String) : Project
        +get_project(project_id: String) : Project
        +list_projects() : List<Project>
        +update_project(project_id: String, ...) : Project
        +delete_project(project_id: String) : void
    }

    class StatisticsService {
        -storage : JsonStorage
        --
        +compute_statistics() : TaskStatistics
    }

    class ImportExportService {
        -storage : JsonStorage
        --
        +export_to_file(file_path: String) : void
        +import_from_file(file_path: String, ...) : void
        +validate_import_data(data: Dictionary) : Tuple<Boolean, String>
    }

    exception ImportExportValidationError
}

' ============================================================================
' CLI LAYER - Layer 5
' ============================================================================
package "5. CLI Layer" #FFE5E5 {
    class TodoCLI {
        -service : TodoService
        -stats_service : StatisticsService
        -import_export_service : ImportExportService
        --
        +run(argv: List<String> [0..1]) : Integer
        -_build_parser() : ArgumentParser
    }

    class InteractiveMenu {
        -service : TodoService
        -stats_service : StatisticsService
        --
        +run() : void
    }
}

' ============================================================================
' DEPENDENCIES
' ============================================================================

' Models
Task --> TaskStatus : status
Task --> Project : references
TaskComment --> Task : task_id

' Storage protocol
JsonStorage --|> StorageProtocol : implements

' Repositories
JsonTaskRepository --|> TaskRepository : implements
JsonTaskRepository --> JsonStorage : uses
JsonTaskRepository --> Task : creates/reads
JsonTaskRepository ..> TaskNotFoundError : raises

JsonCommentRepository --|> CommentRepository : implements
JsonCommentRepository --> JsonStorage : uses
JsonCommentRepository --> TaskComment : creates/reads
JsonCommentRepository ..> CommentNotFoundError : raises

JsonProjectRepository --|> ProjectRepository : implements
JsonProjectRepository --> JsonStorage : uses
JsonProjectRepository --> Project : creates/reads
JsonProjectRepository ..> ProjectNotFoundError : raises

' Services
TodoService --> TaskService : delegates
TodoService --> CommentService : delegates
TodoService --> ProjectService : delegates

TaskService --> TaskRepository : uses
TaskService --> Task : returns

CommentService --> CommentRepository : uses
CommentService --> TaskComment : returns

ProjectService --> ProjectRepository : uses
ProjectService --> Project : returns

StatisticsService --> JsonStorage : uses
StatisticsService --> TaskStatistics : returns

ImportExportService --> JsonStorage : uses
ImportExportService ..> ImportExportValidationError : raises

' CLI
TodoCLI --> TodoService : uses
TodoCLI --> StatisticsService : uses
TodoCLI --> ImportExportService : uses

InteractiveMenu --> TodoService : uses
InteractiveMenu --> StatisticsService : uses

@enduml