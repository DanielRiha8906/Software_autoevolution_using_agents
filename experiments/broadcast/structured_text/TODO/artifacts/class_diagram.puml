@startuml class_diagram

skinparam classAttributeIconSize 0
skinparam classFontStyle bold

package "models" #DDEEFF {
    enum TaskStatus {
        PENDING
        IN_PROGRESS
        DONE
    }

    class Project {
        +id : String
        +name : String
        --
        +toDict() : Dictionary
        +fromDict(data: Dictionary) : Project
    }

    class Task {
        +id : String
        +title : String
        +description : String [0..1]
        +status : TaskStatus
        +createdAt : DateTime
        +updatedAt : DateTime
        +dueDate : DateTime [0..1]
        +project_id : String [0..1]
        --
        +toDict() : Dictionary
        +fromDict(data: Dictionary) : Task
        +isOverdue() : Boolean
    }

    class TaskComment {
        +id : String
        +task_id : String
        +content : String
        +created_at : DateTime
        +author : String [0..1]
        +updated_at : DateTime [0..1]
        --
        +toDict() : Dictionary
        +fromDict(data: Dictionary) : TaskComment
    }

    class TaskStatistics {
        +total_task_count : Integer
        +pending_count : Integer
        +in_progress_count : Integer
        +done_count : Integer
        +overdue_count : Integer
        +tasks_with_due_date_count : Integer
        +completion_rate : Float
    }
}

package "storage" #FFF3CC {
    class JsonStorage {
        -path : String
        --
        +JsonStorage(path: String [0..1])
        +load() : List<Dictionary>
        +save(tasks: List<Dictionary>) : void
    }
}

package "services" #DDFFD4 {
    exception TaskNotFoundError
    exception ProjectNotFoundError
    exception CommentNotFoundError
    exception ImportExportValidationError

    class TaskManager {
        -storage : JsonStorage
        -tasks : Dictionary<String, Task>
        --
        +TaskManager(storage: JsonStorage [0..1])
        +add(title: String, description: String [0..1], dueDate: DateTime [0..1]) : Task
        +get(taskId: String) : Task
        +listAll() : List<Task>
        +listByStatus(status: TaskStatus) : List<Task>
        +listByProject(projectId: String) : List<Task>
        +listOverdue() : List<Task>
        +listByDueDateRange(before: DateTime [0..1], after: DateTime [0..1]) : List<Task>
        +update(taskId: String, title: String [0..1], description: String [0..1], dueDate: DateTime [0..1]) : Task
        +setStatus(taskId: String, status: TaskStatus) : Task
        +delete(taskId: String) : void
        -load() : void
        -persist() : void
    }

    class ProjectManager {
        -storage : JsonStorage
        -projects : Dictionary<String, Project>
        --
        +ProjectManager(storage: JsonStorage [0..1])
        +add(name: String) : Project
        +get(projectId: String) : Project
        +listAll() : List<Project>
        +update(projectId: String, name: String) : Project
        +delete(projectId: String) : void
        -load() : void
        -persist() : void
    }

    class CommentsService {
        -storage : JsonStorage
        -comments : Dictionary<String, TaskComment>
        --
        +CommentsService(storage: JsonStorage [0..1])
        +addComment(taskId: String, content: String, author: String [0..1]) : TaskComment
        +getComment(commentId: String) : TaskComment
        +listCommentsByTask(taskId: String) : List<TaskComment>
        +updateComment(commentId: String, content: String) : TaskComment
        +deleteComment(commentId: String) : void
        +deleteCommentsByTask(taskId: String) : void
        -load() : void
        -persist() : void
    }

    class TodoService {
        -manager : TaskManager
        -project_manager : ProjectManager
        -comments : CommentsService
        --
        +TodoService(storage: JsonStorage [0..1])
        +addTask(title: String, description: String [0..1], dueDate: DateTime [0..1], projectId: String [0..1]) : Task
        +getTask(taskId: String) : Task
        +listTasks(status: TaskStatus [0..1], overdue: Boolean = False, due_before: DateTime [0..1], due_after: DateTime [0..1], projectId: String [0..1]) : List<Task>
        +startTask(taskId: String) : Task
        +completeTask(taskId: String) : Task
        +reopenTask(taskId: String) : Task
        +updateTask(taskId: String, title: String [0..1], description: String [0..1], dueDate: DateTime [0..1]) : Task
        +deleteTask(taskId: String) : void
        +addComment(taskId: String, content: String, author: String [0..1]) : TaskComment
        +getComment(commentId: String) : TaskComment
        +listComments(taskId: String) : List<TaskComment>
        +updateComment(commentId: String, content: String) : TaskComment
        +deleteComment(commentId: String) : void
        +addProject(name: String) : Project
        +getProject(projectId: String) : Project
        +listProjects() : List<Project>
        +updateProject(projectId: String, name: String) : Project
        +deleteProject(projectId: String) : void
    }

    class StatisticsService {
        -task_manager : TaskManager
        --
        +StatisticsService(task_manager: TaskManager)
        +compute_statistics() : TaskStatistics
    }

    class ImportExportService {
        -storage : JsonStorage
        --
        +ImportExportService(storage: JsonStorage [0..1])
        +export_to_file(file_path: String) : Dictionary
        +import_from_file(file_path: String, overwrite: Boolean = False) : Dictionary
        +validate_import_data(data: Dictionary) : Tuple<Boolean, String>
        -_validate_import_data(data: Dictionary) : void
    }
}

package "cli" #FFE5E5 {
    class TodoCLI {
        -service : TodoService
        -stats_service : StatisticsService
        --
        +TodoCLI(storagePath: String [0..1])
        +run(argv: List<String> [0..1]) : Integer
    }

    class InteractiveMenu {
        -service : TodoService
        -stats_service : StatisticsService
        --
        +InteractiveMenu(storagePath: String [0..1])
        +run() : void
    }
}

Task --> TaskStatus : status
Task --> Project : references (project_id)
TaskComment --> Task : references (task_id)
TaskManager --> JsonStorage : storage
TaskManager ..> TaskNotFoundError : raises
ProjectManager --> JsonStorage : storage
ProjectManager ..> ProjectNotFoundError : raises
CommentsService --> JsonStorage : storage
CommentsService ..> CommentNotFoundError : raises
ImportExportService --> JsonStorage : storage
ImportExportService ..> ImportExportValidationError : raises
TodoService --> TaskManager : manager
TodoService --> ProjectManager : project_manager
TodoService --> CommentsService : comments
StatisticsService --> TaskManager : task_manager
StatisticsService --> TaskStatistics : computes
TodoCLI --> TodoService : service
TodoCLI --> StatisticsService : stats_service
TodoCLI --> ImportExportService : import_export_service
InteractiveMenu --> TodoService : service
InteractiveMenu --> StatisticsService : stats_service

@enduml