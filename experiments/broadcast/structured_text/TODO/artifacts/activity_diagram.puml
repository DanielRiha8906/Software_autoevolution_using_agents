@startuml

partition "Interactive Mode" {
  start
  :Launch application;

repeat
  :Display task list + main menu;
  :Wait for user input;

  switch (choice)
    case (1 — List/filter)
      :Display filter options;
      :Wait for filter choice;
      switch (filter_choice)
        case (1 — By status)
          :Select status (pending/in progress/done);
          :Call listTasks(status);
        case (2 — Overdue tasks)
          :Call listTasks(overdue=true);
        case (3 — All tasks)
          :Call listTasks();
        case (0 — Cancel)
          :Return to main menu;
      endswitch
      :Display filtered task list;
    case (2 — Add task)
      :Run add task flow;
    case (3 — Show details)
      :Run show details flow;
    case (4 — Change status)
      :Run change status flow;
    case (5 — Update task)
      :Run update task flow;
    case (6 — Delete task)
      :Run delete task flow;
    case (7 — Manage comments)
      :Run comment management flow;
    case (8 — Export tasks/comments)
      :Run export flow;
    case (0/q — Quit)
      :Clear screen;
      stop
    case (other)
      :Show unknown option;
  endswitch

repeat while (user continues)
}

partition "Export Flow" {
  :Get file path from user;
  :Call export_to_file(file_path);
  :Load all tasks and comments from storage;
  :Serialize to JSON format;
  :Write to file;
  :Display success with counts;
}

partition "Import Flow" {
  :Get file path and overwrite flag;
  :Read JSON file;
  :Validate import data structure;
  if (Data valid?) then (yes)
    :Load current tasks/comments;
    if (overwrite flag set?) then (yes)
      :Clear existing data;
    else (no)
      :Keep existing data;
    endif
    :Merge imported tasks (skip duplicates);
    :Merge imported comments (skip duplicates);
    :Persist merged data;
    :Display import summary;
  else (no)
    :Display validation error;
  endif
}

@enduml