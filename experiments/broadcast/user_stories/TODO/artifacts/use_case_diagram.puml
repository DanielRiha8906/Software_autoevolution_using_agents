    usecase "View task summary report" as I_REPORT
    usecase "Export tasks and comments" as I_EXPORT
    usecase "Import tasks and comments" as I_IMPORT
    usecase "Quit application" as I_QUIT
  }

  package "Command-line mode" {
    usecase "Use one-shot CLI command" as CLI
