    usecase "Update task" as C_UPDATE
    usecase "Delete task" as C_DELETE
    usecase "Add comment" as C_COMMENT_ADD
    usecase "List comments" as C_COMMENT_LIST
    usecase "Edit comment" as C_COMMENT_EDIT
    usecase "Delete comment" as C_COMMENT_DELETE
    usecase "Create project" as C_PROJECT_CREATE
    usecase "List projects" as C_PROJECT_LIST
    usecase "Update project" as C_PROJECT_UPDATE
    usecase "Delete project" as C_PROJECT_DELETE
    usecase "Assign task to project" as C_PROJECT_ASSIGN
    usecase "Unassign task from project" as C_PROJECT_UNASSIGN
    usecase "List tasks by project" as C_PROJECT_TASKS
    usecase "Display task summary report" as C_REPORT
    usecase "Export tasks and comments" as C_EXPORT
    usecase "Import tasks and comments" as C_IMPORT
  }
}

