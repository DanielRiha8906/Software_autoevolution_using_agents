@startuml class_diagram

skinparam classAttributeIconSize 0
skinparam classFontStyle bold

package "models" #DDEEFF {
    enum TaskStatus {
        PENDING
        IN_PROGRESS
        DONE
    }

    class Task {
        +id : String
        +title : String
        +description : String [0..1]
        +status : TaskStatus
        +created_at : DateTime
        +updated_at : DateTime
        +due_date : DateTime [0..1]
        --
        +__post_init__() : void
        +to_dict() : Dictionary
        +from_dict(data: Dictionary) : Task
        +mark_in_progress() : void
        +mark_done() : void
        +reopen() : void
        +is_pending() : Boolean
        +is_in_progress() : Boolean
        +is_completed() : Boolean
        +is_overdue() : Boolean
    }

    class TaskComment {
        +id : String
        +task_id : String
        +content : String
        +created_at : DateTime
        +author : String [0..1]
        +updated_at : DateTime [0..1]
        --
        +__post_init__() : void
        +to_dict() : Dictionary
        +from_dict(data: Dictionary) : TaskComment
    }

    class FilterOptions {
        +status : TaskStatus [0..1]
        +due_before : DateTime [0..1]
        +due_after : DateTime [0..1]
        +overdue_only : Boolean
        --
        +__post_init__() : void
    }

    class TaskSummary {
        +total_tasks : Integer
        +pending_count : Integer
        +in_progress_count : Integer
        +done_count : Integer
        +overdue_count : Integer
        +with_due_date_count : Integer
        +completion_rate : Float
        +avg_days_to_completion : Float [0..1]
    }

    Task "1" --> "*" TaskComment : has
}

package "storage" #FFF3CC {
    class JsonStorage {
        -path : String
        -cached_comments : List<Dictionary>
        --
        +JsonStorage(path: String [0..1])
        +load() : List<Dictionary>
        +save(tasks: List<Dictionary>) : void
        +load_comments() : List<Dictionary>
        +save_all(tasks: List<Dictionary>, comments: List<Dictionary>) : void
        +save_comments(comments: List<Dictionary>) : void
    }
}

package "services" #DDFFD4 {
    exception TaskNotFoundError
    exception CommentNotFoundError

    class CommentsService {
        -task_manager : TaskManager
        -storage : JsonStorage
        -comments : Dictionary<String, TaskComment>
        --
        +CommentsService(task_manager: TaskManager, storage: JsonStorage [0..1])
        +add_comment(task_id: String, content: String, author: String [0..1]) : TaskComment
        +list_comments_for_task(task_id: String) : List<TaskComment>
        +get_comment(comment_id: String) : TaskComment
        +delete_comment(comment_id: String) : void
        +edit_comment(comment_id: String, content: String) : TaskComment
        -load() : void
        -persist() : void
        -delete_comments_for_task(task_id: String) : void
    }

    class TaskManager {
        -storage : JsonStorage
        -tasks : Dictionary<String, Task>
        -on_delete_callback : Callable [0..1]
        --
        +TaskManager(storage: JsonStorage [0..1])
        +add(title: String, description: String [0..1]) : Task
        +get(taskId: String) : Task
        +listAll() : List<Task>
        +listByStatus(status: TaskStatus) : List<Task>
        +list_by_date_range(before: DateTime [0..1], after: DateTime [0..1]) : List<Task>
        +list_overdue() : List<Task>
        +apply_filters(options: FilterOptions) : List<Task>
        +update(taskId: String, title: String [0..1], description: String [0..1]) : Task
        +setStatus(taskId: String, status: TaskStatus) : Task
        +delete(taskId: String) : void
        +set_on_delete_callback(callback: Callable) : void
        +markInProgress(taskId: String) : Task
        +markDone(taskId: String) : Task
        +reopen(taskId: String) : Task
        -load() : void
        -persist() : void
    }

    class ImportExportService {
        -task_manager : TaskManager
        -comments_service : CommentsService
        --
        +ImportExportService(task_manager: TaskManager, comments_service: CommentsService)
        +export_to_file(filepath: String) : Integer
        +import_from_file(filepath: String, merge: Boolean [0..1]) : ImportSummary
    }

    class ImportSummary {
        +tasks_imported : Integer
        +tasks_skipped : Integer
        +comments_imported : Integer
        +comments_skipped : Integer
        +skipped_task_ids : List<String>
        +skipped_comment_ids : List<String>
    }

    class TodoService {
        -manager : TaskManager
        -comments_service : CommentsService
        --
        +TodoService(storage: JsonStorage [0..1])
        +addTask(title: String, description: String [0..1]) : Task
        +getTask(taskId: String) : Task
        +listTasks(status: TaskStatus [0..1], due_before: DateTime [0..1], due_after: DateTime [0..1], overdue: Boolean [0..1]) : List<Task>
        +startTask(taskId: String) : Task
        +completeTask(taskId: String) : Task
        +reopenTask(taskId: String) : Task
        +updateTask(taskId: String, title: String [0..1], description: String [0..1]) : Task
        +deleteTask(taskId: String) : void
        +isTaskPending(taskId: String) : Boolean
        +isTaskInProgress(taskId: String) : Boolean
        +isTaskCompleted(taskId: String) : Boolean
        +isTaskOverdue(taskId: String) : Boolean
        +add_comment(taskId: String, content: String, author: String [0..1]) : TaskComment
        +list_comments(taskId: String) : List<TaskComment>
        +get_comment(commentId: String) : TaskComment
        +delete_comment(commentId: String) : void
        +edit_comment(commentId: String, content: String) : TaskComment
        +generate_report() : TaskSummary
    }
}

package "cli" #FFE5E5 {
    class TodoCLI {
        -service : TodoService
        --
        +TodoCLI(storagePath: String [0..1])
        +run(argv: List<String> [0..1]) : Integer
    }

    class InteractiveMenu {
        -service : TodoService
        --
        +InteractiveMenu(storagePath: String [0..1])
        +run() : void
    }
}

Task --> TaskStatus : status
TaskManager --> JsonStorage : storage
TaskManager --> FilterOptions : uses
TaskManager ..> TaskNotFoundError : raises
CommentsService --> TaskManager : task_manager
CommentsService --> JsonStorage : storage
CommentsService ..> TaskNotFoundError : raises
CommentsService ..> CommentNotFoundError : raises
ImportExportService --> TaskManager : task_manager
ImportExportService --> CommentsService : comments_service
ImportExportService --> ImportSummary : returns
TodoService --> TaskManager : manager
TodoService --> CommentsService : comments_service
TodoService --> TaskSummary : generates
TodoCLI --> TodoService : service
TodoCLI --> ImportExportService : import_export
InteractiveMenu --> TodoService : service
InteractiveMenu --> ImportExportService : import_export

@enduml