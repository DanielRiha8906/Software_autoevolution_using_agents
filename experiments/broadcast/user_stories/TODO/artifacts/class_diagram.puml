@startuml class_diagram

skinparam classAttributeIconSize 0
skinparam classFontStyle bold

' ============ LAYER 0: MODELS ============

package "models" #DDEEFF {
    enum TaskStatus {
        PENDING
        IN_PROGRESS
        DONE
    }

    class Task {
        +id : String
        +title : String
        +description : String [0..1]
        +status : TaskStatus
        +created_at : DateTime
        +updated_at : DateTime
        +due_date : DateTime [0..1]
        +project_id : String [0..1]
        --
        +mark_in_progress() : void
        +mark_done() : void
        +reopen() : void
        +is_pending() : Boolean
        +is_in_progress() : Boolean
        +is_completed() : Boolean
        +is_overdue() : Boolean
    }

    class Project {
        +id : String
        +name : String
        +created_at : DateTime
    }

    class TaskComment {
        +id : String
        +task_id : String
        +content : String
        +created_at : DateTime
        +author : String [0..1]
        +updated_at : DateTime [0..1]
    }

    class FilterOptions {
        +status : TaskStatus [0..1]
        +due_before : DateTime [0..1]
        +due_after : DateTime [0..1]
        +overdue_only : Boolean
    }

    class TaskSummary {
        +total_tasks : Integer
        +pending_count : Integer
        +in_progress_count : Integer
        +done_count : Integer
        +overdue_count : Integer
        +completion_rate : Float
    }

    Task "1" --> "*" TaskComment : has
    Task "*" --> "0..1" Project : belongs_to
}

' ============ LAYER 1: STORAGE ============

package "storage" #FFF3CC {
    class JsonStorage {
        -path : String
        -cached_comments : List
        -cached_projects : List
        --
        +load() : List[Dict]
        +save(tasks: List[Dict]) : void
        +load_tasks() : List[Task]
        +save_tasks(tasks: List[Task]) : void
        +load_comments() : List[TaskComment]
        +save_comments(comments: List[TaskComment]) : void
        +load_projects() : List[Project]
        +save_projects(projects: List[Project]) : void
    }
}

' ============ LAYER 2: PROTOCOLS ============

package "protocols" #EEEEFF {
    interface "<<protocol>>\nTaskRepository" {
        +load_tasks() : List[Task]
        +save_tasks(tasks: List[Task]) : void
    }

    interface "<<protocol>>\nCommentRepository" {
        +load_comments() : List[TaskComment]
        +save_comments(comments: List[TaskComment]) : void
    }

    interface "<<protocol>>\nProjectRepository" {
        +load_projects() : List[Project]
        +save_projects(projects: List[Project]) : void
    }

    interface "<<protocol>>\nStorageBackend" {
        +load_tasks() : List[Task]
        +save_tasks(tasks: List[Task]) : void
        +load_comments() : List[TaskComment]
        +save_comments(comments: List[TaskComment]) : void
        +load_projects() : List[Project]
        +save_projects(projects: List[Project]) : void
    }
}

' ============ LAYER 3: DOMAIN ============

package "task_domain" #FFE5CC {
    exception TaskNotFoundError

    class TaskRepositoryImpl {
        -storage : TaskRepository
        -tasks : Dict[String, Task]
        --
        +add(task: Task) : Task
        +get(task_id: String) : Task
        +get_all() : List[Task]
        +get_by_status(status: TaskStatus) : List[Task]
        +update(task: Task) : Task
        +delete(task_id: String) : Task
        +apply_filters(options: FilterOptions) : List[Task]
        -load() : void
        -persist() : void
    }

    TaskRepositoryImpl ..|> "TaskRepository\nProtocol"
    TaskRepositoryImpl "1" --> "*" Task : manages
}

package "comment_domain" #FFE5CC {
    exception CommentNotFoundError

    class CommentRepositoryImpl {
        -storage : CommentRepository
        -comments : Dict[String, TaskComment]
        -on_cascade_delete : Callable [0..1]
        --
        +add(comment: TaskComment) : TaskComment
        +get(comment_id: String) : TaskComment
        +get_all() : List[TaskComment]
        +get_by_task(task_id: String) : List[TaskComment]
        +update(comment: TaskComment) : TaskComment
        +delete(comment_id: String) : TaskComment
        +delete_by_task(task_id: String) : void
        -load() : void
        -persist() : void
    }

    CommentRepositoryImpl ..|> "CommentRepository\nProtocol"
    CommentRepositoryImpl "1" --> "*" TaskComment : manages
}

package "project_domain" #FFE5CC {
    exception ProjectNotFoundError

    class ProjectRepositoryImpl {
        -storage : ProjectRepository
        -projects : Dict[String, Project]
        --
        +add(project: Project) : Project
        +get(project_id: String) : Project
        +get_all() : List[Project]
        +update(project: Project) : Project
        +delete(project_id: String) : Project
        -load() : void
        -persist() : void
    }

    ProjectRepositoryImpl ..|> "ProjectRepository\nProtocol"
    ProjectRepositoryImpl "1" --> "*" Project : manages
}

' ============ LAYER 4: SERVICES ============

package "services" #DDFFD4 {
    class TodoService {
        -manager : TaskManager
        -comments_service : CommentsService
        -project_manager : ProjectManager
        --
        +add_task(title, description) : Task
        +get_task(task_id) : Task
        +list_tasks(...filters) : List[Task]
        +start_task(task_id) : Task
        +complete_task(task_id) : Task
        +reopen_task(task_id) : Task
        +update_task(task_id, title, description) : Task
        +delete_task(task_id) : void
        +add_comment(task_id, content, author) : TaskComment
        +list_comments(task_id) : List[TaskComment]
        +get_comment(comment_id) : TaskComment
        +delete_comment(comment_id) : void
        +edit_comment(comment_id, content) : TaskComment
        +create_project(name) : Project
        +get_project(project_id) : Project
        +list_projects() : List[Project]
        +update_project(project_id, name) : Project
        +delete_project(project_id) : void
        +assign_task_to_project(task_id, project_id) : Task
        +unassign_task_from_project(task_id) : Task
        +generate_report() : TaskSummary
    }

    class TaskManager {
        -storage : TaskRepository
        -task_repo : TaskRepositoryImpl
        --
        +add(title, description) : Task
        +get(task_id) : Task
        +list_all() : List[Task]
        +list_by_status(status) : List[Task]
        +list_overdue() : List[Task]
        +list_by_project(project_id) : List[Task]
        +list_unassigned() : List[Task]
        +set_project(task_id, project_id) : Task
        +apply_filters(options) : List[Task]
        +update(task_id, title, description) : Task
        +set_status(task_id, status) : Task
        +delete(task_id) : void
        +set_on_delete_callback(callback) : void
        +mark_in_progress(task_id) : Task
        +mark_done(task_id) : Task
        +reopen(task_id) : Task
    }

    class CommentsService {
        -task_manager : TaskManager
        -comment_repo : CommentRepositoryImpl
        --
        +add_comment(task_id, content, author) : TaskComment
        +list_comments_for_task(task_id) : List[TaskComment]
        +get_comment(comment_id) : TaskComment
        +delete_comment(comment_id) : void
        +edit_comment(comment_id, content) : TaskComment
    }

    class ProjectManager {
        -project_repo : ProjectRepositoryImpl
        --
        +add(name) : Project
        +get(project_id) : Project
        +list_all() : List[Project]
        +update(project_id, name) : Project
        +delete(project_id) : void
    }

    class ImportExportService {
        -task_manager : TaskManager
        -comments_service : CommentsService
        --
        +export_to_file(filepath) : Integer
        +import_from_file(filepath, merge) : ImportSummary
    }

    class ImportSummary {
        +tasks_imported : Integer
        +tasks_skipped : Integer
        +comments_imported : Integer
        +comments_skipped : Integer
    }

    TodoService --> TaskManager
    TodoService --> CommentsService
    TodoService --> ProjectManager
    ImportExportService --> TaskManager
    ImportExportService --> CommentsService
    CommentsService --> TaskManager
    ImportExportService --> ImportSummary

    TaskManager --> TaskRepositoryImpl
    CommentsService --> CommentRepositoryImpl
    ProjectManager --> ProjectRepositoryImpl

    TaskManager --> TaskNotFoundError
    CommentsService --> CommentNotFoundError
    ProjectManager --> ProjectNotFoundError

    TodoService --> TaskSummary
}

' ============ LAYER 5: PRESENTATION (GUI & CLI) ============

package "gui" #FFE5E5 {
    class TodoGUI {
        -_service : TodoService
        -root : tk.Tk
        -task_tree : ttk.Treeview
        -status_var : tk.StringVar
        -project_var : tk.StringVar
        -overdue_var : tk.BooleanVar
        --
        +__init__(storage_path: String [0..1])
        -_setup_ui() : void
        -_update_project_list() : void
        -_refresh_task_list() : void
        -_get_selected_task_id() : String [0..1]
        -_add_task() : void
        -_on_task_double_click(event) : void
        -_show_task_details(task_id: String) : void
        -_start_task() : void
        -_complete_task() : void
        -_reopen_task() : void
        -_delete_task() : void
        -_add_comment_dialog() : void
        -_view_comments() : void
        +run() : void
    }

    class AddTaskDialog {
        -service : TodoService
        -dialog : tk.Toplevel
        -result : Task [0..1]
        --
        +__init__(parent: tk.Widget, service: TodoService)
        -_add() : void
    }

    class TaskDetailsDialog {
        -task : Task
        -service : TodoService
        -dialog : tk.Toplevel
        --
        +__init__(parent: tk.Widget, task: Task, service: TodoService)
        -_edit_title() : void
        -_edit_description() : void
    }

    class AddCommentDialog {
        -task_id : String
        -service : TodoService
        -dialog : tk.Toplevel
        --
        +__init__(parent: tk.Widget, task_id: String, service: TodoService)
        -_add() : void
    }

    class ViewCommentsDialog {
        -task_id : String
        -service : TodoService
        -dialog : tk.Toplevel
        --
        +__init__(parent: tk.Widget, task_id: String, service: TodoService)
    }

    TodoGUI --> TodoService
    AddTaskDialog --> TodoService
    TaskDetailsDialog --> TodoService
    AddCommentDialog --> TodoService
    ViewCommentsDialog --> TodoService
}

package "cli" #FFE5E5 {
    class TodoCLI {
        -service : TodoService
        --
        +run(argv) : Integer
    }

    class InteractiveMenu {
        -service : TodoService
        --
        +run() : void
    }

    TodoCLI --> TodoService
    TodoCLI --> ImportExportService
    InteractiveMenu --> TodoService
    InteractiveMenu --> ImportExportService
}

' ============ PROTOCOL IMPLEMENTATION ============

JsonStorage ..|> "StorageBackend\nProtocol" : implements

' Cross-layer relationships
TaskRepositoryImpl --|> "TaskRepository\nProtocol" : implements
CommentRepositoryImpl --|> "CommentRepository\nProtocol" : implements
ProjectRepositoryImpl --|> "ProjectRepository\nProtocol" : implements

TaskRepositoryImpl --> "StorageBackend\nProtocol" : depends on
CommentRepositoryImpl --> "StorageBackend\nProtocol" : depends on
ProjectRepositoryImpl --> "StorageBackend\nProtocol" : depends on

' Storage usage
TaskRepositoryImpl --> JsonStorage : constructed with
CommentRepositoryImpl --> JsonStorage : constructed with
ProjectRepositoryImpl --> JsonStorage : constructed with

@enduml
