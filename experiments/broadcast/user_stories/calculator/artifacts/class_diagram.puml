@startuml class_diagram
!define PROTOCOL_COLOR #FFE6E6
!define IMPL_COLOR #E6F2FF
!define SERVICE_COLOR #E6FFE6
!define CLI_COLOR #FFF9E6

' Layer 1: Calculation Engine
package "Calculation Engine Layer" #FFE6E6 {
    interface CalculationEngine <<protocol>> {
        +calculate(operation: Operation, a: float, b: float): float
    }

    class Calculator <<implementation>> {
        -mode: str
        +add(a: float, b: float): float
        +subtract(a: float, b: float): float
        +multiply(a: float, b: float): float
        +divide(a: float, b: float): float
        +square(a: float, b: float): float
        +sqrt(a: float, b: float): float
        +power(a: float, b: float): float
        +modulo(a: float, b: float): float
        +sin(a: float, b: float): float
        +cos(a: float, b: float): float
        +tan(a: float, b: float): float
        +log(a: float, b: float): float
        +ln(a: float, b: float): float
        +exp(a: float, b: float): float
        +calculate(operation: Operation, a: float, b: float): float
    }

    class CalculationLayer {
        -engine: CalculationEngine
        +perform_calculation(operation: Operation, a: float, b: float): CalculationResult
    }

    CalculationEngine <|.. Calculator: implements
    CalculationLayer --> CalculationEngine: uses
}

' Layer 2: Memory/History
package "Memory/History Layer" #E6FFE6 {
    interface MemoryStore <<protocol>> {
        +store(entry: MemoryEntry): void
        +retrieve(): list[MemoryEntry]
        +filter_entries(operation: str, state: str): list[MemoryEntry]
        +get_valid_operations(): list[str]
        +export_history(filepath: str): void
        +import_history(filepath: str, overwrite: bool): tuple[int, list]
        +get_statistics(): dict
        +get_memory_service(): MemoryService
    }

    class MemoryService <<implementation>> {
        -storage: JsonStorage
        -_filter_service: FilterService
        -_export_service: HistoryExportService
        +store(entry: MemoryEntry): void
        +retrieve(): list[MemoryEntry]
        +filter_entries(operation: str, state: str): list[MemoryEntry]
        +get_valid_operations(): list[str]
        +export_history(filepath: str): void
        +import_history(filepath: str, overwrite: bool): tuple
        +get_statistics(): dict
        +get_memory_service(): MemoryService
    }

    class MemoryStoreImpl <<implementation>> {
        -storage: JsonStorage
        -_memory_service: MemoryService
        -_statistics_service: StatisticsService
        +store(entry: MemoryEntry): void
        +retrieve(): list[MemoryEntry]
        +filter_entries(operation: str, state: str): list[MemoryEntry]
        +get_valid_operations(): list[str]
        +export_history(filepath: str): void
        +import_history(filepath: str, overwrite: bool): tuple
        +get_statistics(): dict
        +get_memory_service(): MemoryService
    }

    class MemoryLayer {
        -memory_store: MemoryStore
        +store_entry(entry: MemoryEntry): void
        +retrieve_all(): list[MemoryEntry]
        +retrieve(): list[MemoryEntry]
        +get_statistics(): dict
    }

    MemoryStore <|.. MemoryService: implements
    MemoryStore <|.. MemoryStoreImpl: implements
    MemoryLayer --> MemoryStore: uses
    MemoryStoreImpl --> MemoryService: wraps
}

' Support Classes
package "Storage & Models" #F0F0F0 {
    class JsonStorage {
        +save(result: CalculationResult): void
        +load_memory_all(): list[MemoryEntry]
    }

    class Operation <<enum>> {
        ADD, SUBTRACT, MULTIPLY, DIVIDE
        SQUARE, SQRT, POWER, MODULO
        SIN, COS, TAN, LOG, LN, EXP
    }

    class MemoryEntry <<abstract>> {
        -id: str
        -timestamp: str
        -operation: str
        -operands: list[float]
    }

    class ResultEntry extends MemoryEntry {
        -result: float
        -execution_time_ms: float
    }

    class ErrorEntry extends MemoryEntry {
        -error_message: str
        -execution_time_ms: float
    }

    class CalculationResult {
        -operation: Operation
        -operands: list[float]
        -result: float
        -execution_time_ms: float
    }
}

' Layer 3: Interface
package "Interface Layer" #FFF9E6 {
    class InterfaceLayer {
        -calculation_layer: CalculationLayer
        -memory_layer: MemoryLayer
        -storage: JsonStorage
        +perform(operation: Operation, a: float, b: float): CalculationResult
        +perform_with_memory(operation: Operation, a: float, b: float): ResultEntry | ErrorEntry
        +get_history(): list[CalculationResult]
        +get_memory_history(): list[MemoryEntry]
    }

    class CalculatorCLI {
        -service: CalculatorService
        -memory_store: MemoryStore
        -statistics_service: StatisticsService
        -mode: str
        +run_interactive(): void
        +run_one_shot(operation: str, operands: list[float]): void
    }

    class CalculatorService {
        -interface_layer: InterfaceLayer
        +calculate(operation: Operation, a: float, b: float): CalculationResult
        +get_history(): list[CalculationResult]
    }

    InterfaceLayer --> CalculationLayer: uses
    InterfaceLayer --> MemoryLayer: uses
    CalculatorCLI --> CalculatorService: uses
    CalculatorCLI --> MemoryStore: uses
    CalculatorService --> InterfaceLayer: uses
}

' Dependencies
MemoryService --> JsonStorage: uses
MemoryStoreImpl --> JsonStorage: uses
MemoryLayer --> JsonStorage: uses (indirectly)

@enduml
