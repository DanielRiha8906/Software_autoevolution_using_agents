@startuml

skinparam defaultFontSize 13
skinparam stateFontStyle bold

top to bottom direction

[*] --> Menu

Menu --> FirstOperand : operation selected
Menu --> Feedback : history/memory history selected
Menu --> FilterInput : filter selected
Menu --> StatsDisplay : statistics selected
Menu --> ExportInput : export selected
Menu --> ImportInput : import selected
Menu --> Feedback : invalid choice
Menu --> [*] : exit

StatsDisplay --> Feedback : stats displayed

FirstOperand --> SecondOperand : valid number
FirstOperand --> Feedback : invalid number

SecondOperand --> Calculating : valid number
SecondOperand --> Feedback : invalid number

Calculating --> Feedback : success / show result
Calculating --> Feedback : error / show error

FilterInput --> FilterApply : criteria entered
FilterApply --> Feedback : entries found / show results
FilterApply --> Feedback : no matches

ExportInput --> ExportPerform : filepath entered
ExportInput --> Feedback : cancelled
ExportPerform --> Feedback : export success/error

ImportInput --> ImportOptions : filepath entered
ImportInput --> Feedback : cancelled
ImportOptions --> ImportPerform : overwrite option selected
ImportPerform --> Feedback : import success/error

Feedback --> Menu

@enduml