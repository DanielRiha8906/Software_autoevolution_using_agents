@startuml use_case_diagram

skinparam defaultFontSize 13

left to right direction

actor User

rectangle "Calculator Application" {
    usecase "Perform calculation" as UC_Calc
    usecase "View calculation history" as UC_History
    usecase "View memory history" as UC_MemHistory
    usecase "Filter entries" as UC_Filter
    usecase "View statistics" as UC_Stats
    usecase "Export history to JSON" as UC_Export
    usecase "Import history from JSON" as UC_Import
    usecase "Exit application" as UC_Exit

}

User --> UC_Calc
User --> UC_History
User --> UC_MemHistory
User --> UC_Filter
User --> UC_Stats
User --> UC_Export
User --> UC_Import
User --> UC_Exit

@enduml