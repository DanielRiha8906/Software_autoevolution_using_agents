@startuml component_diagram

skinparam componentStyle uml2
skinparam defaultFontSize 13
left to right direction

package "Calculator Application" {

    component "Entry Point\n(__main__)" as Main
    component "CLI Interface\n(CalculatorCLI)" as CLI
    component "Calculation Service\n(CalculatorService)" as Service
    component "Memory Service\n(MemoryService)" as MemService
    component "Statistics Service\n(StatisticsService)" as StatSvc
    component "Filter Service\n(FilterService)" as FilterSvc
    component "History Export Service\n(HistoryExportService)" as ExportSvc
    component "Calculation Engine\n(Calculator)" as Calc
    component "JSON Storage\n(JsonStorage)" as Store
    component "Domain Models\n(Operation, CalculationResult, MemoryEntry, Statistics)" as Models

    Main --> CLI : initializes
    Main --> Service : initializes
    Main --> MemService : initializes
    Main --> StatSvc : initializes

    CLI --> Service : uses
    CLI --> MemService : uses
    CLI --> StatSvc : uses
    Service --> Calc : uses
    Service --> Store : uses
    MemService --> Store : delegates to
    MemService --> FilterSvc : uses for filtering
    MemService --> ExportSvc : uses for export/import
    StatSvc --> MemService : uses

    Service ..> Models
    MemService ..> Models
    FilterSvc ..> Models
    ExportSvc ..> Models
    StatSvc ..> Models
    Store ..> Models
}

database "calculations.json" as DB
database "calculations_memory.json" as MemDB

Store --> DB : read/write
Store --> MemDB : read/write

@enduml