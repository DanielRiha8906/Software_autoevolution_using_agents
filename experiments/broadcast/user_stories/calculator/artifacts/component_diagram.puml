@startuml component_diagram

!define CALC_COLOR #FFE6E6
!define MEMORY_COLOR #E6FFE6
!define INTERFACE_COLOR #FFF9E6

package "Calculator System" {
    ' Layer 1: Calculation Engine
    package "Layer 1: Calculation Engine" #FFE6E6 {
        component [CalculationEngine Protocol] as CalcProtocol
        component [Calculator\n(Pure Arithmetic)] as CalcImpl
        component [CalculationLayer\n(Wrapper)] as CalcLayer

        CalcProtocol -- CalcImpl: implements
        CalcLayer -- CalcProtocol: delegates to
    }

    ' Layer 2: Memory/History
    package "Layer 2: Memory/History" #E6FFE6 {
        component [MemoryStore Protocol] as MemProtocol
        component [MemoryService\n(Implementation)] as MemService
        component [MemoryStoreImpl\n(Implementation)] as MemStoreImpl
        component [MemoryLayer\n(Wrapper)] as MemLayer
        component [JsonStorage\n(Persistence)] as Storage

        MemProtocol -- MemService: implements
        MemProtocol -- MemStoreImpl: implements
        MemLayer -- MemProtocol: delegates to
        MemService -- Storage: uses
        MemStoreImpl -- Storage: uses
    }

    ' Layer 3: Interface & CLI
    package "Layer 3: Interface Layer" #FFF9E6 {
        component [InterfaceLayer\n(Orchestration)] as Interface
        component [CalculatorService\n(High-level API)] as CalcService
        component [CalculatorCLI\n(User Interaction)] as CLI
    }

    ' Inter-layer Communication
    Interface --> CalcLayer: calculate(operation, a, b)
    Interface --> MemLayer: store_entry()\nretrieve()
    CalcService --> Interface: perform()
    CLI --> CalcService: execute operation
    CLI --> MemProtocol: access memory

    ' External Dependencies
    Interface --> Storage: access history
    CalcService --> Storage: access history
    CLI --> Storage: import/export

}

@enduml
