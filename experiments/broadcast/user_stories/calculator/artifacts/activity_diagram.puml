@startuml activity_diagram

skinparam activityBackgroundColor #DDEEFF
skinparam activityBorderColor #3366AA
skinparam activityDiamondBackgroundColor #FFF3CC

start

if (CLI operation provided?) then (yes)

  :Validate operation and operands;

  if (Input valid?) then (yes)
    :Perform calculation;

    if (Calculation successful?) then (yes)
      :Save result to history;
      :Show result;
      stop
    else (no)
      :Show calculation error;
      stop
    endif

  else (no)
    :Show usage error;
    stop
  endif

else (no)

  repeat
    :Show menu (standard or scientific mode);
    :Read user choice;

    switch (User choice?)

      case (Toggle Mode)
        if (Current mode == standard?) then (yes)
          :Switch to scientific mode;
          :Update menu with scientific operations;
        else (no)
          :Switch to standard mode;
          :Update menu to standard operations only;
        endif

      case (Exit)
        :Show goodbye message;
        stop

      case (History)
        :Load calculation history;
        :Show history;

      case (Memory History)
        :Load memory history;
        :Show memory entries;

      case (Filter)
        :Show filter options;
        :Get filter criteria (operation, state);
        :Query filtered entries;
        if (Entries found?) then (yes)
          :Show filtered results;
        else (no)
          :Show no match message;
        endif

      case (Statistics)
        :Compute statistics from memory;
        :Show operation counts, error rate, avg execution time;

      case (Export History)
        :Prompt for export filepath;
        :Load all memory entries;
        :Serialize to JSON;
        if (Export successful?) then (yes)
          :Show export confirmation;
        else (no)
          :Show export error;
        endif

      case (Import History)
        :Prompt for import filepath;
        :Prompt for overwrite option;
        :Read and validate JSON file;
        :Deserialize and check duplicates;
        :Store imported entries;
        if (Import successful?) then (yes)
          :Show import results and errors;
        else (no)
          :Show import error;
        endif

      case (Operation)
        :Get operation;

        if (Operation is unary?) then (yes)
          :Prompt for one operand;
          if (Input valid?) then (yes)
            :Perform unary calculation;
            if (Calculation successful?) then (yes)
              :Save result to history;
              :Show result as op(a) = r;
            else (no)
              :Show calculation error;
            endif
          else (no)
            :Show input error;
          endif
        else (no)
          :Prompt for two operands;
          if (Input valid?) then (yes)
            :Perform binary calculation;
            if (Calculation successful?) then (yes)
              :Save result to history;
              :Show result as a op b = r;
            else (no)
              :Show calculation error;
            endif
          else (no)
            :Show input error;
          endif
        endif

      case (Invalid choice)
        :Show invalid choice message;

    endswitch

  repeat while (Menu active?) is (yes)

endif

stop

@enduml