@startuml class_diagram

skinparam classAttributeIconSize 0
skinparam classFontStyle bold

package "models" #DDEEFF {
    enum WorkflowStatus {
        QUEUED = "queued"
        IN_PROGRESS = "in_progress"
        COMPLETED = "completed"
        WAITING = "waiting"
        REQUESTED = "requested"
        PENDING = "pending"
    }

    enum WorkflowConclusion {
        SUCCESS = "success"
        FAILURE = "failure"
        CANCELLED = "cancelled"
        SKIPPED = "skipped"
        TIMED_OUT = "timed_out"
        ACTION_REQUIRED = "action_required"
        NEUTRAL = "neutral"
        STALE = "stale"
    }

    class WorkflowRun {
        +id               : str
        +workflow_name    : str
        +branch           : str
        +status           : WorkflowStatus
        +conclusion       : Optional[WorkflowConclusion]
        +created_at       : datetime
        +updated_at       : Optional[datetime]
        +run_number       : Optional[int]
        +commit_sha       : Optional[str]
        --
        +is_running() : bool
        +is_terminal() : bool
        +is_successful() : bool
        +is_failed() : bool
        +is_cancelled() : bool
        +to_dict() : dict
        +{static} from_dict(data: dict) : WorkflowRun
    }

    class WorkflowRunAttempt {
        +id               : int
        +run_id           : int
        +attempt_number   : int
        +status           : str
        +conclusion       : Optional[str]
        +created_at       : datetime
        +duration_seconds : Optional[float]
        --
        +to_dict() : dict
        +{static} from_dict(data: dict) : WorkflowRunAttempt
    }

    class WorkflowRunStatistics {
        +count_by_conclusion : Dict[str, int]
        +average_duration_seconds : float
        +min_duration_seconds : Optional[float]
        +max_duration_seconds : Optional[float]
        +average_attempts_per_run : float
        +per_status_breakdown : Dict[str, float]
        --
        +to_dict() : dict
    }
}

package "storage" #FFF3CC {
    interface "<<Protocol>>\nStorageBackend" as StorageBackend {
        +save(data: List) : None
        +load() : List
    }

    interface "<<Protocol>>\nGitHubAPIClient" as GitHubAPIClient {
        +fetch_workflow_runs(...) : List[WorkflowRun]
        +fetch_incremental(...) : List[WorkflowRun]
    }

    class WorkflowJsonStorage {
        +filepath : str
        --
        +__init__(filepath: str)
        +save(runs: List[WorkflowRun]) : None
        +load() : List[WorkflowRun]
    }

    class AttemptJsonStorage {
        +filepath : str
        --
        +__init__(filepath: str)
        +save(attempts: List[WorkflowRunAttempt]) : None
        +load() : List[WorkflowRunAttempt]
    }

    StorageBackend <|.. WorkflowJsonStorage : implements
    StorageBackend <|.. AttemptJsonStorage : implements
}

package "services" #DDFFD4 {
    class WorkflowRunService {
        -_storage : StorageBackend
        -_runs    : List[WorkflowRun]
        --
        +__init__(storage: StorageBackend)
        +add_workflow_run(run: WorkflowRun) : WorkflowRun
        +list_runs() : List[WorkflowRun]
        +get_run_detail(run_id: str) : Optional[WorkflowRun]
        +filter_by_branch(branch: str) : List[WorkflowRun]
        +filter_by_status(status: WorkflowStatus) : List[WorkflowRun]
        +filter_by_conclusion(conclusion: WorkflowConclusion) : List[WorkflowRun]
        +create_query(attempt_service: AttemptService) : WorkflowQuery
        -_persist() : None
    }

    class WorkflowQuery {
        -_runs : List[WorkflowRun]
        -_attempt_service : Optional[AttemptService]
        --
        +__init__(runs: List[WorkflowRun], attempt_service: Optional[AttemptService])
        +filter_by_duration(min_seconds: Optional[float], max_seconds: Optional[float]) : List[WorkflowRun]
        +filter_by_timestamp(before: Optional[datetime], after: Optional[datetime]) : List[WorkflowRun]
        +filter_by_attempt_presence(has_attempts: bool) : List[WorkflowRun]
        +query(duration_range: Optional[DurationRange], timestamp_range: Optional[TimestampRange], has_attempts: Optional[bool]) : List[WorkflowRun]
    }

    class DurationRange {
        +min_seconds : Optional[float]
        +max_seconds : Optional[float]
    }

    class TimestampRange {
        +before : Optional[datetime]
        +after : Optional[datetime]
    }

    class WorkflowRunTracker {
        -_service : WorkflowRunService
        --
        +__init__(service: WorkflowRunService)
        +track(workflow_name: str, branch: str,\n  status: WorkflowStatus,\n  conclusion: Optional[WorkflowConclusion],\n  run_number: Optional[int],\n  commit_sha: Optional[str],\n  run_id: Optional[str]) : WorkflowRun
    }

    class AttemptService {
        -_storage   : StorageBackend
        -_attempts  : List[WorkflowRunAttempt]
        --
        +__init__(storage: StorageBackend)
        +create_attempt(attempt: WorkflowRunAttempt) : WorkflowRunAttempt
        +get_attempts_for_run(run_id: int) : List[WorkflowRunAttempt]
        +list_all_attempts() : List[WorkflowRunAttempt]
        -_persist() : None
    }

    class WorkflowStatisticsService {
        -_workflow_service : WorkflowRunService
        -_attempt_service : AttemptService
        --
        +__init__(workflow_service: WorkflowRunService, attempt_service: AttemptService)
        +compute_statistics() : WorkflowRunStatistics
    }

    class WorkflowRunExportService {
        --
        +{static} export_to_file(service: WorkflowRunService, filepath: str) : int
        +{static} import_from_file(service: WorkflowRunService, filepath: str) : Tuple[int, List[str]]
    }

    WorkflowRunService "1" --> "1" StorageBackend : -_storage
    WorkflowRunService "1" --> "1" WorkflowQuery : creates
    WorkflowQuery --> DurationRange : uses
    WorkflowQuery --> TimestampRange : uses
    WorkflowQuery --> AttemptService : queries
    WorkflowRunTracker "1" --> "1" WorkflowRunService : -_service
    AttemptService "1" --> "1" StorageBackend : -_storage
    WorkflowStatisticsService "1" --> "1" WorkflowRunService : -_workflow_service
    WorkflowStatisticsService "1" --> "1" AttemptService : -_attempt_service
}

package "adapters" #FFE5E5 {
    class GitHubFetchService {
        -_token : Optional[str]
        -_repo_owner : Optional[str]
        -_repo_name : Optional[str]
        -_use_gh_cli : bool
        --
        +__init__()
        +fetch_workflow_runs(owner: str, repo: str,\n  workflow: Optional[str], token: Optional[str],\n  validate: bool) : List[WorkflowRun]
        +fetch_incremental(owner: str, repo: str,\n  latest_run_timestamp: Optional[datetime],\n  workflow: Optional[str], token: Optional[str]) : List[WorkflowRun]
        -_resolve_token() : str
        -_validate_token(token: str) : bool
        -_check_gh_cli() : bool
        -_fetch_with_gh_cli(...) : List[WorkflowRun]
        -_fetch_with_requests(...) : List[WorkflowRun]
        -_convert_github_run_to_workflow_run(github_run: dict, workflow_name: str) : WorkflowRun
        -_map_github_status(github_status: str) : WorkflowStatus
        -_map_github_conclusion(github_conclusion: Optional[str]) : Optional[WorkflowConclusion]
        -_parse_iso_datetime(dt_str: str) : datetime
    }

    GitHubAPIClient <|.. GitHubFetchService : implements
}

package "cli" #FFE5E5 {
    class "workflow_cli" <<module>> {
        +build_parser() : ArgumentParser
        +run_cli(workflow_service: WorkflowRunService, attempt_service: AttemptService, args) : None
        -_fmt_run(run: WorkflowRun) : str
        -_fmt_attempt(attempt: WorkflowRunAttempt) : str
        -_fmt_statistics(stats) : str
    }

    class "interactive_menu" <<module>> {
        +run_interactive(workflow_service: WorkflowRunService, attempt_service: AttemptService) : None
        -_add_run(service: WorkflowRunService) : None
        -_list_runs(service: WorkflowRunService) : None
        -_detail_run(service: WorkflowRunService) : None
        -_check_state(service: WorkflowRunService) : None
        -_filter_menu(service: WorkflowRunService) : None
        -_create_attempt(attempt_service: AttemptService) : None
        -_list_attempts(attempt_service: AttemptService) : None
        -_query_runs(workflow_service, attempt_service) : None
        -_view_statistics(workflow_service, attempt_service) : None
        -_export_runs(workflow_service: WorkflowRunService) : None
        -_import_runs(workflow_service: WorkflowRunService) : None
        -_fetch_from_github(workflow_service: WorkflowRunService) : None
    }
}

