@startuml activity_diagram_interactive

skinparam activityBackgroundColor #DDEEFF
skinparam activityBorderColor     #3366AA
skinparam activityDiamondBackgroundColor #FFF3CC

start

:Display interactive menu;

repeat

  :Wait for user selection;

  switch (choice)

    case (1 — Add workflow run)
      :Prompt workflow name;
      :Prompt branch;
      :Choose status from list;
      :Choose conclusion (optional, 0 to skip);
      :Prompt run number (optional);
      :Prompt commit SHA (optional);
      :WorkflowRunTracker.track();
      :Print "Added run <id>";

    case (2 — List all runs)
      :WorkflowRunService.list_runs();
      if (no runs?) then (yes)
        :Print "No runs recorded.";
      else (no)
        :Print all runs;
      endif

    case (3 — Get run detail)
      :Prompt run ID;
      :WorkflowRunService.get_run_detail(run_id);
      if (found?) then (yes)
        :Print run details;
      else (no)
        :Print "No run found with id '<id>'";
      endif

    case (4 — Filter runs)
      :Choose filter type\n(branch / status / conclusion);
      if (branch?) then (yes)
        :Prompt branch name;
        :filter_by_branch();
      elseif (status?) then (yes)
        :Choose status from list;
        :filter_by_status();
      else (conclusion)
        :Choose conclusion from list;
        :filter_by_conclusion();
      endif
      if (no matches?) then (yes)
        :Print "No matching runs.";
      else (no)
        :Print matching runs;
      endif

    case (5 — Check run state)
      :Prompt run ID;
      :WorkflowRunService.get_run_detail(run_id);
      if (found?) then (yes)
        :Call is_running();
        :Call is_terminal();
        :Call is_successful();
        :Call is_failed();
        :Call is_cancelled();
        :Print state check results;
      else (no)
        :Print "No run found with id '<id>'";
      endif

    case (6 — Create attempt)
      :Prompt run ID;
      :Prompt attempt ID;
      :Prompt attempt number;
      :Prompt status;
      :Prompt conclusion (optional);
      :Prompt duration (optional);
      :AttemptService.create_attempt();
      if (success?) then (yes)
        :Print "Created attempt <num> for run <id>";
      else (no)
        :Print error message;
      endif

    case (7 — List attempts for run)
      :Prompt run ID;
      :AttemptService.get_attempts_for_run(run_id);
      if (no attempts?) then (yes)
        :Print "No attempts found for run <id>.";
      else (no)
        :Print all attempts (sorted by attempt_number);
      endif

    case (8 — Query runs (advanced))
      :Choose filter type\n(duration / timestamp / attempts);
      if (duration?) then (yes)
        :Prompt min duration (seconds);
        :Prompt max duration (seconds);
      elseif (timestamp?) then (yes)
        :Prompt before timestamp (ISO format);
        :Prompt after timestamp (ISO format);
      else (attempts)
        :Choose: has attempts / no attempts;
      endif
      :WorkflowQuery.query();
      if (no matches?) then (yes)
        :Print "No matching runs.";
      else (no)
        :Print matching runs;
      endif

    case (9 — View statistics)
      :WorkflowStatisticsService.compute_statistics();
      :Print statistics;

    case (10 — Export workflow runs)
      :Prompt output file path;
      :WorkflowRunExportService.export_to_file();
      if (success?) then (yes)
        :Print "Exported <count> run(s) to <filepath>";
      else (no)
        :Print error message;
      endif

    case (11 — Import workflow runs)
      :Prompt input file path;
      :WorkflowRunExportService.import_from_file();
      if (success?) then (yes)
        :Print "Imported <count> run(s) from <filepath>";
        if (skipped entries?) then (yes)
          :Print <count> entries skipped with reasons;
        endif
      else (no)
        :Print error message;
      endif

    case (12 — Exit)
      :Print "Goodbye.";
      stop

  endswitch

repeat while (user continues)

@enduml
