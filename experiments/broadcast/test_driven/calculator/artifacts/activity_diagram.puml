@startuml activity_diagram

skinparam activityBackgroundColor #DDEEFF
skinparam activityBorderColor #3366AA
skinparam activityDiamondBackgroundColor #FFF3CC

start

if (Interface mode?) then (GUI)

  :Launch tkinter window;

  repeat
    :Display buttons & display field;
    :Wait for user interaction;

    switch (User action?)

      case (Digit/operator button)
        :Update display or set operation;

      case (Calculate/equals)
        :Perform calculation via service;
        :Update display with result;

      case (Clear)
        :Reset display and state;

    endswitch

  repeat while (Window open?) is (yes)
  stop

else (CLI)

if (Import/Export requested?) then (yes)

  if (Import?) then (yes)
    :Validate JSON file path;

    if (File exists?) then (yes)
      :Load JSON file;

      if (Valid structure?) then (yes)
        :Merge entries into memory;
        :Skip duplicates;
        :Show success message;
        stop
      else (no)
        :Show JSON validation error;
        stop
      endif
    else (no)
      :Show file not found error;
      stop
    endif

  else (Export?)
    :Retrieve all entries from memory;

    if (Entries exist?) then (yes)
      :Convert to JSON format;
      :Create parent directories;
      :Write to file;
      :Show success message;
      stop
    else (no)
      :Show empty memory error;
      stop
    endif
  endif

else (no)

  if (CLI operation provided?) then (yes)

    :Validate operation and operands;

    if (Input valid?) then (yes)
      :Perform calculation;

      if (Calculation successful?) then (yes)
        :Save result to history;
        :Show result;
        stop
      else (no)
        :Show calculation error;
        stop
      endif

    else (no)
      :Show usage error;
      stop
    endif

  else (no)

    repeat
      :Show menu;
      :Read user choice;

      switch (User choice?)

        case (Exit)
          :Show goodbye message;
          stop

        case (History)
          :Load calculation history;
          :Show history;

        case (Operation)
          :Read operands;

          if (Input valid?) then (yes)
            :Perform calculation;

            if (Calculation successful?) then (yes)
              :Save result to history;
              :Show result;
            else (no)
              :Show calculation error;
            endif

          else (no)
            :Show input error;
          endif

        case (Invalid choice)
          :Show invalid choice message;

      endswitch

    repeat while (Menu active?) is (yes)

  endif

endif

endif

stop

@enduml
