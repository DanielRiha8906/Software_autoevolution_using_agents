@startuml class_diagram

skinparam classAttributeIconSize 0
skinparam classFontStyle bold

' ============================================================================
' LAYER 1: CALCULATION ENGINE (Pure, Stateless Logic)
' ============================================================================
package "LAYER 1: CALCULATION ENGINE (core/)" #FFE5E5 {
    interface "<<protocol>>\nCalculationEngine" as CalcEngineProto {
        +add(a: float, b: float) : float
        +subtract(a: float, b: float) : float
        +multiply(a: float, b: float) : float
        +divide(a: float, b: float) : float
        +square(x: float) : float
        +sqrt(x: float) : float
        +power(x: float, y: float) : float
        +modulo(x: float, y: float) : float
        +calculate(operation, a, b) : float
    }

    class BasicCalculationEngine {
        +add(a: float, b: float) : float
        +subtract(a: float, b: float) : float
        +multiply(a: float, b: float) : float
        +divide(a: float, b: float) : float
        +square(x: float) : float
        +sqrt(x: float) : float
        +power(x: float, y: float) : float
        +modulo(x: float, y: float) : float
        +calculate(operation, a, b) : float
    }

    BasicCalculationEngine ..|> CalcEngineProto : implements
}

' ============================================================================
' LAYER 2: MEMORY/HISTORY MANAGEMENT (Storage & Tracking)
' ============================================================================
package "LAYER 2: MEMORY/HISTORY MANAGEMENT (history/, services/)" #DDFFD4 {
    interface "<<protocol>>\nMemoryManager" as MemoryManagerProto {
        +store(entry: MemoryEntry) : void
        +retrieve() : List[MemoryEntry]
        +query(operation, success) : List[MemoryEntry]
    }

    class MemoryService {
        -_entries : List[MemoryEntry]
        --
        +store(entry: MemoryEntry) : void
        +retrieve() : List[MemoryEntry]
        +query(operation, success) : List[MemoryEntry]
    }

    class CalculatorService {
        -calculator : CalculationEngine
        -storage : JsonStorage
        --
        +perform(operation, a, b) : CalculationResult
        +get_history() : List[CalculationResult]
    }

    class StatisticsService {
        -memory_service : MemoryService
        --
        +compute() : StatisticsReport
    }

    class ImportExportService {
        -memory_service : MemoryService
        --
        +export(filepath) : void
        +import_from(filepath) : void
    }

    MemoryService ..|> MemoryManagerProto : implements
    StatisticsService --> MemoryService : uses
    ImportExportService --> MemoryService : uses
}

package "Storage Layer (storage/)" #FFF3CC {
    class JsonStorage {
        -filepath : String
        --
        +save(result: CalculationResult) : void
        +load_all() : List[CalculationResult]
    }

    CalculatorService --> JsonStorage : persists to
}

' ============================================================================
' LAYER 3: INTERFACE LAYER (User Interaction)
' ============================================================================
package "LAYER 3: INTERFACE LAYER (cli/, interface/)" #DDEEFF {
    interface "<<protocol>>\nUserInterface" as UIProto {
        +run_interactive() : void
        +run_command(operation, a, b) : void
    }

    class CLIBase {
        #_resolve_menu_choice(choice, menu_len) : int
        #_prompt_number(prompt) : float
    }

    class CalculatorCLI {
        -_MENU : List[Operation, str]
        -service : CalculatorService
        --
        +run_interactive() : void
        +run_command(operation, a, b) : void
    }

    CalculatorCLI --|> CLIBase : extends
    CalculatorCLI ..|> UIProto : implements
    CalculatorCLI --> CalculatorService : delegates to
}

' ============================================================================
' SHARED DATA MODELS (models/)
' ============================================================================
package "Shared Data Models (models/)" #F0F0F0 {
    enum Operation {
        ADD
        SUBTRACT
        MULTIPLY
        DIVIDE
        SQUARE
        SQRT
        POWER
        MODULO
        --
        +from_string(value) : Operation
        +display_name() : String
    }

    class CalculationResult {
        +operation : Operation
        +operand_a : float
        +operand_b : float
        +result : float
        +timestamp : String
        +execution_time_ms : float
        --
        +to_dict() : Dictionary
        +from_dict(data) : CalculationResult
    }

    class MemoryEntry {
        +operation : String
        +operands : List[Any]
        +result : Optional[Any]
        +success : Boolean
        +execution_time_ms : float
        +id : String
        +timestamp : String
    }

    class StatisticsReport {
        +count_per_operation : Dict[String, int]
        +total_errors : int
        +error_rate : float
        +avg_execution_time_ms : float
    }
}

' ============================================================================
' DEPENDENCIES (Upward Flow - No Circular Dependencies)
' ============================================================================

' Layer 3 -> Layer 2
CalculatorCLI ..> Operation : uses

' Layer 2 -> Layer 1
CalculatorService --> BasicCalculationEngine : uses
CalculatorService ..> CalculationResult : creates
MemoryService ..> MemoryEntry : manages

' Shared Models
StatisticsService ..> StatisticsReport : creates
JsonStorage ..> CalculationResult : persists

@enduml
@enduml