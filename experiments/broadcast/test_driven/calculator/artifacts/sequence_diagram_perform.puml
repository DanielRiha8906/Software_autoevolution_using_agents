@startuml sequence_diagram_perform

skinparam sequenceParticipantPadding 25
skinparam sequenceActorBorderColor #1F77B4
skinparam sequenceLifeLineBorderColor #1F77B4
skinparam sequenceArrowColor #1F77B4
skinparam noteBkgColor #FFFFCC

' Participants grouped by layer
participant "User" as User #FFE5E5
participant "CalculatorGUI / CalculatorCLI\n(LAYER 3)" as Interface #FFE5E5
participant "CalculatorService\n(LAYER 2)" as Service #DDFFD4
participant "BasicCalculationEngine\n(LAYER 1)" as Engine #FFE5E5
participant "JsonStorage\n(LAYER 2)" as Storage #DDFFD4
participant "time module" as Time

User -> Interface: GUI: button click / CLI: run_command(operation, a, b)
activate Interface

note over Interface
  LAYER 3: INTERFACE LAYER
  GUI parses UI input or CLI parses command line
  Both delegate to service
end note

Interface -> Service: perform(operation, a, b)
activate Service

note over Service
  LAYER 2: ORCHESTRATION
  Coordinate Engine + Storage
  Start timing
end note

Service -> Time: start_time = perf_counter()
activate Time
Time --> Service: start_time (float)
deactivate Time

note over Service, Engine
  Cross-layer call: LAYER 2 -> LAYER 1
  Service uses CalculationEngine protocol
end note

Service -> Engine: calculate(operation, a, b)
activate Engine

note over Engine
  LAYER 1: PURE CALCULATION ENGINE
  No side effects
  Stateless logic only
  Returns result
end note

Engine --> Service: result (float)
deactivate Engine

Service -> Time: end_time = perf_counter()
activate Time
Time --> Service: end_time (float)
deactivate Time

note over Service
  Calculate execution time
  execution_time_ms = (end_time - start_time) * 1000
end note

Service -> Service: Create CalculationResult(\n  operation=operation,\n  operand_a=a,\n  operand_b=b,\n  result=result,\n  execution_time_ms=ms)

note over Service, Storage
  Cross-layer call: LAYER 2 -> Storage
  Persist calculation to JSON file
end note

Service -> Storage: save(calc_result)
activate Storage
Storage --> Service: (void)
deactivate Storage

Service --> Interface: CalculationResult
deactivate Service

note over Interface
  Format and display result
  GUI: update display field / CLI: show calculation & timing
end note

Interface --> User: Display:\nOperation, Operands, Result,\nExecution Time
deactivate Interface

@enduml
