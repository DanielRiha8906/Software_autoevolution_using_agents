@startuml class_diagram

skinparam classAttributeIconSize 0
skinparam classFontStyle bold

package "models" #DDEEFF {
    enum TaskStatus {
        PENDING
        IN_PROGRESS
        DONE
    }

    class Task {
        +id : String
        +title : String
        +description : String [0..1]
        +status : TaskStatus
        +createdAt : DateTime
        +updatedAt : DateTime
        +dueDate : DateTime [0..1]
        --
        +toDict() : Dictionary
        +fromDict(data: Dictionary) : Task
        +markInProgress() : void
        +markDone() : void
        +reopen() : void
        +isCompleted() : bool
        +isPending() : bool
        +isInProgress() : bool
        +isOverdue() : bool
    }

    class TaskComment {
        +id : String
        +taskId : String
        +content : String
        +author : String [0..1]
        +createdAt : DateTime
        +updatedAt : DateTime [0..1]
        --
        +toDict() : Dictionary
        +fromDict(data: Dictionary) : TaskComment
    }
}

package "storage" #FFF3CC {
    class JsonStorage {
        -path : String
        --
        +JsonStorage(path: String [0..1])
        +load() : List<Dictionary>
        +save(tasks: List<Dictionary>) : void
    }
}

package "services" #DDFFD4 {
    exception TaskNotFoundError

    class TaskManager {
        -storage : JsonStorage
        -tasks : Dictionary<String, Task>
        --
        +TaskManager(storage: JsonStorage [0..1])
        +add(title: String, description: String [0..1], due_date: DateTime [0..1]) : Task
        +get(taskId: String) : Task
        +listAll() : List<Task>
        +listByStatus(status: TaskStatus) : List<Task>
        +update(taskId: String, title: String [0..1], description: String [0..1]) : Task
        +setStatus(taskId: String, status: TaskStatus) : Task
        +delete(taskId: String) : void
        -load() : void
        -persist() : void
    }

    class TodoService {
        -manager : TaskManager
        --
        +TodoService(storage: JsonStorage [0..1])
        +addTask(title: String, description: String [0..1], due_date: DateTime [0..1]) : Task
        +getTask(taskId: String) : Task
        +listTasks(status: TaskStatus [0..1], due_before: DateTime [0..1], due_after: DateTime [0..1], overdue: Boolean) : List<Task>
        +startTask(taskId: String) : Task
        +completeTask(taskId: String) : Task
        +reopenTask(taskId: String) : Task
        +updateTask(taskId: String, title: String [0..1], description: String [0..1]) : Task
        +deleteTask(taskId: String) : void
    }

    class TaskStatisticsReport {
        +total : int
        +count_per_status : Dictionary<TaskStatus, int>
        +overdue_count : int
        +with_due_date_count : int
        +completion_rate : float
    }

    class TaskStatisticsService {
        -todo_service : TodoService
        --
        +TaskStatisticsService(todo_service: TodoService)
        +compute() : TaskStatisticsReport
    }
}

package "cli" #FFE5E5 {
    class TodoCLI {
        -service : TodoService
        --
        +TodoCLI(storagePath: String [0..1])
        +run(argv: List<String> [0..1]) : Integer
    }

    class InteractiveMenu {
        -service : TodoService
        --
        +InteractiveMenu(storagePath: String [0..1])
        +run() : void
    }
}

Task --> TaskStatus : status
TaskManager --> JsonStorage : storage
TaskManager ..> TaskNotFoundError : raises
TodoService --> TaskManager : manager
TaskStatisticsService --> TodoService : todo_service
TaskStatisticsService --> TaskStatisticsReport : returns
TodoCLI --> TodoService : service
InteractiveMenu --> TodoService : service

@enduml