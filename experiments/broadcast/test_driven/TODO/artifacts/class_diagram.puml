@startuml class_diagram

skinparam classAttributeIconSize 0
skinparam classFontStyle bold

package "models" #DDEEFF {
    enum TaskStatus {
        PENDING
        IN_PROGRESS
        DONE
    }

    class Project {
        +id : String
        +name : String
        --
        +toDict() : Dictionary
        +fromDict(data: Dictionary) : Project
    }

    class Task {
        +id : String
        +title : String
        +description : String [0..1]
        +status : TaskStatus
        +projectId : String [0..1]
        +createdAt : DateTime
        +updatedAt : DateTime
        +dueDate : DateTime [0..1]
        --
        +toDict() : Dictionary
        +fromDict(data: Dictionary) : Task
        +markInProgress() : void
        +markDone() : void
        +reopen() : void
        +isCompleted() : bool
        +isPending() : bool
        +isInProgress() : bool
        +isOverdue() : bool
    }

    class TaskComment {
        +id : String
        +taskId : String
        +content : String
        +author : String [0..1]
        +createdAt : DateTime
        +updatedAt : DateTime [0..1]
        --
        +toDict() : Dictionary
        +fromDict(data: Dictionary) : TaskComment
    }
}

package "domain" #E8F5E9 {
    interface TaskDomain {
        +add_task(title, description, due_date, project_id) : Task
        +get_task(task_id) : Task
        +list_all_tasks() : List<Task>
        +list_tasks_by_status(status) : List<Task>
        +update_task(task_id, title, description, project_id) : Task
        +set_task_status(task_id, status) : Task
        +delete_task(task_id) : void
    }

    interface CommentDomain {
        +add_comment(task_id, content, author) : TaskComment
        +list_comments_for_task(task_id) : List<TaskComment>
        +get_all_comments() : List<TaskComment>
    }

    interface ProjectDomain {
        +create_project(name) : Project
        +list_all_projects() : List<Project>
    }
}

package "persistence" #FFF9C4 {
    class TaskPersistenceAdapter {
        -storage : JsonStorage
        --
        +TaskPersistenceAdapter(storage: JsonStorage)
        +load() : Dictionary<String, Task>
        +save(tasks: Dictionary<String, Task>) : void
    }

    class CommentPersistenceAdapter {
        -storage : JsonStorage
        --
        +CommentPersistenceAdapter(storage: JsonStorage)
        +load() : Dictionary<String, List<TaskComment>>
        +save(comments: Dictionary<String, List<TaskComment>>) : void
    }

    class ProjectPersistenceAdapter {
        -storage : JsonStorage
        --
        +ProjectPersistenceAdapter(storage: JsonStorage)
        +load() : Dictionary<String, Project>
        +save(projects: Dictionary<String, Project>) : void
    }
}

package "storage" #FFF3CC {
    class JsonStorage {
        -path : String
        --
        +JsonStorage(path: String [0..1])
        +load() : List<Dictionary> | Dictionary
        +save(data: List<Dictionary> | Dictionary) : void
    }
}

package "services" #DDFFD4 {
    exception TaskNotFoundError

    class TaskManager {
        -storage : JsonStorage
        -tasks : Dictionary<String, Task>
        --
        +TaskManager(storage: JsonStorage [0..1])
        +add(title, description, due_date, project_id) : Task
        +get(taskId) : Task
        +listAll() : List<Task>
        +listByStatus(status) : List<Task>
        +update(taskId, title, description, project_id) : Task
        +setStatus(taskId, status) : Task
        +delete(taskId) : void
    }

    class TodoService {
        -manager : TaskManager
        --
        +TodoService(storage: JsonStorage [0..1])
        +addTask(title, description, due_date, project_id) : Task
        +getTask(taskId) : Task
        +listTasks(status, due_before, due_after, overdue, project_id) : List<Task>
        +startTask(taskId) : Task
        +completeTask(taskId) : Task
        +reopenTask(taskId) : Task
        +updateTask(taskId, title, description, project_id) : Task
        +deleteTask(taskId) : void
        +getStorage() : JsonStorage
    }

    class ProjectService {
        -todo_service : TodoService
        -adapter : ProjectPersistenceAdapter
        -projects : Dictionary<String, Project>
        --
        +ProjectService(todo_service: TodoService)
        +create(name) : Project
        +list() : List<Project>
    }

    class CommentsService {
        -todo_service : TodoService [0..1]
        -comments : Dictionary<String, List<TaskComment>>
        --
        +CommentsService(todo_service: TodoService [0..1])
        +addComment(task_id, content, author) : TaskComment
        +listComments(task_id) : List<TaskComment>
        +getAllComments() : List<TaskComment>
        +toDict() : Dictionary
        +fromDict(data: Dictionary) : void
    }

    class TaskImportExportService {
        -todo_service : TodoService
        -comments_service : CommentsService
        --
        +TaskImportExportService(todo_service: TodoService, comments_service: CommentsService)
        +export(path: String) : void
        +importFrom(path: String) : void
    }

    class TaskStatisticsReport {
        +total : int
        +count_per_status : Dictionary<TaskStatus, int>
        +overdue_count : int
        +with_due_date_count : int
        +completion_rate : float
    }

    class TaskStatisticsService {
        -todo_service : TodoService
        --
        +TaskStatisticsService(todo_service: TodoService)
        +compute() : TaskStatisticsReport
    }
}

package "cli" #FFE5E5 {
    class TodoCLI {
        -service : TodoService
        --
        +TodoCLI(storagePath: String [0..1])
        +run(argv: List<String> [0..1]) : Integer
    }

    class InteractiveMenu {
        -service : TodoService
        --
        +InteractiveMenu(storagePath: String [0..1])
        +run() : void
    }
}

Task --> TaskStatus : status
Task --> Project : references (project_id) [0..1]
TaskComment --> Task : references (task_id)

TaskManager --> JsonStorage : uses
TaskManager ..> TaskNotFoundError : raises
TaskManager ..|> TaskDomain : realizes

TodoService --> TaskManager : manager
TodoService --> JsonStorage : accesses via manager
ProjectService --> TodoService : uses
ProjectService --> ProjectPersistenceAdapter : uses
ProjectService --> Project : manages
CommentsService --> TaskComment : manages
CommentsService --> TodoService : optional ref
CommentsService ..|> CommentDomain : realizes
TaskImportExportService --> TodoService : uses
TaskImportExportService --> CommentsService : uses
TaskStatisticsService --> TodoService : uses
TaskStatisticsService --> TaskStatisticsReport : returns

TaskPersistenceAdapter --> JsonStorage : uses
TaskPersistenceAdapter --> Task : loads/saves
CommentPersistenceAdapter --> JsonStorage : uses
CommentPersistenceAdapter --> TaskComment : loads/saves
ProjectPersistenceAdapter --> JsonStorage : uses
ProjectPersistenceAdapter --> Project : loads/saves

TodoCLI --> TodoService : uses
TodoCLI --> CommentsService : uses
TodoCLI --> ProjectService : uses
TodoCLI --> TaskImportExportService : uses
InteractiveMenu --> TodoService : uses
InteractiveMenu --> CommentsService : uses
InteractiveMenu --> ProjectService : uses
InteractiveMenu --> TaskImportExportService : uses

@enduml