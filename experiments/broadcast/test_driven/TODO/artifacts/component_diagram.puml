@startuml component_diagram

skinparam componentStyle uml2
skinparam defaultFontSize 12

left to right direction

package "TODO Application" {

    component "Entry Point" as Main

    package "CLI Layer" {
        component "Interactive Menu" as IM
        component "TodoCLI" as CLI
    }

    package "Service Layer" {
        component "Todo Service" as SVC
        component "Task Manager" as MGR
        component "Project Service" as PS
        component "Comments Service" as CS
        component "Import Export" as IES
        component "Statistics" as SS
    }

    package "Domain Contracts" {
        component "TaskDomain" as TD
        component "CommentDomain" as CD
        component "ProjectDomain" as PD
    }

    package "Persistence Layer" {
        component "Task Adapter" as TA
        component "Comment Adapter" as CA
        component "Project Adapter" as PA
    }

    package "Storage Layer" {
        component "JsonStorage" as Storage
    }

    package "Models" {
        component "Domain Models" as DM
    }
}

database "todo_data.json" as DB

Main --> IM
Main --> CLI

IM --> SVC
IM --> PS
IM --> CS
IM --> IES
IM --> SS
CLI --> SVC
CLI --> PS
CLI --> CS
CLI --> IES
CLI --> SS

SVC --> MGR
PS --> SVC
CS --> SVC
IES --> SVC
IES --> CS
SS --> SVC

MGR --> Storage
TA --> Storage
CA --> Storage
PA --> Storage

MGR ..> DM
CS ..> DM
TA ..> DM
CA ..> DM
PA ..> DM
Storage ..> DM

Storage --> DB

@enduml
