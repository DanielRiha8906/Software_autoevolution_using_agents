@startuml class_diagram

skinparam classAttributeIconSize 0
skinparam classFontStyle bold

package "models" #DDEEFF {
    enum WorkflowStatus {
        QUEUED = "queued"
        IN_PROGRESS = "in_progress"
        COMPLETED = "completed"
        WAITING = "waiting"
        REQUESTED = "requested"
        PENDING = "pending"
    }

    enum WorkflowConclusion {
        SUCCESS = "success"
        FAILURE = "failure"
        CANCELLED = "cancelled"
        SKIPPED = "skipped"
        TIMED_OUT = "timed_out"
        ACTION_REQUIRED = "action_required"
        NEUTRAL = "neutral"
        STALE = "stale"
    }

    class WorkflowRun {
        +id               : str
        +workflow_name    : str
        +branch           : str
        +status           : WorkflowStatus
        +conclusion       : Optional[WorkflowConclusion]
        +created_at       : datetime
        +updated_at       : Optional[datetime]
        +run_number       : Optional[int]
        +commit_sha       : Optional[str]
        +duration_seconds : float
        --
        +is_running() : bool
        +is_terminal() : bool
        +is_successful() : bool
        +is_failed() : bool
        +is_cancelled() : bool
        +to_dict() : dict
        +{static} from_dict(data: dict) : WorkflowRun
    }

    class WorkflowRunAttempt {
        +id               : int
        +run_id           : int
        +attempt_number   : int
        +status           : str
        +conclusion       : str
        +created_at       : datetime
        +duration_seconds : Optional[float]
        --
        +to_dict() : dict
        +{static} from_dict(data: dict) : WorkflowRunAttempt
    }
}

package "storage" #FFF3CC {
    class WorkflowJsonStorage {
        +filepath : str
        --
        +__init__(filepath: str)
        +save(runs: List[WorkflowRun]) : None
        +load() : List[WorkflowRun]
    }
}

package "services" #DDFFD4 {
    class GitHubFetchService {
        -_secrets_path : Optional[str]
        -_token        : Optional[str]
        --
        +__init__(secrets_path: Optional[str] = None)
        +resolve_token() : str
        +fetch(owner: str, repo: str) : List[WorkflowRun]
        -_load_token_from_file() : Optional[str]
        -_convert_to_workflow_run(data: dict) : WorkflowRun
    }

    class WorkflowRunService {
        -_storage : WorkflowJsonStorage
        -_runs    : List[WorkflowRun]
        -_attempt_service : Optional[AttemptService]
        --
        +__init__(storage: WorkflowJsonStorage,\n  attempt_service: Optional[AttemptService] = None)
        +add_workflow_run(run: WorkflowRun) : WorkflowRun
        +list_runs() : List[WorkflowRun]
        +get_run_detail(run_id: str) : Optional[WorkflowRun]
        +filter_by_branch(branch: str) : List[WorkflowRun]
        +filter_by_status(status: WorkflowStatus) : List[WorkflowRun]
        +filter_by_conclusion(conclusion: WorkflowConclusion) : List[WorkflowConclusion]
        +query(min_duration, max_duration,\n  created_before, created_after,\n  has_attempts) : List[WorkflowRun]
        +get_attempts_for_run(run_id: str) : List[WorkflowRunAttempt]
        +add_attempt(attempt: WorkflowRunAttempt) : None
        +attempt_service : Optional[AttemptService]
        -_persist() : None
    }

    class WorkflowRunTracker {
        -_service : WorkflowRunService
        --
        +__init__(service: WorkflowRunService)
        +track(workflow_name: str, branch: str,\n  status: WorkflowStatus,\n  conclusion: Optional[WorkflowConclusion],\n  run_number: Optional[int],\n  commit_sha: Optional[str],\n  run_id: Optional[str]) : WorkflowRun
    }

    class AttemptService {
        -_attempts : List[WorkflowRunAttempt]
        --
        +__init__()
        +create(attempt: WorkflowRunAttempt) : None
        +get_by_run_id(run_id: int) : List[WorkflowRunAttempt]
    }

    class WorkflowStatisticsReport {
        +count_by_conclusion : Dict[WorkflowConclusion, int]
        +avg_duration_seconds : float
        +min_duration_seconds : float
        +max_duration_seconds : float
        +avg_attempts_per_run : float
    }

    class WorkflowStatisticsService {
        -_run_service : WorkflowRunService
        --
        +__init__(run_service: WorkflowRunService)
        +compute() : WorkflowStatisticsReport
    }

    class WorkflowImportExportService {
        -_run_svc : WorkflowRunService
        --
        +__init__(run_svc: WorkflowRunService)
        +export(file_path: str) : None
        +import_from(file_path: str) : None
    }
}

package "cli" #FFE5E5 {
    class "workflow_cli" <<module>> {
        +build_parser() : ArgumentParser
        +run_cli(service: WorkflowRunService, args) : None
        -_fmt_run(run: WorkflowRun) : str
    }

    class "interactive_menu" <<module>> {
        +run_interactive(service: WorkflowRunService) : None
        -_add_run(service: WorkflowRunService) : None
        -_list_runs(service: WorkflowRunService) : None
        -_detail_run(service: WorkflowRunService) : None
        -_filter_menu(service: WorkflowRunService) : None
    }
}

package "gui" #FFD4D4 {
    class WorkflowGUI {
        -service         : WorkflowRunService
        -root            : Optional[tk.Tk]
        -main_frame      : Optional[tk.Frame]
        -tree            : Optional[tk.Treeview]
        -filter_frame    : Optional[tk.Frame]
        -status_var      : Optional[tk.StringVar]
        -conclusion_var  : Optional[tk.StringVar]
        --
        +__init__(service: WorkflowRunService)
        +create_window(title: str) : tk.Tk
        +refresh_runs() : None
        +run() : None
        -_create_filter_ui() : None
        -_create_tree_view() : None
    }
}

