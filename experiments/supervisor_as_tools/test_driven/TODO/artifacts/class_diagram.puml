@startuml class_diagram

skinparam classAttributeIconSize 0
skinparam classFontStyle bold

package "models" #DDEEFF {
    enum TaskStatus {
        PENDING
        IN_PROGRESS
        DONE
    }

    class TaskComment {
        +id : String
        +task_id : String
        +content : String
        +created_at : DateTime
        +author : String [0..1]
        +updated_at : DateTime [0..1]
        --
        +to_dict() : Dictionary
        +from_dict(data: Dictionary) : TaskComment
    }

    class Project {
        +id : String
        +name : String
        --
        +to_dict() : Dictionary
        +from_dict(data: Dictionary) : Project
    }

    class Task {
        +id : String
        +title : String
        +description : String [0..1]
        +status : TaskStatus
        +created_at : DateTime
        +updated_at : DateTime
        +due_date : DateTime [0..1]
        +project_id : String [0..1]
        --
        +to_dict() : Dictionary
        +from_dict(data: Dictionary) : Task
        +mark_in_progress() : void
        +mark_done() : void
        +reopen() : void
        +is_completed() : Boolean
        +is_pending() : Boolean
        +is_in_progress() : Boolean
        +is_overdue() : Boolean
    }

    class TaskStatistics {
        +total : int
        +count_per_status : dict[TaskStatus, int]
        +overdue_count : int
        +with_due_date_count : int
        +completion_rate : float
    }
}

package "storage" #FFF3CC {
    abstract class StorageInterface {
        {abstract} +load() : List<Dictionary>
        {abstract} +save(data: List<Dictionary>) : void
    }

    class JsonStorage {
        -path : Path
        --
        +JsonStorage(path: String [0..1])
        +path : Property[Path]
        +load() : List<Dictionary>
        +save(data: List<Dictionary>) : void
    }

    JsonStorage --|> StorageInterface
}

package "services" #DDFFD4 {
    exception TaskNotFoundError
    exception CommentNotFoundError
    exception ProjectNotFoundError

    class TaskManager {
        -storage : JsonStorage
        -tasks : Dictionary<String, Task>
        --
        +TaskManager(storage: JsonStorage [0..1])
        +add(title: String, description: String [0..1], project_id: String [0..1]) : Task
        +get(task_id: String) : Task
        +get_all_tasks() : List<Task>
        +list_all() : List<Task>
        +list_by_status(status: TaskStatus) : List<Task>
        +list_by_project_id(project_id: String) : List<Task>
        +update(task_id: String, title: String [0..1], description: String [0..1], project_id: String [0..1]) : Task
        +set_status(task_id: String, status: TaskStatus) : Task
        +delete(task_id: String) : void
        +import_tasks(tasks: List<Task>) : void
        -load() : void
        -persist() : void
    }

    class CommentManager {
        -storage : JsonStorage
        -comments : Dictionary<String, TaskComment>
        --
        +CommentManager(storage: JsonStorage [0..1], storage_path: String [0..1])
        +add(task_id: String, content: String) : TaskComment
        +get(comment_id: String) : TaskComment
        +get_all_comments() : List<TaskComment>
        +get_comments_for_task(task_id: String) : List<TaskComment>
        +list_by_task(task_id: String) : List<TaskComment>
        +delete(comment_id: String) : void
        +delete_all_by_task(task_id: String) : void
        +import_comments(comments: List<TaskComment>) : void
        -load() : void
        -persist() : void
    }

    class TodoService {
        -manager : TaskManager
        -comments_service : CommentsService [0..1]
        -comment_manager : CommentManager [0..1]
        --
        +TodoService(storage: JsonStorage [0..1], comment_manager: CommentManager [0..1])
        +add_task(title: String, description: String [0..1], project_id: String [0..1]) : Task
        +get_task(task_id: String) : Task
        +list_tasks(status: TaskStatus [0..1], overdue: Boolean [0..1], due_before: DateTime [0..1], due_after: DateTime [0..1], project_id: String [0..1]) : List<Task>
        +start_task(task_id: String) : Task
        +complete_task(task_id: String) : Task
        +reopen_task(task_id: String) : Task
        +update_task(task_id: String, title: String [0..1], description: String [0..1], project_id: String [0..1]) : Task
        +delete_task(task_id: String) : void
        -_validate_datetime_cest(dt: DateTime, name: String) : void
    }

    class ProjectService {
        -storage : JsonStorage
        -projects : Dictionary<String, Project>
        --
        +ProjectService(todo_service: TodoService [0..1], storage: JsonStorage [0..1], storage_path: String [0..1])
        +create(name: String) : Project
        +get(project_id: String) : Project
        +list() : List<Project>
        +delete(project_id: String) : void
        -load() : void
        -persist() : void
    }

    class CommentsService {
        -todo_service : TodoService
        -comment_manager : CommentManager
        --
        +CommentsService(todo_service: TodoService, storage: JsonStorage [0..1])
        +add_comment(task_id: String, content: String) : TaskComment
        +list_comments(task_id: String) : List<TaskComment>
        +delete_comment(comment_id: String) : void
        +delete_comments_for_task(task_id: String) : void
    }

    class TaskStatisticsService {
        -_service : TodoService
        --
        +TaskStatisticsService(todo_service: TodoService)
        +compute() : TaskStatistics
    }

    class TaskImportExportService {
        -_todo_service : TodoService
        -_comments_service : CommentsService
        --
        +TaskImportExportService(todo_service: TodoService, comments_service: CommentsService)
        +export(filepath: String) : void
        +import_from(filepath: String) : Tuple<List<Task>, List<TaskComment>>
    }

    note on right of TaskImportExportService
        Uses public APIs only:
        - TodoService.list_tasks()
        - CommentsService.list_comments()
        - TaskManager.import_tasks()
        - CommentManager.import_comments()
    end note
}

package "cli" #FFE5E5 {
    class TodoCLI {
        -service : TodoService
        --
        +TodoCLI(storagePath: String [0..1])
        +run(argv: List<String> [0..1]) : Integer
    }

    class InteractiveMenu {
        -service : TodoService
        --
        +InteractiveMenu(storagePath: String [0..1])
        +run() : void
    }
}

Task --> TaskStatus : status
Task --> Project : references (0..1)
TaskComment --> Task : references
TaskManager --> StorageInterface : storage (interface)
TaskManager ..> TaskNotFoundError : raises
ProjectService --> Project : manages
ProjectService --> StorageInterface : storage (interface)
ProjectService ..> ProjectNotFoundError : raises
CommentManager --> StorageInterface : storage (interface)
CommentManager --> TaskComment : manages
CommentManager ..> CommentNotFoundError : raises
TodoService --> TaskManager : manager
TodoService --> CommentManager : optional dependency
CommentsService --> TodoService : todo_service
CommentsService --> CommentManager : comment_manager
TaskStatisticsService --> TodoService : dependency
TaskStatisticsService ..> TaskStatistics : returns
TaskStatistics --> TaskStatus : uses
TaskImportExportService --> TodoService : uses public APIs
TaskImportExportService --> CommentsService : uses public APIs
TodoCLI --> TodoService : service
TodoCLI --> CommentsService : comments_service
TodoCLI --> TaskImportExportService : import_export
InteractiveMenu --> TodoService : service
InteractiveMenu --> CommentsService : comments_service
InteractiveMenu --> TaskImportExportService : import_export

@enduml