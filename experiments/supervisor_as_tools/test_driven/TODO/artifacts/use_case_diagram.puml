@startuml use_case_diagram

left to right direction

actor "CLI User" as CLIUser
actor "GUI User" as GUIUser

rectangle "TODO Manager" {

  package "Interactive mode" {
    usecase "Use interactive menu" as UI
    usecase "Add task" as I_ADD
    usecase "List / filter tasks" as I_LIST
    usecase "Show task details" as I_SHOW
    usecase "Change task status" as I_STATUS
    usecase "Update task" as I_UPDATE
    usecase "Delete task" as I_DELETE
    usecase "Add comment" as I_COMMENT_ADD
    usecase "View comments" as I_COMMENT_LIST
    usecase "Delete comment" as I_COMMENT_DEL
    usecase "Quit application" as I_QUIT
  }

  package "Command-line mode" {
    usecase "Use one-shot CLI command" as CLI
    usecase "Add task" as C_ADD
    usecase "List / filter tasks" as C_LIST
    usecase "Show task details" as C_SHOW
    usecase "Start task" as C_START
    usecase "Complete task" as C_DONE
    usecase "Reopen task" as C_REOPEN
    usecase "Update task" as C_UPDATE
    usecase "Delete task" as C_DELETE
    usecase "Add comment" as C_COMMENT_ADD
    usecase "List comments" as C_COMMENT_LIST
    usecase "Delete comment" as C_COMMENT_DEL
  }

  package "Import/Export mode" {
    usecase "Export tasks and comments" as C_EXPORT
    usecase "Import tasks and comments" as C_IMPORT
  }

  package "GUI mode" {
    usecase "View all tasks in GUI" as G_VIEW_ALL
    usecase "Filter tasks by status" as G_FILTER
    usecase "View overdue tasks" as G_OVERDUE
    usecase "Add task via GUI" as G_ADD
    usecase "Start task via GUI" as G_START
    usecase "Complete task via GUI" as G_COMPLETE
    usecase "Reopen task via GUI" as G_REOPEN
    usecase "Delete task via GUI" as G_DELETE
  }
}

CLIUser --> UI
CLIUser --> CLI
CLIUser --> C_EXPORT
CLIUser --> C_IMPORT
GUIUser --> G_VIEW_ALL
GUIUser --> G_FILTER
GUIUser --> G_OVERDUE
