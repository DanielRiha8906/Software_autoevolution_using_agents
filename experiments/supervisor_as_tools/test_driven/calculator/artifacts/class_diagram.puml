@startuml class_diagram

skinparam classAttributeIconSize 0
skinparam classFontStyle bold

package "models" #DDEEFF {
    enum Operation {
        ADD
        SUBTRACT
        MULTIPLY
        DIVIDE
        SQUARE
        SQRT
        POWER
        MODULO
        --
        +fromString(value: String) : Operation
        +displayName() : String
    }

    class CalculationResult {
        +operation : Operation
        +operandA : float
        +operandB : float
        +result : float
        +timestamp : String
        +execution_time_ms : float
        --
        +toDict() : Dictionary
        +fromDict(data: Dictionary) : CalculationResult
        +toString() : String
    }

    class MemoryEntry {
        +operation : str
        +operands : list
        +result : Optional[float]
        +success : bool
        +execution_time_ms : float
        +id : str
        +timestamp : str
        --
        +__post_init__() : void
        +to_dict() : dict
        +from_dict(data: dict) : MemoryEntry
    }
}

package "services" #DDFFD4 {
    class Calculator {
        +add(a: float, b: float) : float
        +subtract(a: float, b: float) : float
        +multiply(a: float, b: float) : float
        +divide(a: float, b: float) : float
        +square(a: float) : float
        +sqrt(a: float) : float
        +power(a: float, b: float) : float
        +modulo(a: float, b: float) : float
        +calculate(op: Operation, a: float, b: float) : float
    }

    class CalculatorService {
        -calculator : Calculator
        -storage : JsonStorage
        --
        +CalculatorService(calculator: Calculator, storage: JsonStorage)
        +perform(operation: Operation, a: float, b: float) : CalculationResult
        +getHistory() : List<CalculationResult>
    }

    class MemoryService {
        -entries : List<MemoryEntry>
        --
        +MemoryService()
        +store(entry: MemoryEntry) : void
        +retrieve() : List<MemoryEntry>
        +query(operation: Optional[str], success: Optional[bool]) : List<MemoryEntry>
    }
}

package "storage" #FFF3CC {
    class JsonStorage {
        -filepath : String
        --
        +JsonStorage(filepath: String)
        +save(result: CalculationResult) : void
        +loadAll() : List<CalculationResult>
        -readRaw() : List<Dictionary>
        -writeRaw(records: List<Dictionary>) : void
    }
}

package "cli" #FFE5E5 {
    class CalculatorCLI {
        -MENU : List<Tuple<Operation, String>>
        -service : CalculatorService
        -memory_service : MemoryService
        --
        +CalculatorCLI(service: CalculatorService, memory_service: Optional[MemoryService])
        +run_interactive() : void
        +run_command(operation: String, a: float, b: float) : void
        +run_query(operation: Optional[String], success: Optional[bool]) : void
        -_print_menu() : void
        -_resolve_menu_choice(choice: String) : Operation [0..1]
        -_prompt_number(prompt: String) : float [0..1]
        -_show_history() : void
        -_query_history() : void
        -_prompt_optional_filter(prompt: String) : Optional[String]
        -_prompt_success_filter(prompt: String) : Optional[bool]
    }
}

CalculatorCLI --> CalculatorService : service
CalculatorCLI --> MemoryService : memory_service
CalculatorService --> Calculator : calculator
CalculatorService --> JsonStorage : storage

CalculatorService ..> CalculationResult : create
CalculatorService ..> Operation
CalculatorCLI ..> Operation
Calculator ..> Operation
JsonStorage ..> CalculationResult : stores
MemoryService ..> MemoryEntry : manages

@enduml