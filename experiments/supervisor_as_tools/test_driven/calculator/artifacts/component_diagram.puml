@startuml component_diagram

skinparam componentStyle uml2
skinparam defaultFontSize 13
top to bottom direction

package "Calculator Application" {

    package "Interface Layer" #FFE5E5 {
        component "CLI Interface\n(CalculatorCLI)" as CLI
        component "GUI Interface\n(CalculatorGUI)" as GUI
        component "Entry Point\n(__main__)" as Main
        Main --> CLI : initializes
        Main --> GUI : initializes
    }

    package "Calculation Engine" #DDFFD4 {
        component "Scientific Calculator\n(ScientificCalculator)" as Calc
        component "Base Calculator\n(Calculator)" as BasCalc
        BasCalc <|-- Calc : extends
    }

    package "Memory & History" #E5F5FF {
        component "Memory Service\n(MemoryService)" as Memory
        component "Memory Entry\n(MemoryEntry)" as MemEntry
        component "Import/Export\n(ImportExportService)" as ImportExport
        component "Statistics\n(StatisticsService)" as Stats
        Memory --> MemEntry : manages
        ImportExport --> MemEntry : handles
        Stats --> Memory : analyzes
    }

    package "Persistence" #FFF3CC {
        component "JSON Storage\n(JsonStorage)" as Store
    }

    package "Domain Models" #EEEEEE {
        component "Operation Enum" as Op
        component "CalculationResult" as CalcResult
    }

    CLI --> Calc : execute(operation, a, b)
    CLI --> Memory : retrieve history
    CLI --> ImportExport : uses
    GUI --> Calc : execute(operation, a, b)
    GUI --> Op : uses
    Calc --> Op : uses

    component "CalculatorService" as Service
    Service --> Calc : delegate calculation
    Service --> Memory : store MemoryEntry
    Service --> Store : persist CalculationResult
    Service --> CalcResult : create
    Service --> MemEntry : create

    CLI --> Service : orchestrate
    GUI --> Service : delegate calculation
    Store --> CalcResult : serialize/deserialize
    Memory --> Store : import/export via
}

database "calculations.json" as DB

Store --> DB : read/write

@enduml