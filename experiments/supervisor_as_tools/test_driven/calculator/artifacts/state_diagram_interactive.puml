@startuml

skinparam defaultFontSize 13
skinparam stateFontStyle bold

top to bottom direction

[*] --> Menu

Menu --> FirstOperand : operation selected
Menu --> Feedback : history selected
Menu --> QueryFilter : query selected
Menu --> Feedback : invalid choice
Menu --> [*] : exit

FirstOperand --> SecondOperand : valid number
FirstOperand --> Feedback : invalid number

SecondOperand --> Calculating : valid number
SecondOperand --> Feedback : invalid number

Calculating --> Feedback : success / show result
Calculating --> Feedback : error / show error

QueryFilter --> QueryResults : filter applied
QueryResults --> Feedback : results shown

Feedback --> Menu

@enduml