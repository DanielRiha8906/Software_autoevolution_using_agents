@startuml component_diagram

skinparam componentStyle rectangle
skinparam linetype ortho
top to bottom direction

package "GitHub Workflow Manager" {

  package "Application entrypoint" {
    component "main" as MAIN
  }

  package "Interface layer" {
    component "workflow_cli" as CLI
    component "interactive_menu" as IM
    component "WorkflowGUI" as GUI
  }

  package "Service layer" {
    component "WorkflowRunTracker" as TRACKER
    component "WorkflowRunService" as SVC
    component "AttemptService" as ATTEMPTS
    component "WorkflowStatisticsService" as STATS
    component "WorkflowImportExportService" as IMPORT_EXPORT
    component "GitHubFetchService" as FETCH
  }

  package "Storage layer" {
    component "WorkflowJsonStorage" as STOR
    component "AttemptJsonStorage" as ATTEMPT_STOR
    artifact "workflow_runs.json" as JSON_FILE
    artifact "workflow_attempts.json" as ATTEMPT_FILE
  }

  package "Domain model" {
    component "WorkflowRun" as RUN
    component "WorkflowRunAttempt" as ATTEMPT
    component "WorkflowStatus" as STATUS
    component "WorkflowConclusion" as CONCLUSION
    component "WorkflowStatisticsReport" as REPORT
  }

  package "External integrations" {
    component "GitHub CLI" as GH_CLI
  }
}

MAIN --> CLI
MAIN --> IM
MAIN --> GUI

CLI --> TRACKER
IM --> TRACKER

CLI --> SVC
IM --> SVC
GUI --> SVC

TRACKER --> SVC

SVC --> STOR
STOR --> JSON_FILE

ATTEMPTS --> ATTEMPT_STOR
ATTEMPT_STOR --> ATTEMPT_FILE

SVC --> ATTEMPTS
STATS --> SVC
STATS --> ATTEMPTS
IMPORT_EXPORT --> SVC
IMPORT_EXPORT --> ATTEMPTS

SVC ..> RUN
ATTEMPTS ..> ATTEMPT
RUN --> STATUS
RUN --> CONCLUSION
ATTEMPT --> RUN
STATS ..> REPORT
REPORT --> CONCLUSION

FETCH --> GH_CLI
FETCH ..> RUN

@enduml