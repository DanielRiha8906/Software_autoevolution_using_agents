@startuml

start
:Launch application;

repeat
  :Display task list + main menu;
  :Wait for user input;

  switch (choice)
    case (1 — List/filter)
      :Run list/filter flow with date and status;
    case (2 — Add task)
      :Run add task flow;
    case (3 — Show details)
      :Run show details flow;
    case (4 — Change status)
      :Run change status flow;
    case (5 — Update task)
      :Run update task flow;
    case (6 — Delete task)
      :Run delete task flow;
    case (7 — Check status)
      :Run check status flow;
    case (8 — Manage comments)
      :Run comment management flow;
    case (9 — Manage projects)
      :Run project management flow;
    case (10 — Summary report)
      :Run summary report flow;
    case (11 — Import/Export)
      :Run import/export flow;
    case (0/q — Quit)
      :Clear screen;
      stop
    case (other)
      :Show unknown option;
  endswitch

repeat while (user continues)

partition "List/Filter Flow" {
  :Select project filter (all / specific project);
  if (Specific project?) then (yes)
    :Load and display all projects;
    :Pick project by ID;
    :Set project_id filter;
  else (all)
    :Set project_id filter to None;
  endif
  :Select status filter (pending / in progress / done / all);
  :Select date filter option;
  switch (date_filter_choice)
    case (overdue only)
      :Set overdue_only = true;
    case (due before)
      :Input due_before date;
      if (Valid date?) then (yes)
        :Parse to datetime;
      else (invalid)
        :Show error;
        :Return to input;
      endif
    case (due after)
      :Input due_after date;
      if (Valid date?) then (yes)
        :Parse to datetime;
      else (invalid)
        :Show error;
        :Return to input;
      endif
    case (date range)
      :Input due_after and due_before dates;
      if (Both valid?) then (yes)
        :Parse both datetimes;
        if (due_after <= due_before?) then (yes)
          :Proceed with range;
        else (invalid range)
          :Show error: after > before;
          :Return to input;
        endif
      else (invalid)
        :Show error;
        :Return to input;
      endif
    case (no date filter)
      :Skip date filtering;
  endswitch
  :Call list_tasks(status, due_before, due_after, overdue_only, project_id);
  :Display filtered results;
}

partition "Add/Update Task Flow" {
  :Input title, description;
  :Input optional due date;
  if (Due date provided?) then (yes)
    :Convert to CEST timezone;
    if (Valid ISO format?) then (yes)
      :Parse datetime;
    else (invalid)
      :Show error message;
      :Return to input;
    endif
  else (no)
    :Leave due_date as None;
  endif
  :Ask to assign project (yes/no);
  if (Assign to project?) then (yes)
    :Load and display all projects;
    :Pick project by ID;
    :Set project_id for task;
  else (no)
    :Leave project_id as None;
  endif
  :Create/update task with due_date and project_id;
  :Persist to storage;
}

partition "Change Status Flow" {
  :Pick task from list;
  :Select action (start / done / reopen);
  if (Action == start?) then (yes)
    :Call mark_in_progress();
    :Transition PENDING → IN_PROGRESS;
  else
    if (Action == done?) then (yes)
      :Call mark_done();
      :Transition IN_PROGRESS → DONE;
    else
      :Call reopen();
      :Transition DONE → PENDING;
    endif
  endif
  :Update updated_at timestamp;
  :Persist to storage;
  :Display updated task;
}

partition "Check Status Flow" {
  :Pick task from list;
  :Call is_pending(), is_in_progress(), is_completed();
  :Call is_overdue() if due_date exists;
  :Display status results (true/false);
}

partition "Comment Management Flow" {
  :Pick action (add/view/update/delete);
  if (Action == add?) then (yes)
    :Input comment content;
    if (Content empty?) then (yes)
      :Show error: empty content;
      :Return to input;
    else (no)
      :Check if task exists;
      if (Task found?) then (yes)
        :Create comment with task_id;
        :Persist to storage;
        :Show success;
      else (not found)
        :Show error: task not found;
      endif
    endif
  else
    if (Action == view?) then (yes)
      :Pick task from list;
      :Load all comments for task;
      :Display comments;
    else
      if (Action == update?) then (yes)
        :Pick comment to edit;
        :Input new content;
        :Update comment.updated_at;
        :Persist to storage;
      else
        :Pick comment to delete;
        :Remove from storage;
        :Persist changes;
      endif
    endif
  endif
}

partition "Project Management Flow" {
  :Pick action (create/list/update/delete/assign task);
  if (Action == create?) then (yes)
    :Input project name;
    :Input optional description;
    if (Name empty?) then (yes)
      :Show error: name required;
      :Return to input;
    else (no)
      :Create project;
      :Persist to storage;
      :Show success with project ID;
    endif
  else
    if (Action == list?) then (yes)
      :Load all projects;
      :Display project list with IDs and descriptions;
    else
      if (Action == update?) then (yes)
        :Pick project from list (by ID);
        :Input new name and/or description;
        :Update project;
        :Persist to storage;
        :Show success;
      else
        if (Action == delete?) then (yes)
          :Pick project from list (by ID);
          :Confirm deletion;
          if (Confirmed?) then (yes)
            :Delete project;
            :Cascade: unassign all tasks from project;
            :Persist changes;
            :Show success;
          else (no)
            :Cancel deletion;
          endif
        else
          :Pick project from list;
          :Pick task to assign/reassign;
          :Set task.project_id to selected project;
          :Persist changes;
          :Show success;
        endif
      endif
    endif
  endif
}

partition "Summary Report Flow" {
  :Call generate_summary_report();
  :Retrieve report with statistics;
  :- total_count;
  :- pending_count;
  :- in_progress_count;
  :- done_count;
  :- overdue_count;
  :- with_due_date_count;
  :- completion_rate_percent;
  :- average_days_to_completion;
  :Format and display report;
}

partition "Import/Export Flow" {
  :Display import/export menu;
  switch (action)
    case (Export)
      :Input output file path;
      if (Path empty?) then (yes)
        :Show error: path required;
        :Return to menu;
      else (no)
        :Call export_to_json(file_path);
        :Get all tasks from TaskManager;
        :Get all comments from CommentsService;
        :Create export data with version and timestamp;
        :Serialize to JSON;
        if (File write succeeds?) then (yes)
          :Display: Exported N tasks;
        else (error)
          :Display error message;
        endif
      endif
    case (Import)
      :Input input file path;
      if (Path empty?) then (yes)
        :Show error: path required;
        :Return to menu;
      else (no)
        :Call import_from_json(file_path, merge_mode);
        if (File exists?) then (yes)
          :Parse JSON;
          if (Valid JSON?) then (yes)
            if (Has 'tasks' and 'comments' keys?) then (yes)
              :Initialize counters;
              :For each task in JSON;
              :Check if task ID exists;
              if (Exists & skip mode?) then (yes)
                :Increment tasks_skipped;
              else
                :Add/overwrite task;
                :Increment tasks_imported;
              endif
              :For each comment in JSON;
              :Validate referenced task exists;
              if (Task not found?) then (yes)
                :Increment comments_skipped;
              else
                if (Comment ID exists & skip mode?) then (yes)
                  :Increment comments_skipped;
                else
                  :Add/overwrite comment;
                  :Increment comments_imported;
                endif
              endif
              :Display summary: imported X tasks, skipped Y;
            else (missing keys)
              :Display error: missing keys;
            endif
          else (invalid JSON)
            :Display error: invalid JSON;
          endif
        else (file not found)
          :Display error: file not found;
        endif
      endif
  endswitch
}

@enduml