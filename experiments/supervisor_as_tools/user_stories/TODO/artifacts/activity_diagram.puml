@startuml

start
:Launch application;

repeat
  :Display task list + main menu;
  :Wait for user input;

  switch (choice)
    case (1 — List/filter)
      :Run list/filter flow with date and status;
    case (2 — Add task)
      :Run add task flow;
    case (3 — Show details)
      :Run show details flow;
    case (4 — Change status)
      :Run change status flow;
    case (5 — Update task)
      :Run update task flow;
    case (6 — Delete task)
      :Run delete task flow;
    case (7 — Check status)
      :Run check status flow;
    case (8 — Manage comments)
      :Run comment management flow;
    case (9 — Summary report)
      :Run summary report flow;
    case (0/q — Quit)
      :Clear screen;
      stop
    case (other)
      :Show unknown option;
  endswitch

repeat while (user continues)

partition "List/Filter Flow" {
  :Select status filter (pending / in progress / done / all);
  :Select date filter option;
  switch (date_filter_choice)
    case (overdue only)
      :Set overdue_only = true;
    case (due before)
      :Input due_before date;
      if (Valid date?) then (yes)
        :Parse to datetime;
      else (invalid)
        :Show error;
        :Return to input;
      endif
    case (due after)
      :Input due_after date;
      if (Valid date?) then (yes)
        :Parse to datetime;
      else (invalid)
        :Show error;
        :Return to input;
      endif
    case (date range)
      :Input due_after and due_before dates;
      if (Both valid?) then (yes)
        :Parse both datetimes;
        if (due_after <= due_before?) then (yes)
          :Proceed with range;
        else (invalid range)
          :Show error: after > before;
          :Return to input;
        endif
      else (invalid)
        :Show error;
        :Return to input;
      endif
    case (no date filter)
      :Skip date filtering;
  endswitch
  :Call list_tasks(status, due_before, due_after, overdue_only);
  :Display filtered results;
}

partition "Add/Update Task Flow" {
  :Input title, description;
  :Input optional due date;
  if (Due date provided?) then (yes)
    :Convert to CEST timezone;
    if (Valid ISO format?) then (yes)
      :Parse datetime;
    else (invalid)
      :Show error message;
      :Return to input;
    endif
  else (no)
    :Leave due_date as None;
  endif
  :Create/update task with due_date;
  :Persist to storage;
}

partition "Change Status Flow" {
  :Pick task from list;
  :Select action (start / done / reopen);
  if (Action == start?) then (yes)
    :Call mark_in_progress();
    :Transition PENDING → IN_PROGRESS;
  else
    if (Action == done?) then (yes)
      :Call mark_done();
      :Transition IN_PROGRESS → DONE;
    else
      :Call reopen();
      :Transition DONE → PENDING;
    endif
  endif
  :Update updated_at timestamp;
  :Persist to storage;
  :Display updated task;
}

partition "Check Status Flow" {
  :Pick task from list;
  :Call is_pending(), is_in_progress(), is_completed();
  :Call is_overdue() if due_date exists;
  :Display status results (true/false);
}

partition "Comment Management Flow" {
  :Pick action (add/view/update/delete);
  if (Action == add?) then (yes)
    :Input comment content;
    if (Content empty?) then (yes)
      :Show error: empty content;
      :Return to input;
    else (no)
      :Check if task exists;
      if (Task found?) then (yes)
        :Create comment with task_id;
        :Persist to storage;
        :Show success;
      else (not found)
        :Show error: task not found;
      endif
    endif
  else
    if (Action == view?) then (yes)
      :Pick task from list;
      :Load all comments for task;
      :Display comments;
    else
      if (Action == update?) then (yes)
        :Pick comment to edit;
        :Input new content;
        :Update comment.updated_at;
        :Persist to storage;
      else
        :Pick comment to delete;
        :Remove from storage;
        :Persist changes;
      endif
    endif
  endif
}

partition "Summary Report Flow" {
  :Call generate_summary_report();
  :Retrieve report with statistics;
  :- total_count;
  :- pending_count;
  :- in_progress_count;
  :- done_count;
  :- overdue_count;
  :- with_due_date_count;
  :- completion_rate_percent;
  :- average_days_to_completion;
  :Format and display report;
}

@enduml