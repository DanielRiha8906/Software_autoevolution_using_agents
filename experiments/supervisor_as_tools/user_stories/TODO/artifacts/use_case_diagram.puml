actor User

rectangle "TODO Manager" {

  package "Project Management" {
    usecase "Create project" as CREATE_PROJECT
    usecase "Read project" as READ_PROJECT
    usecase "List projects" as LIST_PROJECTS
    usecase "Update project" as UPDATE_PROJECT
    usecase "Delete project" as DELETE_PROJECT
    usecase "Assign task to project" as ASSIGN_TASK_PROJECT
    usecase "Unassign task from project" as UNASSIGN_TASK_PROJECT
  }

  package "Comment Management" {
    usecase "Add comment to task" as ADD_COMMENT
    usecase "View task comments" as VIEW_COMMENTS
    usecase "View single comment" as VIEW_COMMENT
    usecase "Update comment" as UPDATE_COMMENT
    usecase "Delete comment" as DELETE_COMMENT
  }

  package "Import/Export" {
    usecase "Export tasks and comments to JSON file" as EXPORT
    usecase "Import tasks and comments from JSON file" as IMPORT
  }

  package "Interactive mode" {
    usecase "Use interactive menu" as UI
    usecase "Add task" as I_ADD
    usecase "List / filter tasks" as I_LIST
    usecase "Show task details" as I_SHOW
    usecase "Change task status" as I_STATUS
    usecase "Update task" as I_UPDATE
    usecase "Delete task" as I_DELETE
    usecase "Check task status" as I_CHECK
    usecase "Manage comments" as I_MANAGE_COMMENTS
    usecase "Manage projects" as I_MANAGE_PROJECTS
    usecase "View summary report" as I_SUMMARY
    usecase "Set task due date" as I_DUEDATE
    usecase "View task due date" as I_VIEWDUE
    usecase "Assign task to project" as I_ASSIGN_PROJECT
    usecase "Quit application" as I_QUIT
  }

  package "Command-line mode" {
    usecase "Use one-shot CLI command" as CLI
    usecase "Add task" as C_ADD
    usecase "List / filter tasks" as C_LIST
    usecase "Show task details" as C_SHOW
    usecase "Start task" as C_START
    usecase "Complete task" as C_DONE
    usecase "Reopen task" as C_REOPEN
    usecase "Update task" as C_UPDATE
    usecase "Delete task" as C_DELETE
    usecase "Mark in-progress" as C_MARK_IN_PROG
    usecase "Mark done" as C_MARK_DONE
    usecase "Check if pending" as C_IS_PENDING
    usecase "Check if in-progress" as C_IS_IN_PROG
    usecase "Check if completed" as C_IS_COMPLETED
    usecase "Check if overdue" as C_IS_OVERDUE
    usecase "Create project" as C_CREATE_PROJECT
    usecase "List projects" as C_LIST_PROJECTS
    usecase "Update project" as C_UPDATE_PROJECT
    usecase "Delete project" as C_DELETE_PROJECT
    usecase "View summary report" as C_SUMMARY
    usecase "Set task due date" as C_DUEDATE
  }
}

