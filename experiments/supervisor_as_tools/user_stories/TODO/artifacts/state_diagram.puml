@startuml

[*] --> PENDING

PENDING --> IN_PROGRESS : mark_in_progress()
IN_PROGRESS --> DONE : mark_done()
IN_PROGRESS --> PENDING : reopen()
DONE --> PENDING : reopen()

note right of PENDING
  is_pending() == true
end note

note right of IN_PROGRESS
  is_in_progress() == true
end note

note right of DONE
  is_completed() == true
end note

@enduml