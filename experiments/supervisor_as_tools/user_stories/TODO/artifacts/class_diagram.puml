@startuml class_diagram

skinparam classAttributeIconSize 0
skinparam classFontStyle bold

package "models" #DDEEFF {
    enum TaskStatus {
        PENDING
        IN_PROGRESS
        DONE
    }

    class Task {
        +id : String
        +title : String
        +description : String [0..1]
        +due_date : DateTime [0..1]
        +status : TaskStatus
        +createdAt : DateTime
        +updatedAt : DateTime
        +comments : List<TaskComment> [0..*]
        --
        +toDict() : Dictionary
        +fromDict(data: Dictionary) : Task
    }

    class TaskComment {
        +id : String
        +task_id : String
        +content : String
        +author : String [0..1]
        +created_at : DateTime
        +updated_at : DateTime [0..1]
        --
        +toDict() : Dictionary
        +fromDict(data: Dictionary) : TaskComment
    }
}

package "storage" #FFF3CC {
    class JsonStorage {
        -path : String
        --
        +JsonStorage(path: String [0..1])
        +load() : List<Dictionary>
        +save(tasks: List<Dictionary>) : void
    }
}

package "services" #DDFFD4 {
    exception TaskNotFoundError
    exception CommentNotFoundError

    class TaskManager {
        -storage : JsonStorage
        -tasks : Dictionary<String, Task>
        --
        +TaskManager(storage: JsonStorage [0..1])
        +add(title: String, description: String [0..1]) : Task
        +get(taskId: String) : Task
        +listAll() : List<Task>
        +listByStatus(status: TaskStatus) : List<Task>
        +update(taskId: String, title: String [0..1], description: String [0..1], due_date: DateTime [0..1]) : Task
        +setStatus(taskId: String, status: TaskStatus) : Task
        +delete(taskId: String) : void
        +addComment(taskId: String, content: String, author: String [0..1]) : TaskComment
        +listComments(taskId: String) : List<TaskComment>
        +deleteComment(taskId: String, commentId: String) : void
        -load() : void
        -persist() : void
    }

    class CommentsService {
        -manager : TaskManager
        --
        +CommentsService(manager: TaskManager)
        +addComment(taskId: String, content: String, author: String [0..1]) : TaskComment
        +listComments(taskId: String) : List<TaskComment>
        +deleteComment(taskId: String, commentId: String) : void
        +editComment(taskId: String, commentId: String, newContent: String) : TaskComment
    }

    class TodoService {
        -manager : TaskManager
        -commentsService : CommentsService
        --
        +TodoService(storage: JsonStorage [0..1])
        +addTask(title: String, description: String [0..1]) : Task
        +getTask(taskId: String) : Task
        +listTasks(status: TaskStatus [0..1]) : List<Task>
        +startTask(taskId: String) : Task
        +completeTask(taskId: String) : Task
        +reopenTask(taskId: String) : Task
        +updateTask(taskId: String, title: String [0..1], description: String [0..1]) : Task
        +deleteTask(taskId: String) : void
        +addCommentToTask(taskId: String, content: String, author: String [0..1]) : TaskComment
        +listTaskComments(taskId: String) : List<TaskComment>
        +deleteTaskComment(taskId: String, commentId: String) : void
        +editTaskComment(taskId: String, commentId: String, newContent: String) : TaskComment
    }
}

package "cli" #FFE5E5 {
    class TodoCLI {
        -service : TodoService
        --
        +TodoCLI(storagePath: String [0..1])
        +run(argv: List<String> [0..1]) : Integer
    }

    class InteractiveMenu {
        -service : TodoService
        --
        +InteractiveMenu(storagePath: String [0..1])
        +run() : void
    }
}

Task --> TaskStatus : status
Task --> TaskComment : comments
TaskComment --> Task : belongs to
TaskManager --> JsonStorage : storage
TaskManager ..> TaskNotFoundError : raises
TaskManager ..> CommentNotFoundError : raises
CommentsService --> TaskManager : manager
CommentsService ..> TaskNotFoundError : raises
CommentsService ..> CommentNotFoundError : raises
TodoService --> TaskManager : manager
TodoService --> CommentsService : commentsService
TodoCLI --> TodoService : service
InteractiveMenu --> TodoService : service

@enduml