        -comment_var : StringVar
        --
        +CommentsDialog(parent: Widget, task_id: String, task_title: String, service: TodoService)
        +_build_widgets() : void
        +_populate_comments() : void
        +on_add_comment() : void
        +on_delete_comment() : void
    }
}

