@startuml class_diagram

skinparam classAttributeIconSize 0
skinparam classFontStyle bold

package "models" #DDEEFF {
    enum TaskStatus {
        PENDING
        IN_PROGRESS
        DONE
    }

    class Project {
        +id : String
        +name : String
        +description : String [0..1]
        +created_at : DateTime
        +updated_at : DateTime
        --
        +to_dict() : Dictionary
        +from_dict(data: Dictionary) : Project
    }

    class Task {
        +id : String
        +title : String
        +description : String [0..1]
        +status : TaskStatus
        +createdAt : DateTime
        +updatedAt : DateTime
        +due_date : DateTime [0..1]
        +project_id : String [0..1]
        --
        +toDict() : Dictionary
        +fromDict(data: Dictionary) : Task
        +is_pending() : Boolean
        +is_in_progress() : Boolean
        +is_completed() : Boolean
        +is_overdue() : Boolean
        +mark_in_progress() : Task
        +mark_done() : Task
        +reopen() : Task
    }

    class TaskComment {
        +id : String
        +task_id : String
        +content : String
        +created_at : DateTime
        +updated_at : DateTime
        +author : String [0..1]
        --
        +to_dict() : Dictionary
        +from_dict(data: Dictionary) : TaskComment
    }

    class TaskSummaryReport {
        +total_count : Integer
        +pending_count : Integer
        +in_progress_count : Integer
        +done_count : Integer
        +overdue_count : Integer
        +with_due_date_count : Integer
        +completion_rate_percent : Float
        +average_days_to_completion : Float [0..1]
        --
        +__str__() : String
    }
}

package "utils" #E8F8E8 {
    class DateTimeUtils {
        +toCest(dt: DateTime [0..1]) : DateTime [0..1]
        +parseDatetimeOrIsoString(value: String [0..1]) : DateTime [0..1]
        +isDatetimeInRange(dt: DateTime [0..1], start: DateTime [0..1], end: DateTime [0..1]) : Boolean
    }
}

package "storage" #FFF3CC {
    interface TaskRepository {
        +load() : List<Dictionary>
        +save(tasks: List<Dictionary>) : void
    }

    interface CommentRepository {
        +load() : List<Dictionary>
        +save(comments: List<Dictionary>) : void
    }

    interface ProjectRepository {
        +load() : List<Dictionary>
        +save(projects: List<Dictionary>) : void
    }

    class JsonStorage {
        -path : String
        --
        +JsonStorage(path: String [0..1])
        +load() : List<Dictionary>
        +save(tasks: List<Dictionary>) : void
    }

    class ProjectStorage {
        -path : String
        --
        +ProjectStorage(path: String [0..1])
        +load() : List<Dictionary>
        +save(projects: List<Dictionary>) : void
    }

    JsonStorage ..|> TaskRepository : implements
    JsonStorage ..|> CommentRepository : implements
    ProjectStorage ..|> ProjectRepository : implements
}

package "services" #DDFFD4 {
    exception TaskNotFoundError
    exception CommentNotFoundError
    exception ProjectNotFoundError

    class ProjectManager {
        -storage : ProjectRepository
        -projects : Dictionary<String, Project>
        --
        +ProjectManager(storage: ProjectRepository [0..1])
        +add(name: String, description: String [0..1]) : Project
        +get(project_id: String) : Project
        +list_all() : List<Project>
        +update(project_id: String, name: String [0..1], description: String [0..1]) : Project
        +delete(project_id: String) : void
        -load() : void
        -persist() : void
    }

    class TaskManager {
        -storage : TaskRepository
        -tasks : Dictionary<String, Task>
        --
        +TaskManager(storage: TaskRepository [0..1])
        +add(title: String, description: String [0..1], due_date: DateTime [0..1], project_id: String [0..1]) : Task
        +get(taskId: String) : Task
        +listAll() : List<Task>
        +listByStatus(status: TaskStatus) : List<Task>
        +listByDueDateBefore(due_before: DateTime) : List<Task>
        +listByDueDateAfter(due_after: DateTime) : List<Task>
        +listByDueDateRange(start: DateTime [0..1], end: DateTime [0..1]) : List<Task>
        +listOverdue() : List<Task>
        +listByProject(project_id: String) : List<Task>
        +listByProjectWithFilters(project_id: String [0..1], status: TaskStatus [0..1], due_before: DateTime [0..1], due_after: DateTime [0..1], overdue_only: Boolean) : List<Task>
        +listByStatusWithFilters(status: TaskStatus [0..1], due_before: DateTime [0..1], due_after: DateTime [0..1], overdue_only: Boolean, project_id: String [0..1]) : List<Task>
        +update(taskId: String, title: String [0..1], description: String [0..1], due_date: DateTime [0..1]) : Task
        +setStatus(taskId: String, status: TaskStatus) : Task
        +delete(taskId: String) : void
        +unassign_project(project_id: String) : Integer
        -load() : void
        -persist() : void
        -validateDueDate(due_date: DateTime [0..1]) : DateTime [0..1]
    }

    class CommentsService {
        -storage : CommentRepository
        -comments : Dictionary<String, TaskComment>
        -task_manager : TaskManager
        --
        +CommentsService(task_manager: TaskManager, storage: CommentRepository [0..1])
        +add(task_id: String, content: String) : TaskComment
        +get(comment_id: String) : TaskComment
        +list_by_task(task_id: String) : List<TaskComment>
        +update(comment_id: String, content: String) : TaskComment
        +delete(comment_id: String) : void
        +delete_by_task(task_id: String) : void
        +validate_task_exists(task_id: String) : void
        -load() : void
        -persist() : void
    }

    class ImportExportService {
        -task_manager : TaskManager
        -comments_service : CommentsService
        --
        +ImportExportService(task_manager: TaskManager, comments_service: CommentsService)
        +export_to_json(file_path: String) : Integer
        +import_from_json(file_path: String, merge_mode: String) : Tuple<Integer, Integer, Integer, Integer>
    }

    class TodoService {
        -manager : TaskManager
        -comments_service : CommentsService
        -project_manager : ProjectManager
        --
        +TodoService(storage: JsonStorage [0..1])
        +addTask(title: String, description: String [0..1], due_date: DateTime [0..1], project_id: String [0..1]) : Task
        +getTask(taskId: String) : Task
        +listTasks(status: TaskStatus [0..1], due_before: DateTime [0..1], due_after: DateTime [0..1], overdue_only: Boolean, project_id: String [0..1]) : List<Task>
        +startTask(taskId: String) : Task
        +completeTask(taskId: String) : Task
        +reopenTask(taskId: String) : Task
        +updateTask(taskId: String, title: String [0..1], description: String [0..1], due_date: DateTime [0..1]) : Task
        +deleteTask(taskId: String) : void
        +mark_in_progress(taskId: String) : Task
        +mark_done(taskId: String) : Task
        +reopen(taskId: String) : Task
        +is_pending(taskId: String) : Boolean
        +is_in_progress(taskId: String) : Boolean
        +is_completed(taskId: String) : Boolean
        +is_overdue(taskId: String) : Boolean
        +add_comment(task_id: String, content: String) : TaskComment
        +get_comment(comment_id: String) : TaskComment
        +list_task_comments(task_id: String) : List<TaskComment>
        +update_comment(comment_id: String, content: String) : TaskComment
        +delete_comment(comment_id: String) : void
        +add_project(name: String, description: String [0..1]) : Project
        +get_project(project_id: String) : Project
        +list_projects() : List<Project>
        +update_project(project_id: String, name: String [0..1], description: String [0..1]) : Project
        +delete_project(project_id: String) : void
        +generate_summary_report() : TaskSummaryReport
        +export_to_json(file_path: String) : Integer
        +import_from_json(file_path: String, merge_mode: String) : Tuple<Integer, Integer, Integer, Integer>
    }
}

package "cli" #FFE5E5 {
    class TodoCLI {
        -service : TodoService
        --
        +TodoCLI(storagePath: String [0..1])
        +run(argv: List<String> [0..1]) : Integer
        +_cmd_report(args: argparse.Namespace) : Integer
        +_cmd_export(args: argparse.Namespace) : Integer
        +_cmd_import(args: argparse.Namespace) : Integer
    }

    class InteractiveMenu {
        -service : TodoService
        --
        +InteractiveMenu(storagePath: String [0..1])
        +run() : void
        +_do_summary_report() : void
        +_do_import_export() : void
        +_do_export_menu() : void
        +_do_import_menu() : void
    }
}

package "gui" #FFCCCC {
    class MainWindow {
        -root : Tk
        -service : TodoService
        -treeview : Treeview
        -status_var : StringVar
        -project_var : StringVar
        --
        +MainWindow(root: Tk)
        +_build_widgets() : void
        +_populate_project_filter() : void
        +_populate_treeview() : void
        +on_filter_changed() : void
        +on_refresh_clicked() : void
        +on_add_task_clicked() : void
        +on_view_task_clicked() : void
        +on_delete_task_clicked() : void
        +on_mark_done_clicked() : void
        +on_mark_progress_clicked() : void
        +on_comments_clicked() : void
    }

    class AddTaskDialog {
