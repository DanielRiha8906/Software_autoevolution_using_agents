@startuml component_diagram

skinparam componentStyle rectangle
skinparam linetype ortho
top to bottom direction

package "GitHub Workflow Manager" {

  package "Application entrypoint" {
    component "main" as MAIN
  }

  package "Interface layer" {
    component "workflow_cli" as CLI
    component "interactive_menu" as IM
  }

  package "Service layer" {
    component "WorkflowRunTracker" as TRACKER
    component "WorkflowRunService" as SVC
    component "AttemptService" as ATTEMPT
    component "StatisticsService" as STATS
    component "GitHubImportService" as IMPORT
  }

  package "GitHub API integration" #CCDDFF {
    component "GitHubApiClient" as GITHUB_CLIENT
    component "TokenResolver" as TOKEN_RESOLVER
    component "GitHubRunMapper" as MAPPER
  }

  package "Persistence layer" {
    interface "StorageAdapter" as ADAPTER
    component "WorkflowJsonStorage" as STOR
    artifact "workflow_runs.json" as JSON_FILE
  }

  package "Domain model" {
    component "WorkflowRun" as RUN
    component "WorkflowStatus" as STATUS
    component "WorkflowConclusion" as CONCLUSION
  }
}

cloud "GitHub API" as GITHUB_API

MAIN --> CLI
MAIN --> IM

CLI --> TRACKER
IM --> TRACKER

CLI --> SVC
IM --> SVC

CLI --> ATTEMPT
IM --> ATTEMPT

CLI --> STATS
IM --> STATS

CLI --> IMPORT
IM --> IMPORT

TRACKER --> SVC
ATTEMPT --> SVC
IMPORT --> SVC
STATS --> SVC
SVC --> ADAPTER
STOR ..|> ADAPTER
STOR --> JSON_FILE

IMPORT --> GITHUB_CLIENT
IMPORT --> TOKEN_RESOLVER
IMPORT --> MAPPER

GITHUB_CLIENT --> GITHUB_API
MAPPER --> RUN

SVC ..> RUN
RUN --> STATUS
RUN --> CONCLUSION
STATS ..> RUN

@enduml