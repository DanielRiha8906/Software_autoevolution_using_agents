package "models" #DDEEFF {
    enum WorkflowStatus {
        QUEUED = "queued"
        IN_PROGRESS = "in_progress"
        COMPLETED = "completed"
        WAITING = "waiting"
        REQUESTED = "requested"
        PENDING = "pending"
    }

    enum WorkflowConclusion {
        SUCCESS = "success"
        FAILURE = "failure"
        CANCELLED = "cancelled"
        SKIPPED = "skipped"
        TIMED_OUT = "timed_out"
        ACTION_REQUIRED = "action_required"
        NEUTRAL = "neutral"
        STALE = "stale"
    }

    enum WorkflowAttemptStatus {
        QUEUED = "queued"
        IN_PROGRESS = "in_progress"
        COMPLETED = "completed"
        WAITING = "waiting"
        REQUESTED = "requested"
        PENDING = "pending"
    }

    enum WorkflowAttemptConclusion {
        SUCCESS = "success"
        FAILURE = "failure"
        CANCELLED = "cancelled"
        SKIPPED = "skipped"
        TIMED_OUT = "timed_out"
        ACTION_REQUIRED = "action_required"
        NEUTRAL = "neutral"
        STALE = "stale"
    }

    class WorkflowRun {
        +id               : str
        +workflow_name    : str
        +branch           : str
        +status           : WorkflowStatus
        +conclusion       : Optional[WorkflowConclusion]
        +created_at       : datetime
        +updated_at       : Optional[datetime]
        +run_number       : Optional[int]
        +commit_sha       : Optional[str]
        +duration_seconds : float = 0.0
        +attempts         : list[WorkflowRunAttempt]
        --
        +to_dict() : dict
        +{static} from_dict(data: dict) : WorkflowRun
        +{static} validate_dict(data: dict) : None
        +is_terminal() : bool
        +is_running() : bool
        +is_successful() : bool
        +is_failed() : bool
        +is_cancelled() : bool
    }

    class WorkflowRunAttempt {
        +id                 : int
        +run_id             : int
        +attempt_number     : int
        +status             : WorkflowAttemptStatus
        +conclusion         : Optional[WorkflowAttemptConclusion]
        +created_at         : datetime
        +duration_seconds   : Optional[float]
        --
        +to_dict() : dict
        +{static} from_dict(data: dict) : WorkflowRunAttempt
        +{static} validate_dict(data: dict) : None
    }

    class ValidationError <<Exception>> {
        -_messages : list[str]
        --
        +__init__(messages: Union[str, list[str]])
        +message : str {property}
        +messages : list[str] {property}
        +__str__() : str
    }

    class ImportResult <<dataclass>> {
        +total     : int
        +imported  : int
        +skipped   : int
        +errors    : list
        --
        +error_count : int {property}
        +skipped_count : int {property}
        +is_success() : bool
        +summary() : str
    }
}

package "github_api" #CCDDFF {
    class GitHubApiError <<Exception>> {
    }

    class TokenResolutionError <<Exception>> {
    }

    class GitHubImportError <<Exception>> {
    }

    class GitHubApiClient {
        -_token      : str
        -_session    : Session
        --
        +__init__(token: str)
        +fetch_workflow_runs(owner: str, repo: str,\n  branch: Optional[str],\n  status: Optional[str],\n  per_page: int) : List[dict]
        +fetch_attempts(owner: str, repo: str,\n  run_id: int) : List[dict]
        -{static} _get_next_page_url(response) : Optional[str]
    }

    class TokenResolver {
        -{static} _read_from_env_file() : Optional[str]
        -{static} _prompt_user() : str
        --
        +{static} resolve(cli_arg: Optional[str],\n  prompt_if_missing: bool) : str
    }

    class GitHubTokenValidator {
        +{static} validate(token: str) : None
    }

    class GitHubRunMapper {
        +{static} map_run(github_run: dict,\n  workflow_name: str) : WorkflowRun
