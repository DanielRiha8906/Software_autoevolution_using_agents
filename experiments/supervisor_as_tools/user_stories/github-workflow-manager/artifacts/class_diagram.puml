        +import_from_file(input_path: str) : List[WorkflowRun]
    }

    class WorkflowJsonStorage {
        +filepath : str
        --
        +__init__(filepath: str)
        +save(runs: List[WorkflowRun]) : None
        +load() : List[WorkflowRun]
        +export_to_file(runs: List[WorkflowRun], output_path: str) : None
        +import_from_file(input_path: str) : List[WorkflowRun]
    }

    WorkflowJsonStorage ..|> StorageAdapter : implements
}

package "services" #DDFFD4 {
    class StatisticsReport {
        +total_runs : int
        +count_by_conclusion : dict[WorkflowConclusion, int]
        +average_duration_seconds : float
        +min_duration_seconds : float
        +max_duration_seconds : float
        +average_attempts_per_run : float
        +per_status_avg_duration : dict[WorkflowStatus, float]
    }
    class WorkflowRunService {
        -_storage : StorageAdapter
        -_runs    : List[WorkflowRun]
        --
        +__init__(storage: StorageAdapter)
        +add_workflow_run(run: WorkflowRun) : WorkflowRun
        +list_runs() : List[WorkflowRun]
        +get_run_detail(run_id: str) : Optional[WorkflowRun]
        +get_run_by_number(run_number: int) : Optional[WorkflowRun]
        +filter_by_branch(branch: str) : List[WorkflowRun]
        +filter_by_status(status: WorkflowStatus) : List[WorkflowRun]
        +filter_by_conclusion(conclusion: WorkflowConclusion) : List[WorkflowRun]
        +filter_runs(branch: Optional[str] = None,\n  status: Optional[WorkflowStatus] = None,\n  conclusion: Optional[WorkflowConclusion] = None,\n  duration_min: Optional[float] = None,\n  duration_max: Optional[float] = None,\n  created_after: Optional[datetime] = None,\n  created_before: Optional[datetime] = None,\n  updated_after: Optional[datetime] = None,\n  updated_before: Optional[datetime] = None,\n  has_attempts: Optional[bool] = None) : List[WorkflowRun]
        +add_workflow_run_attempt(run_id: int, attempt: WorkflowRunAttempt) : WorkflowRunAttempt
        +update_workflow_run(run: WorkflowRun) : WorkflowRun
        +validate_attempt_uniqueness(attempts: list) : None
        +export_runs(output_path: str, branch: Optional[str] = None,\n  status: Optional[WorkflowStatus] = None,\n  conclusion: Optional[WorkflowConclusion] = None) : None
        +import_runs(input_path: str, dry_run: bool = False,\n  skip_duplicates: bool = True) : ImportResult
        -_persist() : None
    }

    class WorkflowRunTracker {
        -_service : WorkflowRunService
        --
        +__init__(service: WorkflowRunService)
        +track(workflow_name: str, branch: str,\n  status: WorkflowStatus,\n  conclusion: Optional[WorkflowConclusion],\n  run_number: Optional[int],\n  commit_sha: Optional[str],\n  run_id: Optional[str],\n  duration_seconds: float = 0.0) : WorkflowRun
    }

    class AttemptService {
        -_run_service : WorkflowRunService
        --
        +__init__(run_service: WorkflowRunService)
        +create_attempt(run_id: str, attempt_data: dict) : WorkflowRunAttempt
        +get_attempts_by_run(run_id: str, sort_by_number: bool = False) : list[WorkflowRunAttempt]
        +validate_duplicate_attempt_number(attempts: list) : bool
    }

    class GitHubImportService {
        -_run_service : WorkflowRunService
        --
        +__init__(run_service: WorkflowRunService)
        +import_from_github(owner: str, repo: str,\n  branch: Optional[str],\n  status: Optional[str],\n  github_token: Optional[str],\n  force: bool,\n  incremental: bool) : ImportResult
        -_deduplicate_runs(...) : tuple
    }

    class StatisticsService {
        --
        +compute_statistics(runs: List[WorkflowRun]) : StatisticsReport
        +format_statistics_for_terminal(report: StatisticsReport) : str
    }
}

