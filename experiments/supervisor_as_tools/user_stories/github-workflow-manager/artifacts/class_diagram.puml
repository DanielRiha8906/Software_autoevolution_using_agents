        -{static} _map_status(github_status: str) : WorkflowStatus
        -{static} _map_conclusion(github_conclusion: str) : Optional[WorkflowConclusion]
        -{static} _map_attempt_status(github_status: str) : WorkflowAttemptStatus
        -{static} _map_attempt_conclusion(github_conclusion: str) : Optional[WorkflowAttemptConclusion]
        -{static} _calculate_duration(github_run: dict) : float
        -{static} _calculate_attempt_duration(github_attempt: dict) : Optional[float]
    }
}

