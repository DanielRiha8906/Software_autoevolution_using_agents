@startuml class_diagram

skinparam classAttributeIconSize 0
skinparam classFontStyle bold

package "models" #DDEEFF {
    enum WorkflowStatus {
        QUEUED = "queued"
        IN_PROGRESS = "in_progress"
        COMPLETED = "completed"
        WAITING = "waiting"
        REQUESTED = "requested"
        PENDING = "pending"
    }

    enum WorkflowConclusion {
        SUCCESS = "success"
        FAILURE = "failure"
        CANCELLED = "cancelled"
        SKIPPED = "skipped"
        TIMED_OUT = "timed_out"
        ACTION_REQUIRED = "action_required"
        NEUTRAL = "neutral"
        STALE = "stale"
    }

    enum WorkflowAttemptStatus {
        QUEUED = "queued"
        IN_PROGRESS = "in_progress"
        COMPLETED = "completed"
        WAITING = "waiting"
        REQUESTED = "requested"
        PENDING = "pending"
    }

    enum WorkflowAttemptConclusion {
        SUCCESS = "success"
        FAILURE = "failure"
        CANCELLED = "cancelled"
        SKIPPED = "skipped"
        TIMED_OUT = "timed_out"
        ACTION_REQUIRED = "action_required"
        NEUTRAL = "neutral"
        STALE = "stale"
    }

    class WorkflowRun {
        +id               : str
        +workflow_name    : str
        +branch           : str
        +status           : WorkflowStatus
        +conclusion       : Optional[WorkflowConclusion]
        +created_at       : datetime
        +updated_at       : Optional[datetime]
        +run_number       : Optional[int]
        +commit_sha       : Optional[str]
        +duration_seconds : float = 0.0
        +attempts         : list[WorkflowRunAttempt]
        --
        +to_dict() : dict
        +{static} from_dict(data: dict) : WorkflowRun
        +{static} validate_dict(data: dict) : None
        +is_terminal() : bool
        +is_running() : bool
        +is_successful() : bool
        +is_failed() : bool
        +is_cancelled() : bool
    }

    class WorkflowRunAttempt {
        +id                 : int
        +run_id             : int
        +attempt_number     : int
        +status             : WorkflowAttemptStatus
        +conclusion         : Optional[WorkflowAttemptConclusion]
        +created_at         : datetime
        +duration_seconds   : Optional[float]
        --
        +to_dict() : dict
        +{static} from_dict(data: dict) : WorkflowRunAttempt
        +{static} validate_dict(data: dict) : None
    }

    class ValidationError <<Exception>> {
        -_messages : list[str]
        --
        +__init__(messages: Union[str, list[str]])
        +message : str {property}
        +messages : list[str] {property}
        +__str__() : str
    }

    class ImportResult <<dataclass>> {
        +total     : int
        +imported  : int
        +skipped   : int
        +errors    : list
        --
        +error_count : int {property}
        +skipped_count : int {property}
        +is_success() : bool
        +summary() : str
    }
}

package "storage" #FFF3CC {
    class WorkflowJsonStorage {
        +filepath : str
        --
        +__init__(filepath: str)
        +save(runs: List[WorkflowRun]) : None
        +load() : List[WorkflowRun]
        +export_to_file(runs: List[WorkflowRun], output_path: str) : None
        +import_from_file(input_path: str) : List[WorkflowRun]
    }
}

package "services" #DDFFD4 {
    class StatisticsReport {
        +total_runs : int
        +count_by_conclusion : dict[WorkflowConclusion, int]
        +average_duration_seconds : float
        +min_duration_seconds : float
        +max_duration_seconds : float
        +average_attempts_per_run : float
        +per_status_avg_duration : dict[WorkflowStatus, float]
    }
    class WorkflowRunService {
        -_storage : WorkflowJsonStorage
        -_runs    : List[WorkflowRun]
        --
        +__init__(storage: WorkflowJsonStorage)
        +add_workflow_run(run: WorkflowRun) : WorkflowRun
        +list_runs() : List[WorkflowRun]
        +get_run_detail(run_id: str) : Optional[WorkflowRun]
        +filter_by_branch(branch: str) : List[WorkflowRun]
        +filter_by_status(status: WorkflowStatus) : List[WorkflowRun]
        +filter_by_conclusion(conclusion: WorkflowConclusion) : List[WorkflowRun]
        +filter_runs(branch: Optional[str] = None,\n  status: Optional[WorkflowStatus] = None,\n  conclusion: Optional[WorkflowConclusion] = None,\n  duration_min: Optional[float] = None,\n  duration_max: Optional[float] = None,\n  created_after: Optional[datetime] = None,\n  created_before: Optional[datetime] = None,\n  updated_after: Optional[datetime] = None,\n  updated_before: Optional[datetime] = None,\n  has_attempts: Optional[bool] = None) : List[WorkflowRun]
        +add_workflow_run_attempt(run_id: int, attempt: WorkflowRunAttempt) : WorkflowRunAttempt
        +validate_attempt_uniqueness(attempts: list) : None
        +export_runs(output_path: str, branch: Optional[str] = None,\n  status: Optional[WorkflowStatus] = None,\n  conclusion: Optional[WorkflowConclusion] = None) : None
        +import_runs(input_path: str, dry_run: bool = False,\n  skip_duplicates: bool = True) : ImportResult
        -_persist() : None
    }

    class WorkflowRunTracker {
        -_service : WorkflowRunService
        --
        +__init__(service: WorkflowRunService)
        +track(workflow_name: str, branch: str,\n  status: WorkflowStatus,\n  conclusion: Optional[WorkflowConclusion],\n  run_number: Optional[int],\n  commit_sha: Optional[str],\n  run_id: Optional[str],\n  duration_seconds: float = 0.0) : WorkflowRun
    }

    class AttemptService {
        -_run_service : WorkflowRunService
        --
        +__init__(run_service: WorkflowRunService)
        +create_attempt(run_id: str, attempt_data: dict) : WorkflowRunAttempt
        +get_attempts_by_run(run_id: str, sort_by_number: bool = False) : list[WorkflowRunAttempt]
        +validate_duplicate_attempt_number(attempts: list) : bool
    }

    class StatisticsService {
        --
        +compute_statistics(runs: List[WorkflowRun]) : StatisticsReport
        +format_statistics_for_terminal(report: StatisticsReport) : str
    }
}

package "cli" #FFE5E5 {
    class "workflow_cli" <<module>> {
        +build_parser() : ArgumentParser
        +run_cli(service: WorkflowRunService, args) : None
        -_fmt_run(run: WorkflowRun) : str
        -_parse_iso8601(timestamp_str: str) : datetime
    }

    class "interactive_menu" <<module>> {
        +run_interactive(service: WorkflowRunService) : None
        -_add_run(service: WorkflowRunService) : None
        -_list_runs(service: WorkflowRunService) : None
        -_detail_run(service: WorkflowRunService) : None
        -_filter_menu(service: WorkflowRunService) : None
        -_advanced_filter_menu(service: WorkflowRunService) : None
        -_add_attempt(service: WorkflowRunService) : None
        -_list_attempts(service: WorkflowRunService) : None
        -_view_statistics(service: WorkflowRunService) : None
        -_export_runs(service: WorkflowRunService) : None
        -_import_runs(service: WorkflowRunService) : None
    }
}

