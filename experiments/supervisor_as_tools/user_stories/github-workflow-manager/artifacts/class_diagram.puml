@startuml class_diagram

skinparam classAttributeIconSize 0
skinparam classFontStyle bold

package "models" #DDEEFF {
    enum WorkflowStatus {
        QUEUED = "queued"
        IN_PROGRESS = "in_progress"
        COMPLETED = "completed"
        WAITING = "waiting"
        REQUESTED = "requested"
        PENDING = "pending"
    }

    enum WorkflowConclusion {
        SUCCESS = "success"
        FAILURE = "failure"
        CANCELLED = "cancelled"
        SKIPPED = "skipped"
        TIMED_OUT = "timed_out"
        ACTION_REQUIRED = "action_required"
        NEUTRAL = "neutral"
        STALE = "stale"
    }

    enum RunAttemptStatus {
        QUEUED
        IN_PROGRESS
        COMPLETED
    }

    enum RunAttemptConclusion {
        SUCCESS
        FAILURE
        CANCELLED
        TIMED_OUT
        SKIPPED
    }

    class WorkflowRun {
        +id            : str
        +workflow_name : str
        +branch        : str
        +status        : WorkflowStatus
        +conclusion    : Optional[WorkflowConclusion]
        +created_at    : datetime
        +updated_at    : Optional[datetime]
        +run_number    : Optional[int]
        +commit_sha    : Optional[str]
        +duration_seconds : float
        --
        +to_dict() : dict
        +{static} from_dict(data: dict) : WorkflowRun
    }

    class WorkflowRunAttempt {
        +id            : int
        +run_id        : int
        +attempt_number : int
        +status        : RunAttemptStatus
        +conclusion    : Optional[RunAttemptConclusion]
        +created_at    : datetime
        +duration_seconds : Optional[float]
        --
        +to_dict() : dict
        +{static} from_dict(data: dict) : WorkflowRunAttempt
    }
}

package "storage" #FFF3CC {
    class WorkflowJsonStorage {
        +filepath : str
        --
        +__init__(filepath: str)
        +save(runs: List[WorkflowRun]) : None
        +load() : List[WorkflowRun]
    }

    class WorkflowRunAttemptJsonStorage {
        +filepath : str
        --
        +__init__(filepath: str)
        +save(attempts: List[WorkflowRunAttempt]) : None
        +load() : List[WorkflowRunAttempt]
    }
}

package "services" #DDFFD4 {
    class WorkflowRunService {
        -_storage : WorkflowJsonStorage
        -_runs    : List[WorkflowRun]
        --
        +__init__(storage: WorkflowJsonStorage)
        +add_workflow_run(run: WorkflowRun) : WorkflowRun
        +list_runs() : List[WorkflowRun]
        +get_run_detail(run_id: str) : Optional[WorkflowRun]
        +filter_by_branch(branch: str) : List[WorkflowRun]
        +filter_by_status(status: WorkflowStatus) : List[WorkflowRun]
        +filter_by_conclusion(conclusion: WorkflowConclusion) : List[WorkflowRun]
        -_persist() : None
    }

    class WorkflowRunTracker {
        -_service : WorkflowRunService
        --
        +__init__(service: WorkflowRunService)
        +track(workflow_name: str, branch: str,\n  status: WorkflowStatus,\n  conclusion: Optional[WorkflowConclusion],\n  run_number: Optional[int],\n  commit_sha: Optional[str],\n  run_id: Optional[str]) : WorkflowRun
    }

    class WorkflowRunAttemptService {
        -_storage : WorkflowRunAttemptJsonStorage
        -_attempts : List[WorkflowRunAttempt]
        --
        +__init__(storage: WorkflowRunAttemptJsonStorage)
        +add_workflow_run_attempt(attempt: WorkflowRunAttempt) : WorkflowRunAttempt
        +list_attempts() : List[WorkflowRunAttempt]
        +get_attempt(run_id: int, attempt_number: int) : Optional[WorkflowRunAttempt]
        +list_attempts_by_run_id(run_id: int) : List[WorkflowRunAttempt]
        +filter_by_status(status: RunAttemptStatus) : List[WorkflowRunAttempt]
        +filter_by_conclusion(conclusion: RunAttemptConclusion) : List[WorkflowRunAttempt]
        -_persist() : None
    }

    class WorkflowRunAttemptTracker {
        -_service : WorkflowRunAttemptService
        --
        +__init__(service: WorkflowRunAttemptService)
        +track(...) : WorkflowRunAttempt
    }
}

package "cli" #FFE5E5 {
    class "workflow_cli" <<module>> {
        +build_parser() : ArgumentParser
        +run_cli(service: WorkflowRunService, args) : None
        -_fmt_run(run: WorkflowRun) : str
    }

    class "interactive_menu" <<module>> {
        +run_interactive(service: WorkflowRunService) : None
        -_add_run(service: WorkflowRunService) : None
        -_list_runs(service: WorkflowRunService) : None
        -_detail_run(service: WorkflowRunService) : None
        -_filter_menu(service: WorkflowRunService) : None
    }
}

WorkflowRun                ..>  WorkflowStatus        : status
WorkflowRun                ..>  WorkflowConclusion    : conclusion
WorkflowRunAttempt         ..>  RunAttemptStatus      : status
WorkflowRunAttempt         ..>  RunAttemptConclusion  : conclusion
WorkflowRunService    "1" --> "1" WorkflowJsonStorage : -_storage
WorkflowRunService         ..>  WorkflowRun
WorkflowRunService         ..>  WorkflowStatus
WorkflowRunService         ..>  WorkflowConclusion
WorkflowRunTracker    "1" --> "1" WorkflowRunService  : -_service
WorkflowRunTracker         ..>  WorkflowRun
WorkflowRunAttemptService "1" --> "1" WorkflowRunAttemptJsonStorage : -_storage
WorkflowRunAttemptService  ..>  WorkflowRunAttempt
WorkflowRunAttemptService  ..>  RunAttemptStatus
WorkflowRunAttemptService  ..>  RunAttemptConclusion
WorkflowRunAttemptTracker "1" --> "1" WorkflowRunAttemptService : -_service
WorkflowRunAttemptTracker  ..>  WorkflowRunAttempt
"workflow_cli"             ..>  WorkflowRunService
"workflow_cli"             ..>  WorkflowRunTracker
"interactive_menu"         ..>  WorkflowRunService
"interactive_menu"         ..>  WorkflowRunTracker

@enduml
