@startuml activity_diagram_interactive

skinparam activityBackgroundColor #DDEEFF
skinparam activityBorderColor     #3366AA
skinparam activityDiamondBackgroundColor #FFF3CC

start

:Initialize application;

switch (mode)

  case (GUI Mode)
    :Launch MainWindow;
    :MainWindow initializes frames;
    repeat
      :Display filter, list, detail panels;
      :Wait for user interaction;
      switch (user action)
        case (Select run)
          :FilterFrame.get_filter_kwargs();
          :WorkflowRunService.filter_runs();
          :ListFrame.set_runs();
          :User clicks run in ListFrame;
          :DetailFrame.set_run();
        case (Edit selected)
          :MainWindow shows EditFrame;
          :EditFrame.set_run();
          :User modifies fields;
          if (save?) then (yes)
            :Validate input;
            :WorkflowRunService.update_workflow_run();
            :MainWindow._refresh();
            :EditFrame hidden, DetailFrame shown;
          else (cancel)
            :EditFrame hidden, DetailFrame shown;
          endif
        case (Refresh)
          :MainWindow._refresh();
          :FilterFrame.get_filter_kwargs();
          :WorkflowRunService.filter_runs();
          :ListFrame.set_runs();
        case (Exit)
          stop
      endswitch
    repeat while (user continues)

  case (Interactive Menu Mode)
    :Display interactive menu;
    repeat

  :Wait for user selection;

  switch (choice)

    case (1 — Add workflow run)
      :Prompt workflow name;
      :Prompt branch;
      :Choose status from list;
      :Choose conclusion (optional, 0 to skip);
      :Prompt run number (optional);
      :Prompt commit SHA (optional);
      :Prompt duration in seconds (optional);
      :WorkflowRunTracker.track();
      :Print "Added run <id>";

    case (2 — List all runs)
      :WorkflowRunService.list_runs();
      if (no runs?) then (yes)
        :Print "No runs recorded.";
      else (no)
        :Print all runs;
      endif

    case (3 — Get run detail)
      :Prompt run ID;
      :WorkflowRunService.get_run_detail(run_id);
      if (found?) then (yes)
        :Print run details;
      else (no)
        :Print "No run found with id '<id>'";
      endif

    case (4 — Check run status)
      :Prompt run ID;
      :WorkflowRunService.get_run_detail(run_id);
      if (found?) then (yes)
        :Print status report\n(is_terminal, is_running,\nis_successful, is_failed,\nis_cancelled);
      else (no)
        :Print "No run found with id '<id>'";
      endif

    case (5 — Filter runs)
      :Choose filter type\n(branch / status / conclusion);
      if (branch?) then (yes)
        :Prompt branch name;
        :filter_by_branch();
      elseif (status?) then (yes)
        :Choose status from list;
        :filter_by_status();
      else (conclusion)
        :Choose conclusion from list;
        :filter_by_conclusion();
      endif
      if (no matches?) then (yes)
        :Print "No matching runs.";
      else (no)
        :Print matching runs;
      endif

    case (6 — Add attempt)
      :Prompt run ID;
      :Validate run exists;
      :Prompt attempt number;
      :Choose status from list;
      :Choose conclusion (optional, 0 to skip);
      :Prompt duration in seconds (optional);
      :AttemptService.create_attempt();
      :Print "Added attempt <number> to run <id>";

    case (7 — List attempts)
      :Prompt run ID;
      :Choose sort by number? (Yes / No);
      :AttemptService.get_attempts_by_run();
      if (no attempts?) then (yes)
        :Print "No attempts found for run";
      else (no)
        :Print all attempts;
      endif

    case (8 — Export runs)
      :Prompt output file path;
      :Choose apply filters? (No / Yes);
      if (filters?) then (yes)
        :Choose filter type\n(branch / status / conclusion);
        if (branch?) then (yes)
          :Prompt branch name;
        elseif (status?) then (yes)
          :Choose status from list;
        else (conclusion)
          :Choose conclusion from list;
        endif
      endif
      :WorkflowRunService.export_runs();
      if (error?) then (yes)
        :Print error message;
      else (no)
        :Print "Exported <count> runs to <path>";
      endif

    case (9 — Import runs)
      :Prompt input file path;
      :Choose dry-run? (No / Yes);
      :Choose duplicate handling? (Skip / Replace);
      :WorkflowRunService.import_runs();
      if (error?) then (yes)
        :Print error message;
      else (no)
        :Print import summary;
        if (validation errors?) then (yes)
          :Print validation errors;
        endif
      endif
      if (dry-run?) then (yes)
        :Print "(Dry-run mode: no changes made)";
      endif

    case (10 — Fetch from GitHub)
      :Prompt GitHub owner;
      :Prompt GitHub repository;
      :Resolve GitHub token\n(CLI / env / secrets / prompt);
      :Prompt branch (optional);
      :Prompt status filter (optional);
      :Choose force update? (No / Yes);
      :Choose incremental? (No / Yes);
      :GitHubImportService.import_from_github();
      if (token error?) then (yes)
        :Print "Token resolution failed";
      elseif (API error?) then (yes)
        :Print API error message;
      else (success)
        :Print import summary;
        if (errors?) then (yes)
          :Print per-run errors;
        endif
      endif

    case (11 — Exit)
      :Print "Goodbye.";
      stop

  endswitch

repeat while (user continues)

endswitch

@enduml
