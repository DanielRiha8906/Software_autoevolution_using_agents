@startuml activity_diagram

skinparam activityBackgroundColor #DDEEFF
skinparam activityBorderColor #3366AA
skinparam activityDiamondBackgroundColor #FFF3CC

start

if (CLI operation provided?) then (yes)

  :Validate operation and operands;

  if (Input valid?) then (yes)
    :Measure execution start time;
    :Perform calculation;
    :Measure execution end time;

    if (Calculation successful?) then (yes)
      :Record execution time to result;
      :Save result to history;
      :Record MemoryEntry with result;
      :Save MemoryEntry to storage;
      :Show result;
      stop
    else (no)
      :Record MemoryEntry with error;
      :Save MemoryEntry to storage;
      :Show calculation error;
      stop
    endif

  else (no)
    :Show usage error;
    stop
  endif

else (no)

  repeat
    :Show menu;
    :Read user choice;

    switch (User choice?)

      case (Exit)
        :Show goodbye message;
        stop

      case (History)
        :Load calculation history;
        :Show history;

      case (View Memory)
        :Load memory entries;
        :Show memory entries;

      case (Operation)
        :Read operands;

        if (Input valid?) then (yes)
          :Measure execution start time;
          :Perform calculation;
          :Measure execution end time;

          if (Calculation successful?) then (yes)
            :Record execution time to result;
            :Save result to history;
            :Record MemoryEntry with result;
            :Save MemoryEntry to storage;
            :Show result;
          else (no)
            :Record MemoryEntry with error;
            :Save MemoryEntry to storage;
            :Show calculation error;
          endif

        else (no)
          :Show input error;
        endif

      case (Invalid choice)
        :Show invalid choice message;

    endswitch

  repeat while (Menu active?) is (yes)

endif

stop

@enduml