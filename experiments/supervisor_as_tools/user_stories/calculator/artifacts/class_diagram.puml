@startuml class_diagram

skinparam classAttributeIconSize 0
skinparam classFontStyle bold

package "models" #DDEEFF {
    enum Operation {
        ADD
        SUBTRACT
        MULTIPLY
        DIVIDE
        SQUARE
        SQRT
        POWER
        MODULO
        SIN
        COS
        TAN
        LOG
        LN
        EXP
        --
        +fromString(value: String) : Operation
        +displayName() : String
    }

    class CalculationResult {
        +operation : Operation
        +operandA : float
        +operandB : float
        +result : float
        +timestamp : String
        +executionTimeMs : float
        --
        +toDict() : Dictionary
        +fromDict(data: Dictionary) : CalculationResult
        +toString() : String
    }

    class MemoryEntry {
        +entryId : str
        +operationName : str
        +operandA : float
        +operandB : float
        +result : float | null
        +success : bool
        +errorMessage : str | null
        +timestamp : str
        +executionTimeMs : float
        --
        +toDict() : Dictionary
        +fromDict(data: Dictionary) : MemoryEntry
    }

    class CalculationStatistics {
        +operationCounts : dict[str, int]
        +totalErrors : int
        +errorRate : float
        +avgExecutionTimeMs : float
    }
}

package "services" #DDFFD4 {
    class Calculator {
        +add(a: float, b: float) : float
        +subtract(a: float, b: float) : float
        +multiply(a: float, b: float) : float
        +divide(a: float, b: float) : float
        +square(a: float, b: float) : float
        +sqrt(a: float, b: float) : float
        +power(a: float, b: float) : float
        +modulo(a: float, b: float) : float
        +sin(a: float, b: float) : float
        +cos(a: float, b: float) : float
        +tan(a: float, b: float) : float
        +log(a: float, b: float) : float
        +ln(a: float, b: float) : float
        +exp(a: float, b: float) : float
        +calculate(op: Operation, a: float, b: float) : float
    }

    class CalculatorService {
        -calculator : Calculator
        -storage : JsonStorage
        --
        +CalculatorService(calculator: Calculator, storage: JsonStorage)
        +execute(operation: String, a: float, b: float) : float
        +perform(operation: Operation, a: float, b: float) : CalculationResult
        +getHistory() : List<CalculationResult>
    }

    class MemoryService {
        -calculatorService : CalculatorService
        -storage : JsonStorage
        --
        +MemoryService(calculatorService: CalculatorService, storage: JsonStorage)
        +record(operation: str, operandA: float, operandB: float) : MemoryEntry
        +getAllEntries() : List<MemoryEntry>
        +filterByOperation(operationName: str) : List<MemoryEntry>
        +filterBySuccess(success: bool) : List<MemoryEntry>
        +filter(operationName: str, success: bool) : List<MemoryEntry>
        +exportMemoryEntries(outputPath: String) : int
        +importMemoryEntries(inputPath: String, overwrite: bool) : Tuple[int, int]
    }

    class StatisticsService {
        -memoryService : MemoryService
        --
        +StatisticsService(memoryService: MemoryService)
        +generate() : CalculationStatistics
    }
}

package "storage" #FFF3CC {
    class JsonStorage {
        -filepath : String
        --
        +JsonStorage(filepath: String)
        +save(result: CalculationResult | MemoryEntry) : void
        +loadAll() : List<CalculationResult | MemoryEntry>
        +exportMemoryEntries(outputPath: String, entries: List) : int
        +importMemoryEntries(inputPath: String, overwrite: bool) : Tuple[int, int]
        -readRaw() : List<Dictionary>
        -writeRaw(records: List<Dictionary>) : void
        -validateMemoryEntryDict(data: Dictionary) : Tuple[bool, String]
        -getAllMemoryEntries() : List<MemoryEntry>
    }
}

package "cli" #FFE5E5 {
    class CalculatorCLI {
        -MENU : List<Tuple<Operation, String>>
        -service : CalculatorService
        -memory_service : MemoryService
        -statistics_service : StatisticsService
        --
        +CalculatorCLI(service: CalculatorService, memory_service: MemoryService, statistics_service: StatisticsService)
        +runInteractive() : void
        +runCommand(operation: String, a: float, b: float) : void
        +showMemoryCli() : void
        +showFilteredMemoryCli(operationName: str, success: bool) : void
        -printMenu() : void
        -resolveMenuChoice(choice: String) : Operation [0..1]
        -promptNumber(prompt: String) : float [0..1]
        -showHistory() : void
        -showMemory() : void
        -showMemoryFilterSubmenu() : void
        -displayMemoryEntries(entries: List<MemoryEntry>) : void
        -showStatistics() : void
        -exportMemoryInteractive() : void
        -importMemoryInteractive() : void
    }
}

package "gui" #FFD9D9 {
    class CalculatorWindow {
        -service : CalculatorService
        -memory_service : MemoryService
        -statistics_service : StatisticsService
        -numberInput : NumberInput
        -operationSelector : OperationSelector
        -filterPanel : FilterPanel
        --
        +CalculatorWindow(service: CalculatorService, memory_service: MemoryService, statistics_service: StatisticsService)
        +run() : void
        -setupUI() : void
        -onCalculate() : void
        -onMemoryExport() : void
        -onMemoryImport() : void
    }

    class NumberInput {
        -display : String
        --
        +getValue() : float
        +setValue(value: float) : void
        +clear() : void
        +appendDigit(digit: String) : void
    }

    class OperationSelector {
        --
        +getSelectedOperation() : Operation
        +setSelectedOperation(op: Operation) : void
        +getAvailableOperations() : List<Operation>
    }

    class FilterPanel {
        --
        +getFilteredByOperation(operationName: str) : List<MemoryEntry>
        +getFilteredBySuccess(success: bool) : List<MemoryEntry>
        +getFiltered(operationName: str, success: bool) : List<MemoryEntry>
    }

    CalculatorWindow --> NumberInput : uses
    CalculatorWindow --> OperationSelector : uses
    CalculatorWindow --> FilterPanel : uses
}

CalculatorCLI --> CalculatorService : service
CalculatorCLI --> MemoryService : memory service
CalculatorCLI --> StatisticsService : statistics service
CalculatorWindow --> CalculatorService : service
CalculatorWindow --> MemoryService : memory service
CalculatorWindow --> StatisticsService : statistics service
CalculatorService --> Calculator : calculator
CalculatorService --> JsonStorage : storage
MemoryService --> CalculatorService : uses execute()
MemoryService --> JsonStorage : persists to
StatisticsService --> MemoryService : uses

CalculatorService ..> CalculationResult : create
MemoryService ..> MemoryEntry : create/return
StatisticsService ..> CalculationStatistics : generate
CalculatorService ..> Operation
CalculatorCLI ..> Operation
CalculatorWindow ..> Operation
OperationSelector ..> Operation
FilterPanel ..> MemoryEntry
Calculator ..> Operation
JsonStorage ..> CalculationResult : stores
JsonStorage ..> MemoryEntry : stores

@enduml