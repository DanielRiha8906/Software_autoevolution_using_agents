@startuml

skinparam defaultFontSize 13
skinparam stateFontStyle bold

top to bottom direction

[*] --> Menu

Menu --> FirstOperand : operation selected
Menu --> Feedback : history selected
Menu --> MemoryFilterMenu : memory selected
Menu --> StatisticsDisplay : statistics selected
Menu --> Feedback : invalid choice
Menu --> [*] : exit

FirstOperand --> SecondOperand : valid number
FirstOperand --> Feedback : invalid number

SecondOperand --> Calculating : valid number
SecondOperand --> Feedback : invalid number

Calculating --> MemoryRecord : success / record entry
Calculating --> MemoryRecord : error / record error

MemoryRecord --> Feedback : memory recorded

MemoryFilterMenu --> MemoryDisplay : view / filter selected
MemoryFilterMenu --> ExportProgress : export selected
MemoryFilterMenu --> ImportProgress : import selected
MemoryFilterMenu --> Feedback : back selected

MemoryDisplay --> Feedback : memory displayed

ExportProgress --> Feedback : export complete
ExportProgress --> Feedback : export error

ImportProgress --> Feedback : import complete
ImportProgress --> Feedback : import error

StatisticsDisplay --> Feedback : statistics displayed

Feedback --> Menu

@enduml