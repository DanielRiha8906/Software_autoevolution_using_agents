@startuml component_diagram

skinparam componentStyle uml2
skinparam defaultFontSize 13
left to right direction

package "Calculator Application" {

    component "Entry Point\n(__main__)" as Main
    component "CLI Interface\n(CalculatorCLI)" as CLI
    component "GUI Interface\n(CalculatorWindow)" as GUI
    component "Application Service\n(CalculatorService)" as Service
    component "Memory Service\n(MemoryService)" as MemService
    component "Statistics Service\n(StatisticsService)" as StatService
    component "Calculation Engine\n(Calculator)" as Calc
    component "JSON Storage\n(JsonStorage)" as Store
    component "Domain Models\n(Operation, CalculationResult, MemoryEntry, CalculationStatistics)" as Models

    Main --> CLI : initializes
    Main --> GUI : initializes
    Main --> Service : initializes
    Main --> MemService : initializes
    Main --> StatService : initializes

    CLI --> Service : uses
    CLI --> MemService : uses export/import
    CLI --> StatService : uses
    GUI --> Service : uses
    GUI --> MemService : uses export/import
    GUI --> StatService : uses
    Service --> Calc : uses
    Service --> Store : uses
    MemService --> Service : uses execute()
    MemService --> Store : uses
    StatService --> MemService : uses

    Service ..> Models
    MemService ..> Models
    StatService ..> Models
    Store ..> Models
    GUI ..> Models
}

database "calculations.json" as DB

Store --> DB : read/write

@enduml