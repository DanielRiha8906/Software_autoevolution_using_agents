@startuml use_case_diagram

skinparam defaultFontSize 13

left to right direction

actor User

rectangle "Calculator Application" {
    usecase "Perform calculation" as UC_Calc
    usecase "View calculation history" as UC_History
    usecase "View memory entries" as UC_Memory
    usecase "Exit application" as UC_Exit

}

User --> UC_Calc
User --> UC_History
User --> UC_Memory
User --> UC_Exit

@enduml