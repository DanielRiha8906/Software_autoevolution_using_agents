@startuml class_diagram

skinparam classAttributeIconSize 0
skinparam classFontStyle bold

package "models" #DDEEFF {
    enum Operation {
        ADD
        SUBTRACT
        MULTIPLY
        DIVIDE
        SQUARE
        SQRT
        POWER
        MODULO
        SIN
        COS
        TAN
        LOG10
        LN
        EXP
        --
        +fromString(value: String) : Operation
        +displayName() : String
    }

    class CalculationResult {
        +operation : Operation
        +operandA : float
        +operandB : float
        +result : float
        +timestamp : String
        +execution_time_ms : float
        --
        +toDict() : Dictionary
        +fromDict(data: Dictionary) : CalculationResult
        +toString() : String
    }

    class MemoryEntry {
        +operation : str
        +operand_a : float
        +operand_b : float
        +result : float | None
        +success : bool
        +error_message : str | None
        +timestamp : str
        +execution_time_ms : float
        +id : str
        --
        +to_dict() : Dict
        +from_dict(data: Dict) : MemoryEntry
    }

    class MemoryStatistics {
        +operation_counts : Dict[str, int]
        +total_errors : int
        +error_rate : float
        +avg_execution_time_ms : float
        +total_entries : int
        +min_execution_time_ms : float | None
        +max_execution_time_ms : float | None
        +operation_error_rates : Dict[str, float]
    }
}

package "services" #DDFFD4 {
    class Calculator {
        +add(a: float, b: float) : float
        +subtract(a: float, b: float) : float
        +multiply(a: float, b: float) : float
        +divide(a: float, b: float) : float
        +square(a: float, b: float) : float
        +sqrt(a: float, b: float) : float
        +power(a: float, b: float) : float
        +modulo(a: float, b: float) : float
        +sin(a: float, b: float) : float
        +cos(a: float, b: float) : float
        +tan(a: float, b: float) : float
        +log10(a: float, b: float) : float
        +ln(a: float, b: float) : float
        +exp(a: float, b: float) : float
        +calculate(op: Operation, a: float, b: float) : float
    }

    class CalculatorService {
        -calculator : Calculator
        -storage : StorageInterface
        -memory_service : MemoryRepository [0..1]
        --
        +CalculatorService(calculator: Calculator, storage: StorageInterface, memory_service: MemoryRepository | None)
        +perform(operation: Operation, a: float, b: float) : CalculationResult
        +getHistory() : List<CalculationResult>
    }

    interface MemoryRepository {
        +store(entry: MemoryEntry) : void
        +retrieve_by_id(entry_id: str) : MemoryEntry | None
        +retrieve_all() : List<MemoryEntry>
        +retrieve_by_operation(operation: str) : List<MemoryEntry>
        +retrieve_successes() : List<MemoryEntry>
        +retrieve_failures() : List<MemoryEntry>
        +retrieve_by_filter(operation: str | None, success: bool | None) : List<MemoryEntry>
        +count() : int
        +count_by_status() : Dict[str, int]
        +count_by_operation() : Dict[str, int]
        +clear() : void
        +get_operation_error_rates() : Dict[str, float]
        +compute_statistics(filter_operation: str | None) : MemoryStatistics
    }

    class MemoryService {
        -storage : MemoryStorageInterface
        --
        +MemoryService(storage: MemoryStorageInterface)
        +store(entry: MemoryEntry) : void
        +retrieve_by_id(entry_id: str) : MemoryEntry | None
        +retrieve_all() : List<MemoryEntry>
        +retrieve_by_operation(operation: str) : List<MemoryEntry>
        +retrieve_successes() : List<MemoryEntry>
        +retrieve_failures() : List<MemoryEntry>
        +retrieve_by_filter(operation: str | None, success: bool | None) : List<MemoryEntry>
        +count() : int
        +count_by_status() : Dict[str, int]
        +count_by_operation() : Dict[str, int]
        +clear() : void
        +get_operation_error_rates() : Dict[str, float]
        +compute_statistics(filter_operation: str | None) : MemoryStatistics
    }

    class EventRecorder {
        -calculation_storage : StorageInterface
        -memory_repo : MemoryRepository [0..1]
        --
        +EventRecorder(calculation_storage: StorageInterface, memory_repo: MemoryRepository | None)
        +record_success(result: CalculationResult, elapsed_ms: float) : void
        +record_failure(operation: str, operand_a: float, operand_b: float, elapsed_ms: float, error_message: str) : void
    }

    class MemoryImportExportService {
        --
        +validate_entry(entry_dict: dict) : bool
        +find_duplicates(entries: List<MemoryEntry>, existing: List<MemoryEntry>) : Set<str>
        +export_memory(filepath: Path | str, entries: List<MemoryEntry>) : int
        +import_from_file(filepath: Path | str) : Tuple<List<MemoryEntry>, int, int>
    }
}

package "storage" #FFF3CC {
    interface StorageInterface {
        +save(result: CalculationResult) : void
        +load_all() : List<CalculationResult>
    }

    interface MemoryStorageInterface {
        +save(entry: MemoryEntry) : void
        +load_all() : List<MemoryEntry>
        +clear() : void
    }

    class JsonStorage {
        -filepath : String
        --
        +JsonStorage(filepath: String)
        +save(result: CalculationResult) : void
        +loadAll() : List<CalculationResult>
        -readRaw() : List<Dictionary>
        -writeRaw(records: List<Dictionary>) : void
    }

    class MemoryJsonStorage {
        -filepath : Path | str
        --
        +MemoryJsonStorage(filepath: Path | str)
        +save(entry: MemoryEntry) : void
        +load_all() : List<MemoryEntry>
        +clear() : void
        -_read_raw() : List
        -_write_raw(records: List) : void
    }
}

package "cli" #FFE5E5 {
    class CalculatorCLI {
        -_MENU : List<Tuple<Operation, String>>
        -service : CalculatorService
        -memory_service : MemoryService [0..1]
        -import_export_service : MemoryImportExportService [0..1]
        --
        +CalculatorCLI(service: CalculatorService, memory_service: MemoryService | None)
        +run_interactive() : void
        +run_command(operation: String, a: float, b: float) : void
        +show_memory_list() : void
        +show_memory_filtered_list(operation: str | None, status: bool | None) : void
        +show_memory_detail(entry_id: str) : void
        +show_memory_summary() : void
        +show_memory_failures() : void
        +show_memory_statistics(operation: str | None) : void
        +clear_memory_confirm() : void
        +export_memory_interactive() : void
        +import_memory_interactive() : void
        -_print_menu() : void
        -_resolve_menu_choice(choice: String) : Operation [0..1]
        -_prompt_number(prompt: String) : float [0..1]
        -_show_history() : void
    }
}

package "gui" #F0E5FF {
    class CalculatorGUI {
        -service : CalculatorService
        -memory_service : MemoryService [0..1]
        -root : Tk
        -operand_a_var : StringVar
        -operand_b_var : StringVar
        -_current_operation : Operation | None
        -_unary_operations : Set<Operation>
        -result_text : Text
        -history_listbox : Listbox [0..1]
        -status_label : Label
        --
        +CalculatorGUI(service: CalculatorService, memory_service: MemoryService | None)
        +run() : void
        +setup_ui() : void
        +perform_calculation() : void
        +update_history() : void
        +clear_inputs() : void
        -_on_operation_button_click(operation: Operation) : void
        -_get_float_operand(operand_name: str) : float | None
        -_is_unary_operation(operation: Operation) : bool
        -_display_result(result: float) : void
        -_display_error(error_message: str) : void
        -_format_history_entry(entry: MemoryEntry) : str
    }
}

CalculatorCLI --> CalculatorService : service
CalculatorCLI ..> MemoryService : memory_service [0..1]
CalculatorCLI ..> MemoryImportExportService : import_export_service [0..1]
CalculatorCLI ..> MemoryStatistics : displays
CalculatorGUI --> CalculatorService : service
CalculatorGUI ..> MemoryService : memory_service [0..1]
CalculatorGUI ..> MemoryEntry : displays
CalculatorService --> Calculator : calculator
CalculatorService --> StorageInterface : storage
CalculatorService ..> MemoryRepository : memory_service [0..1]
CalculatorService --> EventRecorder : uses
EventRecorder --> StorageInterface : calculation_storage
EventRecorder ..> MemoryRepository : memory_repo [0..1]
MemoryService ..|> MemoryRepository : implements
MemoryService --> MemoryStorageInterface : storage
MemoryService ..> MemoryEntry : manages
MemoryService ..> MemoryStatistics : creates
JsonStorage ..|> StorageInterface : implements
MemoryJsonStorage ..|> MemoryStorageInterface : implements
MemoryImportExportService ..> MemoryEntry : imports/exports

CalculatorService ..> CalculationResult : create
CalculatorService ..> MemoryEntry : creates
CalculatorService ..> Operation
CalculatorCLI ..> Operation
Calculator ..> Operation
StorageInterface ..> CalculationResult : stores
MemoryStorageInterface ..> MemoryEntry : stores

@enduml
