@startuml state_diagram_interactive

skinparam defaultFontSize 13
skinparam stateFontStyle bold

top to bottom direction

[*] --> Menu

Menu --> FirstOperand : operation selected
Menu --> Feedback : history selected
Menu --> MemoryView : memory selected [optional]
Menu --> MemorySummary : summary selected [optional]
Menu --> MemoryStatistics : statistics selected [optional]
Menu --> ExportMemory : export selected [optional]
Menu --> ImportMemory : import selected [optional]
Menu --> Feedback : invalid choice
Menu --> [*] : exit

FirstOperand --> SecondOperand : valid number
FirstOperand --> Feedback : invalid number

SecondOperand --> Calculating : valid number
SecondOperand --> Feedback : invalid number

Calculating --> Feedback : success / show result
Calculating --> Feedback : error / show error
Feedback --> Menu

MemoryView --> Menu : done viewing
MemorySummary --> Menu : done viewing
MemoryStatistics --> Menu : done viewing

ExportMemory --> FilePath : request path
FilePath --> ValidationExport : path provided
FilePath --> Menu : cancelled
ValidationExport --> ExportSuccess : export complete
ValidationExport --> ExportError : export failed
ExportSuccess --> Menu
ExportError --> Menu

ImportMemory --> FilePath2 : request path
FilePath2 --> ValidationImport : path provided
FilePath2 --> Menu : cancelled
ValidationImport --> ImportConfirm : entries loaded
ValidationImport --> ImportError : read failed
ImportConfirm --> ConfirmPrompt : show entries
ConfirmPrompt --> ImportSuccess : user confirms
ConfirmPrompt --> Menu : user cancels
ImportSuccess --> Menu
ImportError --> Menu

@enduml