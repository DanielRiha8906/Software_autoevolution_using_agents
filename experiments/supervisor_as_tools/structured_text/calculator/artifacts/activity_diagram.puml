@startuml activity_diagram

skinparam activityBackgroundColor #DDEEFF
skinparam activityBorderColor #3366AA
skinparam activityDiamondBackgroundColor #FFF3CC

start

if (CLI operation provided?) then (yes)

  :Validate operation and operands;

  if (Input valid?) then (yes)
    :Perform calculation;

    if (Calculation successful?) then (yes)
      :Save result to history;
      if (Memory service available?) then (yes)
        :Record success to memory;
      endif
      :Show result;
      stop
    else (no)
      if (Memory service available?) then (yes)
        :Record failure to memory;
      endif
      :Show calculation error;
      stop
    endif

  else (no)
    :Show usage error;
    stop
  endif

else (no)

  repeat
    :Show menu;
    :Read user choice;

    switch (User choice?)

      case (Exit)
        :Show goodbye message;
        stop

      case (History)
        :Load calculation history;
        :Show history;

      case (Operation)
        :Read operands;

        if (Input valid?) then (yes)
          :Perform calculation;

          if (Calculation successful?) then (yes)
            :Save result to history;
            if (Memory service available?) then (yes)
              :Record success to memory;
            endif
            :Show result;
          else (no)
            if (Memory service available?) then (yes)
              :Record failure to memory;
            endif
            :Show calculation error;
          endif

        else (no)
          :Show input error;
        endif

      case (Memory)
        if (Memory service available?) then (yes)
          :Show memory operations menu;
          switch (Memory action?)
            case (List all)
              :Retrieve all memory entries;
              :Show list;
            case (List filtered)
              :Apply operation filter (optional);
              :Apply status filter (optional);
              :Retrieve filtered entries;
              :Show filtered list;
            case (Summary)
              :Show memory summary;
            case (Statistics)
              :Compute statistics;
              :Display statistics (counts, timing, error rates);
            case (Export)
              :Prompt for file path;
              :Retrieve all memory entries;
              :Validate entries;
              :Write entries to JSON file;
            case (Import)
              :Prompt for file path;
              :Read and validate JSON file;
              :Check for duplicates;
              :Confirm import;
              :Store entries to memory;
            case (Other)
              :Show failures or clear memory;
          endswitch
        else (no)
          :Show memory unavailable message;
        endif

      case (Invalid choice)
        :Show invalid choice message;

    endswitch

  repeat while (Menu active?) is (yes)

endif

stop

@enduml