@startuml use_case_diagram

skinparam defaultFontSize 13

left to right direction

actor User

rectangle "Calculator Application" {
    usecase "Perform calculation" as UC_Calc
    usecase "View calculation history" as UC_History
    usecase "Exit application" as UC_Exit
    usecase "Square a number" as UC_Square
    usecase "Take square root" as UC_Sqrt
    usecase "Raise to power" as UC_Power
    usecase "Perform modulo" as UC_Modulo
    usecase "View memory entries" as UC_Memory
    usecase "View memory summary" as UC_Summary
    usecase "View failed operations" as UC_Failures
    usecase "Clear memory" as UC_ClearMem

}

User --> UC_Calc
User --> UC_History
User --> UC_Exit
User --> UC_Square
User --> UC_Sqrt
User --> UC_Power
User --> UC_Modulo
User --> UC_Memory
User --> UC_Summary
User --> UC_Failures
User --> UC_ClearMem

UC_Calc ..> UC_Memory : <<extends>> [if available]
UC_Calc ..> UC_Failures : <<extends>> [if available]

@enduml