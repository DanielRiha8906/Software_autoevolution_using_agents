@startuml use_case_diagram

skinparam defaultFontSize 13

left to right direction

actor User

rectangle "Calculator Application" {
    usecase "Perform calculation" as UC_Calc
    usecase "View calculation history" as UC_History
    usecase "Exit application" as UC_Exit
    usecase "Square a number" as UC_Square
    usecase "Take square root" as UC_Sqrt
    usecase "Raise to power" as UC_Power
    usecase "Perform modulo" as UC_Modulo
    usecase "Use sine" as UC_Sin
    usecase "Use cosine" as UC_Cos
    usecase "Use tangent" as UC_Tan
    usecase "Use log base 10" as UC_Log10
    usecase "Use natural log" as UC_Ln
    usecase "Use exponential" as UC_Exp
    usecase "View memory entries" as UC_Memory
    usecase "Query memory with filters" as UC_FilteredMemory
    usecase "View memory summary" as UC_Summary
    usecase "View memory statistics" as UC_Statistics
    usecase "View failed operations" as UC_Failures
    usecase "Clear memory" as UC_ClearMem
    usecase "Export memory entries" as UC_Export
    usecase "Import memory entries" as UC_Import

}

User --> UC_Calc
User --> UC_History
User --> UC_Exit
User --> UC_Square
User --> UC_Sqrt
User --> UC_Power
User --> UC_Modulo
User --> UC_Sin
User --> UC_Cos
User --> UC_Tan
User --> UC_Log10
User --> UC_Ln
User --> UC_Exp
User --> UC_Memory
User --> UC_FilteredMemory
User --> UC_Summary
User --> UC_Statistics
User --> UC_Failures
User --> UC_ClearMem
User --> UC_Export
User --> UC_Import

UC_Calc ..> UC_Memory : <<extends>> [if available]
UC_Calc ..> UC_Failures : <<extends>> [if available]
UC_FilteredMemory --|> UC_Memory : specializes
UC_Statistics --|> UC_Summary : refinement
UC_Export --|> UC_Memory : specializes
UC_Import --|> UC_Memory : specializes

@enduml