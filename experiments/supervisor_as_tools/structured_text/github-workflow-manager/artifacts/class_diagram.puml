@startuml class_diagram

skinparam classAttributeIconSize 0
skinparam classFontStyle bold

package "models" #DDEEFF {
    enum WorkflowStatus {
        QUEUED = "queued"
        IN_PROGRESS = "in_progress"
        COMPLETED = "completed"
        WAITING = "waiting"
        REQUESTED = "requested"
        PENDING = "pending"
    }

    enum WorkflowConclusion {
        SUCCESS = "success"
        FAILURE = "failure"
        CANCELLED = "cancelled"
        SKIPPED = "skipped"
        TIMED_OUT = "timed_out"
        ACTION_REQUIRED = "action_required"
        NEUTRAL = "neutral"
        STALE = "stale"
    }

    class WorkflowRun {
        +id            : str
        +workflow_name : str
        +branch        : str
        +status        : WorkflowStatus
        +conclusion    : Optional[WorkflowConclusion]
        +created_at    : datetime
        +updated_at    : Optional[datetime]
        +run_number    : Optional[int]
        +commit_sha    : Optional[str]
        +duration_seconds : float
        --
        +to_dict() : dict
        +{static} from_dict(data: dict) : WorkflowRun
        +is_terminal() : bool
        +is_running() : bool
        +is_successful() : bool
        +is_failed() : bool
        +is_cancelled() : bool
    }

    class WorkflowRunAttempt {
        +id                : int
        +run_id            : int
        +attempt_number    : int
        +status            : str
        +conclusion        : Optional[str]
        +created_at        : datetime
        +duration_seconds  : float
        --
        +to_dict() : dict
        +{static} from_dict(data: dict) : WorkflowRunAttempt
        +is_successful() : bool
        +is_failed() : bool
        +is_running() : bool
    }
}

package "storage" #FFF3CC {
    class WorkflowJsonStorage {
        +filepath : str
        --
        +__init__(filepath: str)
        +save(runs: List[WorkflowRun]) : None
        +load() : List[WorkflowRun]
    }

    class AttemptJsonStorage {
        +filepath : str
        --
        +__init__(filepath: str)
        +save(attempts: List[WorkflowRunAttempt]) : None
        +load() : List[WorkflowRunAttempt]
    }
}

package "services" #DDFFD4 {
    class WorkflowRunService {
        -_storage : WorkflowJsonStorage
        -_runs    : List[WorkflowRun]
        --
        +__init__(storage: WorkflowJsonStorage)
        +add_workflow_run(run: WorkflowRun) : WorkflowRun
        +list_runs() : List[WorkflowRun]
        +get_run_detail(run_id: str) : Optional[WorkflowRun]
        +filter_by_branch(branch: str) : List[WorkflowRun]
        +filter_by_status(status: WorkflowStatus) : List[WorkflowRun]
        +filter_by_conclusion(conclusion: WorkflowConclusion) : List[WorkflowRun]
        +filter_by_duration_range(min: Optional[float],\n  max: Optional[float]) : List[WorkflowRun]
        +filter_by_created_after(cutoff: datetime) : List[WorkflowRun]
        +filter_by_created_before(cutoff: datetime) : List[WorkflowRun]
        +filter_by_updated_after(cutoff: datetime) : List[WorkflowRun]
        +filter_by_updated_before(cutoff: datetime) : List[WorkflowRun]
        +filter_by_has_attempts(attempt_service: AttemptService,\n  has_attempts: bool) : List[WorkflowRun]
        +filter_runs(attempt_service: Optional[AttemptService],\n  branch: Optional[str],\n  status: Optional[WorkflowStatus],\n  conclusion: Optional[WorkflowConclusion],\n  min_duration_seconds: Optional[float],\n  max_duration_seconds: Optional[float],\n  created_after: Optional[datetime],\n  created_before: Optional[datetime],\n  updated_after: Optional[datetime],\n  updated_before: Optional[datetime],\n  has_attempts: Optional[bool]) : List[WorkflowRun]
        -{static} _normalize_datetime(dt: datetime) : datetime
        -_persist() : None
    }

    class WorkflowRunTracker {
        -_service : WorkflowRunService
        --
        +__init__(service: WorkflowRunService)
        +track(workflow_name: str, branch: str,\n  status: WorkflowStatus,\n  conclusion: Optional[WorkflowConclusion],\n  run_number: Optional[int],\n  commit_sha: Optional[str],\n  duration_seconds: float,\n  run_id: Optional[str]) : WorkflowRun
    }

    class AttemptService {
        -_storage : AttemptJsonStorage
        -_attempts : List[WorkflowRunAttempt]
        --
        +__init__(storage: AttemptJsonStorage)
        +create_attempt(run_id: int, attempt_number: int, status: str,\n  conclusion: Optional[str], created_at: datetime,\n  duration_seconds: float) : WorkflowRunAttempt
        +list_attempts() : List[WorkflowRunAttempt]
        +get_attempts_by_run_id(run_id: int) : List[WorkflowRunAttempt]
        +get_attempt_detail(attempt_id: int) : Optional[WorkflowRunAttempt]
        -_persist() : None
    }
}

package "cli" #FFE5E5 {
    class "workflow_cli" <<module>> {
        +build_parser() : ArgumentParser
        +run_cli(service: WorkflowRunService,\n  attempt_service: AttemptService, args) : None
        -_fmt_run(run: WorkflowRun) : str
        -_fmt_attempt(attempt: WorkflowRunAttempt) : str
    }

    class "interactive_menu" <<module>> {
        +run_interactive(service: WorkflowRunService,\n  attempt_service: AttemptService) : None
        -_add_run(service: WorkflowRunService,\n  attempt_service: AttemptService) : None
        -_list_runs(service: WorkflowRunService,\n  attempt_service: AttemptService) : None
        -_detail_run(service: WorkflowRunService,\n  attempt_service: AttemptService) : None
        -_filter_menu(service: WorkflowRunService,\n  attempt_service: AttemptService) : None
        -_filter_by_duration_interactive(...) : None
        -_filter_by_created_interactive(...) : None
        -_filter_by_updated_interactive(...) : None
        -_filter_by_attempts_interactive(...) : None
        -_filter_compound_interactive(...) : None
        -_advanced_filter_menu(...) : None
        -_list_attempts_menu(attempt_service: AttemptService) : None
    }
}

WorkflowRun                ..>  WorkflowStatus        : status
WorkflowRun                ..>  WorkflowConclusion    : conclusion
WorkflowRunAttempt    "N" --> "1" WorkflowRun           : references run_id
WorkflowRunService    "1" --> "1" WorkflowJsonStorage : -_storage
WorkflowRunService         ..>  WorkflowRun
WorkflowRunService         ..>  WorkflowStatus
WorkflowRunService         ..>  WorkflowConclusion
WorkflowRunService         ..>  AttemptService        : uses for has_attempts filter
WorkflowRunTracker    "1" --> "1" WorkflowRunService  : -_service
WorkflowRunTracker         ..>  WorkflowRun
AttemptService       "1" --> "1" AttemptJsonStorage  : -_storage
AttemptService            ..>  WorkflowRunAttempt
"workflow_cli"             ..>  WorkflowRunService
"workflow_cli"             ..>  AttemptService
"interactive_menu"         ..>  WorkflowRunService
"interactive_menu"         ..>  AttemptService

@enduml
