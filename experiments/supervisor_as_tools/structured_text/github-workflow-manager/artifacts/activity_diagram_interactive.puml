@startuml activity_diagram_interactive

skinparam activityBackgroundColor #DDEEFF
skinparam activityBorderColor     #3366AA
skinparam activityDiamondBackgroundColor #FFF3CC

start

:Display interactive menu;

repeat

  :Wait for user selection;

  switch (choice)

    case (1 — Add workflow run)
      :Prompt workflow name;
      :Prompt branch;
      :Choose status from list;
      :Choose conclusion (optional, 0 to skip);
      :Prompt run number (optional);
      :Prompt commit SHA (optional);
      :Prompt duration (seconds);
      :WorkflowRunTracker.track();
      :Print "Added run <id>";

    case (2 — List all runs)
      :WorkflowRunService.list_runs();
      if (no runs?) then (yes)
        :Print "No runs recorded.";
      else (no)
        :Print all runs;
      endif

    case (3 — Get run detail)
      :Prompt run ID;
      :WorkflowRunService.get_run_detail(run_id);
      if (found?) then (yes)
        :Print run details;
      else (no)
        :Print "No run found with id '<id>'";
      endif

    case (4 — Check run state)
      :Prompt run ID;
      :WorkflowRunService.get_run_detail(run_id);
      if (found?) then (yes)
        :Print run details & state flags;
      else (no)
        :Print "No run found with id '<id>'";
      endif

    case (5 — Filter runs)
      :Choose filter type\n(branch / status / conclusion);
      if (branch?) then (yes)
        :Prompt branch name;
        :filter_by_branch();
      elseif (status?) then (yes)
        :Choose status from list;
        :filter_by_status();
      else (conclusion)
        :Choose conclusion from list;
        :filter_by_conclusion();
      endif
      if (no matches?) then (yes)
        :Print "No matching runs.";
      else (no)
        :Print matching runs;
      endif

    case (6 — Advanced Filter)
      :Display advanced filter submenu;
      repeat
        :Choose advanced filter option;
        switch (adv_choice)
          case (Duration range)
            :Prompt min duration (seconds);
            :Prompt max duration (optional);
            :filter_by_duration_range();
            if (no matches?) then (yes)
              :Print "No matching runs.";
            else (no)
              :Print matching runs;
            endif

          case (Created date range)
            :Prompt created-after (ISO 8601);
            :Prompt created-before (ISO 8601);
            :filter_runs() with created timestamps;
            if (no matches?) then (yes)
              :Print "No matching runs.";
            else (no)
              :Print matching runs;
            endif

          case (Updated date range)
            :Prompt updated-after (ISO 8601);
            :Prompt updated-before (ISO 8601);
            :filter_runs() with updated timestamps;
            if (no matches?) then (yes)
              :Print "No matching runs.";
            else (no)
              :Print matching runs;
            endif

          case (Has attempts)
            :Choose: show with attempts / without attempts;
            :filter_by_has_attempts();
            if (no matches?) then (yes)
              :Print "No matching runs.";
            else (no)
              :Print matching runs;
            endif

          case (Combine filters)
            :Choose which filters to apply;
            :Prompt all relevant filter parameters;
            :filter_runs(...) with all criteria;
            if (no matches?) then (yes)
              :Print "No matching runs.";
            else (no)
              :Print matching runs;
            endif

          case (Back to main menu)
            break
        endswitch
      repeat while (in advanced filters)

    case (7 — Add attempt)
      :Prompt run ID;
      :Prompt attempt number;
      :Prompt status;
      :Prompt conclusion (optional);
      :Prompt duration (seconds);
      :AttemptService.create_attempt();
      :Print "Added attempt <id>";

    case (8 — List attempts)
      :AttemptService.list_attempts();
      if (no attempts?) then (yes)
        :Print "No attempts recorded.";
      else (no)
        :Print all attempts;
      endif

    case (9 — Get attempt detail)
      :Prompt attempt ID;
      :AttemptService.get_attempt_detail(attempt_id);
      if (found?) then (yes)
        :Print attempt details;
      else (no)
        :Print "No attempt found with id '<id>'";
      endif

    case (10 — Exit)
      :Print "Goodbye.";
      stop

  endswitch

repeat while (user continues)

@enduml
