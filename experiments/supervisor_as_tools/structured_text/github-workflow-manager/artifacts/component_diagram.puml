@startuml component_diagram

skinparam componentStyle rectangle
skinparam linetype ortho
top to bottom direction

package "GitHub Workflow Manager" {

  package "Application entrypoint" {
    component "main" as MAIN
  }

  package "Interface layer" {
    component "workflow_cli" as CLI
    component "interactive_menu" as IM
    component "WorkflowRunGUI" as GUI
    component "FilterState" as FILTER_STATE
  }

  package "Filtering subsystem" {
    component "Basic Filters" as BASIC_FILTER
    component "Advanced Filters" as ADV_FILTER
    component "Compound Filter" as COMP_FILTER
  }

  package "Service layer" {
    component "WorkflowRunTracker" as TRACKER
    component "WorkflowRunService" as SVC
    component "AttemptService" as ATTEMPT_SVC
    component "StatisticsService" as STATS_SVC
    component "GitHubFetchService" as GH_SVC
    component "DataPortabilityService" as PORTABILITY
  }

  package "Adapter layer" #FFCCCC {
    component "GitHubAPIClient" as GH_API_CLIENT
    component "GhCliGitHubAdapter" as GH_ADAPTER
    component "GitHubDataMapper" as GH_MAPPER
    component "GithubDataMapperImpl" as GH_MAPPER_IMPL
    component "FileHandler" as FILE_HANDLER
    component "JsonFileAdapter" as JSON_ADAPTER
  }

  package "Data Portability" {
    artifact "export.json" as EXPORT_FILE
  }

  package "Persistence layer" {
    component "WorkflowJsonStorage" as STOR
    component "AttemptJsonStorage" as ATTEMPT_STOR
    artifact "workflow_runs.json" as JSON_FILE
    artifact "workflow_attempts.json" as ATTEMPT_FILE
  }

  package "Domain model" {
    component "WorkflowRun" as RUN
    component "WorkflowStatus" as STATUS
    component "WorkflowConclusion" as CONCLUSION
    component "WorkflowRunAttempt" as ATTEMPT
  }
}

component "GitHub API" as GH_API
component "Exceptions" as EXC
component "File System" as FILESYS

MAIN --> CLI
MAIN --> IM
MAIN --> GUI

CLI --> BASIC_FILTER
CLI --> ADV_FILTER
CLI --> COMP_FILTER
IM --> BASIC_FILTER
IM --> ADV_FILTER
IM --> COMP_FILTER

GUI --> FILTER_STATE
GUI --> SVC
GUI --> ATTEMPT_SVC
GUI --> STATS_SVC

BASIC_FILTER --> SVC
ADV_FILTER --> SVC
COMP_FILTER --> SVC

CLI --> TRACKER
IM --> TRACKER
CLI --> STATS_SVC
IM --> STATS_SVC

CLI --> PORTABILITY
IM --> PORTABILITY

CLI --> GH_SVC
IM --> GH_SVC
GH_SVC --> GH_API_CLIENT
GH_SVC --> GH_MAPPER
GH_SVC --> SVC
GH_SVC --> EXC

GH_API_CLIENT --> GH_ADAPTER
GH_ADAPTER --> GH_API

GH_MAPPER --> GH_MAPPER_IMPL

PORTABILITY --> FILE_HANDLER
PORTABILITY --> SVC
PORTABILITY --> ATTEMPT_SVC
PORTABILITY --> EXPORT_FILE

FILE_HANDLER --> JSON_ADAPTER
JSON_ADAPTER --> FILESYS

TRACKER --> SVC
SVC --> STOR
SVC --> ATTEMPT_SVC
STOR --> JSON_FILE

ATTEMPT_SVC --> ATTEMPT_STOR
ATTEMPT_STOR --> ATTEMPT_FILE

SVC ..> RUN
RUN --> STATUS
RUN --> CONCLUSION
SVC ..> ATTEMPT

@enduml