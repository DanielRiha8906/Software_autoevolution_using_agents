@startuml class_diagram

skinparam classAttributeIconSize 0
skinparam classFontStyle bold

package "models" #DDEEFF {
    enum TaskStatus {
        PENDING
        IN_PROGRESS
        DONE
    }

    class Task {
        +id : String
        +title : String
        +description : String [0..1]
        +status : TaskStatus
        +project_id : String [0..1]
        +createdAt : DateTime
        +updatedAt : DateTime
        +due_date : DateTime [0..1]
        --
        +toDict() : Dictionary
        +fromDict(data: Dictionary) : Task
        +mark_in_progress() : void
        +mark_done() : void
        +reopen() : void
        +is_completed() : Boolean
        +is_overdue() : Boolean
    }

    class Project {
        +id : String
        +name : String
        --
        +to_dict() : Dictionary
        +from_dict(data: Dictionary) : Project
    }

    class TaskComment {
        +id : String
        +task_id : String
        +content : String
        +created_at : DateTime
        --
        +to_dict() : Dictionary
        +from_dict(data: Dictionary) : TaskComment
    }

    class TaskStatistics {
        +total_count : int
        +pending_count : int
        +in_progress_count : int
        +done_count : int
        +overdue_count : int
        +tasks_with_due_date : int
        +completion_rate : float
        +avg_days_to_completion : Optional[float]
    }
}

package "storage" #FFF3CC {
    abstract class Storage {
        --
        +{abstract} load() : List<Dictionary>
        +{abstract} save(tasks: List<Dictionary>) : void
        +{abstract} load_comments() : List<Dictionary>
        +{abstract} save_comments(comments: List<Dictionary>) : void
        +{abstract} load_projects() : List<Dictionary>
        +{abstract} save_projects(projects: List<Dictionary>) : void
    }

    class JsonStorage {
        -path : String
        --
        +JsonStorage(path: String [0..1])
        +load() : List<Dictionary>
        +save(tasks: List<Dictionary>) : void
        +load_comments() : List<Dictionary>
        +save_comments(comments: List<Dictionary>) : void
        +load_projects() : List<Dictionary>
        +save_projects(projects: List<Dictionary>) : void
        +import_data(tasks: List<Dictionary>, comments: List<Dictionary>) : void
    }

    JsonStorage --|> Storage : implements
}

package "repositories" #D4FFFF {
    interface TaskExistenceValidator {
        +{abstract} task_exists(task_id: String) : Boolean
    }

    class TaskRepository {
        -task_manager : TaskManager
        -comments_service : CommentsService [0..1]
        --
        +TaskRepository(task_manager: TaskManager)
        +set_comments_service(comments_service: CommentsService) : void
        +task_exists(task_id: String) : Boolean
        +delete_task_with_comments(task_id: String) : void
    }

    TaskRepository ..|> TaskExistenceValidator : implements
}

package "services" #DDFFD4 {
    exception TaskNotFoundError
    exception CommentNotFoundError
    exception ProjectNotFoundError

    class TaskManager {
        -storage : Storage
        -tasks : Dictionary<String, Task>
        --
        +TaskManager(storage: Storage [0..1])
        +add(title: String, description: String [0..1], project_id: String [0..1]) : Task
        +get(taskId: String) : Task
        +listAll() : List<Task>
        +listByStatus(status: TaskStatus) : List<Task>
        +list_by_project(project_id: String) : List<Task>
        +list_by_due_date_range(start: DateTime [0..1], end: DateTime [0..1], status: TaskStatus [0..1]) : List<Task>
        +list_overdue(status: TaskStatus [0..1]) : List<Task>
        +update(taskId: String, title: String [0..1], description: String [0..1]) : Task
        +setStatus(taskId: String, status: TaskStatus) : Task
        +delete(taskId: String) : void
        +set_due_date(taskId: String, dueDate: DateTime [0..1]) : Task
        +unassign_from_project(project_id: String) : void
        +has_tasks() : Boolean
        +clear() : void
        -load() : void
        -persist() : void
        -validate_due_date(dt: DateTime [0..1]) : void
        -load_from_dicts(task_dicts: List<Dictionary>) : void
    }

    class ProjectManager {
        -storage : Storage
        -projects : Dictionary<String, Project>
        --
        +ProjectManager(storage: Storage [0..1])
        +add(name: String) : Project
        +get(project_id: String) : Project
        +list_all() : List<Project>
        +delete(project_id: String) : void
        -load() : void
        -persist() : void
    }

    class CommentsService {
        -storage : Storage
        -validator : TaskExistenceValidator
        -comments : Dictionary<String, TaskComment>
        --
        +CommentsService(storage: Storage, validator: TaskExistenceValidator)
        +add_comment(task_id: String, content: String) : TaskComment
        +list_comments(task_id: String) : List<TaskComment>
        +delete_comment(comment_id: String) : void
        +delete_all_for_task(task_id: String) : void
        +has_comments() : Boolean
        +clear() : void
        -load() : void
        -persist() : void
        -load_from_dicts(comment_dicts: List<Dictionary>) : void
    }

    class TodoService {
        -task_manager : TaskManager
        -repository : TaskRepository
        -comments_service : CommentsService
        -project_manager : ProjectManager
        -manager : TaskManager
        --
        +TodoService(storage: Storage [0..1])
        +add_task(title: String, description: String [0..1], project_id: String [0..1]) : Task
        +get_task(taskId: String) : Task
        +list_tasks(status: TaskStatus [0..1], due_before: DateTime [0..1], due_after: DateTime [0..1], overdue: Boolean, project_id: String [0..1]) : List<Task>
        +start_task(taskId: String) : Task
        +complete_task(taskId: String) : Task
        +reopen_task(taskId: String) : Task
        +update_task(taskId: String, title: String [0..1], description: String [0..1]) : Task
        +delete_task(taskId: String) : void
        +set_due_date(taskId: String, dueDate: DateTime [0..1]) : Task
        +add_comment(task_id: String, content: String) : TaskComment
        +list_comments(task_id: String) : List<TaskComment>
        +delete_comment(comment_id: String) : void
        +get_statistics() : TaskStatistics
        +export_tasks(filepath: String) : Tuple[int, int]
        +import_tasks(filepath: String, overwrite: Boolean) : Tuple[int, int, List]
        +add_project(name: String) : Project
        +get_project(project_id: String) : Project
        +list_projects() : List<Project>
        +delete_project(project_id: String) : void
    }
}

package "cli" #FFE5E5 {
    class TodoCLI {
        -service : TodoService
        --
        +TodoCLI(storagePath: String [0..1])
        +run(argv: List<String> [0..1]) : Integer
        -_parse_cest_datetime(date_str: String) : DateTime [0..1]
        -_cmd_stats(args: Namespace) : Integer
    }

    class InteractiveMenu {
        -service : TodoService
        --
        +InteractiveMenu(storagePath: String [0..1])
        +run() : void
        -_do_stats() : void
    }
}

Task --> TaskStatus : status
Task --> Project : project_id references [0..1]
Project --> Project : grouping
TaskComment --> Task : task_id references Task.id
TaskManager --> Storage : storage
TaskManager ..> TaskNotFoundError : raises
ProjectManager --> Storage : storage
ProjectManager --> Project : manages
ProjectManager ..> ProjectNotFoundError : raises
CommentsService --> Storage : storage
CommentsService --> TaskExistenceValidator : validator
CommentsService --> TaskComment : manages
CommentsService ..> CommentNotFoundError : raises
TaskRepository --> TaskManager : coordinates
TaskRepository --> CommentsService : coordinates
TodoService --> TaskManager : task_manager
TodoService --> TaskRepository : repository
TodoService --> CommentsService : comments_service
TodoService --> ProjectManager : project_manager
TodoService --> TaskStatistics : returns
TodoCLI --> TodoService : service
TodoCLI --> TaskStatistics : uses
InteractiveMenu --> TodoService : service
InteractiveMenu --> TaskStatistics : uses

@enduml