@startuml class_diagram

skinparam classAttributeIconSize 0
skinparam classFontStyle bold

package "models" #DDEEFF {
    enum TaskStatus {
        PENDING
        IN_PROGRESS
        DONE
    }

    class Task {
        +id : String
        +title : String
        +description : String [0..1]
        +status : TaskStatus
        +createdAt : DateTime
        +updatedAt : DateTime
        +due_date : DateTime [0..1]
        --
        +toDict() : Dictionary
        +fromDict(data: Dictionary) : Task
        +is_overdue() : Boolean
    }

    class TaskComment {
        +id : String
        +task_id : String
        +content : String
        +created_at : DateTime
        +author : String [0..1]
        +updated_at : DateTime [0..1]
        --
        +toDict() : Dictionary
        +fromDict(data: Dictionary) : TaskComment
    }
}

package "storage" #FFF3CC {
    class JsonStorage {
        -path : String
        --
        +JsonStorage(path: String [0..1])
        +load() : List<Dictionary>
        +save(tasks: List<Dictionary>) : void
        +load_all() : Dictionary
        +save_all(data: Dictionary) : void
    }
}

package "services" #DDFFD4 {
    exception TaskNotFoundError
    exception CommentNotFoundError

    class TaskManager {
        -storage : JsonStorage
        -tasks : Dictionary<String, Task>
        -comments_service : CommentsService [0..1]
        --
        +TaskManager(storage: JsonStorage [0..1], comments_service: CommentsService [0..1])
        +add(title: String, description: String [0..1], due_date: DateTime [0..1]) : Task
        +get(taskId: String) : Task
        +listAll() : List<Task>
        +listByStatus(status: TaskStatus) : List<Task>
        +update(taskId: String, title: String [0..1], description: String [0..1], due_date: DateTime [0..1]) : Task
        +setStatus(taskId: String, status: TaskStatus) : Task
        +set_due_date(taskId: String, due_date: DateTime [0..1]) : Task
        +delete(taskId: String) : void
        -load() : void
        -persist() : void
    }

    class CommentsService {
        -storage : JsonStorage
        -comments : Dictionary<String, TaskComment>
        -task_manager : TaskManager [0..1]
        --
        +CommentsService(storage: JsonStorage [0..1], task_manager: TaskManager [0..1])
        +add(task_id: String, content: String, author: String [0..1]) : TaskComment
        +get(comment_id: String) : TaskComment
        +listAll() : List<TaskComment>
        +list_for_task(task_id: String) : List<TaskComment>
        +update(comment_id: String, content: String [0..1], author: String [0..1]) : TaskComment
        +delete(comment_id: String) : void
        +delete_by_task_id(task_id: String) : void
        -load() : void
        -persist() : void
    }

    class TodoService {
        -manager : TaskManager
        --
        +TodoService(storage: JsonStorage [0..1])
        +addTask(title: String, description: String [0..1]) : Task
        +getTask(taskId: String) : Task
        +listTasks(status: TaskStatus [0..1]) : List<Task>
        +startTask(taskId: String) : Task
        +completeTask(taskId: String) : Task
        +reopenTask(taskId: String) : Task
        +updateTask(taskId: String, title: String [0..1], description: String [0..1]) : Task
        +deleteTask(taskId: String) : void
    }
}

package "cli" #FFE5E5 {
    class TodoCLI {
        -service : TodoService
        --
        +TodoCLI(storagePath: String [0..1])
        +run(argv: List<String> [0..1]) : Integer
    }

    class InteractiveMenu {
        -service : TodoService
        --
        +InteractiveMenu(storagePath: String [0..1])
        +run() : void
    }
}

Task --> TaskStatus : status
TaskComment --> Task : task_id references
TaskManager --> JsonStorage : storage
TaskManager "1" --> "0..1" CommentsService : optional dependency
CommentsService --> JsonStorage : storage
CommentsService "0..1" --> "1" TaskManager : optional dependency
CommentsService ..> CommentNotFoundError : raises
TaskManager ..> TaskNotFoundError : raises
TodoService --> TaskManager : manager
TodoCLI --> TodoService : service
InteractiveMenu --> TodoService : service

@enduml