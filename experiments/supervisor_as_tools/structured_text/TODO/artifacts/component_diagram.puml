@startuml component_diagram

skinparam componentStyle uml2
skinparam defaultFontSize 13

top to bottom direction

package "TODO Application" {

    component "Entry Point\n(main)" as Main

    package "Presentation Layer" {
        component "Interactive Menu" as IM
        component "Command-line Interface\n(TodoCLI)" as CLI

        package "GUI (tkinter)" {
            component "Main Window\n(TodoGUI)" as MainWindow
            component "Dialogs\n(Add, Update, etc.)" as Dialogs
            component "Task Display\n(TaskRow)" as TaskDisplay
            component "Styling\n(Colors, Fonts)" as Styling
        }
    }

    package "Orchestration Layer" {
        component "Todo Service" as SVC
    }

    package "Business Logic Layer" {
        component "Task Manager" as MGR
        component "Project Manager" as PMR
        component "Comments Service" as COM
        component "Task Repository" as REPO
    }

    package "Domain Model" {
        component "Task Model\n(Task, TaskStatus)" as Model
        component "Project Model\n(Project)" as ProjectModel
        component "Comment Model\n(TaskComment)" as CommentModel
        component "Statistics Model\n(TaskStatistics)" as StatsModel
    }

    package "Storage Abstraction Layer" {
        component "Storage (ABC)" as StorageABC
    }

    package "Persistence Layer" {
        component "JSON Storage\n(JsonStorage)" as Storage
    }

    package "Export/Import Files" {
        component "JSON Export/Import" as Files
    }
}

database "todo_data.json" as DB

Main --> IM : interactive mode
Main --> CLI : command mode
Main --> MainWindow : GUI mode

IM --> SVC
IM --> MainWindow : launch GUI from menu

CLI --> SVC

MainWindow --> SVC
MainWindow --> Dialogs : uses
MainWindow --> TaskDisplay : uses
MainWindow --> Styling : uses
Dialogs --> Styling : uses

SVC --> MGR
SVC --> PMR
SVC --> COM
SVC --> REPO
SVC ..> StatsModel : returns

REPO --> MGR : coordinates
REPO --> COM : coordinates

MGR --> StorageABC : depends on
MGR ..> Model
PMR --> StorageABC : depends on
PMR ..> ProjectModel
COM --> StorageABC : depends on
COM --> REPO : validates via
COM ..> CommentModel

StorageABC --> Storage : abstraction for
Storage --> DB : read/write
Storage ..> Model
Storage ..> ProjectModel
Storage ..> CommentModel

SVC --> Files : export to / import from

@enduml